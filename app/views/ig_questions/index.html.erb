<% content_for :page_title, "IG 未回覆問題" %>
<div class="subheader">
  <h1 class="subheader-title"><i class="fal fa-comment-alt-exclamation mr-2 text-primary"></i> IG 未回覆問題
    <small>客人在 IG 私訊、但 ManyChat 沒有自動回覆到的訊息；每天早上 8 點後由 AI 整理前一天</small></h1>
</div>

<% [:notice, :alert].each do |k| %>
  <% if flash[k] %><div class="alert alert-<%= k == :notice ? 'success' : 'danger' %>"><%= flash[k] %></div><% end %>
<% end %>

<div class="d-flex align-items-center flex-wrap mb-3" style="gap:8px;">
  <%= link_to "← #{(@day - 1).strftime('%-m/%-d')}", ig_questions_path(day: @day - 1), class: "btn btn-sm btn-outline-secondary" %>
  <%= form_with url: ig_questions_path, method: :get, local: true, class: "d-flex", style: "gap:8px;" do %>
    <input type="date" name="day" value="<%= @day.iso8601 %>" class="form-control form-control-sm" onchange="this.form.submit()">
  <% end %>
  <%= link_to "#{(@day + 1).strftime('%-m/%-d')} →", ig_questions_path(day: @day + 1), class: "btn btn-sm btn-outline-secondary" %>
  <%= button_to "重新整理這天的分析", regenerate_ig_questions_path(day: @day.iso8601), method: :post,
        class: "btn btn-sm btn-outline-primary",
        form: { class: "mb-0", data: { confirm: "要請 AI 重新整理 #{@day} 的問題嗎？" } } %>
</div>

<div class="row">
  <% diff = @total - @prev_total %>
  <% [["未回覆訊息", @total, "前一天 #{@prev_total}（#{diff >= 0 ? '+' : ''}#{diff}）"],
      ["敏感問題（要真人回）", @sensitive.size, "懷孕、吃藥、疾病、不適、客訴"],
      ["還沒處理", @open_count, "還沒加進自動回覆／FAQ"]].each do |label, value, sub| %>
    <div class="col-sm-4 mb-3">
      <div class="p-3 bg-white border rounded">
        <div class="text-muted small"><%= label %></div>
        <div class="fs-xxl fw-700"><%= value %></div>
        <div class="text-muted small"><%= sub %></div>
      </div>
    </div>
  <% end %>
</div>

<div class="row">
  <div class="col-lg-6">
    <div class="panel"><div class="panel-hdr"><h2>AI 總結</h2></div>
    <div class="panel-container show"><div class="panel-content">
      <% if @digest.nil? %>
        <p class="text-muted mb-0">這天還沒整理。</p>
      <% elsif @digest.status == "pending" %>
        <p class="text-muted mb-0"><i class="fal fa-spinner fa-spin mr-1"></i> 整理中，約 1–2 分鐘後重新整理頁面。</p>
      <% elsif @digest.status == "failed" %>
        <p class="text-danger mb-0">整理失敗：<%= @digest.error_message %>（每小時同步時會自動重試，或按「重新整理這天的分析」）</p>
      <% else %>
        <p style="white-space:pre-line;"><%= @digest.overview %></p>
        <p class="text-muted small mb-0">整理時間 <%= l(@digest.generated_at, format: "%m/%d %H:%M") %></p>
      <% end %>
    </div></div></div>
  </div>
  <div class="col-lg-6">
    <div class="panel"><div class="panel-hdr"><h2>建議新增的自動回覆／FAQ</h2></div>
    <div class="panel-container show"><div class="panel-content">
      <% if @digest&.status == "done" && @digest.suggestions.any? %>
        <ol class="pl-3 mb-0">
          <% @digest.suggestions.each do |s| %>
            <li class="mb-2"><strong><%= s["title"] %></strong><br><span class="text-muted"><%= s["detail"] %></span></li>
          <% end %>
        </ol>
      <% else %>
        <p class="text-muted mb-0">沒有建議。</p>
      <% end %>
    </div></div></div>
  </div>
</div>

<div class="panel"><div class="panel-hdr"><h2>問題類別</h2></div>
<div class="panel-container show"><div class="panel-content" style="overflow-x:auto;">
  <table class="table table-sm mb-0">
    <thead class="thead-light"><tr><th>類別</th><th class="text-right">這天</th><th class="text-right">前一天</th><th class="text-right">近 7 天</th><th>客人原話（舉例）</th></tr></thead>
    <tbody>
      <% @category_rows.each do |r| %>
        <tr>
          <td class="text-nowrap"><%= r[:category] %></td>
          <td class="text-right fw-700"><%= r[:day] %></td>
          <td class="text-right"><%= r[:prev] %></td>
          <td class="text-right"><%= r[:week] %></td>
          <td class="small"><%= safe_join(r[:examples].map { |q| content_tag(:div, "「#{q.truncate(80)}」") }) %></td>
        </tr>
      <% end %>
      <% if @category_rows.empty? %><tr><td colspan="5" class="text-muted">沒有資料</td></tr><% end %>
    </tbody>
  </table>
</div></div></div>

<% if @sensitive.any? %>
  <div class="panel"><div class="panel-hdr bg-danger-50"><h2>敏感問題（要真人回，不能交給機器人）</h2></div>
  <div class="panel-container show"><div class="panel-content" style="overflow-x:auto;">
    <table class="table table-sm mb-0">
      <thead class="thead-light"><tr><th>時間</th><th>客人</th><th>原因</th><th>訊息</th></tr></thead>
      <tbody>
        <% @sensitive.each do |q| %>
          <tr>
            <td class="text-nowrap"><%= l(q.asked_at, format: "%H:%M") %></td>
            <td class="text-nowrap"><%= q.ig_username.present? ? "@#{q.ig_username}" : q.name %></td>
            <td class="text-nowrap"><%= q.sensitive_reason %></td>
            <td><%= q.question %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div></div></div>
<% end %>

<div class="panel"><div class="panel-hdr"><h2>全部訊息（<%= @questions.size %>）</h2>
  <div class="panel-toolbar small">
    <%= link_to "全部", ig_questions_path(day: @day), class: "mr-2 #{'fw-700' if params[:status].blank?}" %>
    <% IgQuestion::STATUSES.each do |k, label| %>
      <%= link_to label, ig_questions_path(day: @day, status: k), class: "mr-2 #{'fw-700' if params[:status] == k}" %>
    <% end %>
  </div></div>
<div class="panel-container show"><div class="panel-content" style="overflow-x:auto;">
  <table class="table table-sm mb-0">
    <thead class="thead-light"><tr><th>時間</th><th>帳號</th><th>客人</th><th>類別</th><th>訊息</th><th>處理狀態</th></tr></thead>
    <tbody>
      <% @questions.each do |q| %>
        <tr class="<%= 'text-muted' if q.status == 'ignored' %>">
          <td class="text-nowrap"><%= l(q.asked_at, format: "%H:%M") %></td>
          <td class="text-nowrap small">@<%= q.account_key %></td>
          <td class="text-nowrap"><%= q.ig_username.present? ? "@#{q.ig_username}" : q.name %></td>
          <td class="text-nowrap small"><%= q.category || "未分類" %><%= " ⚠️" if q.sensitive %></td>
          <td style="min-width:260px;"><%= q.question %></td>
          <td class="text-nowrap">
            <%= form_with url: ig_question_path(q), method: :patch, local: true, class: "mb-0" do %>
              <select name="status" class="form-control form-control-sm" onchange="this.form.requestSubmit()">
                <%= options_for_select(IgQuestion::STATUSES.invert, q.status) %>
              </select>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @questions.empty? %><tr><td colspan="6" class="text-muted">這天沒有未回覆的訊息</td></tr><% end %>
    </tbody>
  </table>
</div></div></div>
