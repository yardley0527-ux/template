  <% gold  = customers.select { |r| r[:customer].membership_level == "金卡" } %>
  <div class="px-3 pt-2 border-bottom">
    <ul class="nav nav-tabs" id="tabs-<%= card_id %>">
      <% [["黑卡", "black", black], ["金卡", "gold", gold]].each do |level, key, group| %>
        <% next if group.empty? %>
        <li class="nav-item">
          <button class="nav-link"
                  data-tab-prefix="<%= card_id %>"
                  data-tab-target="<%= card_id %>-<%= key %>"
                  type="button">
            <%= level %> <span class="badge bg-secondary"><%= group.size %></span>
          </button>
        </li>
      <% end %>
    </ul>
  </div>
  <div class="card-body p-0">
    <% [["黑卡", "black", black], ["金卡", "gold", gold]].each do |level, key, group| %>
      <% next if group.empty? %>
      <div class="invite-pane" id="pane-<%= card_id %>-<%= key %>" style="display: none;">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
            <thead class="table-light">
              <tr>
                <th>姓名</th><th>卡別</th><th>最近購買</th>
                <th>上次購買日期</th><th>歷史買代謝次數</th><th>歷史代謝消費</th><th>IG</th>
              </tr>
            </thead>
            <tbody>
              <% group.each do |r| %>
                <% c = r[:customer] %>
                <tr>
                  <td><%= link_to c.full_name, customer_path(c.id), target: "_blank", class: "fw-semibold text-decoration-none" %></td>
                  <td><span class="text-muted small"><%= c.membership_level %></span></td>
                  <td><%= r[:last_product] %></td>
                  <td><%= r[:last_date]&.strftime("%m/%d") || "-" %></td>
                  <td class="text-center"><%= r[:history_count] %> 次</td>
                  <td>NT$<%= number_with_delimiter(r[:history_amount].to_i) %></td>
                  <td>
                    <% if c.instagram_account.present? %>
                      <a href="https://instagram.com/<%= c.instagram_account.gsub('@','') %>" target="_blank" class="text-decoration-none">
                        📷 <%= c.instagram_account %>
                      </a>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
