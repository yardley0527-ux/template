<% content_for :page_title, "代謝錠回購分析" %>

<%= render 'shared/next_livestream_plan',
      cross_event_stats: @cross_event_stats || [],
      iron_fans:         @iron_fans         || [],
      expiring_soon:     @expiring_soon     || [],
      high_risk_lost:    @high_risk_lost    || [],
      section_id:        'meta' %>

<div class="row g-3 mb-4">
  <div class="col-12 d-flex justify-content-between align-items-center">
    <div>
      <h4 class="fw-bold mb-0">代謝錠品牌之夜 — 五場總覽</h4>
      <p class="text-muted small mb-0">含 4/24 回購分析 ＋ 未回購追蹤名單</p>
    </div>
    <%= link_to "⬇ 匯出聯絡名單 CSV", metabolism_analysis_export_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>
</div>

<%# ══════════════════════════════════════════ %>
<%# 區塊一：策略參考                           %>
<%# ══════════════════════════════════════════ %>

<div class="d-flex align-items-center mb-3">
  <div class="border-start border-3 border-secondary ps-3">
    <h5 class="fw-bold mb-0 text-secondary">📊 策略參考</h5>
    <p class="text-muted small mb-0">五場數據總覽，供定價與套組規劃參考</p>
  </div>
</div>

<%# 五場數據總覽 %>
<div class="card border-0 shadow-sm mb-3">
  <div class="card-body p-0 table-responsive">
    <table class="table align-middle mb-0 text-center" style="font-size: 0.9rem;">
      <thead style="background-color: #4a4a4a; color: white;">
        <tr>
          <th class="text-start ps-3">場次</th>
          <th>買家人數</th>
          <th>總營業額</th>
          <th>平均客單價</th>
          <th class="text-start ps-3">熱銷組合 Top 3</th>
        </tr>
      </thead>
      <tbody>
        <% [
          ["7/4",  @jul4_emails.size,  @jul4_revenue,  @jul4_aov,  @jul4_top_products],
          ["7/22", @jul22_emails.size, @jul22_revenue, @jul22_aov, @jul22_top_products],
          ["10/9", @oct9_emails.size,  @oct9_revenue,  @oct9_aov,  @oct9_top_products],
          ["2/25", @feb25_emails.size, @feb25_revenue, @feb25_aov, @feb25_top_products],
          ["4/24", @apr24_emails.size, @apr24_revenue, @apr24_aov, @apr24_top_products],
        ].each_with_index do |(date, count, rev, aov, products), i| %>
          <tr <%= i == 4 ? 'style="background-color: #f0f4ff;"' : '' %>>
            <td class="fw-bold text-start ps-3">
              <%= date %>
              <% if i == 4 %><span class="badge ms-1" style="background-color: #4a6fa5; font-size: 0.65rem;">最新</span><% end %>
            </td>
            <td><%= count %> 人</td>
            <td>NT$<%= number_with_delimiter(rev) %></td>
            <td>NT$<%= number_with_delimiter(aov) %></td>
            <td class="text-start ps-3">
              <% products.each do |name, cnt| %>
                <span class="badge me-1 mb-1" style="background-color: #e9ecef; color: #495057; font-weight: normal;">
                  <%= name %> × <%= cnt %>
                </span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%# 常見共同購買 %>
<div class="card border-0 shadow-sm mb-3">
  <div class="card-header text-white" style="background-color: #4a4a4a;">
    🛒 買代謝錠的人，通常也會買什麼？
  </div>
  <div class="card-body">
    <p class="text-muted small mb-3">以下為所有代謝錠訂單中，同筆訂單出現的其他產品排名，可作為套組搭配或加購推薦參考。</p>
    <div class="d-flex flex-wrap gap-2">
      <% @copurchase_products.each_with_index do |(name, cnt), i| %>
        <% opacity = [1.0 - i * 0.07, 0.4].max %>
        <div class="d-flex align-items-center px-3 py-2 rounded"
             style="background-color: rgba(74,74,74,<%= opacity %>); color: white; font-size: 0.9rem;">
          <span class="me-2 fw-bold">#<%= i + 1 %></span>
          <span><%= name %></span>
          <span class="ms-2 badge bg-white text-dark"><%= number_with_delimiter(cnt) %> 次</span>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%# 黑卡金卡出席率 %>
<div class="card border-0 shadow-sm mb-3">
  <div class="card-header text-white" style="background-color: #4a4a4a;">黑卡 / 金卡 各場出席率</div>
  <div class="card-body p-0 table-responsive">
    <table class="table align-middle mb-0 text-center" style="font-size: 0.9rem;">
      <thead class="table-light">
        <tr>
          <th></th>
          <th>總人數</th>
          <th>7/4</th><th>7/4 %</th>
          <th>7/22</th><th>7/22 %</th>
          <th>10/9</th><th>10/9 %</th>
          <th>2/25</th><th>2/25 %</th>
          <th>4/24</th><th>4/24 %</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="fw-bold text-start ps-3">黑卡</td>
          <td><%= @black_card_total %></td>
          <td><%= @black_jul4 %></td>  <td><%= @black_jul4_rate %>%</td>
          <td><%= @black_jul22 %></td> <td><%= @black_jul22_rate %>%</td>
          <td><%= @black_oct9 %></td>  <td><%= @black_oct9_rate %>%</td>
          <td><%= @black_feb25 %></td> <td><%= @black_feb25_rate %>%</td>
          <td class="fw-bold"><%= @black_apr24 %></td> <td class="fw-bold"><%= @black_apr24_rate %>%</td>
        </tr>
        <tr>
          <td class="fw-bold text-start ps-3">金卡</td>
          <td><%= @gold_card_total %></td>
          <td><%= @gold_jul4 %></td>  <td><%= @gold_jul4_rate %>%</td>
          <td><%= @gold_jul22 %></td> <td><%= @gold_jul22_rate %>%</td>
          <td><%= @gold_oct9 %></td>  <td><%= @gold_oct9_rate %>%</td>
          <td><%= @gold_feb25 %></td> <td><%= @gold_feb25_rate %>%</td>
          <td class="fw-bold"><%= @gold_apr24 %></td> <td class="fw-bold"><%= @gold_apr24_rate %>%</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<%# 回流率卡片 %>
<div class="row g-3 mb-3">
  <% [
    ["7/4 → 7/22",       @jul4_return_rate,  @jul4_to_jul22_count,  @jul4_emails.size],
    ["7/22 → 10/9",      @jul22_return_rate, @jul22_to_oct9_count,  @jul22_emails.size],
    ["10/9 → 2/25",      @oct9_return_rate,  @oct9_to_feb25_count,  @oct9_emails.size],
    ["2/25 → 4/24",      @feb25_return_rate, @feb25_to_apr24_count, @feb25_emails.size],
    ["前四場 → 4/24 整體", @prev_return_rate,
      ((@jul4_emails | @jul22_emails | @oct9_emails | @feb25_emails).uniq & @apr24_emails).size,
      (@jul4_emails | @jul22_emails | @oct9_emails | @feb25_emails).uniq.size],
  ].each do |label, rate, num, den| %>
    <div class="col">
      <div class="card border-0 shadow-sm text-center py-3">
        <div class="text-muted small mb-1"><%= label %></div>
        <div class="fw-bold" style="font-size: 1.8rem; color: #495057;"><%= rate %>%</div>
        <div class="text-muted small"><%= num %> / <%= den %> 人</div>
      </div>
    </div>
  <% end %>
</div>

<%# 建議行動 %>
<div class="card border-0 shadow-sm mb-5">
  <div class="card-header text-white" style="background-color: #4a4a4a;">📌 建議行動</div>
  <div class="card-body">
    <% @insights.each do |insight| %>
      <% bg = { info: "alert-info", warning: "alert-warning", danger: "alert-danger", success: "alert-success" }[insight[:type]] %>
      <div class="alert <%= bg %> py-2 px-3 mb-2" style="font-size: 0.9rem;"><%= insight[:text] %></div>
    <% end %>
  </div>
</div>

<%# ══════════════════════════════════════════════════ %>
<%# ★ 前四場有買、4/24 未回購（金卡以上）             %>
<%# ══════════════════════════════════════════════════ %>

<% if @did_not_return.any? %>
  <div class="d-flex align-items-center mb-3">
    <div class="border-start border-3 border-danger ps-3">
      <h5 class="fw-bold mb-0 text-danger">🚨 前四場有買、4/24 未回購</h5>
      <p class="text-muted small mb-0">黑卡 / 金卡｜逾期越多越優先，建議本週內追蹤</p>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-5">
    <div class="card-header text-white d-flex justify-content-between align-items-center"
         style="background-color: #8b1a1a;">
      <div>
        <span class="fw-bold">4/24 未回購名單</span>
        <span class="ms-2 small opacity-75">依卡級 → 逾期天數排列</span>
      </div>
      <span class="badge bg-white text-dark"><%= @did_not_return.size %> 人</span>
    </div>

    <div class="px-3 pt-2 border-bottom">
      <ul class="nav nav-tabs" id="tabs-dnr">
        <% [["黑卡", "black"], ["金卡", "gold"]].each do |level, key| %>
          <% next if @did_not_return.none? { |r| r[:customer].membership_level == level } %>
          <li class="nav-item">
            <button class="nav-link"
                    data-tab-prefix="dnr"
                    data-tab-target="dnr-<%= key %>"
                    type="button">
              <%= level %>
              <span class="badge bg-secondary">
                <%= @did_not_return.count { |r| r[:customer].membership_level == level } %>
              </span>
            </button>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="card-body p-0">
      <% [["黑卡", "black"], ["金卡", "gold"]].each do |level, key| %>
        <% rows = @did_not_return.select { |r| r[:customer].membership_level == level } %>
        <% next if rows.empty? %>
        <div class="invite-pane" id="pane-dnr-<%= key %>" style="display: none;">
          <div class="table-responsive" data-paginate="true" data-page-size="20">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
              <thead class="table-light">
                <tr>
                  <th>#</th>
                  <th>姓名</th>
                  <th>卡別</th>
                  <th>出席場次</th>
                  <th>上次買</th>
                  <th>瓶數</th>
                  <th>預期回購</th>
                  <th>逾期</th>
                  <th>歷史次數</th>
                  <th>歷史消費</th>
                  <th>電話</th>
                  <th>IG</th>
                </tr>
              </thead>
              <tbody>
                <% rows.each_with_index do |r, i| %>
                  <% c = r[:customer] %>
                  <tr>
                    <td>
                      <span class="badge <%= i < 3 ? 'bg-danger' : i < 8 ? 'bg-warning text-dark' : 'bg-light text-dark' %>">
                        #<%= i + 1 %>
                      </span>
                    </td>
                    <td><%= link_to c.full_name, customer_path(c.id), target: "_blank", class: "fw-semibold text-decoration-none" %></td>
                    <td><span class="text-muted small"><%= c.membership_level %></span></td>
                    <td>
                      <span class="badge <%= r[:attended_jul4]  ? 'bg-success' : 'bg-light text-muted' %> me-1">7/4</span>
                      <span class="badge <%= r[:attended_jul22] ? 'bg-success' : 'bg-light text-muted' %> me-1">7/22</span>
                      <span class="badge <%= r[:attended_oct9]  ? 'bg-success' : 'bg-light text-muted' %> me-1">10/9</span>
                      <span class="badge <%= r[:attended_feb25] ? 'bg-success' : 'bg-light text-muted' %> me-1">2/25</span>
                      <span class="badge bg-light text-muted border">4/24 ✗</span>
                    </td>
                    <td><%= r[:last_date]&.strftime("%m/%d") || "-" %></td>
                    <td class="text-center"><%= r[:bottles] %> 瓶</td>
                    <td><%= r[:last_date] ? (r[:last_date] + r[:expected_days]).strftime("%m/%d") : "-" %></td>
                    <td>
                      <% od = r[:overdue_days] %>
                      <% if od.nil? %>
                        <span class="text-muted">-</span>
                      <% elsif od > 14 %>
                        <span class="badge bg-danger">+<%= od %>天</span>
                      <% elsif od > 0 %>
                        <span class="badge bg-warning text-dark">+<%= od %>天</span>
                      <% else %>
                        <span class="badge bg-success">未到期</span>
                      <% end %>
                    </td>
                    <td class="text-center"><%= r[:history_count] %> 次</td>
                    <td>NT$<%= number_with_delimiter(r[:history_amount].to_i) %></td>
                    <td>
                      <% if c.mobile_phone.present? %>
                        <a href="tel:<%= c.mobile_phone %>" class="text-decoration-none text-muted small">
                          📞 <%= c.mobile_phone %>
                        </a>
                      <% end %>
                    </td>
                    <td>
                      <% if c.instagram_account.present? %>
                        <a href="https://instagram.com/<%= c.instagram_account.gsub('@','') %>" target="_blank" class="text-decoration-none">
                          📷 <%= c.instagram_account %>
                        </a>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%# ══════════════════════════════════════════ %>
<%# 區塊二：業務聯絡名單                       %>
<%# ══════════════════════════════════════════ %>

<div class="d-flex align-items-center mb-3">
  <div class="border-start border-3 border-secondary ps-3">
    <h5 class="fw-bold mb-0 text-secondary">📋 業務聯絡名單</h5>
    <p class="text-muted small mb-0">由緊急到一般，由上往下聯絡</p>
  </div>
</div>

<%# helper：渲染黑卡/金卡分頁 tab 卡片 %>
<% render_invite_card = lambda do |customers, tab_prefix| %>
  <div class="px-3 pt-2 border-bottom">
    <ul class="nav nav-tabs" id="tabs-<%= tab_prefix %>">
      <% [["黑卡", "black"], ["金卡", "gold"]].each do |level, key| %>
        <% group = customers.select { |r| r[:customer].membership_level == level } %>
        <% next if group.empty? %>
        <li class="nav-item">
          <button class="nav-link"
                  data-tab-prefix="<%= tab_prefix %>"
                  data-tab-target="<%= tab_prefix %>-<%= key %>"
                  type="button">
            <%= level %> <span class="badge bg-secondary"><%= group.size %></span>
          </button>
        </li>
      <% end %>
    </ul>
  </div>
  <div class="card-body p-0">
    <% [["黑卡", "black"], ["金卡", "gold"]].each do |level, key| %>
      <% rows = customers.select { |r| r[:customer].membership_level == level } %>
      <% next if rows.empty? %>
      <div class="invite-pane" id="pane-<%= tab_prefix %>-<%= key %>" style="display: none;">
        <%= render partial: "invite_table", locals: { rows: rows } %>
      </div>
    <% end %>
  </div>
<% end %>

<%# ① 已吃完 — 金卡以上，最緊急 %>
<div class="card border-0 shadow-sm mb-3">
  <div class="card-header text-white d-flex justify-content-between align-items-center"
       style="background-color: #7a3030;">
    <div>
      <span class="fw-bold">① 已吃完，需補貨</span>
      <span class="ms-2 small opacity-75">金卡以上｜優先聯繫</span>
    </div>
    <span class="badge bg-white text-dark"><%= @overdue_customers.size %> 人</span>
  </div>
  <% render_invite_card.call(@overdue_customers, "od") %>
</div>

<%# ② 14天內即將吃完 — 全會員 %>
<% if @expiring_soon.any? %>
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header text-white d-flex justify-content-between align-items-center"
         style="background-color: #7a5c00;">
      <div>
        <span class="fw-bold">② 14 天內即將吃完</span>
        <span class="ms-2 small opacity-75">全會員｜趁還沒吃完主動通知</span>
      </div>
      <span class="badge bg-white text-dark"><%= @expiring_soon.size %> 人</span>
    </div>
    <div class="px-3 pt-2 border-bottom">
      <ul class="nav nav-tabs" id="tabs-expiring">
        <% [["黑卡","black"],["金卡","gold"],["銀卡","silver"],["白卡","white"],["一般會員","normal"]].each do |level, key| %>
          <% next if @expiring_soon.none? { |r| r[:customer].membership_level == level } %>
          <li class="nav-item">
            <button class="nav-link"
                    data-tab-prefix="expiring"
                    data-tab-target="expiring-<%= key %>"
                    type="button">
              <%= level %>
              <span class="badge bg-secondary">
                <%= @expiring_soon.count { |r| r[:customer].membership_level == level } %>
              </span>
            </button>
          </li>
        <% end %>
      </ul>
    </div>
    <div class="card-body p-0">
      <% [["黑卡","black"],["金卡","gold"],["銀卡","silver"],["白卡","white"],["一般會員","normal"]].each do |level, key| %>
        <% rows = @expiring_soon.select { |r| r[:customer].membership_level == level } %>
        <% next if rows.empty? %>
        <div class="invite-pane" id="pane-expiring-<%= key %>" style="display: none;">
          <div class="table-responsive" data-paginate="true" data-page-size="20">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
              <thead class="table-light">
                <tr>
                  <th>姓名</th><th>卡別</th><th>上次買</th>
                  <th>瓶數</th><th>預計吃完</th><th>剩餘天數</th>
                  <th>歷史次數</th><th>IG</th>
                </tr>
              </thead>
              <tbody>
                <% rows.each do |r| %>
                  <% c = r[:customer] %>
                  <tr>
                    <td><%= link_to c.full_name, customer_path(c.id), target: "_blank", class: "fw-semibold text-decoration-none" %></td>
                    <td><span class="text-muted small"><%= c.membership_level %></span></td>
                    <td><%= r[:last_date]&.strftime("%m/%d") || "-" %></td>
                    <td class="text-center"><%= r[:bottles] %> 瓶</td>
                    <td><%= r[:last_date] ? (r[:last_date] + r[:expected_days]).strftime("%m/%d") : "-" %></td>
                    <td>
                      <% remaining = r[:days_remaining] %>
                      <% if remaining && remaining >= 0 %>
                        <span class="badge <%= remaining <= 7 ? 'bg-danger' : 'bg-warning text-dark' %>">
                          剩 <%= remaining %> 天
                        </span>
                      <% end %>
                    </td>
                    <td class="text-center"><%= r[:history_count] %> 次</td>
                    <td>
                      <% if c.instagram_account.present? %>
                        <a href="https://instagram.com/<%= c.instagram_account.gsub('@','') %>" target="_blank" class="text-decoration-none">
                          📷 <%= c.instagram_account %>
                        </a>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%# ③ 純邀請 — 金卡以上 %>
<div class="card border-0 shadow-sm mb-5">
  <div class="card-header text-white d-flex justify-content-between align-items-center"
       style="background-color: #2d5a3d;">
    <div>
      <span class="fw-bold">③ 純邀請</span>
      <span class="ms-2 small opacity-75">金卡以上｜還夠吃，邀來看直播即可</span>
    </div>
    <span class="badge bg-white text-dark"><%= @not_due_customers.size %> 人</span>
  </div>
  <% render_invite_card.call(@not_due_customers, "nd") %>
</div>

<%# ══════════════════════════════════════════ %>
<%# 忠實客                                     %>
<%# ══════════════════════════════════════════ %>

<%# helper %>
<% loyal_card = lambda do |customers, card_id| %>
  <% black = customers.select { |r| r[:customer].membership_level == "黑卡" } %>
  <% gold  = customers.select { |r| r[:customer].membership_level == "金卡" } %>
  <div class="px-3 pt-2 border-bottom">
    <ul class="nav nav-tabs" id="tabs-<%= card_id %>">
      <% [["黑卡", "black", black], ["金卡", "gold", gold]].each do |level, key, group| %>
        <% next if group.empty? %>
        <li class="nav-item">
          <button class="nav-link"
                  data-tab-prefix="<%= card_id %>"
                  data-tab-target="<%= card_id %>-<%= key %>"
                  type="button">
            <%= level %> <span class="badge bg-secondary"><%= group.size %></span>
          </button>
        </li>
      <% end %>
    </ul>
  </div>
  <div class="card-body p-0">
    <% [["黑卡", "black", black], ["金卡", "gold", gold]].each do |level, key, group| %>
      <% next if group.empty? %>
      <div class="invite-pane" id="pane-<%= card_id %>-<%= key %>" style="display: none;">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
            <thead class="table-light">
              <tr>
                <th>姓名</th><th>卡別</th><th>最近購買</th>
                <th>上次購買日期</th><th>歷史買代謝次數</th><th>歷史代謝消費</th><th>IG</th>
              </tr>
            </thead>
            <tbody>
              <% group.each do |r| %>
                <% c = r[:customer] %>
                <tr>
                  <td><%= link_to c.full_name, customer_path(c.id), target: "_blank", class: "fw-semibold text-decoration-none" %></td>
                  <td><span class="text-muted small"><%= c.membership_level %></span></td>
