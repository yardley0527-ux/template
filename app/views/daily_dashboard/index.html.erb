<%# app/views/daily_dashboard/index.html.erb %>
<% content_for :page_title, "每日營收儀表板" %>

<%
  ns  = @summary
  fmt_avg = ->(amount, count) { count > 0 ? "均 NT$#{number_with_delimiter((amount / count).to_i)}" : "—" }
  fmt_amt = ->(amount, count) { count > 0 ? "NT$#{number_with_delimiter(amount.to_i)}" : "—" }
  grand_count  = ns[:new_count]  + ns[:old_count]
  grand_amount = ns[:new_amount] + ns[:old_amount]
%>

<%# ── 今日提醒（三區塊）── %>
<% has_alerts = @alerts[:critical].any? || @alerts[:highlights].any? || @alerts[:product_alerts].any? %>
<% if has_alerts %>

<%# 🚨 今日重點 %>
<% if @alerts[:critical].any? %>
<div class="card border-0 shadow-sm mb-2" style="border-left:4px solid #e74c6f;">
  <div class="card-header py-2 px-3 d-flex align-items-center" style="background:#fde8ec; border-bottom:1px solid #f5c0c8; gap:8px;">
    <span class="fw-bold" style="font-size:0.82rem; color:#c0392b;">🚨 昨日重點</span>
    <span class="badge" style="background:#e74c6f; font-size:0.7rem;"><%= @alerts[:critical].size %> 則</span>
  </div>
  <div class="card-body p-2" style="background:#fff9fa;">
    <div class="d-flex flex-wrap" style="gap:8px;">
      <% @alerts[:critical].each do |alert| %>
        <div class="flex-fill" style="min-width:170px; background:white; border-radius:6px; padding:10px 14px; border:1px solid #fdd0d8;">
          <div class="fw-bold mb-2" style="font-size:0.8rem; color:#c0392b;"><%= alert[:title] %></div>
          <% alert[:lines].each do |line| %>
            <div class="d-flex justify-content-between align-items-center" style="font-size:0.8rem; line-height:1.8;">
              <span style="font-size:0.75rem; color:#999;"><%= line[:label] %></span>
              <span class="fw-semibold" style="color:<%= line[:down] ? '#e74c6f' : '#222' %>;">
                <%= line[:value] %>
              </span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>

<%# 🔥 今日亮點 %>
<% if @alerts[:highlights].any? %>
<div class="card border-0 shadow-sm mb-2" style="border-left:4px solid #f0a500;">
  <div class="card-header py-2 px-3 d-flex align-items-center" style="background:#fff8e1; border-bottom:1px solid #ffe082; gap:8px;">
    <span class="fw-bold" style="font-size:0.82rem; color:#b7770d;">🔥 昨日亮點</span>
    <span class="badge" style="background:#f0a500; font-size:0.7rem;"><%= @alerts[:highlights].size %> 則</span>
  </div>
  <div class="card-body p-2" style="background:#fffdf5;">
    <div class="d-flex flex-wrap" style="gap:8px;">
      <% @alerts[:highlights].each do |alert| %>
        <div class="flex-fill" style="min-width:170px; background:white; border-radius:6px; padding:10px 14px; border:1px solid #ffe5a0;">
          <div class="fw-bold mb-1" style="font-size:0.78rem; color:#b7770d; text-transform:uppercase; letter-spacing:0.04em;">
            <%= alert[:kind] == :top_product ? "🏆 #{alert[:title]}" : alert[:title] %>
          </div>
          <% if alert[:kind] == :top_product %>
            <div class="fw-bold mb-2" style="font-size:0.95rem; color:#1a1a1a; line-height:1.3;"><%= alert[:product_name] %></div>
          <% end %>
          <% alert[:lines].each do |line| %>
            <div class="d-flex justify-content-between align-items-center" style="font-size:0.8rem; line-height:1.8;">
              <span style="font-size:0.75rem; color:#999;"><%= line[:label] %></span>
              <span class="fw-semibold" style="color:<%= line[:down] ? '#e74c6f' : line[:up] ? '#27ae60' : '#222' %>;">
                <%= line[:value] %>
              </span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>

<%# ⚠ 商品提醒 %>
<% if @alerts[:product_alerts].any? %>
<%
  visible_products = @alerts[:product_alerts].first(5)
  hidden_products  = @alerts[:product_alerts][5..] || []
%>
<div class="card border-0 shadow-sm mb-3" style="border-left:4px solid #adb5bd;">
  <div class="card-header py-2 px-3 d-flex align-items-center" style="background:#f8f9fa; border-bottom:1px solid #e9ecef; gap:8px;">
    <span class="fw-bold" style="font-size:0.82rem; color:#555;">⚠ 商品提醒</span>
    <span class="badge bg-secondary" style="font-size:0.7rem;"><%= @alerts[:product_alerts].size %> 個商品</span>
  </div>
  <div class="card-body p-0">
    <% visible_products.each_with_index do |p, idx| %>
      <div class="px-3 py-2 <%= (idx < visible_products.size - 1 || hidden_products.any?) ? 'border-bottom' : '' %>">
        <div class="fw-bold mb-1" style="font-size:0.84rem; color:#333;"><%= p[:name] %></div>
        <div class="d-flex flex-wrap" style="gap:20px;">
          <div>
            <div style="font-size:0.72rem; color:#999;">昨日</div>
            <div class="fw-bold text-danger" style="font-size:0.82rem;">0 單</div>
          </div>
          <div>
            <div style="font-size:0.72rem; color:#999;">前日</div>
            <div class="fw-semibold" style="font-size:0.82rem; color:#333;"><%= p[:yesterday] %> 單</div>
          </div>
          <div>
            <div style="font-size:0.72rem; color:#999;">近 7 日平均</div>
            <div class="fw-semibold" style="font-size:0.82rem; color:#333;"><%= p[:week_avg] %> 單</div>
          </div>
          <div>
            <div style="font-size:0.72rem; color:#999;">近 7 日合計</div>
            <div class="fw-semibold" style="font-size:0.82rem; color:#555;"><%= p[:week_total] %> 單</div>
          </div>
        </div>
      </div>
    <% end %>
    <% if hidden_products.any? %>
      <div id="hidden-product-alerts" style="display:none;">
        <% hidden_products.each do |p| %>
          <div class="px-3 py-2 border-bottom">
            <div class="fw-bold mb-1" style="font-size:0.84rem; color:#333;"><%= p[:name] %></div>
            <div class="d-flex flex-wrap" style="gap:20px;">
              <div><div style="font-size:0.72rem; color:#999;">昨日</div><div class="fw-bold text-danger" style="font-size:0.82rem;">0 單</div></div>
              <div><div style="font-size:0.72rem; color:#999;">前日</div><div class="fw-semibold" style="font-size:0.82rem; color:#333;"><%= p[:yesterday] %> 單</div></div>
              <div><div style="font-size:0.72rem; color:#999;">近 7 日平均</div><div class="fw-semibold" style="font-size:0.82rem; color:#333;"><%= p[:week_avg] %> 單</div></div>
              <div><div style="font-size:0.72rem; color:#999;">近 7 日合計</div><div class="fw-semibold" style="font-size:0.82rem; color:#555;"><%= p[:week_total] %> 單</div></div>
            </div>
          </div>
        <% end %>
      </div>
      <div id="expand-product-wrap" class="px-3 py-2 text-center border-top" style="background:#fafafa;">
        <span class="text-muted" style="font-size:0.8rem;">還有 <%= hidden_products.size %> 則提醒</span>
        <button id="expand-product-btn" class="btn btn-sm btn-link text-decoration-none ms-2" style="font-size:0.8rem;">【展開更多】</button>
      </div>
    <% end %>
  </div>
</div>
<% end %>

<% end %>

<%# ── Header ── %>
<div class="d-flex align-items-start justify-content-between flex-wrap mb-3" style="gap:12px;">
  <div>
    <h4 class="fw-bold mb-0">每日營收儀表板</h4>
    <p class="text-muted small mb-0">管理者快覽・適合截圖回報</p>
  </div>
  <%= form_tag daily_dashboard_path, method: :get, class: "d-flex align-items-center flex-wrap", style: "gap:8px;" do %>
    <input type="date" name="start_date" value="<%= @start_date.strftime('%Y-%m-%d') %>" class="form-control form-control-sm">
    <span class="text-muted small">至</span>
    <input type="date" name="end_date" value="<%= @end_date.strftime('%Y-%m-%d') %>" class="form-control form-control-sm">
    <button type="submit" class="btn btn-sm btn-primary">查詢</button>
  <% end %>
</div>

<p class="text-muted small mb-3">
  <% if @start_date == @end_date %>
    <%= @start_date.strftime('%Y/%m/%d') %>
  <% else %>
    <%= @start_date.strftime('%Y/%m/%d') %> ～ <%= @end_date.strftime('%Y/%m/%d') %>
  <% end %>
  共 <%= grand_count %> 筆訂單
</p>

<%# ── 第一區：總覽 ── %>
<div class="row g-2 mb-3">
  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #adb5bd;">
      <div class="card-body py-3 px-3">
        <div class="text-muted mb-1" style="font-size:0.78rem;">訂單數</div>
        <div class="d-flex align-items-baseline" style="gap:4px;">
          <span class="fw-bold" style="font-size:1.6rem; line-height:1.1;"><%= grand_count %></span>
          <span style="font-size:0.88rem; color:#666;">單</span>
        </div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #e74c6f;">
      <div class="card-body py-3 px-3">
        <div class="text-muted mb-1" style="font-size:0.78rem;">總營收</div>
        <div class="fw-bold text-danger" style="font-size:1.2rem; line-height:1.2;">NT$<%= number_with_delimiter(grand_amount.to_i) %></div>
        <div style="font-size:0.8rem; color:#555;"><%= fmt_avg.call(grand_amount, grand_count) %></div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #4a6fa5;">
      <div class="card-body py-3 px-3">
        <div class="text-muted mb-1" style="font-size:0.78rem;">新客</div>
        <div class="fw-bold" style="font-size:1.3rem;"><%= ns[:new_count] %> 單</div>
        <div class="fw-semibold small <%= ns[:new_count] > 0 ? 'text-danger' : 'text-muted' %>"><%= fmt_amt.call(ns[:new_amount], ns[:new_count]) %></div>
        <div style="font-size:0.8rem; color:#555;"><%= fmt_avg.call(ns[:new_amount], ns[:new_count]) %></div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #6c5f4e;">
      <div class="card-body py-3 px-3">
        <div class="text-muted mb-1" style="font-size:0.78rem;">舊客</div>
        <div class="fw-bold" style="font-size:1.3rem;"><%= ns[:old_count] %> 單</div>
        <div class="fw-semibold small <%= ns[:old_count] > 0 ? 'text-danger' : 'text-muted' %>"><%= fmt_amt.call(ns[:old_amount], ns[:old_count]) %></div>
        <div style="font-size:0.8rem; color:#555;"><%= fmt_avg.call(ns[:old_amount], ns[:old_count]) %></div>
      </div>
    </div>
  </div>
</div>

<%# ── 第二區：舊客會員分布 ── %>
<div class="card border-0 shadow-sm mb-3">
  <div class="card-header bg-white d-flex align-items-center py-2" style="border-bottom:2px solid #f0ede9;">
    <span class="fw-semibold" style="font-size:0.82rem; color:#6c757d; letter-spacing:0.03em;">舊客會員分布</span>
  </div>
  <div class="card-body p-0">
    <table class="table table-bordered mb-0" style="font-size:0.85rem;">
      <thead style="background-color:#6c5f4e; color:white;">
        <tr>
          <th class="py-2 ps-3" style="width:20%;">卡別</th>
          <th class="py-2 text-center" style="width:20%;">訂單數</th>
          <th class="py-2 text-center" style="width:30%;">營收</th>
          <th class="py-2 text-center" style="width:30%;">平均客單</th>
        </tr>
      </thead>
      <tbody>
        <% ns[:old_by_tier].each do |s| %>
          <% zero = s[:count] == 0 %>
          <tr style="<%= zero ? 'opacity:0.45; background:#fafafa;' : '' %>">
            <td class="py-2 ps-3 fw-semibold"><%= s[:label] %></td>
            <td class="py-2 text-center"><%= s[:count] %> 單</td>
            <td class="py-2 text-center fw-semibold <%= zero ? 'text-muted' : 'text-danger' %>">
              <%= fmt_amt.call(s[:amount], s[:count]) %>
            </td>
            <td class="py-2 text-center" style="font-size:0.82rem; color:#666;"><%= fmt_avg.call(s[:amount], s[:count]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%# ── 第三區：熱銷商品 TOP 5 ── %>
<% if @product_stats.any? %>
<%
  rank_colors = { 1 => "#c9a227", 2 => "#9e9e9e", 3 => "#a0673a" }
  rank_bg     = ->(r) { rank_colors[r] || "#6c757d" }
%>
<div class="card border-0 shadow-sm mb-3">
  <div class="card-header bg-white py-2" style="border-bottom:2px solid #f0ede9;">
    <span class="fw-semibold" style="font-size:0.82rem; color:#6c757d; letter-spacing:0.03em;">熱銷商品 TOP 5</span>
  </div>
  <div class="card-body p-0">
    <% @product_stats.each_with_index do |p, idx| %>
      <% pid = "prod_breakdown_#{p[:rank]}" %>
      <div class="<%= idx < @product_stats.size - 1 ? 'border-bottom' : '' %>">
        <div class="d-flex align-items-center px-3 py-2" style="gap:10px;">
          <div class="flex-shrink-0 fw-bold text-white text-center rounded-circle"
               style="width:26px;height:26px;line-height:26px;font-size:0.78rem;background:<%= rank_bg.call(p[:rank]) %>;">
            <%= p[:rank] %>
          </div>
          <div style="flex:1; min-width:0;">
            <div class="fw-semibold text-truncate" style="font-size:0.88rem;" title="<%= p[:name] %>"><%= p[:name] %></div>
            <div class="text-muted" style="font-size:0.74rem;">數量 <%= p[:quantity] %> | 訂單 <%= p[:order_count] %> 單</div>
            <div style="background:#f0f0f0; border-radius:2px; height:3px; margin-top:3px;">
              <div style="background:#e74c6f; border-radius:2px; height:3px; width:<%= [p[:share], 100].min %>%;"></div>
            </div>
          </div>
          <div class="text-end flex-shrink-0" style="min-width:90px;">
            <div class="fw-bold text-danger" style="font-size:0.88rem;">NT$<%= number_with_delimiter(p[:amount].to_i) %></div>
            <div class="text-muted" style="font-size:0.74rem;"><%= p[:share] %>%</div>
          </div>
          <button class="prod-toggle btn btn-sm border flex-shrink-0"
                  data-target="<%= pid %>"
                  style="font-size:0.72rem; padding:2px 8px; color:#6c757d; white-space:nowrap;">
            展開 ▼
          </button>
        </div>
        <div id="<%= pid %>" style="display:none; background:#f9f8f7;">
          <table class="table table-sm mb-0" style="font-size:0.8rem;">
            <thead>
              <tr style="background:#ede9e4;">
                <th class="ps-4 py-1 fw-normal text-muted" style="width:35%;">客戶類型</th>
                <th class="py-1 text-center fw-normal text-muted" style="width:25%;">訂單數</th>
                <th class="py-1 text-end pe-3 fw-normal text-muted" style="width:40%;">營業額</th>
              </tr>
            </thead>
            <tbody>
              <% p[:by_type].each do |bt| %>
                <% zero = bt[:order_count] == 0 %>
                <tr style="<%= zero ? 'opacity:0.4;' : '' %>">
                  <td class="ps-4 py-1 fw-semibold"><%= bt[:type] %></td>
                  <td class="py-1 text-center"><%= bt[:order_count] %> 單</td>
                  <td class="py-1 text-end pe-3 fw-semibold <%= zero ? 'text-muted' : 'text-danger' %>">
                    <%= zero ? "—" : "NT$#{number_with_delimiter(bt[:amount].to_i)}" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </div>
</div>
<% end %>

<%# ── 第四區：每日業績概況 ── %>
<% if @daily_stats.size > 0 %>
<div class="card border-0 shadow-sm mb-3">
  <div class="card-header bg-white py-2" style="border-bottom:2px solid #f0ede9;">
    <span class="fw-semibold" style="font-size:0.82rem; color:#6c757d; letter-spacing:0.03em;">每日業績概況</span>
    <span class="text-muted ms-2" style="font-size:0.75rem;">目標 NT$150,000／日</span>
  </div>
  <div class="card-body p-0">
    <table class="table mb-0" style="font-size:0.85rem;">
      <thead style="background-color:#f8f9fa;">
        <tr>
          <th class="py-2 ps-3" style="width:22%;">日期</th>
          <th class="py-2 text-center" style="width:15%;">訂單數</th>
          <th class="py-2 text-center" style="width:25%;">平均客單</th>
          <th class="py-2 text-center" style="width:25%;">總營業額</th>
          <th class="py-2 text-center" style="width:13%;">狀態</th>
        </tr>
      </thead>
      <tbody>
        <% @daily_stats.each do |d| %>
          <% miss = !d[:met_target] %>
          <tr style="<%= miss ? 'background:#fff5f5; border-left:3px solid #e74c6f;' : '' %>">
            <td class="py-2 ps-3 fw-semibold"><%= d[:date].strftime('%m/%d（%a）') %></td>
            <td class="py-2 text-center"><%= d[:order_count] %> 單</td>
            <td class="py-2 text-center" style="color:#666;">
              <%= d[:order_count] > 0 ? "NT$#{number_with_delimiter(d[:avg_amount].to_i)}" : "—" %>
            </td>
            <td class="py-2 text-center fw-bold <%= miss ? 'text-danger' : 'text-dark' %>">
              <%= d[:order_count] > 0 ? "NT$#{number_with_delimiter(d[:total_amount].to_i)}" : "—" %>
            </td>
            <td class="py-2 text-center">
              <% if d[:order_count] == 0 %>
                <span class="text-muted small">無訂單</span>
              <% elsif miss %>
                <span class="badge" style="background:#ffe0e0; color:#c0392b; font-size:0.72rem;">未達標</span>
              <% else %>
                <span class="badge" style="background:#e6f4ea; color:#2e7d32; font-size:0.72rem;">達標</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<% end %>

<%# ── 第五區：每日新舊客營收比較 ── %>
<% if @daily_customer_stats.any? { |d| d[:new_orders] > 0 || d[:old_orders] > 0 } %>
<div class="card border-0 shadow-sm mb-3">
  <div class="card-header bg-white py-2" style="border-bottom:2px solid #f0ede9;">
    <span class="fw-semibold" style="font-size:0.82rem; color:#6c757d; letter-spacing:0.03em;">每日新舊客營收比較</span>
  </div>
  <div class="card-body p-0">
    <table class="table mb-0" style="font-size:0.82rem;">
      <thead>
        <tr>
          <th class="py-2 ps-3" rowspan="2" style="vertical-align:middle; width:14%; border-right:1px solid #dee2e6;">日期</th>
          <th colspan="3" class="py-1 text-center fw-semibold" style="background:#e8f5e9; color:#2e7d32; border-right:1px solid #dee2e6;">舊客</th>
          <th colspan="3" class="py-1 text-center fw-semibold" style="background:#fffde7; color:#f57f17;">新客</th>
        </tr>
        <tr>
          <th class="py-1 text-center fw-normal" style="background:#f1faf2; font-size:0.76rem; width:14%;">人數／單數</th>
          <th class="py-1 text-end pe-2 fw-normal" style="background:#f1faf2; font-size:0.76rem; width:18%;">營業額</th>
          <th class="py-1 text-end pe-2 fw-normal" style="background:#f1faf2; font-size:0.76rem; width:16%; border-right:1px solid #dee2e6;">均單</th>
          <th class="py-1 text-center fw-normal" style="background:#fffef0; font-size:0.76rem; width:14%;">人數／單數</th>
          <th class="py-1 text-end pe-2 fw-normal" style="background:#fffef0; font-size:0.76rem; width:18%;">營業額</th>
          <th class="py-1 text-end pe-3 fw-normal" style="background:#fffef0; font-size:0.76rem; width:6%;">均單</th>
        </tr>
      </thead>
      <tbody>
        <% @daily_customer_stats.each do |d| %>
          <% old_warn = d[:old_orders] > 0 && d[:old_amount] < DailyDashboardController::OLD_DAILY_THRESHOLD %>
          <% new_warn = d[:new_orders] > 0 && d[:new_amount] < DailyDashboardController::NEW_DAILY_THRESHOLD %>
          <tr>
            <td class="py-2 ps-3 fw-semibold" style="border-right:1px solid #dee2e6; white-space:nowrap;"><%= d[:date].strftime('%m/%d（%a）') %></td>
            <%# 舊客 %>
            <td class="py-2 text-center" style="background:<%= old_warn ? '#fff5f5' : 'transparent' %>;">
              <%= d[:old_orders] > 0 ? "#{d[:old_customers]}人 / #{d[:old_orders]}單" : "—" %>
            </td>
            <td class="py-2 text-end pe-2 fw-semibold" style="background:<%= old_warn ? '#fff5f5' : 'transparent' %>; color:<%= d[:old_orders] > 0 ? (old_warn ? '#c0392b' : '#222') : '#aaa' %>;">
              <%= d[:old_orders] > 0 ? "NT$#{number_with_delimiter(d[:old_amount].to_i)}" : "—" %>
            </td>
            <td class="py-2 text-end pe-2" style="background:<%= old_warn ? '#fff5f5' : 'transparent' %>; color:#555; border-right:1px solid #dee2e6;">
              <%= d[:old_avg] ? "NT$#{number_with_delimiter(d[:old_avg].to_i)}" : "—" %>
            </td>
            <%# 新客 %>
            <td class="py-2 text-center" style="background:<%= new_warn ? '#fffde7' : 'transparent' %>;">
              <%= d[:new_orders] > 0 ? "#{d[:new_customers]}人 / #{d[:new_orders]}單" : "—" %>
            </td>
            <td class="py-2 text-end pe-2 fw-semibold" style="background:<%= new_warn ? '#fffde7' : 'transparent' %>; color:<%= d[:new_orders] > 0 ? (new_warn ? '#e65100' : '#222') : '#aaa' %>;">
              <%= d[:new_orders] > 0 ? "NT$#{number_with_delimiter(d[:new_amount].to_i)}" : "—" %>
            </td>
            <td class="py-2 text-end pe-3" style="background:<%= new_warn ? '#fffde7' : 'transparent' %>; color:#555;">
              <%= d[:new_avg] ? "NT$#{number_with_delimiter(d[:new_avg].to_i)}" : "—" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<% end %>

<% content_for :scripts_block do %>
<script>
(function() {
  var expandBtn = document.getElementById('expand-product-btn');
  if (expandBtn) {
    expandBtn.addEventListener('click', function() {
      document.getElementById('hidden-product-alerts').style.display = 'block';
      document.getElementById('expand-product-wrap').style.display = 'none';
    });
  }

  document.querySelectorAll('.prod-toggle').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var panel = document.getElementById(this.dataset.target);
      var open = panel.style.display !== 'none' && panel.style.display !== '';
      panel.style.display = open ? 'none' : 'block';
      this.innerHTML = open ? '展開 ▼' : '收合 ▲';
    });
  });
})();
</script>
<% end %>
