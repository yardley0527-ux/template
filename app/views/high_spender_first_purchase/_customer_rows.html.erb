<% series_list = customers.map(&:first_series).compact.uniq %>

<% if series_list.size > 1 %>
  <div class="hs-tabs" data-tier-tabs="<%= tier_id %>">
    <button class="hs-tab active" data-filter="all">
      全部 <span class="hs-tab-count"><%= customers.size %></span>
    </button>
    <% series_list.each do |s| %>
      <% count = customers.count { |c| c.first_series == s } %>
      <button class="hs-tab" data-filter="<%= s %>">
        <span class="hs-series-dot" style="background:<%= hs_series_color(s) %>"></span>
        <%= s %> <span class="hs-tab-count"><%= count %></span>
      </button>
    <% end %>
  </div>
<% end %>

<div class="fp-table-wrap">
  <table class="fp-table" data-tier-table="<%= tier_id %>">
    <thead>
      <tr>
        <th>姓名</th>
        <th>首購系列</th>
        <th>首購日期</th>
        <th>首購金額</th>
        <th>距首購</th>
        <th>第二次購買</th>
        <th>跟進記錄</th>
      </tr>
    </thead>
    <tbody>
      <% customers.each do |c| %>
        <% status = hs_follow_up_status(c) %>
        <% logs = follow_up_map[c.identity_key] || [] %>
        <tr data-series="<%= c.first_series %>">
          <td>
            <div class="hs-customer-cell">
              <% if c.shopline_customer_id.present? %>
                <%= link_to(c.customer_name.presence || c.email, customer_path(c.shopline_customer_id), class: "fp-customer-link") %>
              <% else %>
                <span class="fp-customer-link"><%= c.customer_name.presence || c.email %></span>
              <% end %>
              <% if c.instagram_account.present? %>
                <a href="https://instagram.com/<%= c.instagram_account %>" target="_blank" rel="noopener noreferrer" class="hs-ig-link">IG</a>
              <% end %>
            </div>
          </td>
          <td>
            <span class="hs-series-dot" style="background:<%= hs_series_color(c.first_series.to_s) %>"></span>
            <%= c.first_series.presence || "—" %>
          </td>
          <td class="fp-muted"><%= c.first_date&.strftime("%Y-%m-%d") || "—" %></td>
          <td class="fp-amount">$<%= number_with_delimiter(c.first_amount.to_i) %></td>
          <td>
            <% if c.first_date %>
              <% days = (Date.today - c.first_date.to_date).to_i %>
              <span class="hs-days-num"><%= days %></span><span class="hs-days-unit"> 天</span>
              <% if status[:cycle] %>
                <div class="hs-cycle-hint">週期 <%= status[:cycle] %> 天</div>
              <% end %>
            <% else %>
              <span class="fp-muted">—</span>
            <% end %>
          </td>
          <td>
            <% if c.purchase_count >= 2 %>
              <div class="hs-second-buy">
                <span><%= c.second_series.presence || c.second_product.presence || "—" %></span>
                <span class="hs-second-date"><%= c.second_date&.strftime("%m/%d") %></span>
              </div>
            <% else %>
              <span class="fp-muted">—</span>
            <% end %>
          </td>
          <td class="hs-followup-cell">
            <% if logs.any? %>
              <div class="hs-followup-logs">
                <% logs.first(2).each do |log| %>
                  <div class="hs-followup-entry">
                    <span class="hs-followup-date"><%= log.followed_up_at.strftime("%m/%d") %></span>
                    <span class="hs-followup-note"><%= log.note %></span>
                  </div>
                <% end %>
                <% if logs.size > 2 %>
                  <span class="fp-muted" style="font-size:10px;">還有 <%= logs.size - 2 %> 筆</span>
                <% end %>
              </div>
            <% end %>
            <details class="hs-followup-form-wrap">
              <summary class="hs-followup-toggle"><%= logs.any? ? "+ 再記一筆" : "記錄跟進" %></summary>
              <%= form_with url: high_spender_follow_ups_path, method: :post, local: true, class: "hs-followup-form" do |f| %>
                <%= f.hidden_field :identity_key, value: c.identity_key %>
                <%= f.text_area :note, placeholder: "做了什麼事...", class: "hs-followup-input", rows: 2 %>
                <%= f.submit "儲存", class: "hs-followup-submit" %>
              <% end %>
            </details>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
