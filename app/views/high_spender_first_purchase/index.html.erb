<%# app/views/high_spender_first_purchase/index.html.erb %>
<% content_for :page_title, "破萬新客分析" %>

<div class="subheader">
  <h1 class="subheader-title">
    <i class="subheader-icon fal fa-crown"></i>
    破萬新客分析
    <small>首筆消費 ≥ $10,000 的新顧客，追蹤首購行為與回購狀況</small>
  </h1>
</div>

<div class="row">
  <div class="col-12">
    <div class="panel">
      <div class="panel-container show">
        <div class="panel-content">

          <%# ── KPI 卡片 ── %>
          <div class="fp-stats-grid mb-4">
            <% @summary_cards.each do |card| %>
              <div class="fp-stat-card">
                <div class="fp-stat-series"><%= card[:label] %></div>
                <div class="fp-stat-row">
                  <div class="fp-stat-item">
                    <span class="fp-stat-num"><%= number_with_delimiter(card[:value]) %></span>
                    <span class="fp-stat-label"><%= card[:note] %></span>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <%# ── 篩選列 ── %>
          <div class="fp-filter-bar mb-3">
            <%= form_with url: high_spender_first_purchase_path, method: :get, local: true do %>
              <div class="fp-filter-row">
                <div class="fp-filter-group">
                  <label class="fp-filter-label">年份</label>
                  <%= select_tag :year,
                        options_for_select([["全部", ""]] + @year_stats.map { |y| [y[:year], y[:year]] }, @selected_year),
                        class: "fp-select" %>
                </div>
                <div class="fp-filter-group">
                  <label class="fp-filter-label">首購系列</label>
                  <%= select_tag :series,
                        options_for_select([["全部", ""]] + @series_options.map { |s| [s, s] }, @selected_series),
                        class: "fp-select" %>
                </div>
                <div class="fp-filter-group">
                  <label class="fp-filter-label">排序</label>
                  <%= select_tag :sort,
                        options_for_select([
                          ["首購日期新到舊", "first_date_desc"],
                          ["首購日期舊到新", "first_date_asc"],
                          ["首購金額高到低", "first_amount_desc"],
                          ["首購金額低到高", "first_amount_asc"],
                          ["購買次數高到低", "repurchase"]
                        ], @sort),
                        class: "fp-select" %>
                </div>
                <div class="fp-filter-group fp-filter-check-group">
                  <label class="fp-filter-label">&nbsp;</label>
                  <label class="fp-checkbox-label">
                    <%= check_box_tag :repurchase_only, "1", @repurchase_only, class: "fp-checkbox" %>
                    只看有回購
                  </label>
                </div>
                <div class="fp-filter-actions">
                  <%= button_tag "查詢", type: "submit", class: "fp-btn-primary" %>
                  <%= link_to "清除", high_spender_first_purchase_path, class: "fp-btn-secondary" %>
                </div>
              </div>
            <% end %>
          </div>

          <%# ── 年度 + 系列並排 ── %>
          <div class="hs-section-grid mb-4">

            <div class="hs-stat-block">
              <div class="hs-block-title">年度統計</div>
              <div class="fp-table-wrap">
                <table class="fp-table">
                  <thead>
                    <tr>
                      <th>年份</th>
                      <th>破萬新客</th>
                      <th>有回購</th>
                      <th>回購率</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @year_stats.each do |row| %>
                      <tr>
                        <td><%= row[:year] %></td>
                        <td><%= number_with_delimiter(row[:total]) %></td>
                        <td><%= number_with_delimiter(row[:repurchased]) %></td>
                        <td>
                          <span class="<%= row[:repurchase_rate] >= 70 ? 'fp-badge-ok' : row[:repurchase_rate] >= 55 ? 'fp-badge-mid' : 'fp-badge-warn' %>">
                            <%= row[:repurchase_rate] %>%
                          </span>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>

            <div class="hs-stat-block">
              <div class="hs-block-title">首購系列表現</div>
              <div class="fp-table-wrap">
                <table class="fp-table">
                  <thead>
                    <tr>
                      <th>系列</th>
                      <th>人數</th>
                      <th>有回購</th>
                      <th>回購率</th>
                      <th>平均首筆</th>
                      <th>第二次最常買</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @series_stats.each do |row| %>
                      <% second_rows = @second_purchase_map[row[:series]] || [] %>
                      <tr>
                        <td><strong><%= row[:series] %></strong></td>
                        <td><%= number_with_delimiter(row[:total]) %></td>
                        <td><%= number_with_delimiter(row[:repurchased]) %></td>
                        <td>
                          <span class="<%= row[:repurchase_rate] >= 70 ? 'fp-badge-ok' : row[:repurchase_rate] >= 55 ? 'fp-badge-mid' : 'fp-badge-warn' %>">
                            <%= row[:repurchase_rate] %>%
                          </span>
                        </td>
                        <td class="fp-amount">$<%= number_with_delimiter(row[:avg_first_amount]) %></td>
                        <td>
                          <% if second_rows.any? %>
                            <% second_rows.first(3).each do |second| %>
                              <div class="hs-next-buy">
                                <span class="hs-next-series"><%= second[:second_series] %></span>
                                <span class="hs-next-count"><%= second[:count] %>人・<%= second[:rate] %>%</span>
                              </div>
                            <% end %>
                          <% else %>
                            <span class="fp-muted">—</span>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>

          </div>

          <%# ── 每月趨勢（含首購商品分布）── %>
          <div class="hs-stat-block mb-4">
            <div class="hs-block-title">每月趨勢</div>
            <div class="fp-table-wrap">
              <table class="fp-table">
                <thead>
                  <tr>
                    <th>月份</th>
                    <th>破萬新客數</th>
                    <th>平均首筆金額</th>
                    <th>回購率</th>
                    <th>首購商品分布（Top 4）</th>
                  </tr>
                </thead>
                <tbody>
                  <% @monthly_stats.each do |row| %>
                    <% series_breakdown = @monthly_series_map[row[:month]] || [] %>
                    <% row_total = series_breakdown.sum { |s| s[:count] }.to_f %>
                    <tr>
                      <td><%= row[:month] %></td>
                      <td><%= number_with_delimiter(row[:total]) %></td>
                      <td class="fp-amount">$<%= number_with_delimiter(row[:avg_first_amount]) %></td>
                      <td>
                        <span class="<%= row[:repurchase_rate] >= 70 ? 'fp-badge-ok' : row[:repurchase_rate] >= 55 ? 'fp-badge-mid' : 'fp-badge-warn' %>">
                          <%= row[:repurchase_rate] %>%
                        </span>
                      </td>
                      <td>
                        <% if series_breakdown.any? %>
                          <div class="hs-series-bar-group">
                            <% series_breakdown.each do |s| %>
                              <% pct = row_total > 0 ? (s[:count] / row_total * 100).round(0).to_i : 0 %>
                              <div class="hs-series-bar-row">
                                <span class="hs-series-name"><%= s[:series] %></span>
                                <div class="hs-bar-wrap">
                                  <div class="hs-bar" style="width:<%= pct %>%;background:<%= hs_series_color(s[:series]) %>;"></div>
                                </div>
                                <span class="hs-series-pct"><%= s[:count] %>人</span>
                              </div>
                            <% end %>
                          </div>
                        <% else %>
                          <span class="fp-muted">—</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<style>
*, *::before, *::after { box-sizing: border-box; }

.fp-stats-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }
.fp-stat-card { background: #fff; border: 1.5px solid #e5e7eb; border-radius: 10px; padding: 14px 16px; text-decoration: none; color: inherit; transition: border-color .15s, box-shadow .15s; display: block; }
.fp-stat-card:hover { border-color: #886ab5; box-shadow: 0 0 0 3px rgba(136,106,181,.1); }
.fp-stat-series { font-weight: 700; font-size: 15px; color: #374151; margin-bottom: 10px; }
.fp-stat-row { display: flex; gap: 12px; flex-wrap: wrap; }
.fp-stat-item { display: flex; flex-direction: column; gap: 2px; }
.fp-stat-num { font-size: 22px; font-weight: 700; color: #111827; }
.fp-stat-label { font-size: 10px; color: #9ca3af; }

.fp-filter-bar { background: #f8f9fa; border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px; }
.fp-filter-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; }
.fp-filter-group { display: flex; flex-direction: column; gap: 4px; }
.fp-filter-label { font-size: 11px; font-weight: 600; color: #9ca3af; text-transform: uppercase; letter-spacing: .5px; }
.fp-select { border: 1px solid #e5e7eb; border-radius: 6px; padding: 6px 10px; font-size: 13px; color: #374151; background: #fff; }
.fp-filter-actions { display: flex; gap: 8px; align-items: flex-end; }
.fp-btn-primary { padding: 7px 18px; background: #886ab5; color: #fff; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; }
.fp-btn-primary:hover { background: #6d52a0; }
.fp-btn-secondary { padding: 7px 14px; background: transparent; color: #6b7280; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 13px; text-decoration: none; display: inline-flex; align-items: center; }

.fp-table-wrap { overflow-x: auto; background: #fff; }
.fp-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.fp-table thead th { background: #886ab5; color: #fff; padding: 10px 14px; text-align: left; font-weight: 600; font-size: 12px; white-space: nowrap; }
.fp-table tbody td { padding: 8px 14px; border-bottom: 1px solid #f3f4f6; vertical-align: middle; }
.fp-table tbody tr:last-child td { border-bottom: none; }
.fp-table tbody tr:hover td { background: #faf9ff; }

.fp-muted { color: #9ca3af; }
.fp-amount { white-space: nowrap; color: #374151; }
.fp-customer-link { font-weight: 600; color: #374151; text-decoration: none; }
.fp-customer-link:hover { color: #886ab5; }

.fp-badge-ok     { background: #f0fdf4; color: #16a34a; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 99px; white-space: nowrap; display: inline-block; }
.fp-badge-mid    { background: #fef9c3; color: #92400e; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 99px; white-space: nowrap; display: inline-block; }
.fp-badge-warn   { background: #fef3c7; color: #b45309; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 99px; white-space: nowrap; display: inline-block; }
.fp-badge-neutral{ background: #f3f4f6; color: #6b7280; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 99px; white-space: nowrap; display: inline-block; }

.hs-section-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 16px; align-items: start; }
.hs-stat-block { background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden; }
.hs-block-title { font-size: 14px; font-weight: 700; color: #374151; padding: 12px 16px; background: #f9fafb; border-bottom: 1px solid #e5e7eb; }

.hs-next-buy { display: flex; align-items: center; gap: 6px; font-size: 12px; margin-bottom: 2px; }
.hs-next-series { font-weight: 600; color: #374151; }
.hs-next-count { color: #9ca3af; }

.fp-filter-check-group { justify-content: flex-end; }
.fp-checkbox-label { display: flex; align-items: center; gap: 6px; font-size: 13px; color: #374151; cursor: pointer; padding: 7px 0; white-space: nowrap; }
.fp-checkbox { width: 15px; height: 15px; cursor: pointer; accent-color: #886ab5; }

/* 每月商品分布 bar */
.hs-series-bar-group { display: flex; flex-direction: column; gap: 4px; min-width: 200px; }
.hs-series-bar-row { display: flex; align-items: center; gap: 6px; }
.hs-series-name { font-size: 11px; color: #374151; font-weight: 600; width: 44px; flex-shrink: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.hs-bar-wrap { flex: 1; height: 8px; background: #f3f4f6; border-radius: 99px; overflow: hidden; }
.hs-bar { height: 100%; border-radius: 99px; transition: width .3s; }
.hs-series-pct { font-size: 11px; color: #9ca3af; width: 30px; text-align: right; flex-shrink: 0; }

@media (max-width: 900px) {
  .hs-section-grid { grid-template-columns: 1fr; }
  .fp-stats-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
  .fp-stats-grid { gap: 8px; }
  .fp-stat-card { padding: 12px; }
  .fp-stat-num { font-size: 17px; }
  .fp-filter-bar { padding: 14px; }
  .fp-filter-row { flex-direction: column; gap: 10px; }
  .fp-filter-group, .fp-select { width: 100%; }
  .fp-filter-check-group { justify-content: flex-start; }
  .fp-filter-actions { width: 100%; }
  .fp-btn-primary, .fp-btn-secondary { flex: 1; text-align: center; justify-content: center; }
}
</style>
