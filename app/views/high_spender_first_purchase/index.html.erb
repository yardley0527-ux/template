<%# app/views/high_spender_first_purchase/index.html.erb %>
<% content_for :page_title, "破萬新客分析" %>

<div class="subheader">
  <h1 class="subheader-title">
    <i class="subheader-icon fal fa-crown"></i>
    破萬新客分析
    <small><%= @selected_year %> 年 · 首筆消費 ≥ $10,000 的新顧客，追蹤首購行為與回購狀況</small>
  </h1>
</div>

<div class="row">
  <div class="col-12">
    <div class="panel">
      <div class="panel-container show">
        <div class="panel-content">

          <%# ── 快照控制列 ── %>
          <div class="hs-snapshot-bar mb-3">
            <span class="hs-snapshot-hint">
              <% if @last_snapshot_week %>
                本週跟進快照：<strong><%= @last_snapshot_week.strftime("%Y-%m-%d") %></strong> 起
              <% else %>
                尚未建立快照，請點右側按鈕
              <% end %>
            </span>
            <%= button_to "重新計算本週名單", high_spender_first_purchase_snapshot_path,
                  method: :post,
                  class: "hs-snapshot-btn",
                  data: { confirm: "將重新計算本週跟進名單（建議每週一執行），確定繼續？" } %>
          </div>

          <%# ── 篩選列 ── %>
          <div class="fp-filter-bar mb-4">
            <%= form_with url: high_spender_first_purchase_path, method: :get, local: true do %>
              <div class="fp-filter-row">
                <div class="fp-filter-group">
                  <label class="fp-filter-label">首購系列</label>
                  <%= select_tag :series,
                        options_for_select([["全部系列", ""]] + @series_options.map { |s| [s, s] }, @selected_series),
                        class: "fp-select" %>
                </div>
                <div class="fp-filter-group">
                  <label class="fp-filter-label">排序</label>
                  <%= select_tag :sort,
                        options_for_select([
                          ["首購日期新到舊", "first_date_desc"],
                          ["首購日期舊到新", "first_date_asc"],
                          ["首購金額高到低", "first_amount_desc"],
                          ["首購金額低到高", "first_amount_asc"],
                          ["購買次數高到低", "repurchase"]
                        ], @sort),
                        class: "fp-select" %>
                </div>
                <div class="fp-filter-group fp-filter-check-group">
                  <label class="fp-filter-label">&nbsp;</label>
                  <label class="fp-checkbox-label">
                    <%= check_box_tag :repurchase_only, "1", @repurchase_only, class: "fp-checkbox" %>
                    只看有回購
                  </label>
                </div>
                <div class="fp-filter-actions">
                  <%= button_tag "查詢", type: "submit", class: "fp-btn-primary" %>
                  <%= link_to "清除", high_spender_first_purchase_path, class: "fp-btn-secondary" %>
                </div>
              </div>
            <% end %>
          </div>

          <%# ── KPI 卡片 ── %>
          <div class="fp-stats-grid mb-4">
            <% @summary_cards.each do |card| %>
              <div class="fp-stat-card">
                <div class="fp-stat-series"><%= card[:label] %></div>
                <div class="fp-stat-row">
                  <div class="fp-stat-item">
                    <span class="fp-stat-num"><%= number_with_delimiter(card[:value]) %></span>
                    <span class="fp-stat-label"><%= card[:note] %></span>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <%# ── 顧客跟進名單（分層）── %>
          <%
            tier_order = [:this_week, :lost, :repurchased]
            tier_meta  = {
              this_week:  { label: "本週跟進",   hint: "距回購週期 70–100%，現在聯繫最有效", css: "hs-tier-thisweek",   collapsible: false },
              lost:       { label: "可能已流失", hint: "已超過回購週期",                      css: "hs-tier-lost",       collapsible: true  },
              repurchased:{ label: "已回購",     hint: "已完成第二次購買",                    css: "hs-tier-repurchased", collapsible: true  },
            }
            grouped = @customers.group_by { |c| hs_follow_up_status(c)[:tier] }
          %>
          <% tier_order.each do |tier| %>
            <% customers_in_tier = grouped[tier] || [] %>
            <% next if customers_in_tier.empty? %>
            <% meta = tier_meta[tier] %>
            <% if meta[:collapsible] %>
              <details class="hs-tier-block hs-stat-block mb-3 <%= meta[:css] %>">
                <summary class="hs-tier-header">
                  <span class="hs-tier-label"><%= meta[:label] %></span>
                  <span class="hs-tier-count"><%= customers_in_tier.size %> 人</span>
                  <span class="hs-tier-hint"><%= meta[:hint] %></span>
                </summary>
                <%= render partial: "high_spender_first_purchase/customer_rows", locals: { customers: customers_in_tier, tier_id: tier.to_s } %>
              </details>
            <% else %>
              <div class="hs-tier-block hs-stat-block mb-3 <%= meta[:css] %>">
                <div class="hs-tier-header">
                  <span class="hs-tier-label"><%= meta[:label] %></span>
                  <span class="hs-tier-count"><%= customers_in_tier.size %> 人</span>
                  <span class="hs-tier-hint"><%= meta[:hint] %></span>
                  <% if tier == :this_week %>
                    <a href="https://app.omnichat.ai/conversation.html" target="_blank" rel="noopener noreferrer" class="hs-omnichat-btn">omnichat 後台</a>
                  <% end %>
                </div>
                <%= render partial: "high_spender_first_purchase/customer_rows", locals: { customers: customers_in_tier, tier_id: tier.to_s } %>
              </div>
            <% end %>
          <% end %>
          <% if @customers.empty? %>
            <div class="hs-stat-block mb-5" style="padding:24px;text-align:center;color:#9ca3af;">查無資料</div>
          <% end %>

          <%# ── 年度 + 系列統計（輔助參考）── %>
          <div class="hs-section-grid mb-4">

            <div class="hs-stat-block">
              <div class="hs-block-title">年度統計</div>
              <div class="fp-table-wrap">
                <table class="fp-table">
                  <thead>
                    <tr>
                      <th>年份</th>
                      <th>破萬新客</th>
                      <th>曾回購率</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @year_stats.each do |row| %>
                      <tr>
                        <td><%= row[:year] %></td>
                        <td><%= number_with_delimiter(row[:total]) %></td>
                        <td>
                          <span class="fp-badge-neutral">
                            <%= row[:repurchase_rate] %>%
                          </span>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>

            <div class="hs-stat-block">
              <div class="hs-block-title">首購系列表現</div>
              <div class="fp-table-wrap">
                <table class="fp-table">
                  <thead>
                    <tr>
                      <th>系列</th>
                      <th>人數</th>
                      <th>曾回購率</th>
                      <th>平均首筆</th>
                      <th>第二次最常買</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @series_stats.each do |row| %>
                      <% second_rows = @second_purchase_map[row[:series]] || [] %>
                      <tr>
                        <td>
                          <strong>
                            <span class="hs-series-dot" style="background:<%= hs_series_color(row[:series]) %>"></span>
                            <%= link_to row[:series],
                                high_spender_first_purchase_path(
                                  series: row[:series],
                                  year:   @selected_year
                                ),
                                class: "fp-customer-link" %>
                          </strong>
                        </td>
                        <td><%= number_with_delimiter(row[:total]) %></td>
                        <td>
                          <span class="fp-badge-neutral">
                            <%= row[:repurchase_rate] %>%
                          </span>
                        </td>
                        <td class="fp-amount">$<%= number_with_delimiter(row[:avg_first_amount]) %></td>
                        <td>
                          <% if second_rows.any? %>
                            <% second_rows.first(3).each do |second| %>
                              <div class="hs-next-buy">
                                <span class="hs-next-series"><%= second[:second_series] %></span>
                                <span class="hs-next-count"><%= second[:count] %>人・<%= second[:rate] %>%</span>
                              </div>
                            <% end %>
                          <% else %>
                            <span class="fp-muted">—</span>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>

          </div>

          <%# ── 異常警示 ── %>
          <% if @anomaly_alerts.any? %>
            <div class="hs-anomaly-banner mb-4">
              <div class="hs-anomaly-header">
                <span class="hs-anomaly-icon">⚠️</span>
                <span class="hs-anomaly-title">本月數據異常偵測</span>
                <span class="hs-anomaly-subtitle"><%= @anomaly_alerts.first[:month] %> 相較過去 3 個月平均出現顯著下滑</span>
              </div>
              <div class="hs-anomaly-list">
                <% @anomaly_alerts.each do |alert| %>
                  <div class="hs-anomaly-item">
                    <div class="hs-anomaly-series-name"><%= alert[:series] %></div>
                    <div class="hs-anomaly-stats">
                      <span class="hs-anomaly-current">本月 <strong><%= alert[:current_count] %> 人</strong></span>
                      <span class="hs-anomaly-arrow">→</span>
                      <span class="hs-anomaly-hist">歷史均值 <strong><%= alert[:hist_avg] %> 人</strong></span>
                      <span class="hs-anomaly-badge">↓ <%= alert[:drop_pct] %>%</span>
                    </div>
                    <div class="hs-anomaly-hint">
                      <% if alert[:current_count] == 0 %>
                        本月尚無該系列首購新客，請確認廣告素材與導購流量是否正常。
                      <% elsif alert[:drop_pct] >= 70 %>
                        跌幅超過 70%，建議立即檢查廣告投放與商品曝光狀況。
                      <% else %>
                        跌幅逾半，可能受節慶、廣告預算調整或競品影響，建議追蹤後續。
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <%# ── 每月趨勢 ── %>
          <div class="hs-stat-block mb-4">
            <div class="hs-block-title">每月趨勢</div>
            <div class="fp-table-wrap">
              <table class="fp-table">
                <thead>
                  <tr>
                    <th>月份</th>
                    <th>破萬新客數</th>
                    <th>平均首筆金額</th>
                    <th>當月回購率</th>
                    <th>首購商品分布（Top 4）</th>
                  </tr>
                </thead>
                <tbody>
                  <% @monthly_stats.each do |row| %>
                    <% series_breakdown = @monthly_series_map[row[:month]] || [] %>
                    <% row_total = series_breakdown.sum { |s| s[:count] }.to_f %>
                    <tr>
                      <td><%= row[:month] %></td>
                      <td><%= number_with_delimiter(row[:total]) %></td>
                      <td class="fp-amount">$<%= number_with_delimiter(row[:avg_first_amount]) %></td>
                      <td>
                        <span class="fp-badge-neutral"><%= row[:repurchase_rate_same_month] %>%</span>
                      </td>
                      <td>
                        <% if series_breakdown.any? %>
                          <div class="hs-series-bar-group">
                            <% series_breakdown.each do |s| %>
                              <% pct = row_total > 0 ? (s[:count] / row_total * 100).round(0).to_i : 0 %>
                              <div class="hs-series-bar-row">
                                <span class="hs-series-name"><%= s[:series] %></span>
                                <div class="hs-bar-wrap">
                                  <div class="hs-bar" style="width:<%= pct %>%;background:<%= hs_series_color(s[:series]) %>;"></div>
                                </div>
                                <span class="hs-series-pct"><%= s[:count] %>人</span>
                              </div>
                            <% end %>
                          </div>
                        <% else %>
                          <span class="fp-muted">—</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<style>
*, *::before, *::after { box-sizing: border-box; }

.hs-anomaly-banner { background: #fffbeb; border: 1.5px solid #fbbf24; border-radius: 10px; overflow: hidden; }
.hs-anomaly-header { display: flex; align-items: center; gap: 8px; padding: 12px 16px; background: #fef3c7; border-bottom: 1px solid #fde68a; }
.hs-anomaly-icon { font-size: 18px; }
.hs-anomaly-title { font-weight: 700; font-size: 14px; color: #92400e; }
.hs-anomaly-subtitle { font-size: 12px; color: #b45309; margin-left: auto; }
.hs-anomaly-list { padding: 8px 0; }
.hs-anomaly-item { padding: 10px 16px; border-bottom: 1px solid #fde68a; }
.hs-anomaly-item:last-child { border-bottom: none; }
.hs-anomaly-series-name { font-weight: 700; font-size: 14px; color: #111827; margin-bottom: 4px; }
.hs-anomaly-stats { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 4px; }
.hs-anomaly-current { font-size: 13px; color: #6b7280; }
.hs-anomaly-current strong { color: #374151; }
.hs-anomaly-arrow { color: #9ca3af; font-size: 12px; }
.hs-anomaly-hist { font-size: 13px; color: #6b7280; }
.hs-anomaly-hist strong { color: #374151; }
.hs-anomaly-badge { display: inline-block; padding: 2px 8px; background: #fee2e2; color: #b91c1c; font-size: 12px; font-weight: 700; border-radius: 4px; }
.hs-anomaly-hint { font-size: 12px; color: #92400e; background: #fef9ee; border-left: 3px solid #fbbf24; padding: 4px 8px; border-radius: 0 4px 4px 0; margin-top: 4px; }

.hs-snapshot-bar { display: flex; align-items: center; justify-content: space-between; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 8px 14px; }
.hs-snapshot-hint { font-size: 13px; color: #374151; }
.hs-snapshot-hint strong { color: #16a34a; }
.hs-snapshot-btn { padding: 6px 16px; background: #16a34a; color: #fff; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; }
.hs-snapshot-btn:hover { background: #15803d; }

.fp-stats-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }
.fp-stat-card { background: #fff; border: 1.5px solid #e5e7eb; border-radius: 10px; padding: 14px 16px; text-decoration: none; color: inherit; transition: border-color .15s, box-shadow .15s; display: block; }
.fp-stat-card:hover { border-color: #886ab5; box-shadow: 0 0 0 3px rgba(136,106,181,.1); }
.fp-stat-series { font-weight: 700; font-size: 15px; color: #374151; margin-bottom: 10px; }
.fp-stat-row { display: flex; gap: 12px; flex-wrap: wrap; }
.fp-stat-item { display: flex; flex-direction: column; gap: 2px; }
.fp-stat-num { font-size: 22px; font-weight: 700; color: #111827; }
.fp-stat-label { font-size: 10px; color: #9ca3af; }

.fp-filter-bar { background: #f8f9fa; border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px; }
.fp-filter-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; }
.fp-filter-group { display: flex; flex-direction: column; gap: 4px; }
.fp-filter-label { font-size: 11px; font-weight: 600; color: #9ca3af; text-transform: uppercase; letter-spacing: .5px; }
.fp-select { border: 1px solid #e5e7eb; border-radius: 6px; padding: 6px 10px; font-size: 13px; color: #374151; background: #fff; }
.fp-filter-actions { display: flex; gap: 8px; align-items: flex-end; }
.fp-btn-primary { padding: 7px 18px; background: #886ab5; color: #fff; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; }
.fp-btn-primary:hover { background: #6d52a0; }
.fp-btn-secondary { padding: 7px 14px; background: transparent; color: #6b7280; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 13px; text-decoration: none; display: inline-flex; align-items: center; }

.fp-table-wrap { overflow-x: auto; background: #fff; }
.fp-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.fp-table thead th { background: #886ab5; color: #fff; padding: 10px 14px; text-align: left; font-weight: 600; font-size: 12px; white-space: nowrap; }
.fp-table tbody td { padding: 8px 14px; border-bottom: 1px solid #f3f4f6; vertical-align: middle; }
.fp-table tbody tr:last-child td { border-bottom: none; }
.fp-table tbody tr:hover td { background: #faf9ff; }
.hs-row-urgent td { background: #fffbf5; }
.hs-row-urgent:hover td { background: #fff8f0 !important; }

.fp-muted { color: #9ca3af; }
.fp-amount { white-space: nowrap; color: #374151; }
.fp-customer-link { font-weight: 600; color: #374151; text-decoration: none; }
.fp-customer-link:hover { color: #886ab5; }

.fp-badge-ok       { background: #f0fdf4; color: #16a34a; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 99px; white-space: nowrap; display: inline-block; }
.fp-badge-mid      { background: #fef9c3; color: #92400e; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 99px; white-space: nowrap; display: inline-block; }
.fp-badge-warn     { background: #fef2f2; color: #dc2626; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 99px; white-space: nowrap; display: inline-block; }
.fp-badge-neutral  { background: #f3f4f6; color: #6b7280; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 99px; white-space: nowrap; display: inline-block; }
.fp-badge-thisweek { background: #eff6ff; color: #1d4ed8; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 99px; white-space: nowrap; display: inline-block; }
.fp-badge-lost     { background: #f8fafc; color: #94a3b8; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 99px; white-space: nowrap; display: inline-block; }

/* 分層區塊 */
.hs-tier-block { border-radius: 10px; overflow: hidden; margin-bottom: 12px; }
.hs-tier-header { display: flex; align-items: center; gap: 10px; padding: 12px 16px; font-size: 14px; font-weight: 700; cursor: pointer; list-style: none; border-bottom: 1px solid #e5e7eb; }
.hs-tier-header::-webkit-details-marker { display: none; }
details.hs-tier-block > summary.hs-tier-header::after { content: "▸"; margin-left: auto; font-size: 11px; color: #9ca3af; }
details[open].hs-tier-block > summary.hs-tier-header::after { content: "▾"; }
.hs-tier-count { font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 99px; }
.hs-tier-hint  { font-size: 11px; font-weight: 400; color: #9ca3af; }

.hs-tier-thisweek   { border: 1.5px solid #bfdbfe; background: #fff; }
.hs-tier-thisweek   .hs-tier-header { background: #eff6ff; color: #1d4ed8; }
.hs-omnichat-btn { margin-left: auto; padding: 4px 12px; background: #2563eb; color: #fff; border-radius: 6px; font-size: 12px; font-weight: 600; text-decoration: none; white-space: nowrap; }
.hs-omnichat-btn:hover { background: #1d4ed8; color: #fff; text-decoration: none; }
.hs-tier-thisweek   .hs-tier-count  { background: #1d4ed8; color: #fff; }
.hs-tier-urgent     { border: 1.5px solid #fecaca; background: #fff; }
.hs-tier-urgent     .hs-tier-header { background: #fef2f2; color: #dc2626; }
.hs-tier-urgent     .hs-tier-count  { background: #dc2626; color: #fff; }
.hs-tier-waiting    { border: 1px solid #e5e7eb; background: #fff; }
.hs-tier-waiting    .hs-tier-header { background: #f9fafb; color: #374151; }
.hs-tier-waiting    .hs-tier-count  { background: #e5e7eb; color: #6b7280; }
.hs-tier-lost       { border: 1px solid #e5e7eb; background: #fff; }
.hs-tier-lost       .hs-tier-header { background: #f8fafc; color: #94a3b8; }
.hs-tier-lost       .hs-tier-count  { background: #e2e8f0; color: #64748b; }
.hs-tier-repurchased{ border: 1px solid #d1fae5; background: #fff; }
.hs-tier-repurchased .hs-tier-header { background: #f0fdf4; color: #16a34a; }
.hs-tier-repurchased .hs-tier-count  { background: #16a34a; color: #fff; }

.hs-section-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 16px; align-items: start; }
.hs-stat-block { background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden; }
.hs-block-title { font-size: 14px; font-weight: 700; color: #374151; padding: 12px 16px; background: #f9fafb; border-bottom: 1px solid #e5e7eb; }
.hs-title-tag { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 99px; margin-left: 8px; }
.hs-title-meta { font-size: 12px; font-weight: 400; color: #6b7280; }
.hs-title-hint { color: #9ca3af; }

/* 顧客名單 */
.hs-customer-cell { display: flex; align-items: center; gap: 6px; }
.hs-ig-link { color: #9ca3af; font-size: 13px; text-decoration: none; }
.hs-ig-link:hover { color: #e1306c; }
.hs-sl-link { color: #9ca3af; font-size: 13px; text-decoration: none; }
.hs-sl-link:hover { color: #886ab5; }
.hs-series-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 4px; flex-shrink: 0; }
.hs-days-num { font-weight: 700; color: #374151; }
.hs-days-unit { font-size: 11px; color: #9ca3af; }
.hs-cycle-hint { font-size: 10px; color: #9ca3af; margin-top: 2px; }
.hs-second-buy { display: flex; flex-direction: column; gap: 1px; }
.hs-second-date { font-size: 11px; color: #9ca3af; }

.hs-next-buy { display: flex; align-items: center; gap: 6px; font-size: 12px; margin-bottom: 2px; }
.hs-next-series { font-weight: 600; color: #374151; }
.hs-next-count { color: #9ca3af; }

.fp-filter-check-group { justify-content: flex-end; }
.fp-checkbox-label { display: flex; align-items: center; gap: 6px; font-size: 13px; color: #374151; cursor: pointer; padding: 7px 0; white-space: nowrap; }
.fp-checkbox { width: 15px; height: 15px; cursor: pointer; accent-color: #886ab5; }

.hs-series-bar-group { display: flex; flex-direction: column; gap: 4px; min-width: 200px; }
.hs-series-bar-row { display: flex; align-items: center; gap: 6px; }
.hs-series-name { font-size: 11px; color: #374151; font-weight: 600; width: 44px; flex-shrink: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.hs-bar-wrap { flex: 1; height: 8px; background: #f3f4f6; border-radius: 99px; overflow: hidden; }
.hs-bar { height: 100%; border-radius: 99px; transition: width .3s; }
.hs-series-pct { font-size: 11px; color: #9ca3af; width: 30px; text-align: right; flex-shrink: 0; }

/* 系列 tabs */
.hs-tabs { display: flex; flex-wrap: wrap; gap: 4px; padding: 10px 14px; background: #fff; border-bottom: 1px solid #e5e7eb; }
.hs-tab { display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border: 1px solid #e5e7eb; border-radius: 99px; font-size: 12px; font-weight: 500; color: #6b7280; background: #f9fafb; cursor: pointer; transition: all .15s; }
.hs-tab:hover { border-color: #886ab5; color: #886ab5; background: #faf8ff; }
.hs-tab.active { background: #886ab5; color: #fff; border-color: #886ab5; }
.hs-tab.active .hs-tab-count { background: rgba(255,255,255,0.3); color: #fff; }
.hs-tab-count { font-size: 10px; font-weight: 700; background: #e5e7eb; color: #6b7280; padding: 1px 5px; border-radius: 99px; }

/* Toast 提示 */
.hs-toast { position: fixed; bottom: 24px; right: 24px; padding: 10px 18px; border-radius: 8px; font-size: 13px; font-weight: 600; opacity: 0; transform: translateY(8px); transition: opacity .25s, transform .25s; z-index: 9999; pointer-events: none; }
.hs-toast-show { opacity: 1; transform: translateY(0); }
.hs-toast-ok  { background: #16a34a; color: #fff; }
.hs-toast-err { background: #dc2626; color: #fff; }

/* LINE 綁定欄 */
.hs-line-cell { white-space: nowrap; }
.hs-line-select { border: 1px solid #e5e7eb; border-radius: 6px; padding: 4px 8px; font-size: 12px; color: #6b7280; background: #fff; cursor: pointer; }
.hs-line-select.hs-line-bound { color: #06c755; font-weight: 600; border-color: #86efac; background: #f0fdf4; }

/* 催單產品欄 */
.hs-product-cell { min-width: 130px; }
.hs-product-select { border: 1px solid #e5e7eb; border-radius: 6px; padding: 4px 8px; font-size: 12px; color: #374151; background: #fff; width: 100%; max-width: 150px; cursor: pointer; }
.hs-product-select:focus { outline: none; border-color: #886ab5; }

/* 分頁 */
.hs-pager { display: flex; align-items: center; gap: 4px; padding: 10px 14px 8px; flex-wrap: wrap; }
.hs-pager-btn { min-width: 30px; height: 28px; padding: 0 8px; border: 1px solid #e5e7eb; border-radius: 5px; background: #fff; font-size: 12px; color: #6b7280; cursor: pointer; font-weight: 500; }
.hs-pager-btn:hover { border-color: #886ab5; color: #886ab5; }
.hs-pager-btn.active { background: #886ab5; color: #fff; border-color: #886ab5; font-weight: 700; }
.hs-pager-info { font-size: 11px; color: #9ca3af; margin-right: 6px; }

@media (max-width: 900px) {
  .hs-section-grid { grid-template-columns: 1fr; }
  .fp-stats-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
  .fp-stats-grid { gap: 8px; }
  .fp-stat-card { padding: 12px; }
  .fp-stat-num { font-size: 17px; }
  .fp-filter-bar { padding: 14px; }
  .fp-filter-row { flex-direction: column; gap: 10px; }
  .fp-filter-group, .fp-select { width: 100%; }
  .fp-filter-check-group { justify-content: flex-start; }
  .fp-filter-actions { width: 100%; }
  .fp-btn-primary, .fp-btn-secondary { flex: 1; text-align: center; justify-content: center; }
}
</style>

<script>
var _hsPagerState = {};

function hsPaginate(tierId, page, filter) {
  var table = document.querySelector('table[data-tier-table="' + tierId + '"]');
  var pager = document.querySelector('.hs-pager[data-pager="' + tierId + '"]');
  if (!table) return;
  var perPage = pager ? parseInt(pager.dataset.perPage) : 10;
  filter = filter !== undefined ? filter : ((_hsPagerState[tierId] || {}).filter || 'all');
  _hsPagerState[tierId] = { page: page, filter: filter };
  var rows     = Array.from(table.querySelectorAll('tbody tr'));
  var filtered = filter === 'all' ? rows : rows.filter(function(r) { return r.dataset.series === filter; });
  var start    = (page - 1) * perPage;
  rows.forEach(function(r) { r.style.display = 'none'; });
  filtered.slice(start, start + perPage).forEach(function(r) { r.style.display = ''; });
  if (pager) {
    var totalPages = Math.ceil(filtered.length / perPage);
    if (totalPages <= 1) { pager.innerHTML = ''; return; }
    var safe = filter.replace(/\\/g,'\\\\').replace(/'/g,"\\'");
    var html = '<span class="hs-pager-info">' + filtered.length + ' 人</span>';
    if (page > 1) html += '<button class="hs-pager-btn" onclick="hsPaginate(\'' + tierId + '\',' + (page-1) + ',\'' + safe + '\')">←</button>';
    for (var i = 1; i <= totalPages; i++) {
      html += '<button class="hs-pager-btn' + (i===page?' active':'') + '" onclick="hsPaginate(\'' + tierId + '\',' + i + ',\'' + safe + '\')">' + i + '</button>';
    }
    if (page < totalPages) html += '<button class="hs-pager-btn" onclick="hsPaginate(\'' + tierId + '\',' + (page+1) + ',\'' + safe + '\')">→</button>';
    pager.innerHTML = html;
  }
}

document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.hs-pager[data-pager]').forEach(function(p) {
    hsPaginate(p.dataset.pager, 1, 'all');
  });
});

function hsShowToast(msg, ok) {
  var t = document.createElement('div');
  t.className = 'hs-toast' + (ok ? ' hs-toast-ok' : ' hs-toast-err');
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(function() { t.classList.add('hs-toast-show'); }, 10);
  setTimeout(function() { t.classList.remove('hs-toast-show'); setTimeout(function() { t.remove(); }, 300); }, 2000);
}

function hsUpdateField(identityKey, field, value, url) {
  var token = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
  var body  = new URLSearchParams({ identity_key: identityKey, field: field, value: value });
  fetch(url, {
    method: 'PATCH',
    headers: { 'X-CSRF-Token': token, 'Content-Type': 'application/x-www-form-urlencoded' },
    body: body.toString()
  }).then(function(r) {
    if (r.ok) { hsShowToast('已儲存 ✓', true); }
    else       { hsShowToast('儲存失敗，請重試', false); }
  }).catch(function() { hsShowToast('儲存失敗，請重試', false); });
}

document.addEventListener('change', function(e) {
  var el  = e.target;
  var key = el.dataset.identityKey;
  var url = el.dataset.updateUrl;
  if (!key || !url) return;

  if (el.classList.contains('hs-line-select')) {
    hsUpdateField(key, 'line_bound', el.value, url);
    el.classList.toggle('hs-line-bound', el.value === '1');
  }

  if (el.classList.contains('hs-product-select')) {
    hsUpdateField(key, 'follow_up_product', el.value, url);
  }
});

document.addEventListener('click', function(e) {
  var btn = e.target.closest('.hs-tab');
  if (!btn) return;
  var tabsEl = btn.closest('[data-tier-tabs]');
  if (!tabsEl) return;
  var tierId = tabsEl.dataset.tierTabs;
  var filter = btn.dataset.filter;
  tabsEl.querySelectorAll('.hs-tab').forEach(function(b) { b.classList.remove('active'); });
  btn.classList.add('active');
  hsPaginate(tierId, 1, filter);
});
</script>
