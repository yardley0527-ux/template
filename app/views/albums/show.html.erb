<div class="customer-show">
  <div class="back-link">
    <%= link_to "← 返回相簿列表", customer_albums_path(@customer), class: "btn-back" %>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h1 style="font-size:22px; font-weight:700; margin:0;"><%= @album.name %></h1>
      <% if @album.description.present? %>
        <p style="color:#6b7280; font-size:14px; margin-top:4px;"><%= @album.description %></p>
      <% end %>
    </div>
  </div>

  <div class="mb-4">
    <button id="upload_btn" type="button" class="btn btn-primary">＋ 上傳照片</button>
  </div>

  <% if @photos.empty? %>
    <p class="text-muted">這個相簿還沒有照片。</p>
  <% else %>
    <div class="photo-grid">
      <% @photos.each do |photo| %>
        <div class="photo-item">
          <img src="<%= photo.url %>" alt="<%= photo.caption %>">

          <div class="photo-overlay">
            <% if photo.caption.present? %>
              <div class="photo-caption"><%= photo.caption %></div>
            <% end %>

            <div class="photo-actions">
              <button
                type="button"
                class="photo-preview-btn"
                onclick="openLightbox('<%= j photo.url %>', '<%= j(photo.caption.to_s) %>')">
                🔍
              </button>

              <%= button_to "🗑",
                    customer_album_photo_path(@customer, @album, photo),
                    method: :delete,
                    class: "photo-delete-btn",
                    form: { class: "photo-delete-form", style: "display:contents;" } %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<%# Lightbox %>
<div id="lightbox"
     onclick="closeLightbox()"
     style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.85); z-index:9999; align-items:center; justify-content:center;">
  <img id="lightbox-img"
       src=""
       alt=""
       style="max-width:90vw; max-height:90vh; border-radius:10px; box-shadow:0 4px 32px rgba(0,0,0,0.5);">
</div>

<%# 自訂刪除確認 Modal（取代 window.confirm） %>
<div id="delete-modal"
     style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:10000; align-items:center; justify-content:center; padding:16px;">
  <div style="background:#fff; border-radius:12px; padding:24px; max-width:320px; width:100%; box-shadow:0 8px 32px rgba(0,0,0,0.2);">
    <p style="font-size:16px; font-weight:600; margin:0 0 8px;">確定刪除？</p>
    <p style="font-size:14px; color:#6b7280; margin:0 0 20px;">這張照片刪除後無法復原。</p>
    <div style="display:flex; gap:10px; justify-content:flex-end;">
      <button id="delete-cancel-btn"
              style="padding:8px 18px; border-radius:8px; border:1px solid #d1d5db; background:#fff; font-size:14px; cursor:pointer;">
        取消
      </button>
      <button id="delete-confirm-btn"
              style="padding:8px 18px; border-radius:8px; border:none; background:#ef4444; color:#fff; font-size:14px; cursor:pointer;">
        刪除
      </button>
    </div>
  </div>
</div>

<script>
  (function() {
    // 使用 window 級別的變數，確保在 Turbo 切換時狀態能被追蹤
    window.cloudinaryWidget = window.cloudinaryWidget || null;
    let pendingDeleteForm = null;
    let activeUploads = 0;

    // 1. 載入 Cloudinary SDK
    function loadCloudinary() {
      if (window.cloudinary) return Promise.resolve(window.cloudinary);
      return new Promise((resolve, reject) => {
        const script = document.createElement("script");
        script.src = "https://upload-widget.cloudinary.com/global/all.js";
        script.async = true;
        script.onload = () => resolve(window.cloudinary);
        script.onerror = reject;
        document.head.appendChild(script);
      });
    }

    // 2. 初始化 Widget (只在不存在時建立)
    function getWidget(cloudinary) {
      if (window.cloudinaryWidget) return window.cloudinaryWidget;

      window.cloudinaryWidget = cloudinary.createUploadWidget({
        cloudName: "<%= Rails.application.credentials.dig(:cloudinary, :cloud_name) %>",
        uploadPreset: "ml_default",
        multiple: true,
        maxFiles: 20,
        language: "zh_TW",
        sources: ["local", "camera"],
        clientAllowedFormats: ["jpg", "jpeg", "png", "webp", "heic"],
        resourceType: "image"
      }, (error, result) => {
        if (result.event === "success") {
          activeUploads++;
          savePhotoToRails(result.info);
        }
        if (result.event === "close") {
          const checkAndReload = () => {
            if (activeUploads <= 0) window.location.reload();
            else setTimeout(checkAndReload, 100);
          };
          checkAndReload();
        }
      });
      return window.cloudinaryWidget;
    }

    function savePhotoToRails(info) {
      fetch("<%= customer_album_photos_path(@customer, @album) %>", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]')?.content,
          "Accept": "application/json"
        },
        body: JSON.stringify({
          photo: {
            cloudinary_public_id: info.public_id,
            url: info.secure_url,
            caption: info.original_filename
          }
        })
      }).finally(() => activeUploads--);
    }

    // 3. 核心：全域事件監聽 (解決視窗跳不出來的問題)
    function bindGlobalEvents() {
      // 避免重複綁定
      if (window.isEventsBound) return;
      window.isEventsBound = true;

      document.addEventListener("click", function(e) {
        // --- 處理上傳按鈕 ---
        if (e.target.closest("#upload_btn")) {
          e.preventDefault();
          loadCloudinary().then(cloudinary => {
            getWidget(cloudinary).open();
          });
        }

        // --- 處理刪除按鈕 (相簿照片刪除) ---
        const deleteBtn = e.target.closest(".photo-delete-btn");
        if (deleteBtn) {
          e.preventDefault();
          pendingDeleteForm = deleteBtn.closest("form");
          const modal = document.getElementById("delete-modal");
          if (modal) modal.style.display = "flex";
        }

        // --- 處理 Modal 內的取消按鈕 ---
        if (e.target.closest("#delete-cancel-btn")) {
          document.getElementById("delete-modal").style.display = "none";
          pendingDeleteForm = null;
        }

        // --- 處理 Modal 內的確認按鈕 ---
        if (e.target.closest("#delete-confirm-btn")) {
          if (pendingDeleteForm) {
            // 這裡直接呼叫 submit，繞過傳統 confirm
            pendingDeleteForm.submit(); 
          }
          document.getElementById("delete-modal").style.display = "none";
        }
      });
    }

    // 4. 啟動
    function init() {
      bindGlobalEvents();
      // 預載 SDK 以提升反應速度
      loadCloudinary().then(cloudinary => getWidget(cloudinary));
    }

    // 同時支援傳統載入與 Turbo 載入
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
    document.addEventListener("turbo:load", init);

  })();
</script>

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
  }

  .photo-item {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 1;
    background: #f3f4f6;
  }

  .photo-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .photo-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-end;
    padding: 8px;
    transition: background 0.2s;
  }

  .photo-item:hover .photo-overlay {
    background: rgba(0,0,0,0.35);
  }

  .photo-caption {
    position: absolute;
    bottom: 36px;
    left: 8px;
    right: 8px;
    color: #fff;
    font-size: 11px;
    opacity: 0;
    transition: opacity 0.2s;
    word-break: break-word;
  }

  .photo-item:hover .photo-caption {
    opacity: 1;
  }

  .photo-actions {
    display: flex;
    gap: 6px;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .photo-item:hover .photo-actions {
    opacity: 1;
  }

  .photo-delete-btn,
  .photo-preview-btn {
    border: none;
    border-radius: 6px;
    cursor: pointer;
    padding: 4px 8px;
    font-size: 13px;
    line-height: 1;
  }

  .photo-delete-btn {
    background: rgba(239,68,68,0.85);
    color: #fff;
  }

  .photo-preview-btn {
    background: rgba(99,102,241,0.85);
    color: #fff;
  }

  .btn-back {
    display: inline-block;
    margin-bottom: 16px;
    color: #6366f1;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
  }


  @media (max-width: 768px) {
    .photo-actions {
      opacity: 1 !important;
    }

    .photo-overlay {
      background: rgba(0,0,0,0.25) !important;
    }

    .photo-delete-btn,
    .photo-preview-btn {
      padding: 8px 12px;
      font-size: 16px;
    }
  }
</style>