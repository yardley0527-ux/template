<div class="customer-show">
  <div class="back-link">
    <%= link_to "← 返回相簿列表", customer_albums_path(@customer), class: "btn-back" %>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h1 style="font-size:22px; font-weight:700; margin:0;"><%= @album.name %></h1>
      <% if @album.description.present? %>
        <p style="color:#6b7280; font-size:14px; margin-top:4px;"><%= @album.description %></p>
      <% end %>
    </div>
  </div>

  <div class="mb-4">
    <button id="upload_btn" type="button" class="btn btn-primary">＋ 上傳照片</button>
  </div>

  <% if @photos.empty? %>
    <p class="text-muted">這個相簿還沒有照片。</p>
  <% else %>
    <div class="photo-grid">
      <% @photos.each do |photo| %>
        <div class="photo-item">
          <img src="<%= photo.url %>" alt="<%= photo.caption %>">

          <div class="photo-overlay">
            <% if photo.caption.present? %>
              <div class="photo-caption"><%= photo.caption %></div>
            <% end %>

            <div class="photo-actions">
              <button
                type="button"
                class="photo-preview-btn"
                onclick="openLightbox('<%= j photo.url %>', '<%= j(photo.caption.to_s) %>')">
                🔍
              </button>

              <%= button_to "🗑",
                    customer_album_photo_path(@customer, @album, photo),
                    method: :delete,
                    class: "photo-delete-btn",
                    form: { class: "photo-delete-form", style: "display:contents;" } %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<div id="lightbox"
     onclick="closeLightbox()"
     style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.85); z-index:9999; align-items:center; justify-content:center;">
  <img id="lightbox-img"
       src=""
       alt=""
       style="max-width:90vw; max-height:90vh; border-radius:10px; box-shadow:0 4px 32px rgba(0,0,0,0.5);">
</div>

<script>
  (function() {
    let uploadWidget = null;
    let cloudinaryScriptPromise = null;
    let uploadInProgress = false;

    function loadCloudinaryScript() {
      if (window.cloudinary) return Promise.resolve(window.cloudinary);
      if (cloudinaryScriptPromise) return cloudinaryScriptPromise;

      cloudinaryScriptPromise = new Promise(function(resolve, reject) {
        const existing = document.querySelector('script[data-cloudinary-widget="true"]');

        if (existing) {
          if (window.cloudinary) {
            resolve(window.cloudinary);
            return;
          }

          existing.addEventListener("load", function() {
            if (window.cloudinary) {
              resolve(window.cloudinary);
            } else {
              reject(new Error("Cloudinary script loaded but window.cloudinary not found"));
            }
          });

          existing.addEventListener("error", function() {
            reject(new Error("Cloudinary script failed to load"));
          });

          return;
        }

        const script = document.createElement("script");
        script.src = "https://upload-widget.cloudinary.com/global/all.js";
        script.type = "text/javascript";
        script.async = true;
        script.dataset.cloudinaryWidget = "true";

        script.onload = function() {
          if (window.cloudinary) {
            resolve(window.cloudinary);
          } else {
            reject(new Error("Cloudinary script loaded but window.cloudinary not found"));
          }
        };

        script.onerror = function() {
          reject(new Error("Cloudinary script failed to load"));
        };

        document.head.appendChild(script);
      });

      return cloudinaryScriptPromise;
    }

    function createUploadWidget() {
      if (uploadWidget) return Promise.resolve(uploadWidget);

      return loadCloudinaryScript().then(function(cloudinary) {
        uploadWidget = cloudinary.createUploadWidget({
          cloudName: "<%= Rails.application.credentials.dig(:cloudinary, :cloud_name) %>",
          uploadPreset: "ml_default",
          multiple: true,
          maxFiles: 20,
          sources: ["local", "camera", "photo_library"],
          language: "zh_TW",
          clientAllowedFormats: ["jpg", "jpeg", "png", "webp", "heic"],
          maxImageFileSize: 10000000,
          resourceType: "image",
          singleUploadAutoClose: false,
          showCompletedButton: true
        }, function(error, result) {
          if (error) {
            uploadInProgress = false;
            console.error("Cloudinary widget error:", error);
            alert("上傳元件載入失敗，請稍後再試。");
            return;
          }

          if (!result) return;

          if (result.event === "success") {
            const info = result.info;

            fetch("<%= customer_album_photos_path(@customer, @album) %>", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "X-CSRF-Token": document.querySelector('meta[name=\"csrf-token\"]')?.content || "",
                "Accept": "application/json"
              },
              body: JSON.stringify({
                photo: {
                  cloudinary_public_id: info.public_id,
                  url: info.secure_url,
                  caption: info.original_filename
                }
              })
            })
            .then(function(response) {
              if (!response.ok) {
                throw new Error("Photo save failed");
              }
              return response.text();
            })
            .catch(function(err) {
              console.error(err);
              alert("照片已上傳到雲端，但寫入相簿失敗，請重新整理後確認。");
            });
          }

          if (result.event === "queues-end") {
            uploadInProgress = false;
          }

          if (result.event === "close") {
            uploadInProgress = false;
            window.location.reload();
          }
        });

        return uploadWidget;
      });
    }

    function bindUploadButton() {
      const uploadBtn = document.getElementById("upload_btn");
      if (!uploadBtn) return;
      if (uploadBtn.dataset.bound === "true") return;

      uploadBtn.dataset.bound = "true";

      uploadBtn.addEventListener("click", async function() {
        if (uploadInProgress) return;

        uploadInProgress = true;

        try {
          const widget = await createUploadWidget();
          widget.open();
        } catch (err) {
          uploadInProgress = false;
          console.error(err);
          alert("上傳功能初始化失敗，請重新整理後再試。");
        }
      });
    }

    function bindDeleteConfirm() {
      if (document.body.dataset.deleteConfirmBound === "true") return;
      document.body.dataset.deleteConfirmBound = "true";

      ["click", "touchstart"].forEach(function(evt) {
        document.addEventListener(evt, function(e) {
          const deleteBtn = e.target.closest(".photo-delete-btn");
          if (!deleteBtn) return;

          const form = deleteBtn.closest("form");
          if (!form) return;

          e.preventDefault();
          e.stopPropagation();

          const ok = window.confirm("確定刪除這張照片？");
          if (!ok) return;

          if (form.requestSubmit) {
            form.requestSubmit();
          } else {
            form.submit();
          }
        }, true);
      });
    }

    function initAlbumPage() {
      bindUploadButton();
      bindDeleteConfirm();
    }

    document.addEventListener("DOMContentLoaded", initAlbumPage);
    document.addEventListener("turbo:load", initAlbumPage);

    window.openLightbox = function(url, caption) {
      const lb = document.getElementById("lightbox");
      const img = document.getElementById("lightbox-img");
      if (!lb || !img) return;

      img.src = url;
      img.alt = caption || "";
      lb.style.display = "flex";
    };

    window.closeLightbox = function() {
      const lb = document.getElementById("lightbox");
      if (lb) lb.style.display = "none";
    };

    document.addEventListener("keydown", function(e) {
      if (e.key === "Escape") {
        window.closeLightbox();
      }
    });
  })();
</script>

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
  }

  .photo-item {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 1;
    background: #f3f4f6;
  }

  .photo-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .photo-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.35);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
    padding: 8px;
    transition: background 0.2s;
  }

  .photo-caption {
    position: absolute;
    bottom: 50px;
    left: 8px;
    right: 8px;
    color: #fff;
    font-size: 11px;
    opacity: 1;
    transition: opacity 0.2s;
    word-break: break-word;
    line-height: 1.4;
  }

  .photo-actions {
    display: flex;
    gap: 6px;
    opacity: 1;
    width: 100%;
    justify-content: space-between;
    transition: opacity 0.2s;
  }

  .photo-delete-btn,
  .photo-preview-btn {
    border: none;
    border-radius: 6px;
    cursor: pointer;
    text-decoration: none;
    padding: 6px 10px;
    font-size: 14px;
    line-height: 1;
  }

  .photo-delete-btn {
    background: rgba(239,68,68,0.85);
    color: #fff;
  }

  .photo-preview-btn {
    background: rgba(99,102,241,0.85);
    color: #fff;
  }

  .btn-back {
    display: inline-block;
    margin-bottom: 16px;
    color: #6366f1;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
  }

  @media (min-width: 769px) {
    .photo-item:hover .photo-overlay {
      background: rgba(0,0,0,0.45);
    }

    .photo-delete-btn:hover {
      background: rgba(239,68,68,1);
    }

    .photo-preview-btn:hover {
      background: rgba(99,102,241,1);
    }
  }

  @media (max-width: 768px) {
    .photo-delete-btn,
    .photo-preview-btn {
      padding: 10px 14px;
      font-size: 18px;
    }

    .photo-caption {
      bottom: 56px;
      font-size: 12px;
    }
  }
</style>