<div class="customer-show">
  <div class="back-link">
    <%= link_to "← 返回相簿列表", customer_albums_path(@customer), class: "btn-back" %>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h1 style="font-size:22px; font-weight:700; margin:0;"><%= @album.name %></h1>
      <% if @album.description.present? %>
        <p style="color:#6b7280; font-size:14px; margin-top:4px;"><%= @album.description %></p>
      <% end %>
    </div>
  </div>

  <div class="mb-4">
    <button id="upload_btn" type="button" class="btn btn-primary">＋ 上傳照片</button>
  </div>

  <% if @photos.empty? %>
    <p class="text-muted">這個相簿還沒有照片。</p>
  <% else %>
    <div class="photo-grid">
      <% @photos.each do |photo| %>
        <div class="photo-item">
          <img src="<%= photo.url %>" alt="<%= photo.caption %>">

          <div class="photo-overlay">
            <% if photo.caption.present? %>
              <div class="photo-caption"><%= photo.caption %></div>
            <% end %>

            <div class="photo-actions">
              <button
                type="button"
                class="photo-preview-btn"
                onclick="openLightbox('<%= j photo.url %>', '<%= j(photo.caption.to_s) %>')">
                🔍
              </button>

              <%= button_to "🗑",
                    customer_album_photo_path(@customer, @album, photo),
                    method: :delete,
                    class: "photo-delete-btn",
                    form: { class: "photo-delete-form", style: "display:contents;" } %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<div id="lightbox"
     onclick="closeLightbox()"
     style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.85); z-index:9999; align-items:center; justify-content:center;">
  <img id="lightbox-img"
       src=""
       alt=""
       style="max-width:90vw; max-height:90vh; border-radius:10px; box-shadow:0 4px 32px rgba(0,0,0,0.5);">
</div>

<div id="delete-modal"
     style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:10000; align-items:center; justify-content:center; padding:16px;">
  <div style="background:#fff; border-radius:12px; padding:24px; max-width:320px; width:100%; box-shadow:0 8px 32px rgba(0,0,0,0.2);">
    <p style="font-size:16px; font-weight:600; margin:0 0 8px;">確定刪除？</p>
    <p style="font-size:14px; color:#6b7280; margin:0 0 20px;">這張照片刪除後無法復原。</p>
    <div style="display:flex; gap:10px; justify-content:flex-end;">
      <button id="delete-cancel-btn"
              type="button"
              style="padding:8px 18px; border-radius:8px; border:1px solid #d1d5db; background:#fff; font-size:14px; cursor:pointer;">
        取消
      </button>
      <button id="delete-confirm-btn"
              type="button"
              style="padding:8px 18px; border-radius:8px; border:none; background:#ef4444; color:#fff; font-size:14px; cursor:pointer;">
        刪除
      </button>
    </div>
  </div>
</div>

<script>
  (function() {
    console.log("[album] script boot start");

    window.cloudinaryWidget = window.cloudinaryWidget || null;
    window.albumDebugBound = window.albumDebugBound || false;

    let pendingDeleteForm = null;
    let activeUploads = 0;
    let cloudinaryPromise = null;

    function log() {
      console.log.apply(console, ["[album]"].concat(Array.from(arguments)));
    }

    function warn() {
      console.warn.apply(console, ["[album]"].concat(Array.from(arguments)));
    }

    function errorLog() {
      console.error.apply(console, ["[album]"].concat(Array.from(arguments)));
    }

    function loadCloudinary() {
      log("loadCloudinary() called");
      log("typeof window.cloudinary =", typeof window.cloudinary);

      if (window.cloudinary) {
        log("cloudinary already exists on window");
        return Promise.resolve(window.cloudinary);
      }

      if (cloudinaryPromise) {
        log("reusing existing cloudinaryPromise");
        return cloudinaryPromise;
      }

      cloudinaryPromise = new Promise(function(resolve, reject) {
        const existing = document.querySelector('script[data-cloudinary-widget="true"]');
        log("existing script tag =", existing);

        if (existing) {
          log("found existing cloudinary script tag");

          if (window.cloudinary) {
            log("existing script + window.cloudinary already ready");
            resolve(window.cloudinary);
            return;
          }

          existing.addEventListener("load", function() {
            log("existing cloudinary script load event fired");
            log("typeof window.cloudinary after existing load =", typeof window.cloudinary);

            if (window.cloudinary) {
              resolve(window.cloudinary);
            } else {
              reject(new Error("Cloudinary script loaded but window.cloudinary is still undefined"));
            }
          });

          existing.addEventListener("error", function(e) {
            errorLog("existing cloudinary script error", e);
            reject(new Error("Existing Cloudinary script failed to load"));
          });

          return;
        }

        const script = document.createElement("script");
        script.src = "https://upload-widget.cloudinary.com/global/all.js";
        script.async = true;
        script.dataset.cloudinaryWidget = "true";

        log("appending new cloudinary script", script.src);

        script.onload = function() {
          log("new cloudinary script loaded");
          log("typeof window.cloudinary after load =", typeof window.cloudinary);

          if (window.cloudinary) {
            resolve(window.cloudinary);
          } else {
            reject(new Error("Cloudinary script loaded but window.cloudinary not found"));
          }
        };

        script.onerror = function(e) {
          errorLog("new cloudinary script failed to load", e);
          reject(new Error("Cloudinary script failed to load"));
        };

        document.head.appendChild(script);
      });

      return cloudinaryPromise;
    }

    function savePhotoToRails(info) {
      log("savePhotoToRails() start", info);

      return fetch("<%= customer_album_photos_path(@customer, @album) %>", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": document.querySelector('meta[name=\"csrf-token\"]')?.content || "",
          "Accept": "application/json"
        },
        body: JSON.stringify({
          photo: {
            cloudinary_public_id: info.public_id,
            url: info.secure_url,
            caption: info.original_filename
          }
        })
      })
      .then(function(response) {
        log("savePhotoToRails response status =", response.status);

        if (!response.ok) {
          throw new Error("Photo save failed with status " + response.status);
        }

        return response.text();
      })
      .then(function(text) {
        log("savePhotoToRails success", text);
        return text;
      })
      .catch(function(err) {
        errorLog("savePhotoToRails failed", err);
        throw err;
      })
      .finally(function() {
        activeUploads--;
        log("activeUploads after save finally =", activeUploads);
      });
    }

    function getWidget(cloudinary) {
      log("getWidget() called");
      log("window.cloudinaryWidget exists =", !!window.cloudinaryWidget);

      if (window.cloudinaryWidget) {
        log("reusing existing widget");
        return window.cloudinaryWidget;
      }

      log("creating new cloudinary widget");

      window.cloudinaryWidget = cloudinary.createUploadWidget({
        cloudName: "<%= ENV['CLOUDINARY_CLOUD_NAME'] %>",
        uploadPreset: "ml_default",
        multiple: true,
        maxFiles: 20,
        language: "zh_TW",
        sources: ["local", "camera", "photo_library"],
        clientAllowedFormats: ["jpg", "jpeg", "png", "webp", "heic"],
        resourceType: "image",
        singleUploadAutoClose: false,
        showCompletedButton: true
      }, function(error, result) {
        log("widget callback fired", { error: error, result: result });

        if (error) {
          errorLog("cloudinary widget error", error);
          return;
        }

        if (!result) {
          warn("widget callback result empty");
          return;
        }

        if (result.event === "success") {
          log("widget success event", result.info);
          activeUploads++;
          log("activeUploads incremented =", activeUploads);
          savePhotoToRails(result.info);
        }

        if (result.event === "queues-end") {
          log("widget queues-end");
        }

        if (result.event === "close") {
          log("widget close event");
          const checkAndReload = function() {
            log("checkAndReload activeUploads =", activeUploads);
            if (activeUploads <= 0) {
              log("reloading page");
              window.location.reload();
            } else {
              setTimeout(checkAndReload, 150);
            }
          };
          checkAndReload();
        }
      });

      log("widget created =", window.cloudinaryWidget);
      return window.cloudinaryWidget;
    }

    function bindGlobalEvents() {
      log("bindGlobalEvents() called");
      log("window.albumDebugBound =", window.albumDebugBound);

      if (window.albumDebugBound) {
        log("events already bound, skip");
        return;
      }

      window.albumDebugBound = true;

      document.addEventListener("click", function(e) {
        const uploadBtn = e.target.closest("#upload_btn");
        const deleteBtn = e.target.closest(".photo-delete-btn");
        const cancelBtn = e.target.closest("#delete-cancel-btn");
        const confirmBtn = e.target.closest("#delete-confirm-btn");

        if (uploadBtn) {
          log("upload button clicked", uploadBtn);

          e.preventDefault();

          loadCloudinary()
            .then(function(cloudinary) {
              log("loadCloudinary resolved", cloudinary);
              const widget = getWidget(cloudinary);
              log("widget before open =", widget);

              if (!widget) {
                throw new Error("Widget is null");
              }

              if (typeof widget.open !== "function") {
                throw new Error("widget.open is not a function");
              }

              widget.open();
              log("widget.open() called successfully");
            })
            .catch(function(err) {
              errorLog("upload flow failed", err);
              alert("上傳功能初始化失敗，請打開 Console 查看 [album] 訊息。");
            });

          return;
        }

        if (deleteBtn) {
          log("delete button clicked", deleteBtn);
          e.preventDefault();

          pendingDeleteForm = deleteBtn.closest("form");
          log("pendingDeleteForm =", pendingDeleteForm);

          const modal = document.getElementById("delete-modal");
          log("delete modal =", modal);

          if (modal) {
            modal.style.display = "flex";
          } else {
            warn("delete modal not found");
          }

          return;
        }

        if (cancelBtn) {
          log("delete cancel clicked");
          const modal = document.getElementById("delete-modal");
          if (modal) modal.style.display = "none";
          pendingDeleteForm = null;
          return;
        }

        if (confirmBtn) {
          log("delete confirm clicked");
          if (pendingDeleteForm) {
            log("submitting delete form", pendingDeleteForm);
            pendingDeleteForm.submit();
          } else {
            warn("pendingDeleteForm is null");
          }

          const modal = document.getElementById("delete-modal");
          if (modal) modal.style.display = "none";
        }
      }, true);

      log("document click listener bound");
    }

    function init() {
      log("init() start");
      log("document.readyState =", document.readyState);
      log("upload_btn =", document.getElementById("upload_btn"));
      log("typeof window.cloudinary before preload =", typeof window.cloudinary);

      bindGlobalEvents();

      loadCloudinary()
        .then(function(cloudinary) {
          log("preload cloudinary success", cloudinary);
          getWidget(cloudinary);
        })
        .catch(function(err) {
          errorLog("preload cloudinary failed", err);
        });

      log("init() end");
    }

    window.openLightbox = function(url, caption) {
      log("openLightbox()", url, caption);

      const lb = document.getElementById("lightbox");
      const img = document.getElementById("lightbox-img");

      if (!lb || !img) {
        warn("lightbox elements missing", { lb: lb, img: img });
        return;
      }

      img.src = url;
      img.alt = caption || "";
      lb.style.display = "flex";
    };

    window.closeLightbox = function() {
      log("closeLightbox()");

      const lb = document.getElementById("lightbox");
      if (lb) lb.style.display = "none";
    };

    document.addEventListener("keydown", function(e) {
      if (e.key === "Escape") {
        log("Escape pressed, close lightbox");
        window.closeLightbox();
      }
    });

    if (document.readyState === "loading") {
      log("document still loading, wait DOMContentLoaded");
      document.addEventListener("DOMContentLoaded", init);
    } else {
      log("document already ready, init immediately");
      init();
    }

    document.addEventListener("turbo:load", function() {
      log("turbo:load fired");
      init();
    });

    log("script boot end");
  })();
</script>

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
  }

  .photo-item {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 1;
    background: #f3f4f6;
  }

  .photo-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .photo-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.35);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
    padding: 8px;
    transition: background 0.2s;
  }

  .photo-caption {
    position: absolute;
    bottom: 50px;
    left: 8px;
    right: 8px;
    color: #fff;
    font-size: 11px;
    opacity: 1;
    transition: opacity 0.2s;
    word-break: break-word;
    line-height: 1.4;
  }

  .photo-actions {
    display: flex;
    gap: 6px;
    opacity: 1;
    width: 100%;
    justify-content: space-between;
    transition: opacity 0.2s;
  }

  .photo-delete-btn,
  .photo-preview-btn {
    border: none;
    border-radius: 6px;
    cursor: pointer;
    text-decoration: none;
    padding: 6px 10px;
    font-size: 14px;
    line-height: 1;
  }

  .photo-delete-btn {
    background: rgba(239,68,68,0.85);
    color: #fff;
  }

  .photo-preview-btn {
    background: rgba(99,102,241,0.85);
    color: #fff;
  }

  .btn-back {
    display: inline-block;
    margin-bottom: 16px;
    color: #6366f1;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
  }

  @media (min-width: 769px) {
    .photo-item:hover .photo-overlay {
      background: rgba(0,0,0,0.45);
    }

    .photo-delete-btn:hover {
      background: rgba(239,68,68,1);
    }

    .photo-preview-btn:hover {
      background: rgba(99,102,241,1);
    }
  }

  @media (max-width: 768px) {
    .photo-delete-btn,
    .photo-preview-btn {
      padding: 10px 14px;
      font-size: 18px;
    }

    .photo-caption {
      bottom: 56px;
      font-size: 12px;
    }
  }
</style>