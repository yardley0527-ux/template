<div class="customer-show">
  <div class="back-link">
    <%= link_to "← 返回相簿列表", customer_albums_path(@customer), class: "btn-back" %>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h1 style="font-size:22px; font-weight:700; margin:0;"><%= @album.name %></h1>
      <% if @album.description.present? %>
        <p style="color:#6b7280; font-size:14px; margin-top:4px;"><%= @album.description %></p>
      <% end %>
    </div>
  </div>

  <div class="mb-4">
    <button id="upload_btn" type="button" class="btn btn-primary">＋ 上傳照片</button>
  </div>

  <% if @photos.empty? %>
    <p class="text-muted">這個相簿還沒有照片。</p>
  <% else %>
    <div class="photo-grid">
      <% @photos.each do |photo| %>
        <div class="photo-item">
          <img src="<%= photo.url %>" alt="<%= photo.caption %>">

          <div class="photo-overlay">
            <% if photo.caption.present? %>
              <div class="photo-caption"><%= photo.caption %></div>
            <% end %>

            <div class="photo-actions">
              <button
                type="button"
                class="photo-preview-btn"
                onclick="openLightbox('<%= j photo.url %>', '<%= j(photo.caption.to_s) %>')">
                🔍
              </button>

              <%= button_to "🗑",
                    customer_album_photo_path(@customer, @album, photo),
                    method: :delete,
                    class: "photo-delete-btn",
                    form: { class: "photo-delete-form", style: "display:contents;" } %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<%# Lightbox %>
<div id="lightbox"
     onclick="closeLightbox()"
     style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.85); z-index:9999; align-items:center; justify-content:center;">
  <img id="lightbox-img"
       src=""
       alt=""
       style="max-width:90vw; max-height:90vh; border-radius:10px; box-shadow:0 4px 32px rgba(0,0,0,0.5);">
</div>

<%# 自訂刪除確認 Modal（取代 window.confirm） %>
<div id="delete-modal"
     style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:10000; align-items:center; justify-content:center; padding:16px;">
  <div style="background:#fff; border-radius:12px; padding:24px; max-width:320px; width:100%; box-shadow:0 8px 32px rgba(0,0,0,0.2);">
    <p style="font-size:16px; font-weight:600; margin:0 0 8px;">確定刪除？</p>
    <p style="font-size:14px; color:#6b7280; margin:0 0 20px;">這張照片刪除後無法復原。</p>
    <div style="display:flex; gap:10px; justify-content:flex-end;">
      <button id="delete-cancel-btn"
              style="padding:8px 18px; border-radius:8px; border:1px solid #d1d5db; background:#fff; font-size:14px; cursor:pointer;">
        取消
      </button>
      <button id="delete-confirm-btn"
              style="padding:8px 18px; border-radius:8px; border:none; background:#ef4444; color:#fff; font-size:14px; cursor:pointer;">
        刪除
      </button>
    </div>
  </div>
</div>

<script>
  (function() {
    let uploadWidget = null;
    let cloudinaryScriptPromise = null;
    let pendingDeleteForm = null;

    // ─── Cloudinary Script Loader ────────────────────────────────
    function loadCloudinaryScript() {
      if (window.cloudinary) return Promise.resolve(window.cloudinary);
      if (cloudinaryScriptPromise) return cloudinaryScriptPromise;

      cloudinaryScriptPromise = new Promise(function(resolve, reject) {
        var script = document.createElement("script");
        script.src = "https://upload-widget.cloudinary.com/global/all.js";
        script.async = true;
        script.onload = function() {
          window.cloudinary ? resolve(window.cloudinary) : reject(new Error("cloudinary not found"));
        };
        script.onerror = function() {
          reject(new Error("Cloudinary script failed to load"));
        };
        document.head.appendChild(script);
      });

      return cloudinaryScriptPromise;
    }

    // ─── Widget Builder ──────────────────────────────────────────
    function buildWidget(cloudinary) {
      return cloudinary.createUploadWidget(
        {
          cloudName: "<%= Rails.application.credentials.dig(:cloudinary, :cloud_name) %>",
          uploadPreset: "ml_default",
          multiple: true,
          maxFiles: 20,
          sources: ["local", "camera"],
          language: "zh_TW",
          clientAllowedFormats: ["jpg", "jpeg", "png", "webp", "heic"],
          maxImageFileSize: 10000000,
          resourceType: "image",
          singleUploadAutoClose: false,
          showCompletedButton: true
        },
        function(error, result) {
          if (error) {
            console.error("Cloudinary widget error:", error);
            alert("上傳元件載入失敗，請稍後再試。");
            return;
          }
          if (!result) return;

          if (result.event === "success") {
            var info = result.info;
            fetch("<%= customer_album_photos_path(@customer, @album) %>", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "X-CSRF-Token": (document.querySelector('meta[name="csrf-token"]') || {}).content || "",
                "Accept": "application/json"
              },
              body: JSON.stringify({
                photo: {
                  cloudinary_public_id: info.public_id,
                  url: info.secure_url,
                  caption: info.original_filename
                }
              })
            })
            .then(function(res) {
              if (!res.ok) throw new Error("Photo save failed");
            })
            .catch(function(err) {
              console.error(err);
              alert("照片已上傳到雲端，但寫入相簿失敗，請重新整理後確認。");
            });
          }

          if (result.event === "close") {
            window.location.reload();
          }
        }
      );
    }

    // ─── 關鍵：頁面載入就提前建好 widget ────────────────────────
    // 讓點擊時可以同步呼叫 widget.open()，避免 iOS Safari 封鎖 popup
    function preloadWidget() {
      loadCloudinaryScript()
        .then(function(cloudinary) {
          uploadWidget = buildWidget(cloudinary);
        })
        .catch(function(err) {
          console.warn("Cloudinary preload failed:", err);
        });
    }

    // ─── 上傳按鈕 ────────────────────────────────────────────────
    function bindUploadButton() {
      var btn = document.getElementById("upload_btn");
      if (!btn || btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";

      btn.addEventListener("click", function() {
        if (uploadWidget) {
          // widget 已就緒 → 同步開啟，手機不會被封鎖
          uploadWidget.open();
        } else {
          // 備援：preload 還沒完成時才走這條
          loadCloudinaryScript()
            .then(function(cloudinary) {
              if (!uploadWidget) uploadWidget = buildWidget(cloudinary);
              uploadWidget.open();
            })
            .catch(function() {
              alert("上傳功能初始化失敗，請重新整理後再試。");
            });
        }
      });
    }

    // ─── 自訂刪除 Modal ──────────────────────────────────────────
    function bindDeleteModal() {
      if (document.body.dataset.deleteModalBound === "true") return;
      document.body.dataset.deleteModalBound = "true";

      var modal = document.getElementById("delete-modal");
      var confirmBtn = document.getElementById("delete-confirm-btn");
      var cancelBtn = document.getElementById("delete-cancel-btn");

      // 攔截刪除按鈕
      document.addEventListener("click", function(e) {
        var deleteBtn = e.target.closest(".photo-delete-btn");
        if (!deleteBtn) return;

        e.preventDefault();
        e.stopPropagation();

        pendingDeleteForm = deleteBtn.closest("form");
        modal.style.display = "flex";
      }, true);

      // 確認刪除
      confirmBtn.addEventListener("click", function() {
        modal.style.display = "none";
        if (!pendingDeleteForm) return;

        if (typeof pendingDeleteForm.requestSubmit === "function") {
          pendingDeleteForm.requestSubmit();
        } else {
          pendingDeleteForm.submit();
        }
        pendingDeleteForm = null;
      });

      // 取消
      cancelBtn.addEventListener("click", function() {
        modal.style.display = "none";
        pendingDeleteForm = null;
      });

      // 點背景關閉
      modal.addEventListener("click", function(e) {
        if (e.target === modal) {
          modal.style.display = "none";
          pendingDeleteForm = null;
        }
      });
    }

    // ─── Lightbox ────────────────────────────────────────────────
    window.openLightbox = function(url, caption) {
      var lb = document.getElementById("lightbox");
      var img = document.getElementById("lightbox-img");
      if (!lb || !img) return;
      img.src = url;
      img.alt = caption || "";
      lb.style.display = "flex";
    };

    window.closeLightbox = function() {
      var lb = document.getElementById("lightbox");
      if (lb) lb.style.display = "none";
    };

    document.addEventListener("keydown", function(e) {
      if (e.key === "Escape") window.closeLightbox();
    });

    // ─── Init ────────────────────────────────────────────────────
    function init() {
      preloadWidget();
      bindUploadButton();
      bindDeleteModal();
    }

    document.addEventListener("DOMContentLoaded", init);
    document.addEventListener("turbo:load", init);
  })();
</script>

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
  }

  .photo-item {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 1;
    background: #f3f4f6;
  }

  .photo-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .photo-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-end;
    padding: 8px;
    transition: background 0.2s;
  }

  .photo-item:hover .photo-overlay {
    background: rgba(0,0,0,0.35);
  }

  .photo-caption {
    position: absolute;
    bottom: 36px;
    left: 8px;
    right: 8px;
    color: #fff;
    font-size: 11px;
    opacity: 0;
    transition: opacity 0.2s;
    word-break: break-word;
  }

  .photo-item:hover .photo-caption {
    opacity: 1;
  }

  .photo-actions {
    display: flex;
    gap: 6px;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .photo-item:hover .photo-actions {
    opacity: 1;
  }

  .photo-delete-btn,
  .photo-preview-btn {
    border: none;
    border-radius: 6px;
    cursor: pointer;
    padding: 4px 8px;
    font-size: 13px;
    line-height: 1;
  }

  .photo-delete-btn {
    background: rgba(239,68,68,0.85);
    color: #fff;
  }

  .photo-preview-btn {
    background: rgba(99,102,241,0.85);
    color: #fff;
  }

  .btn-back {
    display: inline-block;
    margin-bottom: 16px;
    color: #6366f1;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
  }


  @media (max-width: 768px) {
    .photo-actions {
      opacity: 1 !important;
    }

    .photo-overlay {
      background: rgba(0,0,0,0.25) !important;
    }

    .photo-delete-btn,
    .photo-preview-btn {
      padding: 8px 12px;
      font-size: 16px;
    }
  }
</style>