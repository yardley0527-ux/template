<div class="customer-show">
  <div class="back-link">
    <%= link_to "← 返回相簿列表", customer_albums_path(@customer), class: "btn-back" %>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h1 style="font-size:22px; font-weight:700; margin:0;"><%= @album.name %></h1>
      <% if @album.description.present? %>
        <p style="color:#6b7280; font-size:14px; margin-top:4px;"><%= @album.description %></p>
      <% end %>
    </div>
  </div>

  <%# 上傳按鈕 %>
  <div class="mb-4">
    <button id="upload_btn" class="btn btn-primary">＋ 上傳照片</button>
  </div>

  <%# 照片格 %>
  <% if @photos.empty? %>
    <p class="text-muted">這個相簿還沒有照片。</p>
  <% else %>
    <div class="photo-grid">
      <% @photos.each do |photo| %>
        <div class="photo-item">
          <img src="<%= photo.url %>" alt="<%= photo.caption %>">
          <div class="photo-overlay">
            <% if photo.caption.present? %>
              <div class="photo-caption"><%= photo.caption %></div>
            <% end %>
            <div class="photo-actions">
              <button class="photo-preview-btn" onclick="openLightbox('<%= photo.url %>', '<%= photo.caption %>')">🔍</button>
              <%= button_to "🗑",
                    customer_album_photo_path(@customer, @album, photo),
                    method: :delete,
                    class: "photo-delete-btn",
                    form: { style: "display:contents;", onsubmit: "return confirm('確定刪除這張照片？')" } %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<!-- Lightbox -->
<div id="lightbox" onclick="closeLightbox()" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.85); z-index:9999; align-items:center; justify-content:center;">
  <img id="lightbox-img" src="" alt="" style="max-width:90vw; max-height:90vh; border-radius:10px; box-shadow:0 4px 32px rgba(0,0,0,0.5);">
</div>

<%# Cloudinary Upload Widget %>
<script src="https://upload-widget.cloudinary.com/global/all.js" type="text/javascript"></script>
<script>
  var uploadWidget = cloudinary.createUploadWidget({
    cloudName: "<%= Rails.application.credentials.dig(:cloudinary, :cloud_name) %>",
    uploadPreset: "ml_default",
    multiple: true,
    maxFiles: 20,
    sources: ["local", "camera"],
    language: "zh_TW"
  }, function(error, result) {
    if (!error && result && result.event === "success") {
      var info = result.info;

      fetch("<%= customer_album_photos_path(@customer, @album) %>", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({
          photo: {
            cloudinary_public_id: info.public_id,
            url: info.secure_url,
            caption: info.original_filename
          }
        })
      });
    }

    if (result && result.event === "display-changed" && result.info === "hidden") {
      location.reload();
    }
  });

  document.getElementById("upload_btn").addEventListener("click", function() {
    uploadWidget.open();
  });

  function openLightbox(url, caption) {
    var lb = document.getElementById('lightbox');
    document.getElementById('lightbox-img').src = url;
    lb.style.display = 'flex';
  }
  function closeLightbox() {
    document.getElementById('lightbox').style.display = 'none';
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeLightbox();
  });
</script>

<style>
.photo-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 12px;
}
.photo-item {
  position: relative;
  border-radius: 8px;
  overflow: hidden;
  aspect-ratio: 1;
  background: #f3f4f6;
}
.photo-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.photo-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: flex-end;
  padding: 8px;
  transition: background 0.2s;
}
.photo-item:hover .photo-overlay {
  background: rgba(0,0,0,0.35);
}
.photo-caption {
  position: absolute;
  bottom: 30px;
  left: 8px;
  right: 8px;
  color: #fff;
  font-size: 11px;
  opacity: 0;
  transition: opacity 0.2s;
}
.photo-item:hover .photo-caption { opacity: 1; }
.photo-delete-btn {
  background: rgba(239,68,68,0.85);
  color: #fff;
  border: none;
  border-radius: 6px;
  padding: 4px 8px;
  font-size: 13px;
  cursor: pointer;
  text-decoration: none;
  transition: opacity 0.2s;
}
.btn-back {
  display: inline-block;
  margin-bottom: 16px;
  color: #6366f1;
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
}
.photo-actions {
  display: flex;
  gap: 6px;
  opacity: 0;
  transition: opacity 0.2s;
}
.photo-item:hover .photo-actions { opacity: 1; }
.photo-preview-btn {
  background: rgba(99,102,241,0.85);
  color: #fff;
  border: none;
  border-radius: 6px;
  padding: 4px 8px;
  font-size: 13px;
  cursor: pointer;
}
</style>