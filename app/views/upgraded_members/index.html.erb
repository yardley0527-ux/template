<%# app/views/upgraded_members/index.html.erb %>
<% content_for :page_title, "升級名單" %>

<div class="subheader">
  <h1 class="subheader-title">
    <i class="subheader-icon fal fa-arrow-up"></i>
    升級名單
    <small>每次會員報表匯入後，自動記錄當次升級為白卡／銀卡／金卡／黑卡的會員</small>
  </h1>
</div>

<div class="row">
  <div class="col-12">
    <div class="panel">
      <div class="panel-container show">
        <div class="panel-content">

          <%# 卡別統計卡片：今天新增的升級人數，點下去可篩選下方名單 %>
          <div class="um-level-grid mb-4">
            <% UpgradedMembersController::TARGET_LEVELS.each do |level| %>
              <a href="<%= upgraded_members_path(level: level) %>"
                 class="um-level-card <%= @selected_level == level ? 'is-active' : '' %>">
                <span class="um-level-badge um-level-<%= level.delete('卡') %>"><%= level %></span>
                <div class="um-level-count"><%= number_with_delimiter(@period_counts["今天"][level]) %></div>
                <div class="um-level-label">今天升級人數</div>
              </a>
            <% end %>
          </div>

          <%# 本週／本月／本年累計：各期間都是「該期間第一天到今天」的累計人數 %>
          <div class="um-table-wrap mb-4">
            <table class="um-table">
              <thead>
                <tr>
                  <th>卡別</th>
                  <% UpgradedMembersController::PERIODS.each_key do |label| %>
                    <th class="um-nowrap um-text-end"><%= label %></th>
                  <% end %>
                </tr>
              </thead>
              <tbody>
                <% UpgradedMembersController::TARGET_LEVELS.each do |level| %>
                  <tr>
                    <td><span class="um-level fp-level-<%= level.delete('卡') %>"><%= level %></span></td>
                    <% UpgradedMembersController::PERIODS.each_key do |label| %>
                      <td class="um-nowrap um-text-end"><%= number_with_delimiter(@period_counts[label][level]) %> 人</td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <div class="um-filter-bar mb-3">
            <span class="um-filter-meta">
              <% if @selected_level %>
                目前篩選：<span class="um-level fp-level-<%= @selected_level.delete('卡') %>"><%= @selected_level %></span>
                <%= link_to "清除篩選", upgraded_members_path, class: "um-clear-link" %>
              <% else %>
                顯示全部卡別的歷史升級名單
              <% end %>
            </span>
          </div>

          <% if @lists.empty? %>
            <div class="um-empty-hint">
              <% if @selected_level %>
                目前還沒有<%= @selected_level %>的升級名單紀錄。
              <% else %>
                目前還沒有任何升級名單紀錄——下一次會員報表匯入若偵測到升級，會自動在這裡出現。
              <% end %>
            </div>
          <% else %>
            <div class="um-table-wrap">
              <table class="um-table">
                <thead>
                  <tr>
                    <th>日期</th>
                    <th>升級卡別</th>
                    <th class="um-nowrap">人數</th>
                    <th>操作</th>
                  </tr>
                </thead>
                <tbody>
                  <% @lists.each do |list| %>
                    <tr>
                      <td class="um-nowrap"><%= list.sent_on.strftime("%Y/%-m/%-d") %></td>
                      <td><span class="um-level fp-level-<%= list.target_product.delete('卡') %>"><%= list.target_product %></span></td>
                      <td class="um-nowrap"><%= number_with_delimiter(@recipient_counts.fetch(list.id, 0)) %> 人</td>
                      <td class="um-nowrap">
                        <%= link_to "檢視", message_list_path(list), class: "um-btn-link" %>
                        <%= link_to "匯出", export_message_list_path(list), class: "um-btn-link" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>

        </div>
      </div>
    </div>
  </div>
</div>

<style>
.um-level-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
.um-level-card { background: #fff; border: 1.5px solid #e5e7eb; border-radius: 10px; padding: 16px 20px; text-decoration: none; color: inherit; transition: border-color 0.15s, box-shadow 0.15s; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
.um-level-card:hover { border-color: #6b7280; box-shadow: 0 0 0 3px rgba(107,114,128,.1); }
.um-level-card.is-active { border-color: #374151; background: #f9fafb; box-shadow: 0 0 0 3px rgba(55,65,81,.08); }
.um-level-count { font-size: 28px; font-weight: 800; color: #111827; line-height: 1; }
.um-level-label { font-size: 11px; color: #9ca3af; }

.um-level-badge { font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 99px; }
.um-level-白 { background: #f3f4f6; color: #374151; }
.um-level-銀 { background: #9ca3af; color: #fff; }
.um-level-金 { background: #d97706; color: #fff; }
.um-level-黑 { background: #1f2937; color: #fff; }

.um-level { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 99px; }
.fp-level-白 { background: #f3f4f6; color: #374151; }
.fp-level-銀 { background: #9ca3af; color: #fff; }
.fp-level-金 { background: #d97706; color: #fff; }
.fp-level-黑 { background: #1f2937; color: #fff; }

.um-filter-bar { background: #f8f9fa; border: 1px solid #e5e7eb; border-radius: 8px; padding: 12px 16px; }
.um-filter-meta { font-size: 13px; color: #6b7280; }
.um-clear-link { margin-left: 10px; font-size: 12px; color: #374151; }

.um-table-wrap { overflow-x: auto; border-radius: 8px; border: 1px solid #e5e7eb; background: #fff; }
.um-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.um-table thead th { background: #374151; color: #fff; padding: 10px 14px; text-align: left; font-weight: 600; font-size: 12px; white-space: nowrap; }
.um-table tbody td { padding: 10px 14px; border-bottom: 1px solid #f3f4f6; vertical-align: middle; }
.um-table tbody tr:last-child td { border-bottom: none; }
.um-table tbody tr:hover td { background: #f9fafb; }
.um-nowrap { white-space: nowrap; }
.um-text-end { text-align: right; }
.um-btn-link { font-size: 12px; color: #374151; text-decoration: none; margin-right: 12px; font-weight: 600; }
.um-btn-link:hover { color: #1f2937; text-decoration: underline; }

.um-empty-hint { text-align: center; color: #9ca3af; padding: 60px 20px; font-size: 14px; background: #fafafa; border: 1px dashed #e5e7eb; border-radius: 10px; }

@media (max-width: 768px) {
  .um-level-grid { grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .um-level-card { padding: 12px; }
  .um-level-count { font-size: 22px; }
}
</style>
