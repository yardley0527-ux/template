<%# app/views/upgraded_members/index.html.erb %>
<% content_for :page_title, "升級名單" %>

<div class="subheader">
  <h1 class="subheader-title">
    <i class="subheader-icon fal fa-arrow-up"></i>
    升級名單
    <small>每次會員報表匯入後，自動記錄當次升級為白卡／銀卡／金卡／黑卡的會員</small>
  </h1>
</div>

<div class="row">
  <div class="col-12">
    <div class="panel">
      <div class="panel-container show">
        <div class="panel-content">

          <%# 卡別統計卡片：今天新增的升級人數，點下去可篩選下方名單 %>
          <div class="um-level-grid mb-4">
            <% UpgradedMembersController::TARGET_LEVELS.each do |level| %>
              <a href="<%= upgraded_members_path(level: level, month: @selected_month, day: @selected_day&.iso8601) %>"
                 class="um-level-card <%= @selected_level == level ? 'is-active' : '' %>">
                <span class="um-level-badge um-level-<%= level.delete('卡') %>"><%= level %></span>
                <div class="um-level-count"><%= number_with_delimiter(@period_counts["今天"][level]) %></div>
                <div class="um-level-label">今天升級人數</div>
              </a>
            <% end %>
          </div>

          <%# 本週／本月／本年累計：各期間都是「該期間第一天到今天」的累計人數 %>
          <div class="um-table-title">升級人數（依名單傳送日）</div>
          <div class="um-table-wrap mb-4">
            <table class="um-table">
              <thead>
                <tr>
                  <th>卡別</th>
                  <% UpgradedMembersController::PERIODS.each_key do |label| %>
                    <th class="um-nowrap um-text-end"><%= label %><span class="um-period-range">(<%= @period_range_labels[label] %>)</span></th>
                  <% end %>
                </tr>
              </thead>
              <tbody>
                <% UpgradedMembersController::TARGET_LEVELS.each do |level| %>
                  <tr>
                    <td><span class="um-level fp-level-<%= level.delete('卡') %>"><%= level %></span></td>
                    <% UpgradedMembersController::PERIODS.each_key do |label| %>
                      <td class="um-nowrap um-text-end"><%= number_with_delimiter(@period_counts[label][level]) %> 人</td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <%# 有被維護過的人數：依「維護日期」落在哪個期間計算，不是依名單傳送日 %>
          <div class="um-table-title">已維護人數（依維護日期）</div>
          <div class="um-table-wrap mb-4">
            <table class="um-table">
              <thead>
                <tr>
                  <th>卡別</th>
                  <% UpgradedMembersController::PERIODS.each_key do |label| %>
                    <th class="um-nowrap um-text-end"><%= label %><span class="um-period-range">(<%= @period_range_labels[label] %>)</span></th>
                  <% end %>
                </tr>
              </thead>
              <tbody>
                <% UpgradedMembersController::TARGET_LEVELS.each do |level| %>
                  <tr>
                    <td><span class="um-level fp-level-<%= level.delete('卡') %>"><%= level %></span></td>
                    <% UpgradedMembersController::PERIODS.each_key do |label| %>
                      <td class="um-nowrap um-text-end"><%= number_with_delimiter(@maintenance_period_counts[label][level]) %> 人</td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <%# 維護內容成效：員工在「本次維護」勾了什麼、什麼時候維護的、維護後有沒有回購。
              時間篩選跟上面「已維護人數」同一套 PERIODS（累計到今天），選哪個區間下面就只算那個區間內維護的人。 %>
          <div class="um-table-title">維護內容成效（依維護日期，可切換時間區間）</div>
          <div class="um-content-card mb-4">
            <div class="um-period-tabs mb-3">
              <% UpgradedMembersController::PERIODS.each_key do |label| %>
                <a href="<%= upgraded_members_path(content_window: label, level: @selected_level, month: @selected_month, day: @selected_day&.iso8601) %>"
                   class="um-period-tab <%= @content_window == label ? 'is-active' : '' %>">
                  <%= label %> (<%= @period_range_labels[label] %>)
                </a>
              <% end %>
            </div>

            <div class="um-kpi-row mb-3">
              <div class="um-kpi-card">
                <div class="um-kpi-label">已維護人數（<%= @content_window %>，不重複）</div>
                <div class="um-kpi-value"><%= number_with_delimiter(@content_stats[:total]) %></div>
              </div>
              <div class="um-kpi-card">
                <div class="um-kpi-label">維護後回購人數</div>
                <div class="um-kpi-value"><%= number_with_delimiter(@content_stats[:repurchased]) %></div>
              </div>
              <div class="um-kpi-card">
                <div class="um-kpi-label">整體回購率</div>
                <div class="um-kpi-value um-kpi-accent"><%= @content_stats[:total].zero? ? "—" : "#{@content_stats[:rate].round}%" %></div>
              </div>
            </div>

            <% if @content_stats[:total].zero? %>
              <div class="um-empty-hint">這個時間區間還沒有人被填過維護紀錄。</div>
            <% else %>
              <% max_rate = [@content_stats[:by_field].map { |h| h[:rate] }.max.to_f, 1.0].max %>
              <div class="um-bar-list">
                <% @content_stats[:by_field].each do |stat| %>
                  <div class="um-bar-row">
                    <div class="um-bar-label"><%= stat[:label] %></div>
                    <div class="um-bar-track"><div class="um-bar-fill" style="width: <%= (stat[:rate] / max_rate * 100).round(1) %>%;"></div></div>
                    <div class="um-bar-pct"><%= stat[:rate].round %>%</div>
                    <div class="um-bar-sub">已標記 <%= stat[:total] %>人・回購 <%= stat[:repurchased] %>人</div>
                  </div>
                <% end %>
              </div>
              <div class="um-bar-note">＊同一位客人可能同時被勾選多個項目，5 列人數各自獨立，加總會超過上面的已維護總人數，不是切一塊餅圖的概念</div>
            <% end %>
          </div>

          <% if @available_months.any? %>
            <div class="um-month-tabs mb-3">
              <% @available_months.each do |month| %>
                <% y, m = month.split("-") %>
                <a href="<%= upgraded_members_path(level: @selected_level, month: month) %>"
                   class="um-month-tab <%= @selected_month == month ? 'is-active' : '' %>">
                  <%= y %>年<%= m.to_i %>月
                </a>
              <% end %>
            </div>
          <% end %>

          <% if @available_days.any? %>
            <div class="um-day-tabs mb-3">
              <% @available_days.each do |day| %>
                <a href="<%= upgraded_members_path(level: @selected_level, month: @selected_month, day: day.iso8601) %>"
                   class="um-day-tab <%= @selected_day == day ? 'is-active' : '' %>">
                  <%= day.strftime("%-m/%-d") %>
                </a>
              <% end %>
            </div>
          <% end %>

          <div class="um-filter-bar mb-3">
            <span class="um-filter-meta">
              <%= @selected_day&.strftime("%Y/%-m/%-d") %>
              <% if @selected_level %>
                ・目前篩選：<span class="um-level fp-level-<%= @selected_level.delete('卡') %>"><%= @selected_level %></span>
                <%= link_to "清除卡別篩選", upgraded_members_path(month: @selected_month, day: @selected_day&.iso8601), class: "um-clear-link" %>
              <% else %>
                ・顯示這天全部卡別的升級名單
              <% end %>
            </span>
          </div>

          <% if @lists.empty? %>
            <div class="um-empty-hint">
              <% if @selected_level %>
                這天還沒有<%= @selected_level %>的升級名單紀錄。
              <% else %>
                這天還沒有任何升級名單紀錄。
              <% end %>
            </div>
          <% else %>
            <div class="um-table-wrap">
              <table class="um-table">
                <thead>
                  <tr>
                    <th>升級卡別</th>
                    <th class="um-nowrap">人數</th>
                    <th>操作</th>
                  </tr>
                </thead>
                <tbody>
                  <% @lists.each do |list| %>
                    <tr>
                      <td><span class="um-level fp-level-<%= list.target_product.delete('卡') %>"><%= list.target_product %></span></td>
                      <td class="um-nowrap"><%= number_with_delimiter(@recipient_counts.fetch(list.id, 0)) %> 人</td>
                      <td class="um-nowrap">
                        <%= link_to "檢視", message_list_path(list), class: "um-btn-link" %>
                        <%= link_to "匯出", export_message_list_path(list), class: "um-btn-link" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>

        </div>
      </div>
    </div>
  </div>
</div>

<style>
.um-level-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
.um-level-card { background: #fff; border: 1.5px solid #e5e7eb; border-radius: 10px; padding: 16px 20px; text-decoration: none; color: inherit; transition: border-color 0.15s, box-shadow 0.15s; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
.um-level-card:hover { border-color: #6b7280; box-shadow: 0 0 0 3px rgba(107,114,128,.1); }
.um-level-card.is-active { border-color: #374151; background: #f9fafb; box-shadow: 0 0 0 3px rgba(55,65,81,.08); }
.um-level-count { font-size: 28px; font-weight: 800; color: #111827; line-height: 1; }
.um-level-label { font-size: 11px; color: #9ca3af; }

.um-level-badge { font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 99px; }
.um-level-白 { background: #f3f4f6; color: #374151; }
.um-level-銀 { background: #9ca3af; color: #fff; }
.um-level-金 { background: #d97706; color: #fff; }
.um-level-黑 { background: #1f2937; color: #fff; }

.um-level { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 99px; }
.fp-level-白 { background: #f3f4f6; color: #374151; }
.fp-level-銀 { background: #9ca3af; color: #fff; }
.fp-level-金 { background: #d97706; color: #fff; }
.fp-level-黑 { background: #1f2937; color: #fff; }

.um-month-tabs { display: flex; flex-wrap: wrap; gap: 6px; border-bottom: 1px solid #e5e7eb; padding-bottom: 10px; }
.um-month-tab { font-size: 13px; font-weight: 600; color: #6b7280; padding: 6px 14px; border-radius: 99px; text-decoration: none; background: #f3f4f6; white-space: nowrap; }
.um-month-tab:hover { background: #e5e7eb; color: #374151; }
.um-month-tab.is-active { background: #374151; color: #fff; }

.um-day-tabs { display: flex; flex-wrap: wrap; gap: 5px; }
.um-day-tab { font-size: 12px; font-weight: 600; color: #6b7280; padding: 5px 11px; border-radius: 6px; text-decoration: none; background: #fff; border: 1px solid #e5e7eb; white-space: nowrap; }
.um-day-tab:hover { border-color: #9ca3af; color: #374151; }
.um-day-tab.is-active { background: #8f6340; border-color: #8f6340; color: #fff; }

.um-filter-bar { background: #f8f9fa; border: 1px solid #e5e7eb; border-radius: 8px; padding: 12px 16px; }
.um-filter-meta { font-size: 13px; color: #6b7280; }
.um-clear-link { margin-left: 10px; font-size: 12px; color: #374151; }

.um-table-title { font-size: 13px; font-weight: 700; color: #374151; margin-bottom: 6px; }
.um-period-range { display: block; font-size: 10px; font-weight: 400; color: #d1d5db; margin-top: 2px; }
.um-table-wrap { overflow-x: auto; border-radius: 8px; border: 1px solid #e5e7eb; background: #fff; }
.um-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.um-table thead th { background: #374151; color: #fff; padding: 10px 14px; text-align: left; font-weight: 600; font-size: 12px; white-space: nowrap; }
.um-table tbody td { padding: 10px 14px; border-bottom: 1px solid #f3f4f6; vertical-align: middle; }
.um-table tbody tr:last-child td { border-bottom: none; }
.um-table tbody tr:hover td { background: #f9fafb; }
.um-nowrap { white-space: nowrap; }
.um-text-end { text-align: right; }
.um-btn-link { font-size: 12px; color: #374151; text-decoration: none; margin-right: 12px; font-weight: 600; }
.um-btn-link:hover { color: #1f2937; text-decoration: underline; }

.um-empty-hint { text-align: center; color: #9ca3af; padding: 60px 20px; font-size: 14px; background: #fafafa; border: 1px dashed #e5e7eb; border-radius: 10px; }

.um-content-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px 24px; }
.um-period-tabs { display: flex; flex-wrap: wrap; gap: 6px; }
.um-period-tab { font-size: 12px; font-weight: 600; color: #6b7280; padding: 6px 14px; border-radius: 99px; text-decoration: none; background: #f3f4f6; white-space: nowrap; }
.um-period-tab:hover { background: #e5e7eb; color: #374151; }
.um-period-tab.is-active { background: #8f6340; color: #fff; }

.um-kpi-row { display: flex; gap: 12px; }
.um-kpi-card { flex: 1; background: #faf9f5; border: 1px solid #f0e9dc; border-radius: 8px; padding: 12px 16px; }
.um-kpi-label { font-size: 11px; color: #9ca3af; font-weight: 600; }
.um-kpi-value { font-size: 22px; font-weight: 800; color: #111827; margin-top: 2px; }
.um-kpi-accent { color: #8f6340; }

.um-bar-list { display: flex; flex-direction: column; gap: 12px; }
.um-bar-row { display: flex; align-items: center; gap: 12px; }
.um-bar-label { width: 84px; flex-shrink: 0; text-align: right; font-size: 13px; font-weight: 700; color: #374151; }
.um-bar-track { flex-grow: 1; height: 22px; background: #f3f4f6; border-radius: 6px; overflow: hidden; }
.um-bar-fill { height: 100%; background: #8f6340; border-radius: 6px; }
.um-bar-pct { width: 42px; flex-shrink: 0; font-size: 13px; font-weight: 800; color: #8f6340; }
.um-bar-sub { width: 160px; flex-shrink: 0; font-size: 11px; color: #9ca3af; }
.um-bar-note { font-size: 11px; color: #9ca3af; margin-top: 12px; }

@media (max-width: 768px) {
  .um-level-grid { grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .um-level-card { padding: 12px; }
  .um-level-count { font-size: 22px; }
}
</style>
