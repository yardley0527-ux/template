<% content_for :page_title, "Threads 熱門貼文" %>

<div class="row g-3 mb-3">
  <div class="col-12 d-flex justify-content-between align-items-center">
    <div>
      <h4 class="fw-bold mb-0">Threads 熱門貼文</h4>
      <p class="text-muted small mb-0">
        監控關鍵字：益生菌、膠原蛋白、美白、抗老化、魚油⋯等 12 個保健詞
        <% if @last_fetched %>
          ・最後更新：<%= @last_fetched.in_time_zone("Asia/Taipei").strftime("%Y-%m-%d %H:%M") %>
        <% end %>
      </p>
    </div>
    <%= button_to "🔄 更新資料", threads_dashboard_refresh_path, method: :post,
          class: "btn btn-primary btn-sm",
          data: { confirm: "將呼叫 API 爬取最新資料並執行 AI 分析，約需 60–120 秒，確認繼續？" } %>
  </div>
</div>

<% if flash[:notice] %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= flash[:notice] %>
    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
  </div>
<% end %>
<% if flash[:alert] %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <%= flash[:alert] %>
    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
  </div>
<% end %>

<% if @posts.none? %>
  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
      <p class="text-muted mb-2">尚無資料，請按右上角「更新資料」按鈕先爬取一次。</p>
      <p class="text-muted small">需先設定環境變數 <code>APIFY_API_KEY</code>。</p>
    </div>
  </div>
<% else %>

<%# ── 今日統計卡片 ── %>
<div class="row g-3 mb-3">
  <% stats = [
    { label: "今日抓取",   value: @today_count,                         color: "#4a6fa5" },
    { label: "最高按讚",   value: number_with_delimiter(@posts.map(&:like_count).max.to_i),   color: "#dc3545" },
    { label: "最高留言",   value: number_with_delimiter(@posts.map(&:reply_count).max.to_i),  color: "#fd7e14" },
    { label: "監控關鍵字", value: @keywords.size,                         color: "#28a745" },
  ] %>
  <% stats.each do |s| %>
    <div class="col">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center py-3">
          <div class="fw-bold fs-4" style="color:<%= s[:color] %>;"><%= s[:value] %></div>
          <div class="text-muted small"><%= s[:label] %></div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<%# ── 分析區塊（AI 摘要 + 互動量圖表）── %>
<% if @analysis %>
<div class="row g-3 mb-3">

  <%# AI 摘要 %>
  <div class="col-lg-5">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white border-bottom-0 pb-0 pt-3 px-3 d-flex justify-content-between align-items-center">
        <div>
          <span class="fw-semibold" style="font-size:0.9rem;">🤖 AI 分析摘要</span>
          <span class="text-muted small ml-1">(<%= @analysis.fetched_on.strftime("%m/%d") %>)</span>
        </div>
        <%= button_to "重新產生", threads_dashboard_reanalyze_path, method: :post,
              class: "btn btn-outline-secondary btn-sm",
              style: "font-size:0.75rem; padding:2px 8px;" %>
      </div>
      <div class="card-body pt-2 px-3 pb-3">
        <% sections = @analysis.ai_summary.to_s.split(/\n\s*\n/).map(&:strip).reject(&:blank?) %>
        <% if sections.size >= 3 %>
          <% labels = [["可立即互動", "#e8f0fb", "#4a6fa5"], ["本週內容方向", "#fff3e0", "#e65100"], ["注意事項", "#e8f5e9", "#2e7d32"]] %>
          <% sections.first(3).each_with_index do |section, i| %>
            <% label, bg, color = labels[i] %>
            <div class="<%= i < 2 ? 'mb-2' : '' %>">
              <span class="badge mb-1" style="background:<%= bg %>; color:<%= color %>; font-size:0.7rem;"><%= label %></span>
              <ul class="mb-0 small text-dark ps-3" style="line-height:1.6;">
                <% section.split("\n").map { |l| l.strip.sub(/\A[・\-•]\s*/, "") }.reject(&:blank?).each do |item| %>
                  <li><%= item %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
        <% else %>
          <p class="small text-muted mb-0" style="line-height:1.7;"><%= @analysis.ai_summary %></p>
        <% end %>
      </div>
    </div>
  </div>

  <%# 互動量圖表 %>
  <div class="col-lg-7">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white border-bottom-0 pb-0 pt-3 px-3">
        <span class="fw-semibold" style="font-size:0.9rem;">📊 各關鍵字互動量分布</span>
        <span class="text-muted small ms-2">(likes + replies×2 + reposts)</span>
      </div>
      <div class="card-body pt-1 px-3 pb-2">
        <canvas id="keywordEngagementChart" style="max-height:200px;"></canvas>
      </div>
    </div>
  </div>

</div>

<% chart_stats = @analysis.stats_json.is_a?(Array) ? @analysis.stats_json : [] %>
<% if chart_stats.any? %>
<% content_for :scripts_block do %>
<script>
(function() {
  var labels = <%= raw chart_stats.map { |s| s["keyword"] || s[:keyword] }.to_json %>;
  var engagements = <%= raw chart_stats.map { |s| s["total_engagement"] || s[:total_engagement] }.to_json %>;
  var counts = <%= raw chart_stats.map { |s| s["count"] || s[:count] }.to_json %>;

  var colors = [
    "#4a6fa5","#dc3545","#fd7e14","#28a745",
    "#6f42c1","#17a2b8","#e83e8c","#20c997",
    "#ffc107","#6c757d","#343a40","#007bff"
  ];

  var ctx = document.getElementById("keywordEngagementChart");
  if (!ctx) return;

  new Chart(ctx, {
    type: "bar",
    data: {
      labels: labels,
      datasets: [{
        label: "總互動分數",
        data: engagements,
        backgroundColor: colors.slice(0, labels.length),
        borderRadius: 4,
        borderSkipped: false,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: true,
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            afterLabel: function(ctx) {
              return "貼文數：" + counts[ctx.dataIndex];
            }
          }
        }
      },
      scales: {
        x: {
          grid: { display: false },
          ticks: { font: { size: 11 } }
        },
        y: {
          beginAtZero: true,
          grid: { color: "#f0f0f0" },
          ticks: { font: { size: 11 } }
        }
      }
    }
  });
})();
</script>
<% end %>
<% end %>
<% end %>

<%# ── 關鍵字 filter tabs（按類別分組）── %>
<% category_colors = {
     "代謝瘦身" => "#dc3545", "腸道排便" => "#28a745", "美白抗老" => "#9c27b0",
     "私密保養" => "#e91e8c", "眼睛保健" => "#2196f3", "肝臟護肝" => "#e65100",
     "魚油心血管" => "#00838f", "睡眠疲勞" => "#3f51b5", "皮膚保養" => "#c2185b",
     "骨骼保健" => "#5d4037",
   } %>
<div class="card border-0 shadow-sm mb-3">
  <div class="card-body py-2 px-3">

    <div class="mb-2">
      <%= link_to "全部", threads_dashboard_path,
            class: "btn btn-sm #{@active_keyword.blank? ? 'btn-dark' : 'btn-outline-secondary'}" %>
    </div>

    <% @keyword_categories.each do |category, kws| %>
      <% color = category_colors[category] || "#6c757d" %>
      <div class="mb-1">
        <span style="display:inline-block; background:<%= color %>; color:#fff; font-size:0.7rem; font-weight:600; padding:1px 7px; border-radius:3px; margin-right:4px; vertical-align:middle; white-space:nowrap;"><%= category %></span>
        <% kws.each do |kw| %>
          <% active = @active_keyword == kw %>
          <%= link_to kw, threads_dashboard_path(keyword: kw), style: "display:inline-block; margin:2px 3px 2px 0; padding:1px 9px; font-size:0.82rem; border-radius:4px; text-decoration:none; vertical-align:middle; white-space:nowrap; #{active ? "background:#{color}; color:#fff; border:1px solid #{color};" : "background:#fff; color:#333; border:1px solid #ccc;"}" %>
        <% end %>
      </div>
    <% end %>

  </div>
</div>

<%# ── 貼文列表 ── %>
<div class="card border-0 shadow-sm">
  <div class="card-body p-0 table-responsive">
    <table class="table align-middle mb-0" style="font-size:0.88rem;">
      <thead style="background:#f8f9fa;">
        <tr>
          <th class="ps-3" style="width:80px;">關鍵字</th>
          <th style="width:120px;">作者</th>
          <th>內容</th>
          <th class="text-center" style="width:70px;">❤️ 按讚</th>
          <th class="text-center" style="width:70px;">💬 留言</th>
          <th class="text-center" style="width:70px;">🔁 轉貼</th>
          <th class="text-center" style="width:90px;">發文時間</th>
          <th style="width:70px;"></th>
        </tr>
      </thead>
      <tbody>
        <% @posts.each do |post| %>
          <tr>
            <td class="ps-3">
              <% if post.keyword.present? %>
                <span class="badge badge-info" style="font-size:0.75rem;"><%= post.keyword %></span>
              <% end %>
            </td>
            <td>
              <div class="fw-semibold text-truncate" style="max-width:110px;" title="<%= post.full_name %>">
                <%= post.full_name.presence || post.username %>
              </div>
              <div class="text-muted small">@<%= post.username %></div>
            </td>
            <td>
              <span class="d-block" style="max-width:420px; white-space:pre-wrap; overflow:hidden; display:-webkit-box !important; -webkit-line-clamp:2; -webkit-box-orient:vertical;">
                <%= post.text_content.to_s.presence || "（無文字）" %>
              </span>
            </td>
            <td class="text-center fw-semibold text-danger"><%= number_with_delimiter(post.like_count) %></td>
            <td class="text-center fw-semibold text-secondary"><%= number_with_delimiter(post.reply_count) %></td>
            <td class="text-center fw-semibold" style="color:#6f42c1;"><%= number_with_delimiter(post.repost_count) %></td>
            <td class="text-center text-muted small">
              <%= post.posted_at ? post.posted_at.in_time_zone("Asia/Taipei").strftime("%m/%d %H:%M") : "—" %>
            </td>
            <td>
              <% if post.post_url.present? %>
                <a href="<%= post.post_url %>" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-xs">
                  留言 →
                </a>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% end %>
