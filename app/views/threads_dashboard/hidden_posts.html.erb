<% content_for :page_title, "已刪除貼文" %>

<div class="row g-3 mb-3">
  <div class="col-12 d-flex justify-content-between align-items-center">
    <h4 class="fw-bold mb-0">已刪除（隱藏）貼文</h4>
    <%= link_to "← 回到主面板", threads_dashboard_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>
</div>

<% if flash[:notice] %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= flash[:notice] %>
    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
  </div>
<% end %>

<% if @posts.none? %>
  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
      <p class="text-muted mb-0">目前沒有已刪除的貼文。</p>
    </div>
  </div>
<% else %>
<div class="card border-0 shadow-sm">
  <div class="card-body p-0 table-responsive">
    <table class="table align-middle mb-0" style="font-size:0.88rem;">
      <thead style="background:#f8f9fa;">
        <tr>
          <th class="ps-3" style="width:80px;">關鍵字</th>
          <th style="width:120px;">作者</th>
          <th style="width:420px;">內容</th>
          <th class="text-center" style="width:90px;">發文時間</th>
          <th class="text-center" style="width:90px;"></th>
        </tr>
      </thead>
      <tbody>
        <% @posts.each do |post| %>
          <tr>
            <td class="ps-3">
              <% if post.keyword.present? %>
                <span class="badge badge-info" style="font-size:0.75rem;"><%= post.keyword %></span>
              <% end %>
            </td>
            <td>
              <div class="fw-semibold text-truncate" style="max-width:110px;" title="<%= post.full_name %>">
                <%= post.full_name.presence || post.username %>
              </div>
              <div class="text-muted small">@<%= post.username %></div>
            </td>
            <td>
              <span class="d-block" style="max-width:420px; white-space:pre-wrap; overflow:hidden; display:-webkit-box !important; -webkit-line-clamp:2; -webkit-box-orient:vertical;">
                <%= post.text_content.to_s.presence || "（無文字）" %>
              </span>
            </td>
            <td class="text-center text-muted small">
              <%= post.posted_at ? post.posted_at.in_time_zone("Asia/Taipei").strftime("%m/%d %H:%M") : "—" %>
            </td>
            <td class="text-center">
              <%= button_to "復原", threads_dashboard_restore_post_path(post),
                    method: :patch,
                    form_class: "d-inline",
                    class: "btn btn-outline-success btn-xs",
                    style: "padding:2px 8px;" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<% end %>
