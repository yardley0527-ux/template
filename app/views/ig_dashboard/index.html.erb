<% content_for :page_title, "IG 帳號追蹤" %>

<div class="row g-3 mb-3">
  <div class="col-12 d-flex justify-content-between align-items-center">
    <div>
      <h4 class="fw-bold mb-0">IG 帳號追蹤</h4>
      <p class="text-muted small mb-0">@chloechao0527</p>
    </div>
    <%= button_to "🔄 更新資料", ig_dashboard_refresh_path, method: :post,
          class: "btn btn-primary btn-sm",
          data: { confirm: "將呼叫 Apify 爬取最新資料，約需 30–60 秒，確認繼續？" } %>
  </div>
</div>

<% if flash[:notice] %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= flash[:notice] %>
    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
  </div>
<% end %>
<% if flash[:alert] %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <%= flash[:alert] %>
    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
  </div>
<% end %>

<% if @profile.nil? %>
  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
      <i class="fal fa-instagram fa-3x text-muted mb-3 d-block"></i>
      <p class="text-muted">尚無資料，請按右上角「更新資料」按鈕先爬取一次。</p>
      <p class="text-muted small">需要先在環境變數設定 <code>APIFY_TOKEN</code>。</p>
    </div>
  </div>
<% else %>

<%# ── Profile Header ── %>
<div class="card border-0 shadow-sm mb-3">
  <div class="card-body">
    <div class="d-flex align-items-start gap-4">
      <% if @profile.profile_pic_url.present? %>
        <%= image_tag @profile.profile_pic_url, class: "rounded-circle flex-shrink-0",
              style: "width:72px;height:72px;object-fit:cover;" %>
      <% else %>
        <div class="rounded-circle bg-light flex-shrink-0 d-flex align-items-center justify-content-center"
             style="width:72px;height:72px;">
          <i class="fal fa-user fa-2x text-muted"></i>
        </div>
      <% end %>
      <div class="flex-grow-1">
        <div class="d-flex align-items-center gap-2 mb-1">
          <h5 class="fw-bold mb-0"><%= @profile.display_name.presence || "@#{@profile.username}" %></h5>
          <% if @profile.is_verified? %>
            <span class="badge badge-info">✅ 已認證</span>
          <% end %>
          <a href="<%= @profile.ig_url %>" target="_blank" class="btn btn-outline-secondary btn-xs">
            查看 IG →
          </a>
        </div>
        <p class="text-muted small mb-1">@<%= @profile.username %></p>
        <% if @profile.bio.present? %>
          <p class="mb-0 small" style="max-width:600px;"><%= @profile.bio %></p>
        <% end %>
        <% if @profile.last_scraped_at %>
          <p class="text-muted small mb-0 mt-1">
            最後更新：<%= @profile.last_scraped_at.in_time_zone("Asia/Taipei").strftime("%Y-%m-%d %H:%M") %>
          </p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%# ── Key Metrics Row ── %>
<div class="row g-3 mb-3">
  <% metrics = [
    { label: "粉絲數",   value: number_with_delimiter(@profile.follower_count), icon: "fa-users",       color: "#4a6fa5" },
    { label: "互動率",   value: "#{@profile.engagement_rate}%",                 icon: "fa-chart-line",  color: "#28a745" },
    { label: "平均按讚", value: number_with_delimiter(@profile.avg_likes.round), icon: "fa-heart",       color: "#dc3545" },
    { label: "平均留言", value: number_with_delimiter(@profile.avg_comments.round), icon: "fa-comment",  color: "#fd7e14" },
    { label: "總發文數", value: number_with_delimiter(@profile.post_count),      icon: "fa-images",      color: "#6f42c1" },
  ] %>
  <% metrics.each do |m| %>
    <div class="col">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center py-3">
          <div class="mb-1" style="font-size:1.5rem; color:<%= m[:color] %>;">
            <i class="fal <%= m[:icon] %>"></i>
          </div>
          <div class="fw-bold fs-5"><%= m[:value] %></div>
          <div class="text-muted small"><%= m[:label] %></div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<%# ── Charts Row ── %>
<% if @snapshots.size >= 2 || @posts.any? %>
<div class="row g-3 mb-3">
  <% if @snapshots.size >= 2 %>
  <div class="col-md-6">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white fw-bold border-0 pt-3 pb-0">粉絲數趨勢</div>
      <div class="card-body">
        <canvas id="followerChart" height="200"></canvas>
      </div>
    </div>
  </div>
  <% end %>
  <% if @posts.any? %>
  <div class="col-md-<%= @snapshots.size >= 2 ? 6 : 12 %>">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white fw-bold border-0 pt-3 pb-0">近期貼文互動（最新 <%= [12, @posts.size].min %> 篇）</div>
      <div class="card-body">
        <canvas id="engagementChart" height="200"></canvas>
      </div>
    </div>
  </div>
  <% end %>
</div>
<% end %>

<%# ── Recent Posts Table ── %>
<% if @posts.any? %>
<div class="card border-0 shadow-sm mb-3">
  <div class="card-header bg-white fw-bold border-0 pt-3 pb-0">近期貼文</div>
  <div class="card-body p-0 table-responsive">
    <table class="table align-middle mb-0" style="font-size:0.88rem;">
      <thead style="background:#f8f9fa;">
        <tr>
          <th class="ps-3">日期</th>
          <th class="text-center">按讚</th>
          <th class="text-center">留言</th>
          <th class="text-center">互動率</th>
          <th>內容預覽</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @posts.each do |post| %>
          <% post_er = @profile.follower_count > 0 ? ((post.likes + post.comments).to_f / @profile.follower_count * 100).round(2) : 0 %>
          <tr>
            <td class="ps-3 text-muted small">
              <%= post.posted_at ? post.posted_at.in_time_zone("Asia/Taipei").strftime("%m/%d") : "—" %>
            </td>
            <td class="text-center">
              <span class="text-danger">♥</span> <%= number_with_delimiter(post.likes) %>
            </td>
            <td class="text-center">
              <span class="text-secondary">💬</span> <%= number_with_delimiter(post.comments) %>
            </td>
            <td class="text-center">
              <span class="badge <%= post_er >= 3 ? 'badge-success' : post_er >= 1 ? 'badge-warning' : 'badge-secondary' %>">
                <%= post_er %>%
              </span>
            </td>
            <td style="max-width:300px;">
              <span class="text-truncate d-block" style="max-width:300px;" title="<%= post.caption %>">
                <%= post.caption.to_s.first(80).presence || "（無文字）" %>
              </span>
            </td>
            <td>
              <a href="<%= post.ig_url %>" target="_blank" class="btn btn-outline-secondary btn-xs">開啟 →</a>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<% end %>

<% end %>

<% content_for :scripts_block do %>
<script>
document.addEventListener("turbolinks:load", function () {
  <% if @snapshots&.size.to_i >= 2 %>
  (function () {
    var labels = <%= raw @snapshots.map { |s| s.snapshot_date.strftime("%m/%d") }.to_json %>;
    var data   = <%= raw @snapshots.map(&:follower_count).to_json %>;
    new window.Chart(document.getElementById("followerChart").getContext("2d"), {
      type: "line",
      data: {
        labels: labels,
        datasets: [{
          label: "粉絲數",
          data: data,
          borderColor: "#4a6fa5",
          backgroundColor: "rgba(74,111,165,0.1)",
          fill: true,
          tension: 0.3,
          pointRadius: 4,
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: false } }
      }
    });
  })();
  <% end %>

  <% if @posts&.any? %>
  (function () {
    var recent = <%= raw @posts.first(12).reverse.map { |p|
      { date: p.posted_at ? p.posted_at.in_time_zone("Asia/Taipei").strftime("%m/%d") : "—",
        likes: p.likes, comments: p.comments }
    }.to_json %>;
    var labels   = recent.map(function(p){ return p.date; });
    var likes    = recent.map(function(p){ return p.likes; });
    var comments = recent.map(function(p){ return p.comments; });
    new window.Chart(document.getElementById("engagementChart").getContext("2d"), {
      type: "bar",
      data: {
        labels: labels,
        datasets: [
          { label: "按讚", data: likes,    backgroundColor: "rgba(220,53,69,0.7)" },
          { label: "留言", data: comments, backgroundColor: "rgba(74,111,165,0.7)" }
        ]
      },
      options: {
        responsive: true,
        plugins: { legend: { position: "top" } },
        scales: { x: { stacked: false }, y: { beginAtZero: true } }
      }
    });
  })();
  <% end %>
});
</script>
<% end %>
