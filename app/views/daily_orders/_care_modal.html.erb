<%# 舊客總攬完成度小卡（CRM維護已讀／CRM維護未讀）共用的「已完成名單」modal
    locals: modal_id, title, field, done_count, care_applicable_rows, gift_records, export_path %>
<div class="modal fade" id="<%= modal_id %>" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><%= title %></h5>
        <div class="d-flex align-items-center" style="gap:8px;">
          <button type="button" class="care-copy-btn btn btn-sm btn-outline-secondary" data-flag="<%= field %>">
            <i class="fal fa-copy"></i> 複製名單
          </button>
          <%= link_to export_path, class: "btn btn-sm btn-outline-secondary" do %>
            <i class="fal fa-file-excel"></i> 匯出 Excel
          <% end %>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-left:0;"><span aria-hidden="true">&times;</span></button>
        </div>
      </div>
      <div class="modal-body p-0">
        <table class="table align-middle mb-0" style="font-size:0.86rem;">
          <thead style="background-color:#4a4a4a; color:white;">
            <tr>
              <th class="ps-3">姓名</th>
              <th>IG</th>
            </tr>
          </thead>
          <tbody>
            <% care_applicable_rows.each do |row| %>
              <% checked = gift_records[row.order_number]&.public_send(:"#{field}?") %>
              <% url = daily_orders_ig_link(row.ig_account) %>
              <tr class="care-modal-row" data-flag="<%= field %>" data-order="<%= row.order_number %>" data-name="<%= row.customer_name %>" data-ig="<%= url %>" style="<%= checked ? '' : 'display:none;' %>">
                <td class="ps-3 fw-semibold">
                  <% if row.shopline_customer_id %>
                    <%= link_to row.customer_name, customer_path(row.shopline_customer_id), class: "text-decoration-none" %>
                  <% else %>
                    <%= row.customer_name %>
                  <% end %>
                </td>
                <td>
                  <% if url %>
                    <%= link_to url, target: "_blank", class: "text-decoration-none d-flex align-items-center gap-1" do %>
                      <i class="fal fa-at text-danger flex-shrink-0"></i>
                      <span style="font-size:0.8rem;"><%= row.ig_account&.sub(/^@/, '') %></span>
                    <% end %>
                  <% else %>
                    <span class="text-muted small">—</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
            <tr class="care-modal-empty" data-flag="<%= field %>" style="<%= done_count.positive? ? 'display:none;' : '' %>">
              <td colspan="2" class="text-center text-muted py-4">目前尚無已完成名單</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
