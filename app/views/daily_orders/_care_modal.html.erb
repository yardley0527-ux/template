<%# 舊客總攬完成度小卡（CRM維護已讀／CRM維護未讀）共用的「已完成名單」modal
    locals: modal_id, title, field, done_count, care_applicable_rows, gift_records
    mark_read（選填）：true 時多一欄「標記已讀」按鈕，可直接把這筆從未讀改成已讀，不用回大表格找 %>
<% mark_read = local_assigns.fetch(:mark_read, false) %>
<div class="modal fade" id="<%= modal_id %>" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><%= title %></h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
      </div>
      <div class="modal-body p-0">
        <table class="table align-middle mb-0" style="font-size:0.86rem;">
          <thead style="background-color:#4a4a4a; color:white;">
            <tr>
              <th class="ps-3">姓名</th>
              <th>IG</th>
              <% if mark_read %>
                <th class="text-center" style="width:110px;">操作</th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% care_applicable_rows.each do |row| %>
              <% checked = gift_records[row.order_number]&.public_send(:"#{field}?") %>
              <% url = daily_orders_ig_link(row.ig_account) %>
              <tr class="care-modal-row" data-flag="<%= field %>" data-order="<%= row.order_number %>" style="<%= checked ? '' : 'display:none;' %>">
                <td class="ps-3 fw-semibold">
                  <% if row.shopline_customer_id %>
                    <%= link_to row.customer_name, customer_path(row.shopline_customer_id), class: "text-decoration-none" %>
                  <% else %>
                    <%= row.customer_name %>
                  <% end %>
                </td>
                <td>
                  <% if url %>
                    <%= link_to url, target: "_blank", class: "text-decoration-none d-flex align-items-center gap-1" do %>
                      <i class="fal fa-at text-danger flex-shrink-0"></i>
                      <span style="font-size:0.8rem;"><%= row.ig_account&.sub(/^@/, '') %></span>
                    <% end %>
                  <% else %>
                    <span class="text-muted small">—</span>
                  <% end %>
                </td>
                <% if mark_read %>
                  <td class="text-center">
                    <button type="button" class="mark-read-btn btn btn-sm btn-outline-success" data-order="<%= row.order_number %>">標記已讀</button>
                  </td>
                <% end %>
              </tr>
            <% end %>
            <tr class="care-modal-empty" data-flag="<%= field %>" style="<%= done_count.positive? ? 'display:none;' : '' %>">
              <td colspan="<%= mark_read ? 3 : 2 %>" class="text-center text-muted py-4">目前尚無已完成名單</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
