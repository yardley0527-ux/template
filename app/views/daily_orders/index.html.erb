<%# app/views/daily_orders/index.html.erb %>
<% content_for :page_title, "每日訂單報表" %>

<% def daily_orders_ig_link(account)
  return nil if account.blank?
  handle = account.strip.gsub(/^@/, '').gsub(%r{https?://(?:www\.)?instagram\.com/?}, '').gsub(%r{/$}, '').strip
  handle.present? ? "https://www.instagram.com/#{handle}/" : nil
end %>

<div class="row g-3 mb-3">
  <div class="col-12 d-flex align-items-center justify-content-between flex-wrap" style="gap:12px;">
    <div>
      <h4 class="fw-bold mb-0">每日訂單報表</h4>
      <p class="text-muted small mb-0">依新客／舊客卡別分類，協助出貨備貨</p>
    </div>
    <div class="d-flex align-items-center" style="gap:8px;">
      <%= form_tag daily_orders_path, method: :get, class: "d-flex align-items-center flex-wrap", style: "gap:8px;" do %>
        <%= hidden_field_tag :tab, @tab %>
        <input type="date" name="start_date" value="<%= @start_date.strftime('%Y-%m-%d') %>" class="form-control form-control-sm">
        <span class="text-muted small">至</span>
        <input type="date" name="end_date" value="<%= @end_date.strftime('%Y-%m-%d') %>" class="form-control form-control-sm">
        <button type="submit" class="btn btn-sm btn-primary">查詢</button>
      <% end %>
      <%= link_to "匯出 CSV", export_daily_orders_path(start_date: @start_date, end_date: @end_date), class: "btn btn-sm btn-outline-secondary" %>
    </div>
  </div>
</div>

<% total_count = @groups.sum { |_, rows| rows.size } %>
<p class="text-muted small mb-3">
  <% if @start_date == @end_date %>
    <%= @start_date.strftime('%Y/%m/%d') %>
  <% else %>
    <%= @start_date.strftime('%Y/%m/%d') %> ～ <%= @end_date.strftime('%Y/%m/%d') %>
  <% end %>
  共 <%= total_count %> 筆訂單
</p>

<%
  new_stat  = { count: @groups.first.last.size, amount: @groups.first.last.sum { |r| r.order_total.to_f } }
  old_stats = @groups.drop(1).map { |label, rows| { label: label, count: rows.size, amount: rows.sum { |r| r.order_total.to_f } } }
  old_count  = old_stats.sum { |s| s[:count] }
  old_amount = old_stats.sum { |s| s[:amount] }
  grand_count  = new_stat[:count] + old_count
  grand_amount = new_stat[:amount] + old_amount
  fmt_avg = ->(amount, count) { count > 0 ? "均 NT$#{number_with_delimiter((amount / count).to_i)}" : "—" }
  fmt_amt = ->(amount, count) { count > 0 ? "NT$#{number_with_delimiter(amount.to_i)}" : "—" }
%>

<%# ── 第一區：總覽 ── %>
<div class="row g-2 mb-3">
  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #adb5bd;">
      <div class="card-body py-3 px-3">
        <div class="text-muted mb-1" style="font-size:0.78rem;">今日訂單</div>
        <div class="fw-bold" style="font-size:1.6rem; line-height:1.1;"><%= grand_count %></div>
        <div class="text-muted small">單</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #e74c6f;">
      <div class="card-body py-3 px-3">
        <div class="text-muted mb-1" style="font-size:0.78rem;">今日營收</div>
        <div class="fw-bold text-danger" style="font-size:1.2rem; line-height:1.2;">NT$<%= number_with_delimiter(grand_amount.to_i) %></div>
        <div style="font-size:0.78rem; color:#666;"><%= fmt_avg.call(grand_amount, grand_count) %></div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #4a6fa5;">
      <div class="card-body py-3 px-3">
        <div class="d-flex align-items-center gap-1 mb-1">
          <span class="badge" style="background-color:#4a6fa5; font-size:0.7rem;">新客</span>
        </div>
        <div class="fw-bold" style="font-size:1.3rem;"><%= new_stat[:count] %> 單</div>
        <div class="fw-semibold small <%= new_stat[:count] > 0 ? 'text-danger' : 'text-muted' %>"><%= fmt_amt.call(new_stat[:amount], new_stat[:count]) %></div>
        <div style="font-size:0.78rem; color:#666;"><%= fmt_avg.call(new_stat[:amount], new_stat[:count]) %></div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #6c5f4e;">
      <div class="card-body py-3 px-3">
        <div class="d-flex align-items-center gap-1 mb-1">
          <span class="badge" style="background-color:#6c5f4e; font-size:0.7rem;">舊客</span>
        </div>
        <div class="fw-bold" style="font-size:1.3rem;"><%= old_count %> 單</div>
        <div class="fw-semibold small <%= old_count > 0 ? 'text-danger' : 'text-muted' %>"><%= fmt_amt.call(old_amount, old_count) %></div>
        <div style="font-size:0.78rem; color:#666;"><%= fmt_avg.call(old_amount, old_count) %></div>
      </div>
    </div>
  </div>
</div>

<%# ── 第二區：舊客會員分布 ── %>
<div class="card border-0 shadow-sm mb-3">
  <div class="card-header bg-white d-flex align-items-center py-2" style="border-bottom:2px solid #f0ede9;">
    <span class="fw-semibold" style="font-size:0.82rem; color:#6c757d; letter-spacing:0.03em;">舊客會員分布</span>
  </div>
  <div class="card-body p-0">
    <table class="table table-bordered mb-0" style="font-size:0.85rem;">
      <thead style="background-color:#6c5f4e; color:white;">
        <tr>
          <th class="py-2 ps-3" style="width:20%;">卡別</th>
          <th class="py-2 text-center" style="width:20%;">訂單數</th>
          <th class="py-2 text-center" style="width:30%;">營收</th>
          <th class="py-2 text-center" style="width:30%;">平均客單</th>
        </tr>
      </thead>
      <tbody>
        <% old_stats.each do |s| %>
          <% zero = s[:count] == 0 %>
          <tr style="<%= zero ? 'opacity:0.45; background:#fafafa;' : '' %>">
            <td class="py-2 ps-3 fw-semibold"><%= s[:label] %></td>
            <td class="py-2 text-center"><%= s[:count] %> 單</td>
            <td class="py-2 text-center fw-semibold <%= zero ? 'text-muted' : 'text-danger' %>">
              <%= fmt_amt.call(s[:amount], s[:count]) %>
            </td>
            <td class="py-2 text-center text-muted small"><%= fmt_avg.call(s[:amount], s[:count]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%# ── 第三區：熱銷商品 TOP 5 ── %>
<% if @product_stats.any? %>
<%
  rank_colors = { 1 => "#c9a227", 2 => "#9e9e9e", 3 => "#a0673a" }
  rank_bg     = ->(r) { rank_colors[r] || "#6c757d" }
%>
<div class="card border-0 shadow-sm mb-3">
  <div class="card-header bg-white py-2" style="border-bottom:2px solid #f0ede9;">
    <span class="fw-semibold" style="font-size:0.82rem; color:#6c757d; letter-spacing:0.03em;">熱銷商品 TOP 5</span>
  </div>
  <div class="card-body p-0">
    <% @product_stats.each_with_index do |p, idx| %>
      <% pid = "prod_breakdown_#{p[:rank]}" %>
      <div class="<%= idx < @product_stats.size - 1 ? 'border-bottom' : '' %>">
        <%# 商品摘要列 %>
        <div class="d-flex align-items-center px-3 py-2" style="gap:10px;">
          <div class="flex-shrink-0 fw-bold text-white text-center rounded-circle"
               style="width:26px;height:26px;line-height:26px;font-size:0.78rem;background:<%= rank_bg.call(p[:rank]) %>;">
            <%= p[:rank] %>
          </div>
          <div style="flex:1; min-width:0;">
            <div class="fw-semibold text-truncate" style="font-size:0.88rem;" title="<%= p[:name] %>"><%= p[:name] %></div>
            <div class="text-muted" style="font-size:0.74rem;">數量 <%= p[:quantity] %> | 訂單 <%= p[:order_count] %> 單</div>
            <div style="background:#f0f0f0; border-radius:2px; height:3px; margin-top:3px; width:100%;">
              <div style="background:#e74c6f; border-radius:2px; height:3px; width:<%= [p[:share], 100].min %>%;"></div>
            </div>
          </div>
          <div class="text-end flex-shrink-0" style="min-width:90px;">
            <div class="fw-bold text-danger" style="font-size:0.88rem;">NT$<%= number_with_delimiter(p[:amount].to_i) %></div>
            <div class="text-muted" style="font-size:0.74rem;"><%= p[:share] %>%</div>
          </div>
          <button class="prod-toggle btn btn-sm border flex-shrink-0"
                  data-target="<%= pid %>"
                  style="font-size:0.72rem; padding:2px 8px; color:#6c757d; white-space:nowrap;">
            展開 ▼
          </button>
        </div>
        <%# 客戶類型分布（預設隱藏） %>
        <div id="<%= pid %>" style="display:none; background:#f9f8f7;">
          <table class="table table-sm mb-0" style="font-size:0.8rem;">
            <thead>
              <tr style="background:#ede9e4;">
                <th class="ps-4 py-1 fw-normal text-muted" style="width:35%;">客戶類型</th>
                <th class="py-1 text-center fw-normal text-muted" style="width:25%;">訂單數</th>
                <th class="py-1 text-end pe-3 fw-normal text-muted" style="width:40%;">營業額</th>
              </tr>
            </thead>
            <tbody>
              <% p[:by_type].each do |bt| %>
                <% zero = bt[:order_count] == 0 %>
                <tr style="<%= zero ? 'opacity:0.4;' : '' %>">
                  <td class="ps-4 py-1 fw-semibold"><%= bt[:type] %></td>
                  <td class="py-1 text-center"><%= bt[:order_count] %> 單</td>
                  <td class="py-1 text-end pe-3 fw-semibold <%= zero ? 'text-muted' : 'text-danger' %>">
                    <%= zero ? "—" : "NT$#{number_with_delimiter(bt[:amount].to_i)}" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </div>
</div>
<% end %>

<ul class="nav nav-tabs mb-3" style="font-size:0.9rem;">
  <li class="nav-item">
    <%= link_to "新客（#{@new_count}）", daily_orders_path(start_date: @start_date, end_date: @end_date, tab: "new"), class: "nav-link #{@tab == 'new' ? 'active fw-bold' : 'text-muted'}" %>
  </li>
  <li class="nav-item">
    <%= link_to "舊客（#{@old_count}）", daily_orders_path(start_date: @start_date, end_date: @end_date, tab: "old"), class: "nav-link #{@tab == 'old' ? 'active fw-bold' : 'text-muted'}" %>
  </li>
</ul>

<% visible_groups = @tab == "new" ? @groups.first(1) : @groups.drop(1) %>

<% visible_groups.each do |label, rows| %>
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white d-flex align-items-center" style="gap:8px;">
      <span class="fw-bold"><%= label %></span>
      <% unless label == "新客" %>
        <span class="badge bg-secondary"><%= rows.size %></span>
      <% end %>
    </div>
    <div class="card-body p-0 table-responsive">
      <table class="table align-middle mb-0" style="font-size:0.86rem; table-layout:fixed; width:100%; min-width:1000px;">
        <% is_new = label == "新客" %>
        <thead style="background-color:#4a4a4a; color:white;">
          <tr>
            <th class="ps-3" style="width:12%;">訂單號碼</th>
            <th style="width:9%;">姓名</th>
            <th style="width:11%;">IG</th>
            <th class="text-end" style="width:9%;">消費金額</th>
            <th style="width:<%= is_new ? 27 : 30 %>%;">是否購買過同產品</th>
            <th style="width:<%= is_new ? 25 : 29 %>%;">健康資料</th>
            <% if is_new %>
              <th class="text-center" style="width:7%;">綁定 LINE</th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% rows.each do |row| %>
            <% url = daily_orders_ig_link(row.ig_account) %>
            <tr>
              <td class="ps-3 text-muted small"><%= row.order_number %></td>
              <td class="fw-semibold"><%= row.customer_name %></td>
              <td style="overflow:hidden;">
                <% if url %>
                  <%= link_to url, target: "_blank", class: "text-decoration-none d-flex align-items-center gap-1", style: "overflow:hidden;" do %>
                    <i class="fal fa-at text-danger flex-shrink-0"></i>
                    <span style="font-size:0.8rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= row.ig_account&.sub(/^@/, '') %></span>
                  <% end %>
                <% else %>
                  <span class="text-muted small">—</span>
                <% end %>
              </td>
              <td class="text-end fw-bold text-danger">
                NT$<%= number_with_delimiter(row.order_total.to_i) %>
              </td>
              <td>
                <% row.products.each do |p| %>
                  <div style="font-size:0.78rem;">
                    <% if p[:prior_date] %>
                      <span class="text-success">✓</span> <%= p[:name] %>（<%= p[:prior_date].strftime('%Y/%m/%d') %>）
                    <% else %>
                      <span class="text-muted">　</span> <%= p[:name] %>（首次購買）
                    <% end %>
                  </div>
                <% end %>
              </td>
              <td style="max-width:220px;">
                <% if row.health_profile.present? %>
                  <div class="small text-truncate" style="max-width:220px;" title="<%= row.health_profile %>"><%= row.health_profile %></div>
                <% end %>
                <% if row.health_tags.present? %>
                  <div class="d-flex flex-wrap" style="gap:3px; margin-top:2px;">
                    <% row.health_tags.each do |tag| %>
                      <span class="badge bg-light text-dark border" style="font-size:0.7rem;"><%= tag %></span>
                    <% end %>
                  </div>
                <% end %>
                <% if row.health_profile.blank? && row.health_tags.blank? %>
                  <% if row.shopline_customer_id %>
                    <%= link_to "+ 填寫健康資料", edit_customer_path(row.shopline_customer_id, section: "health"), target: "_blank", class: "small text-decoration-none" %>
                  <% else %>
                    <span class="text-muted small">—</span>
                  <% end %>
                <% end %>
              </td>
              <% if is_new %>
                <td class="text-center">
                  <% if row.shopline_customer_id %>
                    <input type="checkbox"
                      class="customer-flag-checkbox"
                      data-customer-id="<%= row.shopline_customer_id %>"
                      data-field="line_bound"
                      <%= row.line_bound ? 'checked' : '' %>
                      style="width:18px; height:18px; cursor:pointer; accent-color:#28a745;">
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
          <% if rows.empty? %>
            <tr>
              <td colspan="<%= is_new ? 7 : 6 %>" class="text-center py-4 text-muted">（無訂單）</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<% content_for :scripts_block do %>
<script>
(function() {
  // 熱銷商品展開/收合
  document.querySelectorAll('.prod-toggle').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var panel = document.getElementById(this.dataset.target);
      var open = panel.style.display !== 'none' && panel.style.display !== '';
      panel.style.display = open ? 'none' : 'block';
      this.innerHTML = open ? '展開 ▼' : '收合 ▲';
    });
  });

  var CSRF = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
  var URL = "<%= toggle_daily_orders_customer_flag_path %>";

  document.querySelectorAll('.customer-flag-checkbox').forEach(function(cb) {
    cb.addEventListener('change', function() {
      fetch(URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
        body: JSON.stringify({ customer_id: cb.dataset.customerId, field: cb.dataset.field, value: cb.checked })
      }).then(function(r) {
        if (!r.ok) { cb.checked = !cb.checked; alert('更新失敗，請重新整理頁面再試一次'); }
      });
    });
  });
})();
</script>
<% end %>
