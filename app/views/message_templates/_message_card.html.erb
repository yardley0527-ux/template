<%
  blocks_data = template.message_template_blocks.includes(:message_template_images).map do |blk|
    {
      id:      blk.id,
      type:    blk.block_type,
      content: blk.content,
      images:  blk.message_template_images.map { |i| { id: i.id, url: i.url } }
    }
  end
%>
<div class="msg-card card mb-2"
     data-id="<%= template.id %>"
     data-title="<%= h(template.title.to_s) %>"
     data-blocks="<%= h(blocks_data.to_json) %>">
  <div class="card-body py-2 px-3">
    <div class="d-flex align-items-start">

      <span class="drag-handle text-muted mr-2 mt-1" style="cursor:grab;font-size:1.1rem;" title="拖拉排序">
        <i class="fal fa-grip-vertical"></i>
      </span>

      <div class="flex-grow-1">
        <% if template.title.present? %>
          <div class="text-muted small font-weight-bold mb-1"><%= template.title %></div>
        <% end %>

        <% template.message_template_blocks.includes(:message_template_images).each do |blk| %>
          <% if blk.block_type == "text" %>
            <div class="d-flex align-items-start mb-1">
              <pre class="flex-grow-1 mb-0"
                   style="white-space:pre-wrap;word-break:break-word;font-family:inherit;font-size:0.8rem;background:#f8f9fa;padding:6px 8px;border-radius:4px;"><%= blk.content %></pre>
              <button type="button"
                      class="btn btn-xs btn-outline-secondary ml-1 flex-shrink-0"
                      onclick="copyBlock('<%= j(blk.content.to_s) %>')"
                      title="複製這段文字">
                <i class="fal fa-copy"></i>
              </button>
            </div>
          <% else %>
            <div class="d-flex flex-wrap mb-1" style="gap:4px;">
              <% blk.message_template_images.each do |img| %>
                <img src="<%= img.url %>" style="width:52px;height:52px;object-fit:cover;border-radius:4px;">
              <% end %>
              <% if blk.message_template_images.empty? %>
                <span class="text-muted small"><i class="fal fa-image mr-1"></i>圖片區塊（空）</span>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>

      <div class="ml-2 d-flex flex-column" style="gap:4px;min-width:32px;">
        <button type="button" class="btn btn-xs btn-outline-secondary btn-edit"
                onclick="openEdit(this)" title="編輯">
          <i class="fal fa-pencil"></i>
        </button>
        <button type="button" class="btn btn-xs btn-outline-danger"
                onclick="deleteTemplate(this)" title="刪除">
          <i class="fal fa-trash"></i>
        </button>
      </div>

    </div>
  </div>
</div>
