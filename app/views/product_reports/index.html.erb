<% content_for :page_title, "產品報告" %>

<div class="subheader">
  <h1 class="subheader-title">
    <i class="fal fa-file-alt mr-2 text-danger"></i> 產品報告
  </h1>
  <div class="ml-auto">
    <%= link_to product_strategy_path, class: "btn btn-outline-secondary btn-sm" do %>
      <i class="fal fa-chart-line mr-1"></i>產品策略報表
    <% end %>
  </div>
</div>

<p class="text-muted small mb-4">
  每個產品的「今年 vs 去年、誰流失了」檢討報告（Claude Artifact）連結，依產品分區。
  這份清單目前是手動維護，新增報告時要請 Claude 加進 <code>ProductReportsController::REPORTS</code>。
</p>

<%# ── 總結：14個產品一次看 ── %>
<div class="panel">
  <div class="panel-hdr">
    <h2>📊 總結：14 個產品一次看</h2>
  </div>
  <div class="panel-container show">
    <div class="panel-content p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="thead-light">
            <tr>
              <th>產品</th>
              <th>狀態</th>
              <th class="text-right">2026 新客</th>
              <th class="text-right">舊客回頭率</th>
              <th>重點</th>
            </tr>
          </thead>
          <tbody>
            <% status_badge = {
                 growing:   "badge-success",
                 watch:     "badge-warning",
                 declining: "badge-danger",
                 new:       "badge-info",
               } %>
            <% @summary.each do |row| %>
              <tr>
                <td class="font-weight-bold"><%= row[:product] %></td>
                <td>
                  <span class="badge <%= status_badge[row[:status]] %>"><%= @status_label[row[:status]] %></span>
                </td>
                <td class="text-right"><%= row[:new_customers] ? number_with_delimiter(row[:new_customers]) + " 人" : "—" %></td>
                <td class="text-right">
                  <% if row[:retention_pct] %>
                    <span class="<%= row[:retention_pct] < 15 ? 'text-danger' : (row[:retention_pct] >= 25 ? 'text-success' : '') %>">
                      <%= row[:retention_pct] %>%
                    </span>
                  <% else %>
                    —
                  <% end %>
                </td>
                <td class="text-muted small"><%= row[:note] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="p-3 small text-muted border-top">
        <b>狀態說明：</b>
        <span class="badge badge-success">成長中</span> 買家數／營收都在成長；
        <span class="badge badge-warning">營收撐住但買家流失</span> 買家在流失，但靠客單價拉高讓營收沒掉，要留意基本盤持續萎縮；
        <span class="badge badge-danger">流失中</span> 買家、營收同步下滑；
        <span class="badge badge-info">新品/待觀察</span> 2026年才上市，還沒有「去年」可以比較。<br>
        「舊客回頭率」定義是去年買過、今年也買的比例；新品用首購回購率替代時已在「重點」欄位註明。
        膠原蛋白因為 92 天缺貨，新客數與回頭率改用「今年1~5月 vs 去年同期」的公平口徑計算，跟其他產品的全年口徑不同，詳見該產品報告。
      </div>
    </div>
  </div>
</div>

<% @reports_by_product.each do |product, reports| %>
  <div class="panel">
    <div class="panel-hdr">
      <h2><%= product %></h2>
      <% if reports.present? %>
        <span class="text-muted small ml-2"><%= reports.size %> 份報告</span>
      <% else %>
        <span class="badge badge-secondary ml-2">尚未製作</span>
      <% end %>
    </div>
    <div class="panel-container show">
      <div class="panel-content p-0">
        <% if reports.blank? %>
          <div class="text-center py-4 text-muted">
            <i class="fal fa-hourglass-half mr-1"></i> 這個產品的報告還沒做
          </div>
        <% else %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="thead-light">
                <tr>
                  <th style="width:90px;">日期</th>
                  <th>報告標題</th>
                  <th>說明</th>
                  <th style="width:60px;"></th>
                </tr>
              </thead>
              <tbody>
                <% reports.sort_by { |r| r[:date] }.reverse_each do |report| %>
                  <tr>
                    <td class="text-nowrap"><%= report[:date].strftime("%Y/%m/%d") %></td>
                    <td>
                      <%= link_to report[:title], report[:url], target: "_blank", rel: "noopener" %>
                    </td>
                    <td class="text-muted small"><%= report[:desc] %></td>
                    <td class="text-center">
                      <%= link_to report[:url], target: "_blank", rel: "noopener", class: "text-muted" do %>
                        <i class="fal fa-external-link"></i>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
