<!-- path: app/views/monthly_sales/index.html.erb -->
<div class="subheader">
  <h1 class="subheader-title">
    <i class="subheader-icon fal fa-chart-line"></i>
    每月營收趨勢（2024–2026）
    <small>用月份看旺淡季，規劃下一年檔期</small>
  </h1>
</div>

<div class="row">
  <div class="col-12">
    <div class="panel">
      <div class="panel-hdr"><h2>Revenue by Month</h2></div>

      <div class="panel-container show">
        <div class="panel-content">
          <div style="height:320px;">
            <canvas
              id="revenueChart"
              data-chart="<%= ERB::Util.html_escape(@chart.to_json) %>"></canvas>
          </div>
          <p class="text-muted mt-2 mb-0">營收顯示純整數；多年度同月對比。</p>
        </div>
      </div>
    </div>
  </div>
</div>

<% content_for :scripts_block do %>
  <script>
    (function () {
      var el = document.getElementById("revenueChart");
      if (!el) return;

      var raw = el.getAttribute("data-chart") || "{}";
      var payload = {};
      try {
        payload = JSON.parse(raw);
      } catch (e) {
        console.error("[monthly_sales] JSON.parse failed:", e, raw);
        return;
      }

      var labels = payload.labels || [];
      var series = payload.series || [];

      if (!window.Chart) {
        console.warn("[monthly_sales] Chart.js not found (window.Chart missing)");
        return;
      }

      var datasets = series.map(function (s) {
        return {
          label: s.name,
          data: (s.data || []).map(function (v) { return Number(v || 0); }),
          fill: false,
          tension: 0.25
        };
      });

      new Chart(el.getContext("2d"), {
        type: "line",
        data: { labels: labels, datasets: datasets },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: true } },
          scales: {
            y: {
              ticks: {
                callback: function(v){ return String(Math.round(v)); }
              }
            }
          }
        }
      });
    })();
  </script>
<% end %>
