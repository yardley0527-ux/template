<% content_for :page_title, "品牌之夜管理" %>

<div class="row g-3 mb-3">
  <div class="col-12">
    <h4 class="fw-bold mb-0">品牌之夜場次總覽</h4>
    <p class="text-muted small mb-0">2024–2026 全年場次比較 · 點擊場次列查看詳細分析</p>
  </div>
</div>

<% if @events_data.empty? %>
  <div class="alert alert-info">尚無場次資料。</div>
<% else %>

<%
  total_revenue  = @events_data.select { |e| e[:revenue] > 0 }.sum { |e| e[:revenue] }
  total_orders   = @events_data.sum { |e| e[:orders] }
  max_event      = @events_data.select { |e| e[:revenue] > 0 }.max_by { |e| e[:revenue] }
  chart_events   = @events_data.select { |e| e[:revenue] > 0 }
  latest_revenue = @events_data.last { |e| e[:revenue] > 0 }
%>

<%# ── 1. 走勢圖（第一眼看趨勢） ───────────────────────────────── %>
<% if chart_events.size >= 2 %>
<div class="row g-3 mb-4">
  <div class="col-lg-7">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-secondary text-white small fw-semibold">營業額走勢（有 Shopline 資料的場次）</div>
      <div class="card-body pb-2">
        <canvas id="revenueChart" height="110"></canvas>
      </div>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-secondary text-white small fw-semibold">各卡別出席人數走勢</div>
      <div class="card-body pb-2">
        <canvas id="levelChart" height="110"></canvas>
      </div>
    </div>
  </div>
</div>
<% end %>

<%# ── 2. 場次比較表（精簡 + 漲跌） ──────────────────────────── %>
<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-secondary text-white small fw-semibold">場次比較</div>
  <div class="card-body p-0 table-responsive">
    <table class="table table-hover align-middle mb-0" style="font-size: 0.82rem;">
      <thead class="table-light">
        <tr>
          <th>年份</th>
          <th>日期</th>
          <th>主力商品</th>
          <th class="text-end">訂單</th>
          <th class="text-end">vs 上場</th>
          <th class="text-end">營業額</th>
          <th class="text-end">vs 上場</th>
          <% LivestreamAnalysisController::ALL_LEVELS.each do |level| %>
            <th class="text-center"><%= level %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% current_year = nil %>
        <% @events_data.each_with_index do |e, idx| %>
          <% prev = idx > 0 ? @events_data[idx - 1] : nil %>

          <%# 年份分隔列 %>
          <% if e[:year] != current_year %>
            <% current_year = e[:year] %>
            <tr class="table-dark">
              <td colspan="<%= 7 + LivestreamAnalysisController::ALL_LEVELS.size %>" class="fw-bold small py-1 px-3">
                <%= current_year %> 年
              </td>
            </tr>
          <% end %>

          <%
            # 訂單漲跌
            order_diff = prev ? e[:orders] - prev[:orders] : nil
            order_pct  = (prev && prev[:orders] > 0) ? ((e[:orders].to_f / prev[:orders] - 1) * 100).round(0) : nil

            # 營業額漲跌（只在兩場都有資料時顯示）
            rev_pct = (prev && prev[:revenue] > 0 && e[:revenue] > 0) ?
                      ((e[:revenue].to_f / prev[:revenue] - 1) * 100).round(0) : nil

            is_selected = e[:date] == @selected[:date]
          %>

          <tr class="<%= is_selected ? 'table-primary fw-semibold' : '' %>" style="cursor:pointer;"
              onclick="location.href='<%= livestream_analysis_path(event: e[:date].to_s) %>'">
            <td><span class="text-muted small"><%= e[:year] %></span></td>
            <td><%= e[:label] %><%= " ★" if is_selected %></td>
            <td class="text-muted"><%= e[:note] %></td>
            <td class="text-end"><%= e[:orders] %></td>
            <td class="text-end">
              <% if order_pct %>
                <span class="<%= order_pct >= 0 ? 'text-success' : 'text-danger' %> fw-semibold">
                  <%= order_pct >= 0 ? '↑' : '↓' %><%= order_pct.abs %>%
                </span>
              <% else %>
                <span class="text-muted">—</span>
              <% end %>
            </td>
            <td class="text-end">
              <% if e[:revenue] > 0 %>NT$<%= number_with_delimiter(e[:revenue]) %><% else %><span class="text-muted">-</span><% end %>
            </td>
            <td class="text-end">
              <% if rev_pct %>
                <span class="<%= rev_pct >= 0 ? 'text-success' : 'text-danger' %> fw-semibold">
                  <%= rev_pct >= 0 ? '↑' : '↓' %><%= rev_pct.abs %>%
                </span>
              <% else %>
                <span class="text-muted">—</span>
              <% end %>
            </td>
            <% LivestreamAnalysisController::ALL_LEVELS.each do |level| %>
              <% d = e[:levels][level] %>
              <td class="text-center">
                <span class="d-block"><%= d[:n] %> 人</span>
                <% if d[:amt] %>
                  <span class="text-muted" style="font-size:0.72rem;">$<%= number_with_delimiter(d[:amt]) %></span>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="table-secondary">
        <tr class="fw-bold">
          <td colspan="3">合計 <%= @events_data.size %> 場</td>
          <td class="text-end"><%= @events_data.sum { |e| e[:orders] } %></td>
          <td></td>
          <td class="text-end">NT$<%= number_with_delimiter(total_revenue) %></td>
          <td></td>
          <% LivestreamAnalysisController::ALL_LEVELS.each do |level| %>
            <td class="text-center"><%= @events_data.sum { |e| e[:levels][level][:n] } %> 人</td>
          <% end %>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<%# ── 3. 詳細分析（折疊區） ─────────────────────────────────── %>
<div class="la-accordion mb-4">
  <div class="la-accordion-header" onclick="toggleSection('detail-section')">
    <span>📊 <%= @selected[:year] %>/<%= @selected[:label] %> 詳細分析</span>
    <span class="la-toggle-icon" id="detail-section-icon">▼</span>
  </div>
  <div id="detail-section" class="la-accordion-body" style="display:none;">

    <%# 各卡別出席率 %>
    <div class="card border-0 shadow-sm mb-3 mt-3">
      <div class="card-header bg-light small fw-semibold">各卡別出席率</div>
      <div class="card-body p-0 table-responsive">
        <table class="table align-middle mb-0 text-center" style="font-size: 0.875rem;">
          <thead class="table-light">
            <tr>
              <th class="text-start">卡別</th>
              <th>系統總人數</th>
              <th>出席人數</th>
              <th>出席率</th>
              <% if @selected[:levels].values.any? { |d| d[:amt] } %>
                <th>消費額</th>
                <th>人均消費</th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% LivestreamAnalysisController::ALL_LEVELS.each do |level| %>
              <% d    = @selected[:levels][level] %>
              <% tot  = @level_totals[level] %>
              <% rate = tot > 0 ? (d[:n].to_f / tot * 100).round(1) : 0 %>
              <tr>
                <td class="text-start fw-semibold"><%= level %></td>
                <td><%= tot %></td>
                <td><%= d[:n] %></td>
                <td>
                  <span class="badge <%= rate >= 20 ? 'bg-success' : rate >= 10 ? 'bg-warning text-dark' : 'bg-secondary' %>">
                    <%= rate %>%
                  </span>
                </td>
                <% if @selected[:levels].values.any? { |d| d[:amt] } %>
                  <td><% if d[:amt] %>NT$<%= number_with_delimiter(d[:amt]) %><% else %>-<% end %></td>
                  <td><% if d[:amt] && d[:n] > 0 %>NT$<%= number_with_delimiter(d[:amt] / d[:n]) %><% else %>-<% end %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%# 連場回流率 %>
    <% if @return_rates.any? %>
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header bg-light small fw-semibold">連場回流率</div>
      <div class="card-body p-0 table-responsive">
        <table class="table table-hover align-middle mb-0 text-center" style="font-size: 0.875rem;">
          <thead class="table-light">
            <tr><th>上場</th><th>本場</th><th>上場人數</th><th>回流人數</th><th>回流率</th></tr>
          </thead>
          <tbody>
            <% @return_rates.each do |rr| %>
              <tr>
                <td><%= rr[:from] %></td>
                <td><%= rr[:to] %></td>
                <td><%= rr[:from_total] %></td>
                <td><%= rr[:count] %></td>
                <td>
                  <span class="badge <%= rr[:rate] >= 30 ? 'bg-success' : rr[:rate] >= 15 ? 'bg-warning text-dark' : 'bg-danger' %>">
                    <%= rr[:rate] %>%
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <% end %>

    <%# 分析結論 %>
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header bg-light small fw-semibold">分析結論與行動建議</div>
      <div class="card-body py-2">
        <% @insights.each do |ins| %>
          <% cls = { info: "alert-info", warning: "alert-warning", danger: "alert-danger", success: "alert-success" }[ins[:type]] %>
          <div class="alert <%= cls %> py-2 px-3 mb-2" style="font-size: 0.88rem;"><%= ins[:text] %></div>
        <% end %>
      </div>
    </div>

  </div>
</div>

<%# ── 4. 未出席名單（折疊） ─────────────────────────────────── %>
<% if @missing_customers.any? %>
<div class="la-accordion mb-4">
  <div class="la-accordion-header" onclick="toggleSection('missing-section')">
    <span>本場缺席的老面孔 <span class="la-count-badge"><%= @missing_customers.size %> 人</span> <span class="la-hint">之前有來、這場沒出現 → 建議主動聯繫</span></span>
    <span class="la-toggle-icon" id="missing-section-icon">▼</span>
  </div>
  <div id="missing-section" class="la-accordion-body" style="display:none;">
    <div class="px-3 pt-2 border-bottom">
      <ul class="nav nav-tabs" id="missingTabs">
        <% LivestreamAnalysisController::ALL_LEVELS.each do |level| %>
          <% count = @missing_customers.count { |r| r[:customer].membership_level == level } %>
          <% next if count.zero? %>
          <li class="nav-item">
            <button class="nav-link" data-tab="missing-<%= level %>" type="button" onclick="switchMissingTab(this)">
              <%= level %> <span class="badge bg-secondary"><%= count %></span>
            </button>
          </li>
        <% end %>
      </ul>
    </div>
    <div class="card-body p-0">
      <% LivestreamAnalysisController::ALL_LEVELS.each do |level| %>
        <% rows = @missing_customers.select { |r| r[:customer].membership_level == level } %>
        <% next if rows.empty? %>
        <div class="missing-tab-pane" id="missing-<%= level %>">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
              <thead class="table-light">
                <tr><th>#</th><th>姓名</th><th>卡別</th><th>曾出席</th><th>累積消費</th><th>IG</th></tr>
              </thead>
              <tbody>
                <% rows.each_with_index do |r, i| %>
                  <% c = r[:customer] %>
                  <tr>
                    <td><span class="badge <%= i < 3 ? 'bg-danger' : i < 8 ? 'bg-warning text-dark' : 'bg-light text-dark' %>">#<%= i + 1 %></span></td>
                    <td><%= link_to c.full_name, customer_path(c.id), target: "_blank", class: "fw-semibold text-decoration-none" %></td>
                    <td class="text-muted small"><%= c.membership_level %></td>
                    <td><% r[:appeared_in].each do |lbl| %><span class="badge bg-primary me-1"><%= lbl %></span><% end %></td>
                    <td>NT$<%= number_with_delimiter(c.total_amount.to_i) %></td>
                    <td>
                      <% if c.instagram_account.present? %>
                        <a href="https://instagram.com/<%= c.instagram_account.gsub('@','') %>" target="_blank" class="text-decoration-none small">📷 <%= c.instagram_account %></a>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>

<%# ── 5. 忠實客（折疊） ──────────────────────────────────────── %>
<% loyal_block = lambda do |customers, card_id, title| %>
  <% next if customers.empty? %>
  <div class="la-accordion mb-4">
    <div class="la-accordion-header" onclick="toggleSection('<%= card_id %>')">
      <span><%= title %> <span class="la-count-badge"><%= customers.size %> 人</span></span>
      <span class="la-toggle-icon" id="<%= card_id %>-icon">▼</span>
    </div>
    <div id="<%= card_id %>" class="la-accordion-body" style="display:none;">
      <div class="px-3 pt-2 border-bottom">
        <ul class="nav nav-tabs" id="tabs-<%= card_id %>">
          <% LivestreamAnalysisController::ALL_LEVELS.each do |level| %>
            <% group = customers.select { |r| r[:customer].membership_level == level } %>
            <% next if group.empty? %>
            <li class="nav-item">
              <button class="nav-link" data-tab="pane-<%= card_id %>-<%= level %>" data-card="<%= card_id %>"
                      type="button" onclick="switchLoyalTab(this)">
                <%= level %> <span class="badge bg-secondary"><%= group.size %></span>
              </button>
            </li>
          <% end %>
        </ul>
      </div>
      <div class="card-body p-0">
        <% LivestreamAnalysisController::ALL_LEVELS.each do |level| %>
          <% group = customers.select { |r| r[:customer].membership_level == level } %>
          <% next if group.empty? %>
          <div class="loyal-pane" id="pane-<%= card_id %>-<%= level %>">
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
                <thead class="table-light">
                  <tr><th>姓名</th><th>卡別</th><th>出席紀錄</th><th>累積消費</th><th>IG</th></tr>
                </thead>
                <tbody>
                  <% group.each do |r| %>
                    <% c = r[:customer] %>
                    <tr>
                      <td><%= link_to c.full_name, customer_path(c.id), target: "_blank", class: "fw-semibold text-decoration-none" %></td>
                      <td class="text-muted small"><%= c.membership_level %></td>
                      <td><% r[:attended_labels].each do |lbl| %><span class="badge bg-success me-1"><%= lbl %></span><% end %></td>
                      <td>NT$<%= number_with_delimiter(c.total_amount.to_i) %></td>
                      <td>
                        <% if c.instagram_account.present? %>
                          <a href="https://instagram.com/<%= c.instagram_account.gsub('@','') %>" target="_blank" class="text-decoration-none small">📷 <%= c.instagram_account %></a>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<% loyal_block.call(@loyal_3_customers, "loyal3", "死忠粉絲 · 最近三場都來") %>
<% loyal_block.call(@loyal_2_customers, "loyal2", "潛力粉絲 · 最近三場來了兩場") %>

<% end %><%# end if @events_data.empty? %>

<style>
.la-accordion { border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; }
.la-accordion-header {
  background: #f3f4f6;
  padding: 10px 16px;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  user-select: none;
}
.la-accordion-header:hover { background: #e5e7eb; }
.la-accordion-body { background: #fff; }
.la-toggle-icon { font-size: 0.75rem; color: #6b7280; transition: transform 0.2s; }
.la-toggle-icon.open { transform: rotate(180deg); }
.la-count-badge { display: inline-block; background: #374151; color: #fff; font-size: 11px; font-weight: 700; padding: 1px 8px; border-radius: 99px; margin-left: 6px; vertical-align: middle; }
.la-hint { font-size: 11px; font-weight: 400; color: #6b7280; margin-left: 8px; }
</style>

<% content_for :scripts_block do %>
<script>
document.addEventListener('DOMContentLoaded', function() {
  <% chart_events = @events_data.select { |e| e[:revenue] > 0 }.last(15) %>
  <% if chart_events.size >= 2 %>
  const labels   = <%= raw chart_events.map { |e| "#{e[:label]}" }.to_json %>;
  const revenues = <%= raw chart_events.map { |e| e[:revenue] }.to_json %>;
  const selectedLabel = "<%= @selected[:label] %>";

  const xTickOpts = {
    maxRotation: 45, minRotation: 45,
    font: { size: 11 }
  };

  new Chart(document.getElementById('revenueChart'), {
    type: 'line',
    data: {
      labels,
      datasets: [{
        label: '營業額 (NT$)',
        data: revenues,
        borderColor: 'rgba(13,110,253,0.9)',
        backgroundColor: 'rgba(13,110,253,0.08)',
        fill: true,
        tension: 0.3,
        pointRadius: labels.map(l => l === selectedLabel ? 7 : 4),
        pointBackgroundColor: labels.map(l => l === selectedLabel ? 'rgba(220,53,69,1)' : 'rgba(13,110,253,0.8)')
      }]
    },
    options: {
      responsive: true,
      interaction: { mode: 'index', intersect: false },
      plugins: { legend: { display: false } },
      scales: {
        x: { ticks: xTickOpts },
        y: { beginAtZero: true, ticks: { callback: v => 'NT$' + v.toLocaleString() } }
      }
    }
  });

  const levelColors = { '黑卡':'#212529','金卡':'#d97706','銀卡':'#6c757d','白卡':'#0ea5e9' };
  const levelData   = <%= raw %w[黑卡 金卡 銀卡 白卡].map { |lv|
    { label: lv, data: chart_events.map { |e| e[:levels][lv][:n] } }
  }.to_json %>;

  new Chart(document.getElementById('levelChart'), {
    type: 'line',
    data: {
      labels,
      datasets: levelData.map(d => ({
        label: d.label,
        data: d.data,
        borderColor: levelColors[d.label],
        backgroundColor: 'transparent',
        tension: 0.3,
        pointRadius: 3,
        borderWidth: 2
      }))
    },
    options: {
      responsive: true,
      interaction: { mode: 'index', intersect: false },
      plugins: { legend: { position: 'top', labels: { boxWidth: 12, font: { size: 12 } } } },
      scales: {
        x: { ticks: xTickOpts },
        y: { beginAtZero: true }
      }
    }
  });
  <% end %>

  initTabs('.missing-tab-pane', '#missingTabs .nav-link');
  document.querySelectorAll('[id^="tabs-loyal"]').forEach(nav => {
    const cardId = nav.id.replace('tabs-', '');
    initTabs(`[id^="pane-${cardId}-"]`, `#${nav.id} .nav-link`);
  });
});

function toggleSection(id) {
  const body = document.getElementById(id);
  const icon = document.getElementById(id + '-icon');
  const isOpen = body.style.display !== 'none';
  body.style.display = isOpen ? 'none' : 'block';
  icon.classList.toggle('open', !isOpen);
}

function initTabs(paneSelector, btnSelector) {
  const panes = document.querySelectorAll(paneSelector);
  const btns  = document.querySelectorAll(btnSelector);
  panes.forEach((p, i) => p.style.display = i === 0 ? 'block' : 'none');
  btns.forEach((b, i)  => { if (i === 0) b.classList.add('active'); });
}

function switchMissingTab(btn) {
  document.querySelectorAll('.missing-tab-pane').forEach(p => p.style.display = 'none');
  document.querySelectorAll('#missingTabs .nav-link').forEach(b => b.classList.remove('active'));
  document.getElementById(btn.dataset.tab).style.display = 'block';
  btn.classList.add('active');
}

function switchLoyalTab(btn) {
  const cardId = btn.dataset.card;
  document.querySelectorAll(`[id^="pane-${cardId}-"]`).forEach(p => p.style.display = 'none');
  document.querySelectorAll(`#tabs-${cardId} .nav-link`).forEach(b => b.classList.remove('active'));
  document.getElementById(btn.dataset.tab).style.display = 'block';
  btn.classList.add('active');
}
</script>
<% end %>
