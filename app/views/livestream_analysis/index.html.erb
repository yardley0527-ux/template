<% content_for :page_title, "薑黃回購分析" %>

<div class="row g-3 mb-3">
  <div class="col-12">
    <h4 class="fw-bold mb-0">薑黃回購分析</h4>
    <p class="text-muted small mb-0">追蹤曾買過薑黃，但 4/10 未出現的金卡以上客人</p>
  </div>
</div>

<%# 人數卡片 %>
<div class="row g-3 mb-3">
  <% [
    ["1/9 直播買薑黃人數", @jan9_emails.size],
    ["2/25 直播買薑黃人數", @feb25_emails.size],
    ["4/10 直播買薑黃人數", @apr10_emails.size]
  ].each do |label, count| %>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm text-center py-4">
        <div class="text-muted mb-2"><%= label %></div>
        <div class="fw-bold text-primary" style="font-size: 2rem; line-height: 1;"><%= count %></div>
      </div>
    </div>
  <% end %>
</div>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-secondary text-white">
    黑卡 / 金卡 各場出席狀況
  </div>
  <div class="card-body p-0">
    <table class="table table-hover align-middle mb-0 text-center">
      <thead class="table-light">
        <tr>
          <th></th>
          <th>總人數</th>
          <th>1/9 出席</th>
          <th>1/9 出席率</th>
          <th>2/25 出席</th>
          <th>2/25 出席率</th>
          <th>4/10 出席</th>
          <th>4/10 出席率</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="fw-bold text-start ps-3">黑卡</td>
          <td><%= @black_card_total %></td>
          <td><%= @black_jan9 %></td>
          <td><%= @black_jan9_rate %>%</td>
          <td><%= @black_feb25 %></td>
          <td><%= @black_feb25_rate %>%</td>
          <td><%= @black_apr10 %></td>
          <td><%= @black_apr10_rate %>%</td>
        </tr>
        <tr>
          <td class="fw-bold text-start ps-3">金卡</td>
          <td><%= @gold_card_total %></td>
          <td><%= @gold_jan9 %></td>
          <td><%= @gold_jan9_rate %>%</td>
          <td><%= @gold_feb25 %></td>
          <td><%= @gold_feb25_rate %>%</td>
          <td><%= @gold_apr10 %></td>
          <td><%= @gold_apr10_rate %>%</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<%# 回流率卡片 %>
<div class="row g-3 mb-4">
  <% [
    ["1/9 → 2/25 直播回流率", @jan9_return_rate, @jan9_to_feb25_count, @jan9_emails.size],
    ["2/25 → 4/10 直播回流率", @feb25_return_rate, @feb25_to_apr10_count, @feb25_emails.size],
    ["曾買過 → 4/10 回流率", @prev_return_rate, @prev_to_apr10_count, @all_prev_emails.size]
  ].each do |label, rate, num, den| %>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm text-center py-4">
        <div class="text-muted mb-2"><%= label %></div>
        <div class="fw-bold text-success" style="font-size: 2rem; line-height: 1;"><%= rate %>%</div>
        <div class="text-muted mt-1"><%= num %> / <%= den %> 人</div>
      </div>
    </div>
  <% end %>
</div>

<%# 未出現名單 %>
<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
    <span>⚠️ 金卡以上未出現名單（曾買薑黃，4/10 未購買）</span>
    <span class="badge bg-danger"><%= @missing_customers.size %> 人</span>
  </div>
  <div class="px-3 pt-2 border-bottom">
    <ul class="nav nav-tabs" id="membershipTabs">
      <% { "黑卡" => "black", "金卡" => "gold" }.each_with_index do |(level, key), idx| %>
        <% count = @missing_customers.count { |r| r[:customer].membership_level == level } %>
        <% next if count.zero? %>
        <li class="nav-item">
          <button class="nav-link <%= idx == 0 ? 'active' : '' %>" onclick="switchTab('<%= key %>', this)" type="button">
            <%= level %> <span class="badge bg-secondary"><%= count %></span>
          </button>
        </li>
      <% end %>
    </ul>
  </div>
  <div class="card-body p-0">
    <div class="tab-content">
      <% [["黑卡", "black"], ["金卡", "gold"]].each do |level, tab_id| %>
        <% rows = level.nil? ? @missing_customers : @missing_customers.select { |r| r[:customer].membership_level == level } %>
        <% next if !level.nil? && rows.empty? %>
        <div class="tab-pane" id="tab-<%= tab_id %>">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
              <thead class="table-light">
                <tr>
                  <th>優先</th>
                  <th>姓名</th>
                  <th>卡別</th>
                  <th>上次買薑黃</th>
                  <th>瓶數</th>
                  <th>預期回購</th>
                  <th>逾期</th>
                  <th>歷史次數</th>
                  <th>歷史消費</th>
                  <th>IG</th>
                </tr>
              </thead>
              <tbody>
                <% rows.each_with_index do |r, i| %>
                  <% c = r[:customer] %>
                  <tr>
                    <td>
                      <span class="badge <%= i < 3 ? 'bg-danger' : i < 8 ? 'bg-warning text-dark' : 'bg-light text-dark' %>">
                        #<%= i + 1 %>
                      </span>
                    </td>
                    <td><%= link_to c.full_name, customer_path(c.id), target: "_blank", class: "fw-semibold text-decoration-none" %></td>
                    <td><span class="text-muted small"><%= c.membership_level %></span></td>
                    <td><%= r[:last_date]&.strftime("%m/%d") || "-" %></td>
                    <td class="text-center"><%= r[:bottles] %> 瓶</td>
                    <td><%= r[:last_date] ? (r[:last_date] + r[:expected_days]).strftime("%m/%d") : "-" %></td>
                    <td>
                      <% od = r[:overdue_days] %>
                      <% if od.nil? %>
                        <span class="text-muted">-</span>
                      <% elsif od <= 0 %>
                        <span class="badge bg-success">未到期</span>
                      <% elsif od <= 14 %>
                        <span class="badge bg-warning text-dark">+<%= od %>天</span>
                      <% else %>
                        <span class="badge bg-danger">+<%= od %>天</span>
                      <% end %>
                    </td>
                    <td class="text-center"><%= r[:history_count] %> 次</td>
                    <td>NT$<%= number_with_delimiter(r[:history_amount].to_i) %></td>
                    <td>
                      <% if c.instagram_account.present? %>
                        <a href="https://instagram.com/<%= c.instagram_account.gsub('@','') %>" target="_blank" class="text-decoration-none">
                          📷 <%= c.instagram_account %>
                        </a>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
                <% if rows.empty? %>
                  <tr><td colspan="10" class="text-center text-muted py-4">無資料</td></tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%# 忠實客 helper - 帶 tab 版 %>
<% loyal_card = lambda do |customers, card_id| %>
  <% black = customers.select { |r| r[:customer].membership_level == "黑卡" } %>
  <% gold  = customers.select { |r| r[:customer].membership_level == "金卡" } %>

  <div class="px-3 pt-2 border-bottom">
    <ul class="nav nav-tabs" id="tabs-<%= card_id %>">
      <% [["黑卡", "black"], ["金卡", "gold"]].each_with_index do |(level, key), idx| %>
        <% group = level == "黑卡" ? black : gold %>
        <% next if group.empty? %>
        <li class="nav-item">
          <button class="nav-link <%= idx == 0 && !black.empty? || (idx == 1 && black.empty?) ? 'active' : '' %>"
                  onclick="switchLoyalTab('<%= card_id %>-<%= key %>', '<%= card_id %>', this)"
                  type="button">
            <%= level %> <span class="badge bg-secondary"><%= group.size %></span>
          </button>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="card-body p-0">
    <% [["黑卡", "black", black], ["金卡", "gold", gold]].each do |level, key, group| %>
      <% next if group.empty? %>
      <div class="loyal-pane" id="pane-<%= card_id %>-<%= key %>">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
            <thead class="table-light">
              <tr>
                <th>姓名</th>
                <th>卡別</th>
                <th>4/10 買了</th>
                <th>上次購買日期</th>
                <th>歷史買薑黃次數</th>
                <th>歷史薑黃消費</th>
                <th>IG</th>
              </tr>
            </thead>
            <tbody>
              <% group.each do |r| %>
                <% c = r[:customer] %>
                <tr>
                  <td><%= link_to c.full_name, customer_path(c.id), target: "_blank", class: "fw-semibold text-decoration-none" %></td>
                  <td><span class="text-muted small"><%= c.membership_level %></span></td>
                  <td><%= r[:last_product] %></td>
                  <td><%= r[:last_date]&.strftime("%m/%d") || "-" %></td>
                  <td class="text-center"><%= r[:history_count] %> 次</td>
                  <td>NT$<%= number_with_delimiter(r[:history_amount].to_i) %></td>
                  <td>
                    <% if c.instagram_account.present? %>
                      <a href="https://instagram.com/<%= c.instagram_account.gsub('@','') %>" target="_blank" class="text-decoration-none">📷 <%= c.instagram_account %></a>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<%# 三場都買 %>
<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
    <span>⭐⭐⭐ 三場都有買薑黃</span>
    <span class="badge bg-white text-success"><%= @loyal_3_customers.size %> 人</span>
  </div>
  <% if @loyal_3_customers.empty? %>
    <div class="text-center text-muted py-4">無資料</div>
  <% else %>
    <% loyal_card.call(@loyal_3_customers, "loyal3") %>
  <% end %>
</div>

<%# 任意兩場都買 %>
<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
    <span>⭐⭐ 任意兩場有買薑黃</span>
    <span class="badge bg-white text-primary"><%= @loyal_2_customers.size %> 人</span>
  </div>
  <% if @loyal_2_customers.empty? %>
    <div class="text-center text-muted py-4">無資料</div>
  <% else %>
    <% loyal_card.call(@loyal_2_customers, "loyal2") %>
  <% end %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const panes = document.querySelectorAll('.tab-pane');
  panes.forEach((p, i) => p.style.display = i === 0 ? 'block' : 'none');
});

function switchTab(id, btn) {
  document.querySelectorAll('.tab-pane').forEach(p => p.style.display = 'none');
  document.querySelectorAll('#membershipTabs .nav-link').forEach(b => b.classList.remove('active'));
  document.getElementById('tab-' + id).style.display = 'block';
  btn.classList.add('active');
}

function switchLoyalTab(paneId, cardId, btn) {
  document.querySelectorAll(`[id^="pane-${cardId}-"]`).forEach(p => p.style.display = 'none');
  document.querySelectorAll(`#tabs-${cardId} .nav-link`).forEach(b => b.classList.remove('active'));
  document.getElementById('pane-' + paneId).style.display = 'block';
  btn.classList.add('active');
}

document.addEventListener('DOMContentLoaded', function() {
  const panes = document.querySelectorAll('.tab-pane');
  panes.forEach((p, i) => p.style.display = i === 0 ? 'block' : 'none');

  // 忠實客 tab 初始化
  ['loyal3', 'loyal2'].forEach(cardId => {
    const allPanes = document.querySelectorAll(`[id^="pane-${cardId}-"]`);
    allPanes.forEach((p, i) => p.style.display = i === 0 ? 'block' : 'none');
  });
});
</script>