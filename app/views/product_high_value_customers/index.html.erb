<%# app/views/product_high_value_customers/index.html.erb %>
<% content_for :page_title, "產品高破萬次數客人" %>

<% def ig_link_url(account)
  return nil if account.blank?
  handle = account.strip.gsub(/^@/, '').gsub(%r{https?://(?:www\.)?instagram\.com/?}, '').gsub(%r{/$}, '').strip
  handle.present? ? "https://www.instagram.com/#{handle}/" : nil
end %>

<%# Header %>
<div class="row g-3 mb-3">
  <div class="col-12 d-flex align-items-center justify-content-between flex-wrap" style="gap:12px;">
    <div>
      <h4 class="fw-bold mb-0">產品高破萬次數客人</h4>
      <p class="text-muted small mb-0">單筆訂單中該產品買滿 NT$<%= number_with_delimiter(ProductHighValueCustomersController::THRESHOLD) %> 才算破萬一次，依次數排序 — 各產品可推大單的客人</p>
    </div>
    <%= form_tag product_high_value_customers_path, method: :get, class: "d-flex align-items-center flex-wrap", style: "gap:8px;" do %>
      <%= hidden_field_tag :series, @series_filter %>
      <input type="date" name="start_date" value="<%= @start_date.strftime('%Y-%m-%d') %>" class="form-control form-control-sm">
      <span class="text-muted small">至</span>
      <input type="date" name="end_date" value="<%= @end_date.strftime('%Y-%m-%d') %>" class="form-control form-control-sm">
      <button type="submit" class="btn btn-sm btn-primary">查詢</button>
      <% if params[:start_date].present? %>
        <%= link_to "回今年", product_high_value_customers_path(series: @series_filter), class: "btn btn-sm btn-outline-secondary" %>
      <% end %>
    <% end %>
  </div>
</div>

<% if @series_filter %>
  <%# 產品內頁：返回總覽 + 依破萬次數分 tab %>
  <div class="mb-3">
    <%= link_to "← 回產品總覽", product_high_value_customers_path(start_date: params[:start_date], end_date: params[:end_date]),
          class: "btn btn-sm btn-dark" %>
  </div>
  <ul class="nav nav-tabs mb-3" style="font-size:0.9rem;">
    <% @count_tabs.each do |t| %>
      <li class="nav-item">
        <%= link_to "#{t[:count]} 次（#{t[:size]}）",
              product_high_value_customers_path(series: @series_filter, times: t[:count], start_date: params[:start_date], end_date: params[:end_date]),
              class: "nav-link #{@times_filter == t[:count] ? 'active fw-bold' : 'text-muted'}" %>
      </li>
    <% end %>
  </ul>
<% else %>
  <%# 產品總覽面板：依總破萬次數排序，點產品看客人名單 %>
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white fw-bold">產品破萬總覽</div>
    <div class="card-body p-0 table-responsive">
      <table class="table align-middle mb-0" style="font-size:0.88rem;">
        <thead style="background-color:#4a4a4a; color:white;">
          <tr>
            <th class="ps-3" style="width:50px;">#</th>
            <th>產品</th>
            <th class="text-end" style="width:130px;">總破萬次數</th>
            <th class="text-end" style="width:120px;">破萬人數</th>
            <th class="text-end" style="width:120px;">破萬 2 次</th>
            <th class="text-end" style="width:140px;">破萬 3 次含以上</th>
            <th class="text-end" style="width:160px;">破萬合計金額</th>
            <th style="width:110px;"></th>
          </tr>
        </thead>
        <tbody>
          <% @product_summary.each_with_index do |p, i| %>
            <% detail_path = product_high_value_customers_path(series: p[:series], start_date: params[:start_date], end_date: params[:end_date]) %>
            <tr>
              <td class="ps-3 text-muted"><%= i + 1 %></td>
              <td class="fw-semibold"><%= link_to p[:series], detail_path, class: "text-decoration-none" %></td>
              <td class="text-end fw-bold" style="font-size:1rem; color:#c0392b;"><%= p[:total_count] %> 次</td>
              <td class="text-end"><%= p[:customers] %> 人</td>
              <td class="text-end"><%= p[:two_times] %> 人</td>
              <td class="text-end"><%= p[:three_plus] %> 人</td>
              <td class="text-end fw-bold" style="color:#6e4a2e;">NT$<%= number_with_delimiter(p[:total_amount]) %></td>
              <td class="text-end pe-3"><%= link_to "看名單", detail_path, class: "btn btn-sm btn-outline-primary" %></td>
            </tr>
          <% end %>
          <% if @product_summary.empty? %>
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">
                <i class="fal fa-inbox fa-2x mb-2 d-block opacity-25"></i>
                此期間沒有單一產品破萬的訂單
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<% @groups.each do |group| %>
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white d-flex align-items-center" style="gap:8px;">
      <span class="fw-bold"><%= group[:series] %></span>
      <span class="badge bg-secondary"><%= group[:rows].size %> 人</span>
    </div>
    <div class="card-body p-0 table-responsive">
      <table class="table align-middle mb-0" style="font-size:0.86rem;">
        <thead style="background-color:#4a4a4a; color:white;">
          <tr>
            <th class="ps-3" style="width:50px;">#</th>
            <th style="width:130px;">姓名</th>
            <th style="width:160px;">IG</th>
            <th style="width:90px;">卡別</th>
            <th class="text-end" style="width:110px;">
              破萬次數
              <div class="fw-normal" style="font-size:0.68rem; opacity:0.75;">點擊看消費紀錄</div>
            </th>
            <th class="text-end" style="width:140px;">破萬合計金額</th>
            <th class="text-end" style="width:130px;">
              平均客單價
              <div class="fw-normal" style="font-size:0.68rem; opacity:0.75;">歷史累計消費總額 ÷ 總訂單數</div>
            </th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% group[:rows].each_with_index do |r, i| %>
            <% url = ig_link_url(r[:instagram_account]) %>
            <tr>
              <td class="ps-3 text-muted"><%= i + 1 %></td>
              <td class="fw-semibold">
                <% if r[:shopline_customer_id] %>
                  <%= link_to r[:full_name].presence || r[:email], customer_path(r[:shopline_customer_id]), target: "_blank", class: "text-decoration-none" %>
                <% else %>
                  <%= r[:full_name].presence || r[:email] %>
                <% end %>
              </td>
              <td>
                <% if url %>
                  <%= link_to url, target: "_blank", class: "text-decoration-none d-flex align-items-center gap-1" do %>
                    <i class="fal fa-at text-danger"></i>
                    <span style="font-size:0.8rem; max-width:140px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:inline-block;">
                      <%= r[:instagram_account]&.sub(/^@/, '') %>
                    </span>
                  <% end %>
                <% else %>
                  <span class="text-muted small">—</span>
                <% end %>
              </td>
              <td>
                <% badge_bg, badge_fg = case r[:membership_level]
                                      when '黑卡' then ['#333', '#fff']
                                      when '金卡' then ['#b8860b', '#fff']
                                      when '銀卡' then ['#6c757d', '#fff']
                                      when '白卡' then ['#dee2e6', '#333']
                                      else             ['#adb5bd', '#333']
                                      end %>
                <span class="badge" style="background:<%= badge_bg %>; color:<%= badge_fg %>; font-size:0.75rem;"><%= r[:membership_level].presence || "—" %></span>
              </td>
              <td class="text-end">
                <a href="#" class="fw-bold text-decoration-none" style="font-size:1rem; color:#c0392b;"
                   onclick="document.getElementById('phv-detail-<%= i %>').classList.toggle('d-none'); return false;">
                  <%= r[:count] %> 次 <i class="fal fa-chevron-down" style="font-size:0.7rem;"></i>
                </a>
              </td>
              <td class="text-end fw-bold" style="color:#6e4a2e;">NT$<%= number_with_delimiter(r[:total]) %></td>
              <td class="text-end"><%= r[:avg_order] ? "NT$#{number_with_delimiter(r[:avg_order])}" : "—" %></td>
              <td></td>
            </tr>
            <tr id="phv-detail-<%= i %>" class="d-none">
              <td colspan="8" style="background:#faf7f2; padding:8px 16px 8px 60px;">
                <div class="text-muted mb-1" style="font-size:0.75rem;">破萬消費紀錄（<%= group[:series] %>）</div>
                <% r[:orders].each do |o| %>
                  <div style="font-size:0.82rem;">
                    <span class="text-muted"><%= o[:date].strftime('%Y/%m/%d') %></span>
                    ・<span class="fw-bold" style="color:#6e4a2e;">NT$<%= number_with_delimiter(o[:amount]) %></span>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

