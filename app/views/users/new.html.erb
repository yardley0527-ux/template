<%# app/views/users/new.html.erb %>
<% content_for :page_title, "新增使用者" %>

<div class="row g-3 mb-4">
  <div class="col-12">
    <h4 class="fw-bold mb-0">新增使用者</h4>
    <p class="text-muted small mb-0">建立帳號密碼並指派角色，之後可在「使用者管理」修改角色。</p>
  </div>
</div>

<div class="card border-0 shadow-sm" style="max-width: 480px;">
  <div class="card-body">
    <% if @user.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: users_path, local: true do |f| %>
      <div class="mb-3">
        <%= f.label :username, "帳號", class: "form-label" %>
        <%= f.text_field :username, class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= f.label :email, "Email", class: "form-label" %>
        <%= f.email_field :email, class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= f.label :password, "密碼", class: "form-label" %>
        <%= f.password_field :password, class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= f.label :password_confirmation, "確認密碼", class: "form-label" %>
        <%= f.password_field :password_confirmation, class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= f.label :role_id, "角色", class: "form-label" %>
        <%= f.select :role_id, options_from_collection_for_select(@roles, :id, :name), {}, class: "form-select" %>
      </div>

      <%= f.submit "建立帳號", class: "btn btn-primary" %>
      <%= link_to "取消", users_path, class: "btn btn-outline-secondary" %>
    <% end %>
  </div>
</div>
