<%# app/views/probiotic_analysis/index.html.erb %>
<% content_for :page_title, "益生菌直播分析" %>

<% level_keys = ProbioticAnalysisController::LEVEL_KEYS %>

<%# ══════════════════════════════════════════════════════════════════════ %>
<%# 頁面標題 ＋ 場次切換                                                  %>
<%# ══════════════════════════════════════════════════════════════════════ %>
<div class="row g-3 mb-4">
  <div class="col-12 d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
      <h4 class="fw-bold mb-0">益生菌直播分析</h4>
      <p class="text-muted small mb-0">目前場次：<%= @event_label %></p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <% @all_probiotic_events.each do |ev| %>
        <% label  = "#{ev[:year]}/#{ev[:label]}" %>
        <% active = ev[:date] == @current_event[:date] %>
        <%= link_to label,
              probiotic_analysis_path(event: ev[:date].to_s),
              class: "btn btn-sm #{active ? 'btn-secondary' : 'btn-outline-secondary'}" %>
      <% end %>
    </div>
  </div>
</div>

<%# ══════════════════════════════════════════════════════════════════════ %>
<%# 一、歷史場次趨勢 ＋ 策略參考                                           %>
<%# ══════════════════════════════════════════════════════════════════════ %>
<div class="d-flex align-items-center mb-3">
  <div class="border-start border-3 border-secondary ps-3">
    <h5 class="fw-bold mb-0 text-secondary">📊 策略參考</h5>
    <p class="text-muted small mb-0">場次趨勢 ＋ 鐵粉 ＋ 卡別出席率</p>
  </div>
</div>

<%# 歷史場次趨勢表 %>
<% if @cross_event_stats&.any? %>
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header text-white fw-semibold" style="background-color: #4a6fa5;">📈 歷史場次趨勢</div>
    <div class="card-body p-0 table-responsive">
      <table class="table align-middle mb-0 text-center" style="font-size: 0.875rem;">
        <thead class="table-light">
          <tr>
            <th class="text-start ps-3">場次</th>
            <th class="text-start">品項</th>
            <th>買家數</th>
            <th>業績</th>
            <th>人均消費</th>
            <th>連場回流率</th>
          </tr>
        </thead>
        <tbody>
          <% @cross_event_stats.each_with_index do |s, i| %>
            <tr <%= i == @cross_event_stats.size - 1 ? 'style="background-color:#f0f4ff;"' : '' %>>
              <td class="fw-bold text-start ps-3">
                <%= s[:label] %>
                <% if i == @cross_event_stats.size - 1 %>
                  <span class="badge ms-1" style="background-color:#4a6fa5;font-size:0.6rem;">最新</span>
                <% end %>
              </td>
              <td class="text-start">
                <div class="text-muted small"><%= s[:note] %></div>
                <% if s.key?(:single_product) %>
                  <% if s[:single_product] %>
                    <span style="display:inline-block;margin-top:3px;padding:2px 7px;border-radius:4px;font-size:0.72rem;font-weight:700;background:#d4edda;color:#155724;border:1px solid #c3e6cb;">單品業績</span>
                  <% else %>
                    <span style="display:inline-block;margin-top:3px;padding:2px 7px;border-radius:4px;font-size:0.72rem;font-weight:700;background:#fde8c8;color:#7d3c00;border:1px solid #f5c580;">混場 — 業績僅含本產品</span>
                  <% end %>
                <% end %>
              </td>
              <td><%= s[:buyers] %> 人</td>
              <td><%= s[:revenue] > 0 ? "NT$#{number_with_delimiter(s[:revenue])}" : "—" %></td>
              <td><%= s[:aov] > 0 ? "NT$#{number_with_delimiter(s[:aov])}" : "—" %></td>
              <td>
                <% if s[:return_rate] %>
                  <span class="fw-semibold <%= s[:return_rate] >= 30 ? 'text-success' : 'text-warning' %>">
                    <%= s[:return_rate] %>%
                  </span>
                  <span class="text-muted small">（<%= s[:return_count] %>人）</span>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<%# 本場人數卡片 %>
<div class="row g-3 mb-3">
  <div class="col-md-4">
    <div class="card border-0 shadow-sm text-center py-4">
      <div class="text-muted mb-2"><%= @event_label %> 直播買益生菌人數</div>
      <div class="fw-bold text-primary" style="font-size: 2rem; line-height: 1;"><%= @event_emails.size %></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card border-0 shadow-sm text-center py-4">
      <div class="text-muted mb-2">曾購買過（<%= @event_label %> 前）</div>
      <div class="fw-bold" style="font-size: 2rem; line-height: 1; color: #495057;"><%= @prev_count %></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card border-0 shadow-sm text-center py-4">
      <div class="text-muted mb-2">舊客回流率</div>
      <div class="fw-bold text-success" style="font-size: 2rem; line-height: 1;"><%= @prev_return_rate %>%</div>
      <div class="text-muted small mt-1"><%= @prev_returned_count %> / <%= @prev_count %> 人</div>
    </div>
  </div>
</div>

<%# 各卡別出席率 %>
<div class="card border-0 shadow-sm mb-3">
  <div class="card-header text-white" style="background-color: #4a4a4a;">各卡別出席狀況</div>
  <div class="card-body p-0 table-responsive">
    <table class="table align-middle mb-0 text-center" style="font-size: 0.9rem;">
      <thead class="table-light">
        <tr>
          <th></th>
          <th>總人數</th>
          <th><%= @event_label %> 出席</th>
          <th><%= @event_label %> 出席率</th>
        </tr>
      </thead>
      <tbody>
        <% @level_stats.each do |stat| %>
          <tr>
            <td class="fw-bold text-start ps-3"><%= stat[:level] %></td>
            <td><%= stat[:total] %></td>
            <td><%= stat[:attended] %></td>
            <td><%= stat[:rate] %>%</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%# 建議行動 %>
<div class="card border-0 shadow-sm mb-3">
  <div class="card-header text-white" style="background-color: #4a4a4a;">📌 建議行動</div>
  <div class="card-body">
    <% @insights.each do |insight| %>
      <% bg = { info: "alert-info", warning: "alert-warning", danger: "alert-danger", success: "alert-success" }[insight[:type]] %>
      <div class="alert <%= bg %> py-2 px-3 mb-2" style="font-size: 0.9rem;"><%= insight[:text] %></div>
    <% end %>
  </div>
</div>

<%# 鐵粉（可展開） %>
<% if @iron_fans&.any? %>
  <div class="mb-4">
    <button class="btn btn-outline-warning btn-sm fw-semibold" type="button"
            data-bs-toggle="collapse" data-bs-target="#iron-fans-panel">
      ⭐ 鐵粉（全場次出席）— <%= @iron_fans.size %> 人
    </button>
    <div id="iron-fans-panel" class="collapse mt-2">
      <div class="card border-0 shadow-sm">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0" style="font-size:0.85rem;">
            <thead class="table-light">
              <tr><th>姓名</th><th>卡別</th><th>出席場數</th><th>IG</th><th>Email</th></tr>
            </thead>
            <tbody>
              <% @iron_fans.each do |r| %>
                <% c = r[:customer] %>
                <tr>
                  <td><%= link_to c.full_name, customer_path(c.id), target: "_blank", class: "fw-semibold text-decoration-none" %></td>
                  <td><span class="text-muted small"><%= c.membership_level %></span></td>
                  <td class="text-center fw-bold text-warning"><%= r[:attended_count] %> 場</td>
                  <td><%= c.instagram_account.present? ? link_to("📷 #{c.instagram_account}", "https://instagram.com/#{c.instagram_account.gsub('@','')}", target: "_blank", class: "text-decoration-none small") : "" %></td>
                  <td class="text-muted small"><%= c.email %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
<% end %>

<%# ══════════════════════════════════════════════════════════════════════ %>
<%# 二、盒數組合分析                                                        %>
<%# ══════════════════════════════════════════════════════════════════════ %>
<% if @sku_by_event&.any? %>
  <div class="d-flex align-items-center mb-3">
    <div class="border-start border-3 border-primary ps-3">
      <h5 class="fw-bold mb-0 text-primary">📦 盒數組合分析</h5>
      <p class="text-muted small mb-0">各場次 SKU 拆分與跨場彙總</p>
    </div>
  </div>

  <div class="row g-3 mb-5">
    <% @sku_by_event.each do |ev_data| %>
      <% ev = ev_data[:event] %>
      <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-header text-white fw-bold" style="background-color: #3a5a8a;">
            <%= ev[:year] %>/<%= ev[:label] %> 場次
            <span class="ms-2 small opacity-75 fw-normal"><%= ev[:note] %></span>
          </div>
          <div class="card-body p-0">
            <table class="table align-middle mb-0 text-center" style="font-size: 0.875rem;">
              <thead class="table-light">
                <tr>
                  <th class="text-start ps-3">品項</th>
                  <th>盒數</th>
                  <th>買家</th>
                  <th>訂單</th>
                  <th>營業額</th>
                  <th>佔比</th>
                </tr>
              </thead>
              <tbody>
                <% ev_data[:skus].each do |s| %>
                  <tr>
                    <td class="text-start ps-3 fw-semibold"><%= s[:product_name] %></td>
                    <td><span class="badge bg-secondary"><%= s[:boxes] %> 盒</span></td>
                    <td><%= s[:buyers] %></td>
                    <td><%= s[:orders] %></td>
                    <td>NT$<%= number_with_delimiter(s[:revenue]) %></td>
                    <td>
                      <div class="d-flex align-items-center gap-1 justify-content-center">
                        <div style="width:50px; background:#e9ecef; border-radius:4px; height:8px; overflow:hidden;">
                          <div style="width:<%= s[:rev_pct] %>%; background:#3a5a8a; height:100%;"></div>
                        </div>
                        <span class="text-muted small"><%= s[:rev_pct] %>%</span>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
              <tfoot class="table-light fw-bold">
                <tr>
                  <td class="text-start ps-3" colspan="2">合計</td>
                  <td><%= ev_data[:total_buyers] %></td>
                  <td><%= ev_data[:total_orders] %></td>
                  <td>NT$<%= number_with_delimiter(ev_data[:total_revenue]) %></td>
                  <td>100%</td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<%# ══════════════════════════════════════════════════════════════════════ %>
<%# 三、本場購買名單（客戶價值分層）                                         %>
<%# ══════════════════════════════════════════════════════════════════════ %>
<% if @event_customers.any? %>
  <% vip_count   = @event_customers.count { |r| r[:value_tier] == "重點維護" } %>
  <% track_count = @event_customers.count { |r| r[:value_tier] == "值得追蹤" } %>
  <% basic_count = @event_customers.count { |r| r[:value_tier] == "一般客群" } %>

  <div class="d-flex align-items-center mb-3">
    <div class="border-start border-3 border-success ps-3">
      <h5 class="fw-bold mb-0 text-success">⭐ <%= @event_label %> 購買名單（所有卡別）</h5>
      <p class="text-muted small mb-0">本場核心客群，依客戶價值分層排列</p>
    </div>
  </div>

  <div class="row g-2 mb-3">
    <div class="col-4">
      <div class="vt-stat-card vt-vip" data-tier-filter="重點維護">
        <div class="vt-stat-icon">🏆</div>
        <div class="vt-stat-num"><%= vip_count %></div>
        <div class="vt-stat-label">重點維護</div>
        <div class="vt-stat-hint">分數 ≥ 12</div>
      </div>
    </div>
    <div class="col-4">
      <div class="vt-stat-card vt-track" data-tier-filter="值得追蹤">
        <div class="vt-stat-icon">📌</div>
        <div class="vt-stat-num"><%= track_count %></div>
        <div class="vt-stat-label">值得追蹤</div>
        <div class="vt-stat-hint">分數 7–11</div>
      </div>
    </div>
    <div class="col-4">
      <div class="vt-stat-card vt-basic" data-tier-filter="一般客群">
        <div class="vt-stat-icon">👤</div>
        <div class="vt-stat-num"><%= basic_count %></div>
        <div class="vt-stat-label">一般客群</div>
        <div class="vt-stat-hint">分數 &lt; 7</div>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-5">
    <div class="card-header text-white d-flex justify-content-between align-items-center"
         style="background-color: #2d5a3d;">
      <span class="fw-bold">本場購買名單</span>
      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-white text-dark" id="event-visible-count"><%= @event_customers.size %> 人</span>
        <%= link_to "⬇ 匯出 CSV", probiotic_export_event_path, class: "btn btn-sm btn-light fw-semibold" %>
      </div>
    </div>

    <div class="px-3 pt-3 pb-2 border-bottom bg-light d-flex align-items-center gap-2 flex-wrap">
      <span class="text-muted small fw-semibold me-1">篩選：</span>
      <button class="vt-filter-btn is-active" data-tier="all">全部</button>
      <button class="vt-filter-btn vt-btn-vip"   data-tier="重點維護">🏆 重點維護</button>
      <button class="vt-filter-btn vt-btn-track"  data-tier="值得追蹤">📌 值得追蹤</button>
      <button class="vt-filter-btn vt-btn-basic"  data-tier="一般客群">👤 一般客群</button>
    </div>

    <div class="px-3 pt-2 border-bottom">
      <ul class="nav nav-tabs" id="tabs-event">
        <% ProbioticAnalysisController::TARGET_MEMBERSHIPS.each do |level| %>
          <% key = level_keys[level] %>
          <% next if @event_customers.none? { |r| r[:customer].membership_level == level } %>
          <li class="nav-item">
            <button class="nav-link"
                    data-tab-prefix="event"
                    data-tab-target="event-<%= key %>"
                    type="button">
              <%= level %>
              <span class="badge bg-secondary">
                <%= @event_customers.count { |r| r[:customer].membership_level == level } %>
              </span>
            </button>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="card-body p-0">
      <% ProbioticAnalysisController::TARGET_MEMBERSHIPS.each do |level| %>
        <% key  = level_keys[level] %>
        <% rows = @event_customers.select { |r| r[:customer].membership_level == level } %>
        <% next if rows.empty? %>
        <div class="invite-pane" id="pane-event-<%= key %>" style="display: none;">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
              <thead class="table-light">
                <tr>
                  <th>客戶價值</th>
                  <th>姓名</th>
                  <th>卡別</th>
                  <th>購買品項</th>
                  <th>本次盒數</th>
                  <th>本次金額</th>
                  <th>整體消費力</th>
                  <th>益生菌歷史</th>
                  <th>IG</th>
                </tr>
              </thead>
              <tbody>
                <% rows.each do |r| %>
                  <% c = r[:customer] %>
                  <tr data-tier="<%= r[:value_tier] %>">
                    <td>
                      <span class="vt-badge vt-badge-<%= r[:value_tier] %>">
                        <%= r[:value_tier] == "重點維護" ? "🏆 重點維護" : r[:value_tier] == "值得追蹤" ? "📌 值得追蹤" : "👤 一般" %>
                      </span>
                    </td>
                    <td><%= link_to c.full_name, customer_path(c.id), target: "_blank", class: "fw-semibold text-decoration-none" %></td>
                    <td><span class="text-muted small"><%= c.membership_level %></span></td>
                    <td><%= r[:last_product] || "-" %></td>
                    <td class="text-center"><%= r[:bottles] %> 盒</td>
                    <td>NT$<%= number_with_delimiter(r[:order_amount].to_i) %></td>
                    <td class="fw-semibold">NT$<%= number_with_delimiter(r[:total_spend].to_i) %></td>
                    <td class="text-center text-muted"><%= r[:omni_count] %> 次</td>
                    <td>
                      <% if c.instagram_account.present? %>
                        <a href="https://instagram.com/<%= c.instagram_account.gsub('@','') %>" target="_blank" class="text-decoration-none">
                          📷 <%= c.instagram_account %>
                        </a>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%# ══════════════════════════════════════════════════════════════════════ %>
<%# 四、本週行動清單（最下面，要傳訊息的名單）                               %>
<%# ══════════════════════════════════════════════════════════════════════ %>
<% if @action_list&.any? %>
  <div class="d-flex align-items-center mb-3">
    <div class="border-start border-4 ps-3" style="border-color: #b91c1c !important;">
      <h5 class="fw-bold mb-0" style="color: #b91c1c;">📋 本週行動清單</h5>
      <p class="text-muted small mb-0">
        快用完、黑金流失、未回購整合成一份，同一人只出現一次，依最急迫理由排序
      </p>
    </div>
  </div>

  <div class="d-flex gap-2 flex-wrap mb-3">
    <% urgent = @action_list.count { |e| e[:best_rank] <= 2 } %>
    <% medium = @action_list.count { |e| e[:best_rank] == 3 || e[:best_rank] == 4 } %>
    <% normal = @action_list.count { |e| e[:best_rank] >= 5 } %>
    <span class="badge bg-danger fs-6 px-3 py-2">立即聯絡 <%= urgent %> 人</span>
    <span class="badge bg-warning text-dark fs-6 px-3 py-2">本週內 <%= medium %> 人</span>
    <span class="badge bg-secondary fs-6 px-3 py-2">追蹤中 <%= normal %> 人</span>
  </div>

  <div class="card border-0 shadow-sm mb-5">
    <div class="card-header text-white d-flex justify-content-between align-items-center"
         style="background-color: #7f1d1d;">
      <span class="fw-bold">行動清單（共 <%= @action_list.size %> 人）</span>
      <div class="d-flex align-items-center gap-2">
        <span class="text-white-50 small d-none d-md-inline">同一人若有多個理由，全部列在同一列</span>
        <%= link_to "⬇ 匯出 CSV", probiotic_export_action_path, class: "btn btn-sm btn-light fw-semibold" %>
      </div>
    </div>
    <div class="table-responsive" data-paginate="true" data-page-size="20">
      <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
        <thead class="table-light">
          <tr>
            <th style="width: 2.5rem;">#</th>
            <th>姓名</th>
            <th>卡別</th>
            <th>聯絡理由</th>
            <th>IG</th>
          </tr>
        </thead>
        <tbody>
          <% @action_list.each_with_index do |e, i| %>
            <% c    = e[:customer] %>
            <% rank = e[:best_rank] %>
            <tr>
              <td>
                <span class="badge <%= rank <= 2 ? 'bg-danger' : rank <= 4 ? 'bg-warning text-dark' : 'bg-light text-muted' %>">
                  <%= i + 1 %>
                </span>
              </td>
              <td>
                <%= link_to c.full_name, customer_path(c.id), target: "_blank", class: "fw-semibold text-decoration-none" %>
              </td>
              <td><span class="text-muted small"><%= c.membership_level %></span></td>
              <td>
                <div class="d-flex flex-column gap-1">
                  <% e[:reasons].each do |r| %>
                    <div>
                      <span class="badge <%= r[:badge].include?('已用完') ? 'bg-danger' :
                                            r[:badge].include?('流失')   ? 'bg-danger bg-opacity-75' :
                                            r[:badge].include?('剩 ') && r[:badge].match?(/剩 [0-7] 天/) ? 'bg-warning text-dark' :
                                            'bg-secondary' %>
                            me-1 fw-semibold" style="font-size: 0.75rem;">
                        <%= r[:badge] %>
                      </span>
                      <span class="text-muted small"><%= r[:detail] %></span>
                    </div>
                  <% end %>
                </div>
              </td>
              <td>
                <% if c.instagram_account.present? %>
                  <%= link_to "📷 #{c.instagram_account}",
                        "https://instagram.com/#{c.instagram_account.gsub('@', '')}",
                        target: "_blank", class: "text-decoration-none small" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<script>
let currentTierFilter = 'all';

document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('[id^="tabs-"]').forEach(function (tabGroup) {
    const firstBtn = tabGroup.querySelector('.nav-link');
    if (firstBtn) activateTab(firstBtn);
  });

  document.querySelectorAll('.vt-stat-card[data-tier-filter]').forEach(function (card) {
    card.addEventListener('click', function () {
      const tier = card.dataset.tierFilter;
      applyTierFilter(currentTierFilter === tier ? 'all' : tier);
    });
  });

  document.querySelectorAll('.vt-filter-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      applyTierFilter(btn.dataset.tier);
    });
  });

  document.querySelectorAll('[data-paginate="true"]').forEach(function (wrapper) {
    if (!wrapper.dataset.paginated) initPaginate(wrapper);
  });
});

function applyTierFilter(tier) {
  currentTierFilter = tier;

  document.querySelectorAll('.vt-filter-btn').forEach(function (btn) {
    btn.classList.toggle('is-active', btn.dataset.tier === tier);
  });
  document.querySelectorAll('.vt-stat-card[data-tier-filter]').forEach(function (card) {
    card.classList.toggle('is-active', card.dataset.tierFilter === tier);
  });

  let visibleCount = 0;
  document.querySelectorAll('[id^="pane-event-"] tbody tr[data-tier]').forEach(function (row) {
    const show = tier === 'all' || row.dataset.tier === tier;
    row.style.display = show ? '' : 'none';
    if (show) visibleCount++;
  });

  const countBadge = document.getElementById('event-visible-count');
  if (countBadge) countBadge.textContent = visibleCount + ' 人';
}

function activateTab(btn) {
  const prefix   = btn.dataset.tabPrefix;
  const targetId = btn.dataset.tabTarget;

  document.querySelectorAll(`[id^="pane-${prefix}-"]`).forEach(function (p) {
    p.style.display = 'none';
  });
  document.querySelectorAll(`#tabs-${prefix} .nav-link`).forEach(function (b) {
    b.classList.remove('active');
  });

  const target = document.getElementById('pane-' + targetId);
  if (target) {
    target.style.display = 'block';
    if (prefix === 'event' && currentTierFilter !== 'all') {
      target.querySelectorAll('tbody tr[data-tier]').forEach(function (row) {
        row.style.display = row.dataset.tier === currentTierFilter ? '' : 'none';
      });
    }
    target.querySelectorAll('[data-paginate="true"]').forEach(function (wrapper) {
      if (!wrapper.dataset.paginated) initPaginate(wrapper);
    });
  }
  btn.classList.add('active');
}

document.addEventListener('click', function (e) {
  const btn = e.target.closest('[data-tab-target]');
  if (btn) activateTab(btn);
});

function initPaginate(wrapper) {
  wrapper.dataset.paginated = 'true';
  const pageSize = parseInt(wrapper.dataset.pageSize) || 20;
  const tbody    = wrapper.querySelector('tbody');
  if (!tbody) return;

  const allRows  = Array.from(tbody.querySelectorAll('tr'));
  if (allRows.length <= pageSize) return;

  const totalPages = Math.ceil(allRows.length / pageSize);
  const pane       = wrapper.closest('.invite-pane') || wrapper.parentNode;

  function renderPage(page) {
    allRows.forEach(function (row, i) {
      row.style.display = (i >= (page - 1) * pageSize && i < page * pageSize) ? '' : 'none';
    });

    const old = pane.querySelector('.paginate-controls');
    if (old) old.remove();

    const ctrl = document.createElement('div');
    ctrl.className = 'paginate-controls d-flex justify-content-between align-items-center px-3 py-2 border-top bg-light';
    ctrl.style.fontSize = '0.85rem';

    const info  = document.createElement('span');
    info.className = 'text-muted';
    const start = (page - 1) * pageSize + 1;
    const end   = Math.min(page * pageSize, allRows.length);
    info.textContent = `第 ${start}–${end} 筆，共 ${allRows.length} 筆`;

    const btns = document.createElement('div');
    btns.className = 'd-flex gap-1 flex-wrap';

    const prev = document.createElement('button');
    prev.className = 'btn btn-sm btn-outline-secondary py-0';
    prev.textContent = '‹';
    prev.disabled = page === 1;
    prev.addEventListener('click', function () { renderPage(page - 1); });
    btns.appendChild(prev);

    const startPage = Math.max(1, page - 2);
    const endPage   = Math.min(totalPages, startPage + 4);

    for (let p = startPage; p <= endPage; p++) {
      const pb = document.createElement('button');
      pb.className = 'btn btn-sm py-0 ' + (p === page ? 'btn-secondary' : 'btn-outline-secondary');
      pb.textContent = p;
      const captured = p;
      pb.addEventListener('click', function () { renderPage(captured); });
      btns.appendChild(pb);
    }

    const next = document.createElement('button');
    next.className = 'btn btn-sm btn-outline-secondary py-0';
    next.textContent = '›';
    next.disabled = page === totalPages;
    next.addEventListener('click', function () { renderPage(page + 1); });
    btns.appendChild(next);

    ctrl.appendChild(info);
    ctrl.appendChild(btns);
    pane.appendChild(ctrl);
  }

  renderPage(1);
}
</script>

