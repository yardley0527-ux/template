<% content_for :page_title, "產品拍片主題" %>

<div class="subheader">
  <h1 class="subheader-title">
    <i class="fal fa-video mr-2 text-danger"></i> 產品拍片主題
  </h1>
</div>

<p class="text-muted small mb-3">
  每個產品的影片方向與知識型主題，每個區塊有幾個主題，點主題頁籤可切換看各自的分鏡、照片準備與拍攝重點。這份內容目前是手動維護，新增產品時要請 Claude 加進 <code>config/video_topics.yml</code>。
</p>

<% if @product.blank? %>
  <div class="panel">
    <div class="panel-content text-center py-5 text-muted">
      <i class="fal fa-video fa-3x mb-3 d-block opacity-25"></i>
      尚無任何拍片主題
    </div>
  </div>
<% else %>
  <% directions = @product["directions"].to_a %>

  <ul class="nav nav-pills mb-3">
    <% @products.each do |product| %>
      <li class="nav-item">
        <%= link_to video_topics_path(product: product["key"]),
              class: "nav-link #{'active' if product["key"] == @product["key"]}" do %>
          <%= product["name"] %>
          <% if product["label"].present? %><span class="small opacity-75">（<%= product["label"] %>）</span><% end %>
          <span class="badge badge-light ml-1"><%= product["directions"].to_a.sum { |d| d["scripts"].to_a.size } + product["knowledge_topics"].to_a.size %></span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <div class="d-flex flex-wrap mb-3">
    <% directions.each_with_index do |direction, i| %>
      <a href="#topic-<%= i %>" class="btn btn-sm btn-outline-secondary mr-2 mb-2">
        <%= video_topic_number(i) %> <%= direction["name"] %>
        <span class="badge badge-light ml-1"><%= direction["scripts"].to_a.size %></span>
      </a>
    <% end %>
    <% if @product["knowledge_topics"].present? %>
      <a href="#knowledge-topics" class="btn btn-sm btn-outline-secondary mr-2 mb-2">
        <i class="fal fa-book-open mr-1"></i>知識型主題
        <span class="badge badge-light ml-1"><%= @product["knowledge_topics"].size %></span>
      </a>
    <% end %>
  </div>

  <% first_batch = directions.each_with_index.flat_map { |d, i| d["scripts"].to_a.each_with_index.select { |sc, _| sc["first_batch"] }.map { |sc, j| [sc, "topic-#{i}-#{j}"] } } %>
  <% series = Hash.new { |h, k| h[k] = [] } %>
  <% directions.each_with_index { |d, i| d["scripts"].to_a.each_with_index { |sc, j| series[sc["series"]] << [sc, "topic-#{i}-#{j}"] if sc["series"].present? } } %>
  <% @product["knowledge_topics"].to_a.each_with_index { |sc, j| series[sc["series"]] << [sc, "knowledge-#{j}"] if sc["series"].present? } %>
  <% if series.any? %>
    <div class="alert alert-warning mb-3">
      <div class="fw-500 mb-2"><i class="fal fa-layer-group mr-1"></i>固定系列（同系列用同樣的開場與名稱，讓觀眾認得、會追）</div>
      <% series.each do |name, items| %>
        <div class="mb-1">
          <span class="badge badge-warning mr-1"><%= name %></span>
          <span class="text-muted small mr-1"><%= VideoTopicsHelper::SERIES[name] %></span>
          <% items.each_with_index do |(sc, anchor), n| %><%= "、" if n.positive? %><a href="#<%= anchor %>"><%= sc["tab"].presence || sc["title"] %></a><% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if first_batch.any? %>
    <div class="alert alert-danger mb-3">
      <div class="fw-500 mb-2"><i class="fal fa-star mr-1"></i>第一批建議先拍（<%= first_batch.size %> 支）</div>
      <ol class="mb-0 pl-3">
        <% first_batch.each do |sc, anchor| %>
          <li><a href="#<%= anchor %>" class="text-danger"><%= sc["title"] %></a></li>
        <% end %>
      </ol>
    </div>
  <% end %>

  <% directions.each_with_index do |direction, i| %>
    <% scripts = direction["scripts"].to_a %>
    <div class="panel" id="topic-<%= i %>">
      <div class="panel-hdr">
        <h2><%= video_topic_number(i) %>&nbsp;<%= direction["name"] %></h2>
        <span class="text-muted small mr-3"><%= scripts.size %> 個主題</span>
      </div>
      <div class="panel-container show">
        <div class="panel-content">
          <% if direction["intro"].present? %>
            <p class="text-muted mb-3"><%= video_topic_text(direction["intro"]) %></p>
          <% end %>
          <%= render "script_tabs", scripts: scripts, prefix: "topic-#{i}", headers: @product["shot_headers"] %>
        </div>
      </div>
    </div>
  <% end %>

  <% if @product["knowledge_topics"].present? %>
    <div class="panel" id="knowledge-topics">
      <div class="panel-hdr">
        <h2><i class="fal fa-book-open mr-2"></i>知識型主題</h2>
        <span class="text-muted small mr-3"><%= @product["knowledge_topics"].size %> 個主題</span>
      </div>
      <div class="panel-container show">
        <div class="panel-content">
          <%= render "script_tabs", scripts: @product["knowledge_topics"], prefix: "knowledge", headers: @product["shot_headers"] %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>

<% content_for :scripts_block do %>
  <script>
    (function () {
      // 網址帶 #topic-1-2 或 #knowledge-0 時，直接打開那個主題的頁籤並捲過去
      function openFromHash() {
        var m = window.location.hash.match(/^#(topic-\d+|knowledge)-\d+$/);
        if (!m) return;
        var link = document.querySelector('a[data-toggle="tab"][href="' + m[0] + '"]');
        if (!link) return;
        $(link).tab('show');
        var panel = link.closest('.panel');
        if (panel) panel.scrollIntoView();
      }
      document.addEventListener('turbolinks:load', openFromHash, { once: true });
      window.addEventListener('hashchange', openFromHash);
      // 切換頁籤時更新網址，方便把某個主題的連結傳給拍攝的人
      $(document).off('shown.bs.tab.videoTopics').on('shown.bs.tab.videoTopics', 'a[data-toggle="tab"]', function (e) {
        var href = e.target.getAttribute('href');
        if (/^#(topic-\d+|knowledge)-\d+$/.test(href)) history.replaceState(history.state, '', href);
      });
    })();
  </script>
<% end %>
