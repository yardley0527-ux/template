<% content_for :page_title, "產品拍片主題" %>

<div class="subheader">
  <h1 class="subheader-title">
    <i class="fal fa-video mr-2 text-danger"></i> 產品拍片主題
  </h1>
</div>

<p class="text-muted small mb-3">
  每個產品的影片方向，每個方向有幾個主題，點主題頁籤可切換看各自的分鏡、照片準備與拍攝重點。這份內容目前是手動維護，新增產品時要請 Claude 加進 <code>config/video_topics.yml</code>。
</p>

<% if @product.blank? %>
  <div class="panel">
    <div class="panel-content text-center py-5 text-muted">
      <i class="fal fa-video fa-3x mb-3 d-block opacity-25"></i>
      尚無任何拍片主題
    </div>
  </div>
<% else %>
  <% directions = @product["directions"].to_a %>

  <ul class="nav nav-pills mb-3">
    <% @products.each do |product| %>
      <li class="nav-item">
        <%= link_to video_topics_path(product: product["key"]),
              class: "nav-link #{'active' if product["key"] == @product["key"]}" do %>
          <%= product["name"] %>
          <% if product["label"].present? %><span class="small opacity-75">（<%= product["label"] %>）</span><% end %>
          <span class="badge badge-light ml-1"><%= product["directions"].to_a.sum { |d| d["scripts"].to_a.size } %></span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <div class="d-flex flex-wrap mb-3">
    <% directions.each_with_index do |direction, i| %>
      <a href="#topic-<%= i %>" class="btn btn-sm btn-outline-secondary mr-2 mb-2">
        <%= video_topic_number(i) %> <%= direction["name"] %>
        <span class="badge badge-light ml-1"><%= direction["scripts"].to_a.size %></span>
      </a>
    <% end %>
    <% if @product["knowledge_topics"].present? %>
      <a href="#knowledge-topics" class="btn btn-sm btn-outline-secondary mr-2 mb-2">
        <i class="fal fa-book-open mr-1"></i>知識型主題
      </a>
    <% end %>
  </div>

  <% directions.each_with_index do |direction, i| %>
    <% scripts = direction["scripts"].to_a %>
    <div class="panel" id="topic-<%= i %>">
      <div class="panel-hdr">
        <h2><%= video_topic_number(i) %>&nbsp;<%= direction["name"] %></h2>
        <span class="text-muted small mr-3"><%= scripts.size %> 個主題</span>
      </div>
      <div class="panel-container show">
        <div class="panel-content">
          <ul class="nav nav-tabs" role="tablist">
            <% scripts.each_with_index do |script, j| %>
              <li class="nav-item">
                <a class="nav-link <%= 'active' if j.zero? %>" data-toggle="tab" role="tab"
                   href="#topic-<%= i %>-<%= j %>" style="max-width:340px; white-space:normal;">
                  <strong><%= video_topic_number(j) %></strong> <%= script["title"] %>
                </a>
              </li>
            <% end %>
          </ul>

          <div class="tab-content border border-top-0 rounded-bottom p-3">
            <% scripts.each_with_index do |script, j| %>
              <div class="tab-pane fade <%= 'show active' if j.zero? %>" id="topic-<%= i %>-<%= j %>" role="tabpanel">
                <div class="d-flex flex-wrap align-items-start justify-content-between mb-3">
                  <div class="mr-3">
                    <div class="fs-lg fw-500"><%= video_topic_text(script["title"]) %></div>
                    <% if script["subtitle"].present? %>
                      <div class="text-muted mt-1">副標：<%= video_topic_text(script["subtitle"]) %></div>
                    <% end %>
                  </div>
                  <div class="mt-1">
                    <% if script["format"].present? %>
                      <span class="badge badge-primary"><i class="fal fa-camera mr-1"></i>拍法：<%= script["format"] %></span>
                    <% end %>
                    <% if script["duration"].present? %>
                      <span class="badge badge-info"><i class="fal fa-clock mr-1"></i>建議片長 <%= script["duration"] %></span>
                    <% end %>
                  </div>
                </div>

                <% if script["follow_up"].present? || script["approach"].present? %>
                  <div class="row">
                    <% if script["follow_up"].present? %>
                      <div class="col-md-5 mb-3">
                        <div class="text-muted small mb-1">內容怎麼接下去</div>
                        <div><%= video_topic_text(script["follow_up"]) %></div>
                      </div>
                    <% end %>
                    <% if script["approach"].present? %>
                      <div class="col-md-7 mb-3">
                        <div class="text-muted small mb-1">切入方式</div>
                        <div><%= video_topic_text(script["approach"]) %></div>
                      </div>
                    <% end %>
                  </div>
                <% end %>

                <% if script["shots"].present? %>
                  <div class="text-muted small mb-1">分鏡</div>
                  <div class="table-responsive mb-3">
                    <table class="table table-bordered table-sm mb-0">
                      <thead class="thead-light">
                        <tr>
                          <th class="text-nowrap" style="width:90px;">分鏡／時間</th>
                          <th>鏡頭與動作</th>
                          <th>講解方向</th>
                          <th>圖片／字幕建議</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% script["shots"].each_with_index do |shot, s| %>
                          <tr>
                            <td class="text-nowrap"><strong><%= s + 1 %></strong>｜<%= shot["time"] %></td>
                            <td><%= video_topic_text(shot["camera"]) %></td>
                            <td><%= video_topic_text(shot["talk"]) %></td>
                            <td><%= video_topic_text(shot["visual"]) %></td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                <% end %>

                <% boosts = [
                     ["owner_story",   "fa-user",        "老闆經驗切入（有真實經驗再用）"],
                     ["cta",           "fa-comment-dots", "結尾互動問句"],
                     ["short_version", "fa-cut",          "15–20 秒短版剪法"],
                   ].select { |key, _, _| script[key].present? } %>
                <% if boosts.any? %>
                  <div class="row">
                    <% boosts.each do |key, icon, label| %>
                      <div class="col-md mb-3">
                        <div class="card h-100 border-success">
                          <div class="card-body py-2 px-3">
                            <div class="text-success small fw-500 mb-1"><i class="fal <%= icon %> mr-1"></i><%= label %></div>
                            <div><%= video_topic_text(script[key]) %></div>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% end %>

                <% script["extra_sections"].to_a.each do |section| %>
                  <div class="alert alert-info mb-3">
                    <div class="fw-500 mb-1"><i class="fal fa-flask mr-1"></i><%= section["heading"] %></div>
                    <% section["paragraphs"].to_a.each do |para| %>
                      <p class="mb-1"><%= video_topic_text(para) %></p>
                    <% end %>
                  </div>
                <% end %>

                <div class="row">
                  <% if script["photos"].present? %>
                    <div class="col-md-6 mb-3 mb-md-0">
                      <div class="text-muted small mb-1"><i class="fal fa-images mr-1"></i>照片準備</div>
                      <ul class="mb-0 pl-3">
                        <% script["photos"].each do |photo| %>
                          <li><%= video_topic_text(photo) %></li>
                        <% end %>
                      </ul>
                    </div>
                  <% end %>
                  <% if script["notes"].present? %>
                    <div class="col-md-6">
                      <div class="alert alert-warning mb-0">
                        <div class="fw-500 mb-1"><i class="fal fa-exclamation-triangle mr-1"></i>拍攝重點</div>
                        <%= video_topic_text(script["notes"]) %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <% if @product["knowledge_topics"].present? %>
    <div class="panel" id="knowledge-topics">
      <div class="panel-hdr">
        <h2><i class="fal fa-book-open mr-2"></i>知識型主題</h2>
        <span class="text-muted small mr-3">沒有分鏡，只列可以拍的題目</span>
      </div>
      <div class="panel-container show">
        <div class="panel-content">
          <div class="row">
            <% @product["knowledge_topics"].each do |kt| %>
              <div class="col-md-6 col-xl-4 mb-3">
                <div class="card h-100">
                  <div class="card-header py-2 fw-500"><%= video_topic_text(kt["title"]) %></div>
                  <div class="card-body py-2">
                    <ul class="mb-0 pl-3">
                      <% kt["questions"].to_a.each do |q| %>
                        <li><%= video_topic_text(q) %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
<% end %>

<% content_for :scripts_block do %>
  <script>
    (function () {
      // 網址帶 #topic-1-2 時，直接打開那個主題的頁籤並捲過去
      function openFromHash() {
        var m = window.location.hash.match(/^#topic-\d+-\d+$/);
        if (!m) return;
        var link = document.querySelector('a[data-toggle="tab"][href="' + m[0] + '"]');
        if (!link) return;
        $(link).tab('show');
        var panel = link.closest('.panel');
        if (panel) panel.scrollIntoView();
      }
      document.addEventListener('turbolinks:load', openFromHash, { once: true });
      window.addEventListener('hashchange', openFromHash);
      // 切換頁籤時更新網址，方便把某個主題的連結傳給拍攝的人
      $(document).off('shown.bs.tab.videoTopics').on('shown.bs.tab.videoTopics', 'a[data-toggle="tab"]', function (e) {
        var href = e.target.getAttribute('href');
        if (/^#topic-\d+-\d+$/.test(href)) history.replaceState(history.state, '', href);
      });
    })();
  </script>
<% end %>
