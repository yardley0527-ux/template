<% content_for :page_title, "產品拍片主題" %>

<div class="subheader">
  <h1 class="subheader-title">
    <i class="fal fa-video mr-2 text-danger"></i> 產品拍片主題
  </h1>
</div>

<p class="text-muted small mb-3">
  每個產品的影片方向、分鏡、照片準備與拍攝注意事項。這份內容目前是手動維護，新增產品時要請 Claude 加進 <code>config/video_topics.yml</code>。
</p>

<% if @product.blank? %>
  <div class="panel">
    <div class="panel-content text-center py-5 text-muted">
      <i class="fal fa-video fa-3x mb-3 d-block opacity-25"></i>
      尚無任何拍片主題
    </div>
  </div>
<% else %>
  <ul class="nav nav-pills mb-3">
    <% @products.each do |product| %>
      <li class="nav-item">
        <%= link_to video_topics_path(product: product["key"]),
              class: "nav-link #{'active' if product["key"] == @product["key"]}" do %>
          <%= product["name"] %>
          <% if product["label"].present? %><span class="small opacity-75">（<%= product["label"] %>）</span><% end %>
          <span class="badge badge-light ml-1"><%= product["topics"].to_a.size %></span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <% topics = @product["topics"].to_a %>

  <div class="d-flex flex-wrap mb-3">
    <% topics.each_with_index do |topic, i| %>
      <a href="#topic-<%= i %>" class="btn btn-sm btn-outline-secondary mr-2 mb-2">
        <%= video_topic_number(i) %> <%= topic["direction"] %>
      </a>
    <% end %>
  </div>

  <% topics.each_with_index do |topic, i| %>
    <div class="panel" id="topic-<%= i %>">
      <div class="panel-hdr">
        <h2>
          <%= video_topic_number(i) %>&nbsp;<%= topic["direction"] %>
        </h2>
        <% if topic["duration"].present? %>
          <span class="badge badge-info mr-3"><i class="fal fa-clock mr-1"></i>建議片長 <%= topic["duration"] %></span>
        <% end %>
      </div>
      <div class="panel-container show">
        <div class="panel-content">
          <div class="mb-3">
            <div class="text-muted small mb-1">主題</div>
            <div class="fs-lg fw-500"><%= video_topic_text(topic["title"]) %></div>
            <% if topic["subtitle"].present? %>
              <div class="text-muted mt-1">副標：<%= video_topic_text(topic["subtitle"]) %></div>
            <% end %>
          </div>

          <% if topic["approach"].present? %>
            <div class="mb-3">
              <div class="text-muted small mb-1">切入方式</div>
              <div><%= video_topic_text(topic["approach"]) %></div>
            </div>
          <% end %>

          <% if topic["shots"].present? %>
            <div class="text-muted small mb-1">分鏡</div>
            <div class="table-responsive mb-3">
              <table class="table table-bordered table-sm mb-0">
                <thead class="thead-light">
                  <tr>
                    <th class="text-nowrap" style="width:90px;">分鏡／時間</th>
                    <th>鏡頭與動作</th>
                    <th>講解方向</th>
                    <th>圖片／字幕建議</th>
                  </tr>
                </thead>
                <tbody>
                  <% topic["shots"].each_with_index do |shot, s| %>
                    <tr>
                      <td class="text-nowrap"><strong><%= s + 1 %></strong>｜<%= shot["time"] %></td>
                      <td><%= video_topic_text(shot["camera"]) %></td>
                      <td><%= video_topic_text(shot["talk"]) %></td>
                      <td><%= video_topic_text(shot["visual"]) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>

          <% topic["extra_sections"].to_a.each do |section| %>
            <div class="alert alert-info mb-3">
              <div class="fw-500 mb-1"><i class="fal fa-flask mr-1"></i><%= section["heading"] %></div>
              <% section["paragraphs"].to_a.each do |para| %>
                <p class="mb-1"><%= video_topic_text(para) %></p>
              <% end %>
            </div>
          <% end %>

          <div class="row">
            <% if topic["photos"].present? %>
              <div class="col-md-6 mb-3">
                <div class="text-muted small mb-1"><i class="fal fa-images mr-1"></i>照片準備</div>
                <ul class="mb-0 pl-3">
                  <% topic["photos"].each do |photo| %>
                    <li><%= video_topic_text(photo) %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
            <% if topic["notes"].present? %>
              <div class="col-md-6 mb-3">
                <div class="alert alert-warning mb-0">
                  <div class="fw-500 mb-1"><i class="fal fa-exclamation-triangle mr-1"></i>拍攝重點</div>
                  <%= video_topic_text(topic["notes"]) %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

<% end %>
