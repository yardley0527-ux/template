<%# app/views/stickiness_results/index.html.erb %>
<% content_for :page_title, "黏著度成效" %>

<% def ig_link_url(account)
  return nil if account.blank?
  handle = account.strip.gsub(/^@/, '').gsub(%r{https?://(?:www\.)?instagram\.com/?}, '').gsub(%r{/$}, '').strip
  handle.present? ? "https://www.instagram.com/#{handle}/" : nil
end %>

<%# Header %>
<div class="row g-3 mb-3">
  <div class="col-12 d-flex align-items-center justify-content-between flex-wrap" style="gap:12px;">
    <div>
      <h4 class="fw-bold mb-0">黏著度成效</h4>
      <p class="text-muted small mb-0">已追蹤（有填黏著度備註）的客人，追蹤後是否回購同系列產品</p>
    </div>
    <div class="d-flex align-items-center flex-wrap" style="gap:8px;">
      <%
        today = Date.current
        range_presets = {
          "本週" => [today.beginning_of_week, today.end_of_week],
          "上週" => [(today - 1.week).beginning_of_week, (today - 1.week).end_of_week],
          "本月" => [today.beginning_of_month, today.end_of_month],
          "上月" => [(today - 1.month).beginning_of_month, (today - 1.month).end_of_month],
        }
      %>
      <% range_presets.each do |label, (from, to)| %>
        <% active = @start_date == from && @end_date == to %>
        <%= link_to label,
              stickiness_results_path(tab: @tab, start_date: from, end_date: to),
              class: "btn btn-sm #{active ? 'btn-primary' : 'btn-outline-secondary'}" %>
      <% end %>
      <%= form_tag stickiness_results_path, method: :get, class: "d-flex align-items-center flex-wrap", style: "gap:8px;" do %>
        <%= hidden_field_tag :tab, @tab %>
        <span class="text-muted small">追蹤日期</span>
        <input type="date" name="start_date" value="<%= @start_date&.strftime('%Y-%m-%d') %>" class="form-control form-control-sm">
        <span class="text-muted small">至</span>
        <input type="date" name="end_date" value="<%= @end_date&.strftime('%Y-%m-%d') %>" class="form-control form-control-sm">
        <button type="submit" class="btn btn-sm btn-primary">查詢</button>
        <% if @start_date.present? %>
          <%= link_to "清除", stickiness_results_path(tab: @tab), class: "btn btn-sm btn-outline-secondary" %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<%# 成效統計：已追蹤=灰（分母）、已回購=綠（成果）、間隔=藍（參考）、營業額=品牌棕（重點） %>
<div class="d-flex flex-wrap mb-3" style="gap:10px;">
  <div class="d-flex align-items-center px-3 py-2" style="background:#fff; border:1px solid #e9e2d8; border-left:4px solid #6c757d; border-radius:10px; gap:10px; box-shadow:0 1px 2px rgba(78,51,32,.05); min-width:150px;">
    <div class="d-flex align-items-center justify-content-center" style="width:34px; height:34px; border-radius:8px; background:#eef0f2; flex-shrink:0;">
      <i class="fal fa-user-check" style="color:#6c757d; font-size:1rem;"></i>
    </div>
    <div>
      <div class="text-muted" style="font-size:0.75rem;">已追蹤</div>
      <div class="fw-bold" style="font-size:1.05rem; color:#2f2a24;"><%= @stats[:tracked] %> 人</div>
    </div>
  </div>
  <div class="d-flex align-items-center px-3 py-2" style="background:#fff; border:1px solid #e9e2d8; border-left:4px solid #188038; border-radius:10px; gap:10px; box-shadow:0 1px 2px rgba(78,51,32,.05); min-width:150px;">
    <div class="d-flex align-items-center justify-content-center" style="width:34px; height:34px; border-radius:8px; background:#e8f4ea; flex-shrink:0;">
      <i class="fal fa-redo" style="color:#188038; font-size:1rem;"></i>
    </div>
    <div>
      <div class="text-muted" style="font-size:0.75rem;">已回購</div>
      <div class="fw-bold" style="font-size:1.05rem; color:#2f2a24;">
        <%= @stats[:repurchased] %> 人
        <% if @stats[:rate] %>
          <span style="font-size:0.85rem; color:#188038;">（<%= @stats[:rate] %>%）</span>
        <% end %>
      </div>
    </div>
  </div>
  <div class="d-flex align-items-center px-3 py-2" style="background:#fff; border:1px solid #e9e2d8; border-left:4px solid #2a78d6; border-radius:10px; gap:10px; box-shadow:0 1px 2px rgba(78,51,32,.05); min-width:150px;">
    <div class="d-flex align-items-center justify-content-center" style="width:34px; height:34px; border-radius:8px; background:#eaf1fb; flex-shrink:0;">
      <i class="fal fa-hourglass-half" style="color:#2a78d6; font-size:1rem;"></i>
    </div>
    <div>
      <div class="text-muted" style="font-size:0.75rem;">平均回購間隔</div>
      <div class="fw-bold" style="font-size:1.05rem; color:#2f2a24;"><%= @stats[:avg_days] ? "#{@stats[:avg_days]} 天" : "—" %></div>
    </div>
  </div>
  <div class="d-flex align-items-center px-3 py-2" style="background:#f9f3ea; border:1px solid #e4d3bd; border-left:4px solid #8f6340; border-radius:10px; gap:10px; box-shadow:0 1px 2px rgba(78,51,32,.05); min-width:170px;">
    <div class="d-flex align-items-center justify-content-center" style="width:34px; height:34px; border-radius:8px; background:#f0e2cf; flex-shrink:0;">
      <i class="fal fa-dollar-sign" style="color:#8f6340; font-size:1rem;"></i>
    </div>
    <div>
      <div class="text-muted" style="font-size:0.75rem;">回購帶回營業額</div>
      <div class="fw-bold" style="font-size:1.05rem; color:#6e4a2e;">NT$<%= number_with_delimiter(@stats[:revenue]) %></div>
    </div>
  </div>
</div>

<%# 依卡別回購成效：業績/人數雙欄長條（口徑同上方統計卡，跟著追蹤日期篩選，不受下方 tab 影響）%>
<% if @level_stats.present? %>
  <%
    max_revenue = [@level_stats.map { |s| s[:revenue] }.max, 1].compact.max
    max_list    = [@level_stats.map { |s| s[:list_count] }.max, 1].compact.max
  %>
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white d-flex align-items-center justify-content-between flex-wrap" style="gap:8px;">
      <span class="fw-bold">依卡別回購成效</span>
      <span class="text-muted" style="font-size:0.75rem;">
        回購＝追蹤後再次購買追蹤前買過的系列・<%= @start_date.present? ? "追蹤日 #{@start_date.strftime('%Y/%m/%d')}〜#{@end_date.strftime('%Y/%m/%d')}" : "全部期間" %>
      </span>
    </div>
    <div class="card-body pt-3">
      <div style="overflow-x:auto;">
        <div style="display:grid; grid-template-columns:72px minmax(180px,1fr) minmax(180px,1fr); column-gap:24px; row-gap:14px; align-items:center; min-width:560px;">
          <div></div>
          <div class="text-muted" style="font-size:0.75rem;">回購業績</div>
          <div class="text-muted" style="font-size:0.75rem;">回購人數／已追蹤人數</div>

          <% @level_stats.each do |s| %>
            <%
              rate    = s[:list_count].zero? ? 0 : (s[:repurchase_count] * 100.0 / s[:list_count]).round
              tooltip = "#{s[:level]}：回購 #{s[:repurchase_count]}/#{s[:list_count]} 人（#{rate}%）・業績 NT$#{number_with_delimiter(s[:revenue])}"
              badge_bg, badge_fg = case s[:level]
                                   when '黑卡' then ['#333', '#fff']
                                   when '金卡' then ['#b8860b', '#fff']
                                   when '銀卡' then ['#6c757d', '#fff']
                                   when '白卡' then ['#dee2e6', '#333']
                                   else             ['#adb5bd', '#333']
                                   end
            %>
            <div title="<%= tooltip %>">
              <span class="badge" style="background:<%= badge_bg %>; color:<%= badge_fg %>; font-size:0.75rem;"><%= s[:level] %></span>
            </div>
            <div class="d-flex align-items-center" style="gap:8px; min-width:0;" title="<%= tooltip %>">
              <% if s[:revenue] > 0 %>
                <div style="height:16px; width:<%= (s[:revenue] * 100.0 / max_revenue).round(1) %>%; min-width:4px; background:#8f6340; border-radius:0 4px 4px 0; flex-shrink:0;"></div>
                <span style="font-size:0.8rem; color:#2f2a24; white-space:nowrap;">NT$<%= number_with_delimiter(s[:revenue]) %></span>
              <% else %>
                <div style="height:16px; width:2px; background:#e9e2d8; flex-shrink:0;"></div>
                <span class="text-muted" style="font-size:0.8rem;">NT$0</span>
              <% end %>
            </div>
            <div class="d-flex align-items-center" style="gap:8px; min-width:0;" title="<%= tooltip %>">
              <div style="height:16px; width:<%= (s[:list_count] * 100.0 / max_list).round(1) %>%; min-width:8px; background:#f0e7db; border-radius:0 4px 4px 0; position:relative; flex-shrink:0;">
                <% if s[:repurchase_count] > 0 %>
                  <div style="position:absolute; left:0; top:0; height:100%; width:<%= (s[:repurchase_count] * 100.0 / s[:list_count]).round(1) %>%; min-width:4px; background:#8f6340; border-radius:0 4px 4px 0;"></div>
                <% end %>
              </div>
              <span style="font-size:0.8rem; color:#2f2a24; white-space:nowrap;">
                <%= s[:repurchase_count] %>/<%= s[:list_count] %><span class="text-muted">（<%= rate %>%）</span>
              </span>
            </div>
          <% end %>
        </div>
      </div>

      <div class="d-flex align-items-center mt-3" style="gap:14px; font-size:0.72rem; color:#8a8073;">
        <span class="d-flex align-items-center" style="gap:5px;">
          <span style="width:12px; height:12px; background:#8f6340; border-radius:3px; display:inline-block;"></span>已回購
        </span>
        <span class="d-flex align-items-center" style="gap:5px;">
          <span style="width:12px; height:12px; background:#f0e7db; border-radius:3px; display:inline-block;"></span>已追蹤人數（淺色底）
        </span>
      </div>
    </div>
  </div>
<% end %>

<%# 已回購／未回購 tabs %>
<ul class="nav nav-tabs mb-3" style="font-size:0.9rem;">
  <li class="nav-item">
    <%= link_to "已回購（#{@repurchased_count}）",
          stickiness_results_path(tab: 'repurchased', start_date: params[:start_date], end_date: params[:end_date]),
          class: "nav-link #{@tab == 'repurchased' ? 'active fw-bold' : 'text-muted'}" %>
  </li>
  <li class="nav-item">
    <%= link_to "未回購（#{@pending_count}）",
          stickiness_results_path(tab: 'pending', start_date: params[:start_date], end_date: params[:end_date]),
          class: "nav-link #{@tab == 'pending' ? 'active fw-bold' : 'text-muted'}" %>
  </li>
</ul>

<%# 依客人類型分組，組內照卡別排序，全部往下疊在同一頁 %>
<% @groups.each do |label, rows| %>
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white d-flex align-items-center" style="gap:8px;">
      <span class="fw-bold"><%= label %></span>
      <span class="badge bg-secondary"><%= rows.size %></span>
    </div>
    <div class="card-body p-0 table-responsive">
      <table class="table align-middle mb-0" style="font-size:0.86rem;">
        <thead style="background-color:#4a4a4a; color:white;">
          <tr>
            <th class="ps-3" style="width:110px;">姓名</th>
            <th style="width:150px;">IG</th>
            <th style="width:80px;">卡別</th>
            <th style="width:100px;">最後購買日</th>
            <th style="width:28%;">追蹤備註</th>
            <th>回購狀態</th>
          </tr>
        </thead>
        <tbody>
          <% rows.each do |r| %>
            <% url = ig_link_url(r.customer.instagram_account) %>
            <tr>
              <td class="ps-3 fw-semibold">
                <%= link_to r.customer.full_name, customer_path(r.customer.id), target: "_blank", class: "text-decoration-none" %>
              </td>
              <td>
                <% if url %>
                  <%= link_to url, target: "_blank", class: "text-decoration-none d-flex align-items-center gap-1" do %>
                    <i class="fal fa-at text-danger"></i>
                    <span style="font-size:0.8rem; max-width:130px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:inline-block;">
                      <%= r.customer.instagram_account&.sub(/^@/, '') %>
                    </span>
                  <% end %>
                <% else %>
                  <span class="text-muted small">—</span>
                <% end %>
              </td>
              <td>
                <% badge_bg, badge_fg = case r.membership_level
                                      when '黑卡' then ['#333', '#fff']
                                      when '金卡' then ['#b8860b', '#fff']
                                      when '銀卡' then ['#6c757d', '#fff']
                                      when '白卡' then ['#dee2e6', '#333']
                                      else             ['#adb5bd', '#333']
                                      end %>
                <span class="badge" style="background:<%= badge_bg %>; color:<%= badge_fg %>; font-size:0.75rem;"><%= r.membership_level %></span>
              </td>
              <td class="text-nowrap text-muted"><%= r.last_purchase_date ? r.last_purchase_date.strftime('%Y/%m/%d') : '—' %></td>
              <td>
                <% if r.profile.stickiness_followed_up_at %>
                  <div class="text-muted" style="font-size:0.72rem;">追蹤於 <%= r.profile.stickiness_followed_up_at.strftime('%-m/%-d') %><% if r.profile.stickiness_note_edited_by.present? %>・edit by <%= note_editor_name(r.profile.stickiness_note_edited_by) %><% end %></div>
                <% end %>
                <div class="text-muted" style="font-size:0.8rem; white-space:pre-wrap;"><%= r.profile.stickiness_note %></div>
              </td>
              <td>
                <% if r.repurchases.any? %>
                  <% r.repurchases.each do |rep| %>
                    <div style="font-size:0.8rem;">
                      <span class="text-success fw-bold">✓</span>
                      <%= rep[:product_name] %>
                      <span class="text-muted"><%= rep[:date].strftime('%-m/%-d') %>・NT$<%= number_with_delimiter(rep[:amount]) %>・追蹤後 <%= rep[:days_between] %> 天</span>
                    </div>
                  <% end %>
                <% else %>
                  <span class="badge bg-light text-muted border" style="font-size:0.75rem;">尚未回購</span>
                <% end %>
              </td>
            </tr>
          <% end %>
          <% if rows.empty? %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">
                <i class="fal fa-inbox fa-2x mb-2 d-block opacity-25"></i>
                <%= @tab == 'repurchased' ? "此類型沒有已回購的追蹤客人" : "此類型沒有未回購的追蹤客人" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
