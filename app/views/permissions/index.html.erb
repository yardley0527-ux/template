<%# app/views/permissions/index.html.erb %>
<% content_for :page_title, "權限管理" %>

<div class="row g-3 mb-4">
  <div class="col-12">
    <h4 class="fw-bold mb-0">權限管理</h4>
    <p class="text-muted small mb-0">勾選每個角色可以存取的頁面。Admin 角色永遠可存取全部頁面，不受此設定影響。</p>
  </div>
</div>

<%= form_with url: permissions_path, method: :patch, local: true do %>
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-0">
      <table class="table table-hover mb-0 align-middle">
        <thead>
          <tr>
            <th class="ps-3">頁面</th>
            <% @roles.each do |role| %>
              <th class="text-center"><%= role.name %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @groups.each do |group| %>
            <tr class="table-light">
              <td colspan="<%= @roles.size + 1 %>" class="fw-bold small text-muted ps-3">
                <%= group[:group_title] %>
              </td>
            </tr>
            <% group[:pages].each do |page| %>
              <tr>
                <td class="ps-3"><%= page[:title] %></td>
                <% @roles.each do |role| %>
                  <td class="text-center">
                    <input type="checkbox"
                           name="permissions[<%= role.id %>][]"
                           value="<%= page[:controller] %>"
                           <%= "checked" if @granted[role.id]&.include?(page[:controller]) %>>
                  </td>
                <% end %>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%= submit_tag "儲存權限設定", class: "btn btn-primary" %>
<% end %>
