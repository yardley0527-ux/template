<% content_for :page_title, "定期購管理" %>

<div id="content">
  <div class="subheader">
    <div class="subheader-block d-lg-flex align-items-center">
      <div class="d-inline-flex flex-column justify-content-center mr-3">
        <span class="fw-300 fs-xs d-none d-md-block opacity-50">管理</span>
        <span class="fs-xl fw-700 d-none d-md-flex align-items-center">定期購管理</span>
      </div>
    </div>
    <div class="subheader-block ml-auto">
      <%= link_to "＋ 新增定期購", new_subscription_path, class: "btn btn-primary btn-sm" %>
    </div>
  </div>

  <div class="container-fluid">

    <%# Stats row %>
    <div class="row mb-4">
      <div class="col-6 col-md-3 mb-3">
        <div class="card border-0 shadow-sm text-center py-3">
          <div style="font-size:2rem;font-weight:800;color:#2563eb;"><%= @stat_active %></div>
          <div class="text-muted small">目前訂閱中</div>
        </div>
      </div>
      <div class="col-6 col-md-3 mb-3">
        <div class="card border-0 shadow-sm text-center py-3">
          <div style="font-size:2rem;font-weight:800;color:#dc2626;"><%= @stat_due_week %></div>
          <div class="text-muted small">7 天內到期</div>
        </div>
      </div>
      <div class="col-6 col-md-3 mb-3">
        <div class="card border-0 shadow-sm text-center py-3">
          <div style="font-size:2rem;font-weight:800;color:#d97706;"><%= @stat_due_fortnight %></div>
          <div class="text-muted small">8–14 天後到期</div>
        </div>
      </div>
      <div class="col-6 col-md-3 mb-3">
        <div class="card border-0 shadow-sm text-center py-3">
          <div style="font-size:2rem;font-weight:800;color:#059669;">NT$<%= number_with_delimiter(@stat_monthly_rev) %></div>
          <div class="text-muted small">每月預估訂閱收入</div>
        </div>
      </div>
    </div>

    <%# Filter bar %>
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-body py-2">
        <%= form_with url: subscriptions_path, method: :get, local: true, class: "d-flex flex-wrap gap-2 align-items-end" do |f| %>
          <div>
            <label class="small text-muted mb-1 d-block">狀態</label>
            <%= f.select :status, [["全部狀態", ""], ["訂閱中", "active"], ["暫停", "paused"], ["已取消", "cancelled"], ["已完成", "completed"]],
                         { selected: @filter_status }, class: "form-control form-control-sm" %>
          </div>
          <div>
            <label class="small text-muted mb-1 d-block">產品系列</label>
            <%= f.select :series, [["全部產品", ""], ["穀胱甘肽", "穀胱甘肽"], ["代謝錠", "代謝錠"], ["全能", "全能"], ["薑黃", "薑黃"], ["NMN", "NMN"], ["美白", "美白"]],
                         { selected: @filter_series }, class: "form-control form-control-sm" %>
          </div>
          <div>
            <label class="small text-muted mb-1 d-block">訂閱頻率</label>
            <%= f.select :frequency_days, [["全部頻率", ""], ["月訂 30天", 30], ["雙月訂 60天", 60], ["季訂 90天", 90]],
                         { selected: @filter_freq }, class: "form-control form-control-sm" %>
          </div>
          <%= f.submit "篩選", class: "btn btn-outline-secondary btn-sm mt-auto" %>
          <%= link_to "清除", subscriptions_path, class: "btn btn-link btn-sm mt-auto" %>
        <% end %>
      </div>
    </div>

    <%# Flash %>
    <% if notice %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= notice %>
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
      </div>
    <% end %>

    <%# Table %>
    <div class="card border-0 shadow-sm">
      <div class="card-header d-flex justify-content-between align-items-center" style="background:#2563eb;">
        <span class="text-white fw-semibold">📋 定期購名單</span>
        <span class="badge badge-light"><%= @subscriptions.size %> 筆</span>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size:0.85rem;">
          <thead class="table-light">
            <tr>
              <th>姓名 / 卡別</th>
              <th>產品</th>
              <th class="text-center">頻率</th>
              <th class="text-center">折扣</th>
              <th class="text-center">每期金額</th>
              <th class="text-center">已完成期數</th>
              <th class="text-center">下次補貨日</th>
              <th class="text-center">狀態</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% if @subscriptions.empty? %>
              <tr><td colspan="9" class="text-center text-muted py-4">目前沒有定期購記錄</td></tr>
            <% end %>
            <% @subscriptions.each do |s| %>
              <% c = s.shopline_customer %>
              <% days_until = (s.next_due_on - Date.today).to_i %>
              <tr>
                <td>
                  <%= link_to c.full_name, customer_path(c.id), target: "_blank", class: "fw-semibold text-decoration-none" %>
                  <br><span class="badge badge-secondary" style="font-size:0.65rem;"><%= c.membership_level %></span>
                </td>
                <td>
                  <div class="fw-semibold"><%= s.product_name %></div>
                  <div class="text-muted small">數量 <%= s.quantity %></div>
                </td>
                <td class="text-center"><%= s.frequency_label %></td>
                <td class="text-center fw-bold text-primary"><%= s.discount_label %></td>
                <td class="text-center">NT$<%= number_with_delimiter(s.total_per_delivery) %></td>
                <td class="text-center">
                  <span class="<%= s.completed_periods >= s.min_periods ? 'text-success fw-bold' : 'text-muted' %>">
                    <%= s.completed_periods %> / <%= s.min_periods %> 期
                  </span>
                </td>
                <td class="text-center">
                  <% if s.status == "active" %>
                    <% if days_until < 0 %>
                      <span class="badge badge-danger">逾期 <%= days_until.abs %> 天</span>
                    <% elsif days_until == 0 %>
                      <span class="badge badge-danger">今天到期</span>
                    <% elsif days_until <= 7 %>
                      <span class="badge badge-warning text-dark"><%= s.next_due_on.strftime("%-m/%-d") %>（<%= days_until %>天）</span>
                    <% else %>
                      <span class="badge badge-light text-dark"><%= s.next_due_on.strftime("%-m/%-d") %>（<%= days_until %>天）</span>
                    <% end %>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>
                <td class="text-center">
                  <span class="badge <%= s.status_badge_class %>"><%= s.status_label %></span>
                </td>
                <td>
                  <%= link_to "詳情", subscription_path(s), class: "btn btn-sm btn-outline-primary" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>
