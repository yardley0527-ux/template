<%= form_with model: subscription, local: true, class: "needs-validation" do |f| %>
  <% if subscription.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% subscription.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <div class="col-md-6 mb-3">
      <label class="form-label fw-semibold">客戶 <span class="text-danger">*</span></label>
      <%= f.select :shopline_customer_id,
          @customers.map { |c| ["#{c.full_name}（#{c.membership_level}）#{c.mobile_phone}", c.id] },
          { prompt: "請選擇客戶", selected: subscription.shopline_customer_id },
          class: "form-control" %>
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label fw-semibold">產品名稱 <span class="text-danger">*</span></label>
      <%= f.select :product_name,
          Subscription::PRODUCT_OPTIONS,
          { prompt: "請選擇產品", selected: subscription.product_name },
          class: "form-control" %>
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label fw-semibold">產品系列</label>
      <%= f.select :product_series,
          [["穀胱甘肽", "穀胱甘肽"], ["代謝錠", "代謝錠"], ["全能", "全能"], ["薑黃", "薑黃"], ["NMN", "NMN"], ["美白", "美白"]],
          { prompt: "請選擇系列", selected: subscription.product_series },
          class: "form-control" %>
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label fw-semibold">訂閱頻率 <span class="text-danger">*</span></label>
      <%= f.select :frequency_days,
          Subscription::FREQUENCIES.map { |days, label| [label, days] },
          { selected: subscription.frequency_days || 30 },
          class: "form-control", id: "freq-select" %>
      <small class="text-muted">頻率自動對應折扣：30天=88折、60天=85折、90天=82折</small>
    </div>

    <div class="col-md-4 mb-3">
      <label class="form-label fw-semibold">原價（元）<span class="text-danger">*</span></label>
      <%= f.number_field :unit_price, step: 1, min: 1, class: "form-control", placeholder: "如 1980" %>
    </div>

    <div class="col-md-4 mb-3">
      <label class="form-label fw-semibold">數量 <span class="text-danger">*</span></label>
      <%= f.number_field :quantity, step: 1, min: 1, value: (subscription.quantity || 1), class: "form-control" %>
    </div>

    <div class="col-md-4 mb-3">
      <label class="form-label fw-semibold">最低期數</label>
      <%= f.number_field :min_periods, step: 1, min: 1, value: (subscription.min_periods || 3), class: "form-control" %>
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label fw-semibold">開始日期 <span class="text-danger">*</span></label>
      <%= f.date_field :started_on, value: subscription.started_on || Date.today, class: "form-control" %>
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label fw-semibold">狀態</label>
      <%= f.select :status,
          Subscription::STATUSES.map { |s| [{ "active" => "訂閱中", "paused" => "暫停", "cancelled" => "已取消", "completed" => "已完成" }[s], s] },
          { selected: subscription.status || "active" },
          class: "form-control" %>
    </div>

    <div class="col-12 mb-3">
      <label class="form-label fw-semibold">備注</label>
      <%= f.text_area :notes, rows: 3, class: "form-control", placeholder: "備注（選填）" %>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit subscription.new_record? ? "建立定期購" : "儲存變更",
                 class: "btn btn-primary" %>
    <%= link_to "取消", subscriptions_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
