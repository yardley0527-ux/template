<% content_for :page_title, "編輯定期購" %>

<div id="content">
  <div class="subheader">
    <div class="subheader-block d-lg-flex align-items-center">
      <div class="d-inline-flex flex-column justify-content-center mr-3">
        <span class="fw-300 fs-xs d-none d-md-block opacity-50">定期購管理</span>
        <span class="fs-xl fw-700 d-none d-md-flex align-items-center">編輯定期購</span>
      </div>
    </div>
    <div class="subheader-block ml-auto">
      <%= link_to "← 返回詳情", subscription_path(@subscription), class: "btn btn-outline-secondary btn-sm" %>
    </div>
  </div>

  <div class="container-fluid">
    <div class="card border-0 shadow-sm" style="max-width:800px;">
      <div class="card-header text-white fw-semibold" style="background:#2563eb;">編輯訂閱</div>
      <div class="card-body">
        <%= render "form", subscription: @subscription %>
      </div>
    </div>
  </div>
</div>
