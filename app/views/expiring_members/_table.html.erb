<div class="table-responsive">
  <table class="table table-bordered table-hover table-striped w-100">
    <thead class="bg-primary-600">
      <tr>
        <th>姓名</th>
        <th>SL 連結</th>
        <th>會員等級</th>
        <th>到期日</th>
        <th class="text-center">剩餘天數</th>
        <th class="text-center">續會確認</th>
      </tr>
    </thead>
    <tbody>
      <% customers.each do |c| %>
        <% days_left = (c.membership_expiry_date - Date.today).to_i %>
        <tr>
          <td>
            <div class="fw-500">
              <%= link_to (c.full_name.presence || "(無名)"), customer_path(c) %>
            </div>
            <div class="small text-muted">
              <% if c.instagram_account.present? %>
                <a href="https://instagram.com/<%= c.instagram_account %>" target="_blank" rel="noopener noreferrer">
                  <%= c.instagram_account %>
                </a>
              <% end %>
            </div>
          </td>
          <td>
            <% if c.shopline_id.present? %>
              <a href="https://admin.shoplineapp.com/admin/yardley/users/<%= c.shopline_id %>" 
                target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary">
                開啟 ↗
              </a>
            <% else %>
              —
            <% end %>
          </td>
          <td><%= c.membership_level.presence || "—" %></td>
          <td><%= c.membership_expiry_date&.strftime("%Y/%m/%d") %></td>
          <td class="text-center">
            <span style="color:<%= days_left <= 15 ? '#c0392b' : '#2980b9' %>; font-weight:600;">
              <%= days_left %> 天
            </span>
          </td>
          <td class="text-center">
            <% profile = c.customer_profile %>
            <% confirmed = profile&.renewal_confirmed_for == c.membership_expiry_date %>
            <% if confirmed %>
              <span style="color:#27ae60; font-weight:600;">✅ 已確認</span>
              <div class="text-muted" style="font-size:10px;">
                <%= profile.renewal_confirmed_at.strftime("%Y/%m/%d %H:%M") %>
              </div>
            <% else %>
              <%= button_to "確認續會", confirm_renewal_expiring_member_path(c),
                  method: :post,
                  class: "btn btn-sm btn-outline-success",
                  form: { style: "display:inline" } %>
            <% end %>
          </td>
        </tr>
      <% end %>

      <% if customers.blank? %>
        <tr><td colspan="8" class="text-center text-muted py-4">目前無即將到期會員</td></tr>
      <% end %>
    </tbody>
  </table>
</div>

<style>
.bg-primary-600 { background-color: #886ab5 !important; color: white; }
.fw-500 { font-weight: 600; }
</style>