<% content_for :page_title, "LINE 小幫手群組" %>

<div class="subheader">
  <h1 class="subheader-title"><i class="fal fa-comment-dots mr-2 text-success"></i> LINE 小幫手群組</h1>
</div>

<div class="alert alert-light border small mb-3">
  <i class="fal fa-info-circle mr-1"></i>
  把「苼莛小幫手」邀進 LINE 群組後，群組會自動出現在這裡。新群組預設不收任何報告，勾選後按「儲存」才會開始收。
</div>

<%# LINE 推播狀態：額度用完或推播失敗時，背景工作只記 log，這裡讓人看得到原因 %>
<% if !LineBot::Client.configured? %>
  <div class="alert alert-danger small mb-3">⚠️ 伺服器沒有設定 LINE_REPORT_CHANNEL_ACCESS_TOKEN，所有報告都不會發出</div>
<% else %>
  <% full = @quota && @quota[:limit] && @quota[:used] >= @quota[:limit] %>
  <div class="alert <%= full || @last_error ? 'alert-danger' : 'alert-light border' %> small mb-3">
    <% if @quota %>
      <div>
        📨 LINE 本月推播：已用 <strong><%= @quota[:used] %></strong> 則
        <%= @quota[:limit] ? "／上限 #{@quota[:limit]} 則" : "（無上限）" %>
        <% if full %><strong class="ml-1">— 額度已用完，下個月 1 號前所有報告都發不出去（要升級 LINE 方案或等下個月）</strong><% end %>
      </div>
    <% else %>
      <div>📨 查不到 LINE 推播額度：<%= @quota_error %></div>
    <% end %>
    <% if @last_error %>
      <div class="mt-1">❌ 最近一次發送失敗（<%= @last_error[:at].in_time_zone.strftime("%m/%d %H:%M") %>）：<%= @last_error[:message] %></div>
    <% end %>
  </div>
<% end %>

<div class="panel">
  <div class="panel-container show">
    <div class="panel-content">
      <div style="overflow-x:auto;">
        <table class="table table-bordered align-middle small mb-0">
          <thead class="thead-light">
            <tr>
              <th>群組</th>
              <th>加入時間</th>
              <th>訂閱的報告</th>
            </tr>
          </thead>
          <tbody>
            <% if @groups.empty? %>
              <tr><td colspan="3" class="text-center text-muted py-4">小幫手還沒被邀進任何群組</td></tr>
            <% end %>
            <% @groups.each do |group| %>
              <tr class="<%= 'text-muted' unless group.active %>">
                <td>
                  <%= group.name.presence || group.group_id %>
                  <% unless group.active %><span class="badge badge-secondary ml-1">已離開</span><% end %>
                </td>
                <td class="text-nowrap"><%= group.joined_at&.strftime("%Y/%m/%d") || "—" %></td>
                <td>
                  <% if group.active %>
                    <%= form_with model: group, local: true, class: "form-inline" do |f| %>
                      <%= hidden_field_tag "line_bot_group[subscriptions][]", "" %>
                      <% LineBotGroup::TOPICS.each do |topic, label| %>
                        <div class="custom-control custom-checkbox mr-3">
                          <%= check_box_tag "line_bot_group[subscriptions][]", topic, group.subscriptions.include?(topic),
                                            id: "group-#{group.id}-#{topic}", class: "custom-control-input" %>
                          <label class="custom-control-label" for="group-<%= group.id %>-<%= topic %>"><%= label %></label>
                        </div>
                      <% end %>
                      <button type="submit" class="btn btn-sm btn-primary">儲存</button>
                    <% end %>
                    <% if (group.subscriptions & LineReportResendJob::DIGESTS.keys).any? %>
                      <% days = LineReportResendJob.default_days %>
                      <%= form_with url: resend_reports_line_bot_group_path(group), method: :post, local: true,
                                    class: "form-inline mt-2 mr-2 d-inline-flex",
                                    data: { confirm: "要把選的日期的報告（訂單簡報／銷售日報／黑金卡回來，有勾的才發）補發到「#{group.name || group.group_id}」嗎？已發過的日期會用現在的資料重發" } do %>
                        <span class="mr-1">補發</span>
                        <%= date_field_tag :from, days.first, max: Date.current - 1, class: "form-control form-control-sm", id: "from-#{group.id}" %>
                        <span class="mx-1">到</span>
                        <%= date_field_tag :to, days.last, max: Date.current - 1, class: "form-control form-control-sm mr-1", id: "to-#{group.id}" %>
                        <button type="submit" class="btn btn-sm btn-success">補發報告</button>
                      <% end %>
                    <% end %>
                    <%# 訂單簡報只給有勾的群組（目前是策略部），測試按鈕也只在這些群組出現 %>
                    <% if group.subscriptions.include?("order_brief") %>
                      <%= button_to "發一份前一天訂單簡報（測試）", preview_order_brief_line_bot_group_path(group),
                                    method: :post, class: "btn btn-sm btn-outline-secondary mt-2",
                                    form_class: "d-inline-block",
                                    form: { data: { confirm: "要發一份前一天的訂單簡報到「#{group.name || group.group_id}」嗎？（測試預覽，不算正式發送）" } } %>
                    <% end %>
                  <% else %>
                    —
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<% if @deliveries.any? %>
  <div class="panel">
    <div class="panel-hdr"><h2>最近推播紀錄（訂單簡報）</h2></div>
    <div class="panel-container show">
      <div class="panel-content">
        <table class="table table-sm small mb-0">
          <thead><tr><th>簡報日期</th><th>發送時間</th><th class="text-right">群組數</th></tr></thead>
          <tbody>
            <% @deliveries.each do |d| %>
              <tr>
                <td><%= d.report_date.strftime("%m/%d") %></td>
                <td><%= d.created_at.strftime("%m/%d %H:%M") %></td>
                <td class="text-right"><%= d.group_count %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% end %>
