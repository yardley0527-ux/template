<% content_for :page_title, "IG 私訊整理" %>
<div class="subheader">
  <h1 class="subheader-title"><i class="fal fa-clipboard-list-check mr-2 text-primary"></i> IG 私訊整理
    <small>Chloe 帳號歷史私訊的整理結果。私訊都已回覆過，這裡只供查詢，不需逐筆處理；內容未經專業審閱，不可直接對外使用</small></h1>
</div>
<%= render "reply_assistant/nav", active: :reviews %>

<ul class="nav nav-tabs mb-3">
  <% IgReviewItem::KINDS.each do |k, label| %>
    <li class="nav-item">
      <%= link_to ig_reviews_path(kind: k), class: "nav-link #{'active' if k == @kind}" do %>
        <%= label %> <span class="badge badge-secondary"><%= @kind_counts[k].to_i %></span>
      <% end %>
    </li>
  <% end %>
</ul>
<% if @kind == "risk" %>
  <p class="text-muted small">Chloe 當時的回答不適合當標準答案的說法。等級代表說法的風險程度：最高＞高＞中。</p>
<% end %>

<%= form_with url: ig_reviews_path, method: :get, local: true, class: "form-inline mb-3" do %>
  <input type="hidden" name="kind" value="<%= @kind %>">
  <label class="sr-only" for="q">搜尋</label>
  <input id="q" name="q" value="<%= @q %>" class="form-control mr-2" placeholder="搜尋內容、客人、事件代碼">
  <button class="btn btn-primary" type="submit">搜尋</button>
<% end %>

<% if @items.empty? %>
  <p class="text-muted">沒有符合的項目。</p>
<% else %>
  <div class="table-responsive"><table class="table table-bordered table-hover bg-white">
    <thead><tr>
      <% if @kind == "risk" %><th>等級</th><% end %>
      <th>日期</th><th>內容</th><th>客人</th><th>事件</th>
    </tr></thead>
    <tbody>
      <% @items.each do |item| %>
        <tr>
          <% if @kind == "risk" %><td class="text-nowrap"><span class="badge badge-<%= item.severity_rank < 2 ? 'danger' : 'warning' %>"><%= item.severity %></span></td><% end %>
          <td class="text-nowrap"><%= item.as_of&.strftime("%Y/%m/%d") || "—" %></td>
          <td style="white-space:pre-line"><%= item.title %><% item.detail.each do |k, v| %><% next if v.blank? %>
<small class="text-muted"><%= k %>：<%= v %></small><% end %></td>
          <td><%= item.customer_name.presence || "—" %></td>
          <td><% item.event_codes.each do |c| %><code class="d-block small"><%= c %></code><% end %></td>
        </tr>
      <% end %>
    </tbody>
  </table></div>
<% end %>
