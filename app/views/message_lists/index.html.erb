<%# app/views/message_lists/index.html.erb %>
<% content_for :page_title, "訊息名單追蹤" %>

<div class="row g-3 mb-3">
  <div class="col-12">
    <h4 class="fw-bold mb-0">訊息名單追蹤</h4>
    <p class="text-muted small mb-0">每批傳送出去的訊息名單，追蹤傳送日之後是否回購目標商品</p>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0 table-responsive">
    <table class="table align-middle mb-0" style="font-size:0.88rem;">
      <thead style="background-color:#4a4a4a; color:white;">
        <tr>
          <th class="ps-3">名單名稱</th>
          <th style="width:110px;">傳送日期</th>
          <th style="width:140px;">目標商品</th>
          <th class="text-end" style="width:90px;">人數</th>
          <th class="text-end" style="width:110px;">已回購</th>
          <th class="text-end" style="width:90px;">回購率</th>
          <th class="text-end" style="width:140px;">回購帶回營業額</th>
          <th style="width:80px;"></th>
        </tr>
      </thead>
      <tbody>
        <% @lists.each do |list| %>
          <% s = @stats[list.id] %>
          <tr>
            <td class="ps-3">
              <%= link_to list.name, message_list_path(list), class: "text-decoration-none fw-semibold" %>
              <% if list.source_note.present? %>
                <div class="text-muted" style="font-size:0.75rem;"><%= list.source_note %></div>
              <% end %>
              <% if list.message_content.present? %>
                <div style="font-size:0.75rem; color:#8f6340;">
                  <i class="fal fa-comment-lines me-1"></i><%= truncate(list.message_content.gsub(/\s+/, " "), length: 60) %>
                </div>
              <% else %>
                <div class="text-muted" style="font-size:0.75rem;">
                  <i class="fal fa-comment-slash me-1 opacity-50"></i>尚未上傳訊息內容
                </div>
              <% end %>
            </td>
            <td class="text-nowrap"><%= list.sent_on.strftime("%Y/%-m/%-d") %></td>
            <td><span class="badge bg-light text-dark border"><%= list.target_product %></span></td>
            <td class="text-end"><%= s[:total] %></td>
            <td class="text-end fw-bold" style="color:#188038;"><%= s[:repurchased] %></td>
            <td class="text-end"><%= s[:rate] ? "#{s[:rate]}%" : "—" %></td>
            <td class="text-end fw-bold" style="color:#6e4a2e;">NT$<%= number_with_delimiter(s[:revenue]) %></td>
            <td class="text-end pe-3">
              <%= link_to "明細", message_list_path(list), class: "btn btn-sm btn-outline-primary" %>
            </td>
          </tr>
        <% end %>
        <% if @lists.empty? %>
          <tr>
            <td colspan="8" class="text-center py-5 text-muted">
              <i class="fal fa-inbox fa-2x mb-2 d-block opacity-25"></i>
              目前還沒有名單。要新增時把撈取條件、傳送日期與目標商品告訴 Claude 即可。
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
