<%# KOC 名單（/kocs 與各品牌）共用：公關品寄送紀錄欄位。locals: koc %>
<td style="min-width:260px">
  <% koc.gift_shipments.each_with_index do |shipment, i| %>
    <div class="d-flex align-items-start gap-1 small mb-1">
      <span class="badge badge-light border">第 <%= i + 1 %> 次</span>
      <div class="flex-grow-1">
        <%= shipment.shipped_on.strftime("%Y-%m-%d") %>
        <% if shipment.items.present? %><span class="text-muted">・<%= shipment.items %></span><% end %>
        <% if shipment.notes.present? %><div class="text-muted"><%= shipment.notes %></div><% end %>
      </div>
      <% if can_edit_logistics_fields? %>
        <%= link_to polymorphic_path([:gift_shipment, koc], shipment_id: shipment.id), method: :delete,
              data: { confirm: "確定刪除 #{shipment.shipped_on.strftime('%Y-%m-%d')} 這筆寄送紀錄？" },
              class: "text-danger", title: "刪除這筆" do %><i class="fal fa-times"></i><% end %>
      <% end %>
    </div>
  <% end %>
  <% if can_edit_logistics_fields? %>
    <%= form_with scope: :gift_shipment, url: polymorphic_path([:gift_shipments, koc]), method: :post, local: true, class: "mb-0 mt-1" do |f| %>
      <div class="d-flex gap-1 mb-1">
        <%= f.date_field :shipped_on, value: Date.current, class: "form-control form-control-sm", required: true %>
        <%= f.text_field :items, class: "form-control form-control-sm", placeholder: "品項，如 代謝錠x1" %>
      </div>
      <div class="d-flex gap-1">
        <%= f.text_field :notes, class: "form-control form-control-sm", placeholder: "備註（選填），如 看成效後加寄" %>
        <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap"><i class="fal fa-plus"></i> 新增</button>
      </div>
    <% end %>
  <% elsif koc.gift_shipments.empty? %>
    <span class="small text-muted">—</span>
  <% end %>
</td>
