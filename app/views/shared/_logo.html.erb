<div class="page-logo">
  <%= link_to root_path, class: "d-flex align-items-center justify-content-center w-100" do %>
    <%= image_tag "smartadmin/#{Rails.configuration.logo}", alt: Rails.configuration.app_flavor, aria: {roledescription: 'logo'} %>
    <span class="page-logo-text mr-1"><%= Rails.configuration.app_flavor %></span>
  <% end %>
</div>