<div class="dropdown-header bg-trans-gradient d-flex flex-row py-4 rounded-top">
  <div class="d-flex flex-row align-items-center mt-1 mb-1 color-white">
    <span class="mr-2">
      <%= image_tag "smartadmin/demo/avatars/#{Rails.configuration.avatar}",
                    class: "rounded-circle profile-image",
                    alt: (current_user&.username || "User") %>
    </span>

    <div class="info-card-text">
      <div class="fs-lg text-truncate text-truncate-lg">
        <%= current_user&.username || current_user&.email || "使用者" %>
      </div>
      <span class="text-truncate text-truncate-md opacity-80">
        <%= current_user&.email || "" %>
      </span>
    </div>
  </div>
</div>

<div class="dropdown-divider m-0"></div>

<%= button_to destroy_user_session_path,
              method: :delete,
              class: "dropdown-item fw-500 pt-3 pb-3 w-100 text-start",
              form: { class: "m-0 p-0" } do %>
  <span data-i18n="drpdwn.page-logout">登出</span>
<% end %>
