<% content_for :page_title, "Chloe 話術卡" %>

<% content_for :head_block do %>
<style>
  .pb-stat { border: 1px solid #eadfdd; border-radius: 8px; padding: .6rem .9rem; background: #fff; }
  .pb-stat b { font-size: 1.25rem; color: #b5525a; font-variant-numeric: tabular-nums; }
  .pb-quote { background: #f3eded; border-radius: 14px 14px 14px 4px; padding: .4rem .8rem; margin-bottom: .4rem; display: inline-block; max-width: 100%; white-space: pre-line; overflow-wrap: anywhere; }
  .pb-quote small { display: block; color: #77666a; }
  .pb-label { font-size: .75rem; letter-spacing: .06em; color: #77666a; font-weight: 500; margin-bottom: .25rem; }
  .pb-note { border-top: 1px dashed #eadfdd; padding-top: .5rem; margin-top: .5rem; color: #77666a; font-size: .85rem; }
  .pb-step-no { color: #b5525a; font-weight: 700; margin-right: .4rem; }
  .pb-card { height: 100%; }
  .pb-spec li { margin-bottom: .15rem; }
  .pb-q { font-weight: 500; margin-bottom: .2rem; }
  .pb-table td.n, .pb-table th.n { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
</style>
<% end %>

<div class="subheader">
  <h1 class="subheader-title">
    <i class="fal fa-comments-alt mr-2 text-danger"></i> Chloe 話術卡
  </h1>
</div>

<p class="text-muted mb-3">
  從 Chloe 2024–2026 年的 IG 私訊整理出來，給客服回覆客人時參考。每句「原文」都是 Chloe 當時親口說的；價格與活動是當時的例子，回覆時以當期為準。
</p>


<ul class="nav nav-pills mb-3">
  <li class="nav-item">
    <%= link_to "通用話術", chloe_playbook_path, class: "nav-link #{'active' if @product.nil?}" %>
  </li>
  <% @playbook["products"].each do |product| %>
    <li class="nav-item">
      <%= link_to product["name"], chloe_playbook_path(tab: product["key"]), class: "nav-link #{'active' if @product && @product['key'] == product['key']}" %>
    </li>
  <% end %>
</ul>

<% if @product %>
  <%= render "product", product: @product %>
<% else %>
  <%= render "general", pb: @playbook %>
<% end %>
