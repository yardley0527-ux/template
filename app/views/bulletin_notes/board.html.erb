<% content_for :page_title, "#{@department}佈告欄" %>

<div class="subheader">
  <h1 class="subheader-title">
    📌 <%= @department %>佈告欄
  </h1>
  <div class="ml-auto">
    <%= link_to root_path, class: "btn btn-sm btn-outline-secondary" do %>
      <i class="fal fa-arrow-left mr-1"></i> 回戰情首頁
    <% end %>
  </div>
</div>

<div class="row">
  <div class="col-lg-7 mb-3">
    <% custom_sections = BulletinSection.where(department: @department).index_by(&:name) %>
    <% @section_names.each do |section_name| %>
      <div class="card mb-3" style="border-left:6px solid <%= BulletinSection::FIXED.include?(section_name) ? '#f0b429' : '#8a6fd8' %>;">
        <div class="card-header py-2 d-flex align-items-center">
          <strong>
            <%= section_name == "周待辦" ? "📅" : (section_name == "月待辦" ? "🗓️" : "📋") %>
            <%= section_name %>
          </strong>
          <% if (section = custom_sections[section_name]) %>
            <%= button_to board_section_path(section), method: :delete,
                  data: { confirm: "刪除「#{section_name}」這個板？板上的便條會一併刪除。" },
                  class: "btn btn-link p-0 ml-auto text-muted small", title: "刪除板子" do %>
              <i class="fal fa-trash"></i>
            <% end %>
          <% end %>
        </div>
        <div class="card-body py-2">
          <%= render "notes", notes: (@notes_by_section[section_name] || []),
                              department: @department, section: section_name %>
        </div>
      </div>
    <% end %>

    <%# 新增自訂板 %>
    <div class="card mb-3" style="border-style:dashed;">
      <div class="card-body py-2">
        <%= form_with url: department_board_sections_path(@department), method: :post, local: true do %>
          <div class="input-group input-group-sm" style="max-width:420px;">
            <input type="text" name="name" class="form-control"
                   placeholder="新增板子，例：omnichat 標籤確認事項" maxlength="50" autocomplete="off">
            <div class="input-group-append">
              <button class="btn btn-outline-primary" type="submit"><i class="fal fa-plus"></i> 建立板子</button>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-lg-5 mb-3">
    <div class="card">
      <div class="card-header py-2">
        <strong><i class="fal fa-file-alt mr-1"></i> <%= @department %>最近日誌</strong>
        <%= link_to "完整內容 →", calendar_events_path, class: "small float-right" %>
      </div>
      <div class="card-body py-2">
        <% if @recent_logs.empty? %>
          <div class="text-muted small">尚無日誌</div>
        <% end %>
        <% @recent_logs.each do |log| %>
          <details class="mb-1">
            <summary class="font-weight-bold" style="cursor:pointer;">
              <%= log.log_date.strftime("%-m/%-d") %>（週<%= %w[日 一 二 三 四 五 六][log.log_date.wday] %>）
            </summary>
            <div class="small mt-1 pl-2" style="border-left:3px solid #e0e6ef; white-space:pre-wrap; word-break:break-word;"><%= auto_link_urls(log.content) %></div>
          </details>
        <% end %>
      </div>
    </div>
  </div>
</div>
