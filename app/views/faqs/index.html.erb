<% content_for :page_title, "常見問題" %>
<% content_for :head_block do %>
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
  <style>
    .faq-card { border: 1px solid #dee2e6; border-radius: 6px; padding: 10px 12px; margin-bottom: 10px; background: #fff; }
    .faq-card:hover { border-color: #adb5bd; }
    .faq-drag-handle { cursor: grab; color: #adb5bd; }
    .faq-drag-handle:active { cursor: grabbing; }
    .faq-question-input { font-weight: 600; border: none; padding: 2px 4px; width: 100%; }
    .faq-question-input:focus { border: 1px solid #80bdff; border-radius: 4px; outline: none; }
    .faq-answer-textarea { font-size: 0.85rem; resize: vertical; white-space: pre-wrap; }
    .faq-img-thumb { position: relative; display: inline-block; margin: 2px; }
    .faq-img-thumb img { width: 84px; height: 84px; object-fit: cover; border-radius: 4px; display: block; cursor: pointer; }
    .faq-img-thumb .del-img { position: absolute; top: -6px; right: -6px; background: #dc3545; color: #fff; border: none; border-radius: 50%; width: 20px; height: 20px; font-size: 12px; line-height: 1; cursor: pointer; }
    .ghost-faq { opacity: 0.4; background: #e9ecef; }
    .ghost-tab { opacity: 0.4; }
    .faq-tab-rename { border: none; background: transparent; padding: 0; width: 6em; }
    #faqImageLightbox { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 9999; align-items: center; justify-content: center; }
    #faqImageLightbox img { max-width: 90vw; max-height: 90vh; border-radius: 8px; box-shadow: 0 4px 32px rgba(0,0,0,0.5); }
  </style>
<% end %>

<div class="subheader">
  <h1 class="subheader-title">
    <i class="fal fa-question-circle mr-2 text-muted"></i> 常見問題
    <small>拖 <i class="fal fa-grip-vertical"></i> 排序；點文字直接編輯，離開欄位自動儲存</small>
  </h1>
</div>

<div class="row">
  <div class="col-12">
    <ul class="nav nav-tabs flex-nowrap" id="faqTabs" role="tablist" style="overflow-x:auto;flex-wrap:nowrap;">
      <% @categories.each_with_index do |cat, i| %>
        <li class="nav-item" data-category-id="<%= cat.id %>" style="white-space:nowrap;">
          <a class="nav-link <%= 'active' if i == 0 %> d-flex align-items-center" data-toggle="tab" href="#panel-<%= cat.id %>" role="tab">
            <span class="faq-tab-drag-handle mr-1 text-muted" title="拖拉排序分類"><i class="fal fa-grip-vertical"></i></span>
            <input type="text" class="faq-tab-rename" value="<%= h(cat.name) %>"
                   onclick="event.preventDefault(); event.stopPropagation();"
                   onblur="renameCategory(<%= cat.id %>, this)">
            <span class="badge badge-light ml-1"><%= cat.faqs.size %></span>
            <button type="button" class="btn btn-xs btn-link text-danger p-0 ml-1" title="刪除分類"
                    onclick="event.preventDefault(); event.stopPropagation(); deleteCategory(<%= cat.id %>, this)">
              <i class="fal fa-trash"></i>
            </button>
          </a>
        </li>
      <% end %>
      <li class="nav-item">
        <a class="nav-link" href="#" onclick="addCategory(event)"><i class="fal fa-plus mr-1"></i>新增分類</a>
      </li>
    </ul>

    <div class="tab-content border border-top-0 p-3 bg-white">
      <% @categories.each_with_index do |cat, i| %>
        <div class="tab-pane fade <%= 'show active' if i == 0 %>" id="panel-<%= cat.id %>" role="tabpanel">
          <div class="faq-list" data-category-id="<%= cat.id %>">
            <% cat.faqs.each do |faq| %>
              <%= render 'faq_card', faq: faq %>
            <% end %>
          </div>
          <button type="button" class="btn btn-sm btn-outline-secondary mt-2" data-category-id="<%= cat.id %>" onclick="addFaq(this)">
            <i class="fal fa-plus mr-1"></i>新增問題
          </button>
        </div>
      <% end %>
    </div>

    <% if @categories.empty? %>
      <p class="text-muted mt-3">還沒有任何分類，點上面「+ 新增分類」開始建立常見問題。</p>
    <% end %>
  </div>
</div>

<div id="faqImageLightbox" onclick="closeImageLightbox()">
  <img id="faqImageLightboxImg" src="" alt="">
</div>

<% content_for :scripts_block do %>
<script>
var CSRF = document.querySelector('meta[name="csrf-token"]').content;

// ─── Category CRUD ──────────────────────────────────────────────────
function addCategory(e) {
  e.preventDefault();
  fetch('/faq_categories', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
    body: JSON.stringify({ faq_category: { name: '新分類' } })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    var tabs = document.getElementById('faqTabs');
    var addTab = tabs.lastElementChild;

    var li = document.createElement('li');
    li.className = 'nav-item';
    li.dataset.categoryId = data.id;
    li.style.whiteSpace = 'nowrap';
    li.innerHTML = '<a class="nav-link d-flex align-items-center" data-toggle="tab" href="#panel-' + data.id + '" role="tab">' +
      '<span class="faq-tab-drag-handle mr-1 text-muted" title="拖拉排序分類"><i class="fal fa-grip-vertical"></i></span>' +
      '<input type="text" class="faq-tab-rename" value="' + escapeHtml(data.name) + '" ' +
      'onclick="event.preventDefault(); event.stopPropagation();" onblur="renameCategory(' + data.id + ', this)">' +
      '<span class="badge badge-light ml-1">0</span>' +
      '<button type="button" class="btn btn-xs btn-link text-danger p-0 ml-1" title="刪除分類" ' +
      'onclick="event.preventDefault(); event.stopPropagation(); deleteCategory(' + data.id + ', this)"><i class="fal fa-trash"></i></button></a>';
    tabs.insertBefore(li, addTab);

    var content = document.querySelector('.tab-content');
    var pane = document.createElement('div');
    pane.className = 'tab-pane fade';
    pane.id = 'panel-' + data.id;
    pane.setAttribute('role', 'tabpanel');
    pane.innerHTML = '<div class="faq-list" data-category-id="' + data.id + '"></div>' +
      '<button type="button" class="btn btn-sm btn-outline-secondary mt-2" data-category-id="' + data.id + '" onclick="addFaq(this)">' +
      '<i class="fal fa-plus mr-1"></i>新增問題</button>';
    content.appendChild(pane);

    initFaqSortables();
    initTabSortable();
    $(li.querySelector('a')).tab('show');
  });
}

function renameCategory(id, input) {
  var name = input.value.trim();
  if (!name) { input.value = input.defaultValue || '未命名'; return; }
  fetch('/faq_categories/' + id, {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
    body: JSON.stringify({ faq_category: { name: name } })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) { input.value = data.name; input.defaultValue = data.name; });
}

function deleteCategory(id, btn) {
  if (!confirm('確定刪除這個分類？分類底下的問題也會一併刪除。')) return;
  fetch('/faq_categories/' + id, { method: 'DELETE', headers: { 'X-CSRF-Token': CSRF } })
  .then(function() {
    var li = btn.closest('li[data-category-id]');
    var wasActive = li.querySelector('a').classList.contains('active');
    var pane = document.getElementById('panel-' + id);
    li.remove();
    if (pane) pane.remove();
    if (wasActive) {
      var firstTab = document.querySelector('#faqTabs li[data-category-id] a');
      if (firstTab) $(firstTab).tab('show');
    }
  });
}

// ─── Faq CRUD ────────────────────────────────────────────────────────
function addFaq(btn) {
  var categoryId = btn.dataset.categoryId;
  fetch('/faqs', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
    body: JSON.stringify({ faq: { faq_category_id: categoryId, question: '新問題' } })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    var list = btn.previousElementSibling;
    list.insertAdjacentHTML('beforeend', data.html);
    initFaqSortables();
    bumpCategoryCount(categoryId, 1);
  });
}

function saveFaqField(faqId, field, value) {
  var payload = { faq: {} };
  payload.faq[field] = value;
  fetch('/faqs/' + faqId, {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
    body: JSON.stringify(payload)
  });
}

function deleteFaq(faqId, btn) {
  if (!confirm('確定刪除這個問題？')) return;
  var card = btn.closest('.faq-card');
  var categoryId = card.closest('.faq-list').dataset.categoryId;
  fetch('/faqs/' + faqId, { method: 'DELETE', headers: { 'X-CSRF-Token': CSRF } })
  .then(function() {
    card.remove();
    bumpCategoryCount(categoryId, -1);
  });
}

function bumpCategoryCount(categoryId, delta) {
  var li = document.querySelector('#faqTabs li[data-category-id="' + categoryId + '"]');
  if (!li) return;
  var badge = li.querySelector('.badge');
  badge.textContent = Math.max(0, parseInt(badge.textContent, 10) + delta);
}

// ─── Image upload (Cloudinary widget, same flow as message_templates) ──
var cloudinaryPromise = null;

function loadCloudinary() {
  if (window.cloudinary) return Promise.resolve(window.cloudinary);
  if (cloudinaryPromise) return cloudinaryPromise;

  cloudinaryPromise = new Promise(function(resolve, reject) {
    var existing = document.querySelector('script[data-cloudinary-widget="true"]');
    if (existing) {
      if (window.cloudinary) { resolve(window.cloudinary); return; }
      existing.addEventListener('load', function() {
        if (window.cloudinary) resolve(window.cloudinary);
        else reject(new Error('Cloudinary script loaded but window.cloudinary is still undefined'));
      });
      existing.addEventListener('error', function() { reject(new Error('Existing Cloudinary script failed to load')); });
      return;
    }

    var script = document.createElement('script');
    script.src = 'https://upload-widget.cloudinary.com/global/all.js';
    script.async = true;
    script.dataset.cloudinaryWidget = 'true';
    script.onload = function() {
      if (window.cloudinary) resolve(window.cloudinary);
      else reject(new Error('Cloudinary script loaded but window.cloudinary not found'));
    };
    script.onerror = function() { reject(new Error('Cloudinary script failed to load')); };
    document.head.appendChild(script);
  });

  return cloudinaryPromise;
}

function uploadImage(faqId) {
  loadCloudinary()
    .then(function(cloudinary) {
      var widget = cloudinary.createUploadWidget({
        cloudName: '<%= ENV["CLOUDINARY_CLOUD_NAME"] %>',
        uploadPreset: 'ml_default',
        multiple: true,
        maxFiles: 20,
        language: 'zh_TW',
        sources: ['local', 'camera', 'photo_library'],
        clientAllowedFormats: ['jpg', 'jpeg', 'png', 'webp', 'heic'],
        resourceType: 'image'
      }, function(error, result) {
        if (error) { console.error('[faqs] cloudinary widget error', error); return; }
        if (result && result.event === 'success') {
          saveImageToRails(faqId, result.info);
        }
      });
      widget.open();
    })
    .catch(function(err) {
      console.error('[faqs] upload flow failed', err);
      alert('上傳功能初始化失敗，請稍後再試。');
    });
}

function saveImageToRails(faqId, info) {
  fetch('/faq_images', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
    body: JSON.stringify({
      faq_image: { faq_id: faqId, cloudinary_public_id: info.public_id, url: info.secure_url }
    })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.error) { alert(data.error); return; }
    updateFaqCard(faqId, data.html);
  })
  .catch(function(err) {
    console.error('[faqs] saveImageToRails failed', err);
    alert('圖片儲存失敗，請稍後再試。');
  });
}

function deleteImage(imgId, faqId, btn) {
  if (!confirm('刪除這張圖片？')) return;
  fetch('/faq_images/' + imgId, { method: 'DELETE', headers: { 'X-CSRF-Token': CSRF } })
  .then(function(r) { return r.json(); })
  .then(function(data) { updateFaqCard(faqId, data.html); });
}

function updateFaqCard(faqId, html) {
  if (!html) return;
  var card = document.querySelector('.faq-card[data-id="' + faqId + '"]');
  if (!card) return;
  var tmp = document.createElement('div');
  tmp.innerHTML = html;
  var newCard = tmp.firstElementChild;
  card.replaceWith(newCard);
  initFaqSortables();
}

// ─── Sortable ────────────────────────────────────────────────────────
function initFaqSortables() {
  document.querySelectorAll('.faq-list').forEach(function(list) {
    if (list._sortable) list._sortable.destroy();
    list._sortable = Sortable.create(list, {
      animation: 150,
      handle: '.faq-drag-handle',
      ghostClass: 'ghost-faq',
      onEnd: function() {
        var ids = Array.from(list.querySelectorAll('.faq-card')).map(function(c) { return c.dataset.id; });
        fetch('/faqs/reorder', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
          body: JSON.stringify({ ids: ids })
        });
      }
    });
  });
}

var tabSortable = null;
function initTabSortable() {
  var tabs = document.getElementById('faqTabs');
  if (tabSortable) tabSortable.destroy();
  tabSortable = Sortable.create(tabs, {
    animation: 150,
    handle: '.faq-tab-drag-handle',
    ghostClass: 'ghost-tab',
    filter: 'li:not([data-category-id])',
    onEnd: function() {
      var ids = Array.from(tabs.querySelectorAll('li[data-category-id]')).map(function(li) { return li.dataset.categoryId; });
      fetch('/faq_categories/reorder', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
        body: JSON.stringify({ ids: ids })
      });
    }
  });
}

function escapeHtml(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ─── Image lightbox ────────────────────────────────────────────────────
function openImageLightbox(url) {
  document.getElementById('faqImageLightboxImg').src = url;
  document.getElementById('faqImageLightbox').style.display = 'flex';
}
function closeImageLightbox() {
  document.getElementById('faqImageLightbox').style.display = 'none';
}
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeImageLightbox(); });

document.addEventListener('DOMContentLoaded', function() {
  initFaqSortables();
  initTabSortable();
});
</script>
<% end %>
