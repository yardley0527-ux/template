<% content_for :page_title, "產品庫存" %>

<div class="pi-page">

  <div class="pi-header">
    <div>
      <h4 class="pi-title">📦 產品庫存</h4>
      <p class="pi-subtitle">同步自 DANDY 庫存試算表（庫存_X月＋按摩棒、藥盒庫存）</p>
    </div>
    <div class="pi-meta">
      <% if @snapshot %>
        <div>最後同步：<%= @snapshot.synced_at.in_time_zone("Taipei").strftime("%Y/%m/%d %H:%M") %></div>
        <div>資料最新記錄日：<%= @snapshot.latest_entry_date&.strftime("%Y/%m/%d") || "—" %></div>
      <% else %>
        <div>尚未同步</div>
      <% end %>
    </div>
  </div>

  <% if @purchasing_plan.present? %>
    <div class="pi-section pi-plan">
      <div class="pi-section-head">
        <h5>🗓️ 叫貨行動時程</h5>
        <span class="pi-sheet-tag">2026-08-17 人工分析</span>
      </div>
      <div class="alert alert-warning small mb-3">
        這份時程是對照「2025 vs 2026 進貨／營收同期比較表」（含 8/17 補充的第二批品項與代謝錠到貨日）
        與系統實際銷售、庫存狀態整理出的行動建議，不是任何表格的即時查詢結果——日期異動請直接改
        <code>ProductInventoryController::PURCHASING_ACTION_PLAN</code>。
      </div>
      <div class="pi-chart-wrap">
        <svg viewBox="0 0 1040 560" class="pi-chart" role="img" aria-label="時間軸（7月15日至8月31日）：薑黃7月15日已到貨；今天是8月17日；全能B群、維生素D、美白現貨都已見底且尚無到貨日；蝦紅素即時庫存僅剩1件、8月21日到貨；膠原蛋白8月20日到貨、隔天喚回流失客戶、8月23日檢查是否已上架；私密粉尚未排下一輪叫貨。代謝錠10月中與12月中的到貨不在這張圖的範圍內，列在下方清單。">
          <rect x="250" y="24" width="274.9" height="18" fill="#f3f4f6" />
          <rect x="524.9" y="24" width="485.1" height="18" fill="#f3f4f6" opacity="0.55" />
          <text class="pi-month-label" x="387.5" y="37.5" text-anchor="middle">七月</text>
          <text class="pi-month-label" x="767.5" y="37.5" text-anchor="middle">八月</text>

          <line x1="250" y1="68" x2="1010" y2="68" stroke="#e5e7eb" stroke-width="1.5" />

          <g stroke="#9ca3af" stroke-width="1">
            <line x1="250"   y1="60" x2="250"   y2="68" />
            <line x1="832.1" y1="60" x2="832.1" y2="68" />
            <line x1="848.3" y1="50" x2="848.3" y2="68" />
            <line x1="880.6" y1="60" x2="880.6" y2="68" />
            <line x1="1010"  y1="60" x2="1010"  y2="68" />
          </g>
          <text class="pi-axis-label" x="250"   y="54" text-anchor="middle">7/15</text>
          <text class="pi-axis-label" x="832.1" y="54" text-anchor="middle">8/20</text>
          <text class="pi-axis-label" x="848.3" y="44" text-anchor="middle">8/21</text>
          <text class="pi-axis-label" x="880.6" y="54" text-anchor="middle">8/23</text>
          <text class="pi-axis-label" x="1010"  y="54" text-anchor="middle">8/31</text>

          <line x1="783.6" y1="20" x2="783.6" y2="533" stroke="#0f766e" stroke-width="1.5" stroke-dasharray="3 4" />
          <text class="pi-today-label" x="783.6" y="14" text-anchor="middle">今天・8/17</text>

          <g stroke="#e5e7eb" stroke-width="1">
            <line x1="16" y1="74"  x2="1010" y2="74" />
            <line x1="16" y1="125" x2="1010" y2="125" />
            <line x1="16" y1="176" x2="1010" y2="176" />
            <line x1="16" y1="227" x2="1010" y2="227" />
            <line x1="16" y1="278" x2="1010" y2="278" />
            <line x1="16" y1="329" x2="1010" y2="329" />
            <line x1="16" y1="380" x2="1010" y2="380" />
            <line x1="16" y1="431" x2="1010" y2="431" />
            <line x1="16" y1="482" x2="1010" y2="482" />
            <line x1="16" y1="533" x2="1010" y2="533" />
          </g>

          <text class="pi-row-name"   x="16" y="94.5">🔴 全能 B群</text>
          <text class="pi-row-action" x="16" y="111">立即下單叫貨（現貨 0）</text>

          <text class="pi-row-name"   x="16" y="145.5">🔴 維生素D</text>
          <text class="pi-row-action" x="16" y="162">確認到貨日（已斷貨3個月+）</text>

          <text class="pi-row-name"   x="16" y="196.5">🔴 美白</text>
          <text class="pi-row-action" x="16" y="213">確認到貨日（營收年減95%）</text>

          <text class="pi-row-name"   x="16" y="247.5">🟠 蝦紅素</text>
          <text class="pi-row-action" x="16" y="264">到貨（現貨僅剩1）</text>

          <text class="pi-row-name"   x="16" y="298.5">🟠 膠原蛋白</text>
          <text class="pi-row-action" x="16" y="315">到貨</text>

          <text class="pi-row-name"   x="16" y="349.5">🟠 膠原蛋白</text>
          <text class="pi-row-action" x="16" y="366">喚回流失客戶</text>

          <text class="pi-row-name"   x="16" y="400.5">🟠 膠原蛋白</text>
          <text class="pi-row-action" x="16" y="417">檢查零銷售</text>

          <text class="pi-row-name"   x="16" y="451.5">🟡 私密粉</text>
          <text class="pi-row-action" x="16" y="468">尚未排下一輪叫貨</text>

          <text class="pi-row-name"   x="16" y="502.5">🟢 薑黃</text>
          <text class="pi-row-action" x="16" y="519">已到貨（案例佐證）</text>

          <g>
            <line x1="783.6" y1="99.5" x2="1005" y2="99.5" stroke="#dc2626" stroke-width="2" stroke-dasharray="1 6" stroke-linecap="round" marker-end="url(#pi-arrow-urgent)" />
            <polygon points="783.6,90 792,104 775.2,104" fill="#dc2626" />
            <text x="783.6" y="102.3" text-anchor="middle" font-size="9.5" font-weight="700" fill="#fff">!</text>
            <text class="pi-flag-label" x="960" y="94" text-anchor="middle" fill="#dc2626">尚無到貨日</text>
          </g>

          <g>
            <line x1="783.6" y1="150.5" x2="1005" y2="150.5" stroke="#dc2626" stroke-width="2" stroke-dasharray="1 6" stroke-linecap="round" marker-end="url(#pi-arrow-urgent)" />
            <polygon points="783.6,141 792,155 775.2,155" fill="#dc2626" />
            <text x="783.6" y="153.3" text-anchor="middle" font-size="9.5" font-weight="700" fill="#fff">!</text>
            <text class="pi-flag-label" x="960" y="145" text-anchor="middle" fill="#dc2626">尚無到貨日</text>
          </g>

          <g>
            <line x1="783.6" y1="201.5" x2="1005" y2="201.5" stroke="#dc2626" stroke-width="2" stroke-dasharray="1 6" stroke-linecap="round" marker-end="url(#pi-arrow-urgent)" />
            <polygon points="783.6,192 792,206 775.2,206" fill="#dc2626" />
            <text x="783.6" y="204.3" text-anchor="middle" font-size="9.5" font-weight="700" fill="#fff">!</text>
            <text class="pi-flag-label" x="960" y="196" text-anchor="middle" fill="#dc2626">尚無到貨日</text>
          </g>

          <g transform="translate(848.3,252.5)">
            <polygon points="0,-9 9,0 0,9 -9,0" fill="#ea580c" />
            <text class="pi-milestone-label" x="16" y="4.5" fill="#ea580c">到貨</text>
          </g>

          <g transform="translate(832.1,303.5)">
            <polygon points="0,-9 9,0 0,9 -9,0" fill="#ea580c" />
            <text class="pi-milestone-label" x="16" y="4.5" fill="#ea580c">到貨</text>
          </g>

          <rect x="826" y="346.5" width="30" height="15" rx="7.5" fill="#ea580c" />
          <text class="pi-milestone-label" x="864" y="358" fill="#ea580c">8/20–8/21</text>

          <g transform="translate(880.6,405.5)">
            <polygon points="0,-9 9,0 0,9 -9,0" fill="#fff" stroke="#ea580c" stroke-width="2.5" />
            <text class="pi-milestone-label" x="16" y="4.5" fill="#ea580c">到貨＋3天檢查</text>
          </g>

          <g>
            <line x1="783.6" y1="456.5" x2="1005" y2="456.5" stroke="#ca8a04" stroke-width="2" stroke-dasharray="1 6" stroke-linecap="round" marker-end="url(#pi-arrow-plan)" />
            <polygon points="783.6,447 792,461 775.2,461" fill="#ca8a04" />
            <text x="783.6" y="459.3" text-anchor="middle" font-size="9.5" font-weight="700" fill="#fff">!</text>
            <text class="pi-flag-label" x="920" y="451" text-anchor="middle" fill="#ca8a04">未排下一輪</text>
          </g>

          <g transform="translate(250,507.5)">
            <polygon points="0,-9 9,0 0,9 -9,0" fill="#16a34a" opacity="0.85" />
            <text x="0" y="3.5" text-anchor="middle" font-size="10" font-weight="700" fill="#fff">✓</text>
            <text class="pi-milestone-label" x="16" y="4.5" fill="#16a34a">已到貨</text>
          </g>

          <defs>
            <marker id="pi-arrow-urgent" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
              <path d="M0,0 L8,4 L0,8 Z" fill="#dc2626" />
            </marker>
            <marker id="pi-arrow-plan" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
              <path d="M0,0 L8,4 L0,8 Z" fill="#ca8a04" />
            </marker>
          </defs>
        </svg>
        <div class="pi-chart-caption">
          實心菱形＝到貨或行動、空心菱形＝檢查點、長條＝跨日期任務、虛線箭頭＝日期未定的待辦（紅＝急件、黃＝提前準備）。
          代謝錠（10月中、12月中到貨）與其他健康/新品項不在這張圖的範圍內，完整清單在下方。
        </div>
      </div>

      <div class="pi-plan-list">
        <% @purchasing_plan.each do |item| %>
          <div class="pi-plan-item pi-plan-<%= item[:status] %>">
            <div class="pi-plan-when"><%= item[:when] %></div>
            <div class="pi-plan-body">
              <div class="pi-plan-head">
                <span class="pi-plan-icon"><%= item[:icon] %></span>
                <span class="pi-plan-product"><%= item[:product] %></span>
                <span class="pi-plan-action"><%= item[:action] %></span>
              </div>
              <div class="pi-plan-reason"><%= item[:reason] %></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @last_run&.status == "failed" %>
    <div class="alert alert-danger">
      上次同步失敗：<%= @last_run.error_messages.join("；") %>
      <br>請確認試算表已開啟「知道連結的人可檢視」。下方顯示的是最後一次成功同步的資料。
    </div>
  <% end %>

  <% if @snapshot.nil? %>
    <div class="alert alert-warning">
      還沒有庫存資料。請先確認 DANDY 庫存試算表已開啟「知道連結的人可檢視」，
      同步會每小時自動執行（或重新整理此頁觸發）。
    </div>
  <% else %>

    <% supplements = @snapshot.supplements %>
    <div class="pi-section">
      <div class="pi-section-head">
        <h5><%= supplements["title"].presence || "保健品庫存" %></h5>
        <span class="pi-sheet-tag">分頁：<%= supplements["sheet_name"] %></span>
      </div>
      <div class="pi-table-wrap">
        <table class="pi-table">
          <thead>
            <tr>
              <th class="pi-th-name">品項</th>
              <% supplements["columns"].each do |col| %>
                <th><%= col %></th>
              <% end %>
              <th>預定到貨日期</th>
            </tr>
          </thead>
          <tbody>
            <% supplements["rows"].each do |row| %>
              <tr>
                <td class="pi-td-name"><%= row["name"] %></td>
                <% row["values"].each_with_index do |value, i| %>
                  <td class="<%= 'pi-outbound' if [2, 3].include?(i) %>">
                    <%= value.is_a?(Numeric) ? number_with_delimiter(value) : value %>
                  </td>
                <% end %>
                <td class="pi-arrival"><%= row["arrival"] %></td>
              </tr>
            <% end %>
            <% if (total = supplements["total"]) %>
              <tr class="pi-total-row">
                <td class="pi-td-name">小計</td>
                <% total["values"].each_with_index do |value, i| %>
                  <td class="<%= 'pi-outbound' if [2, 3].include?(i) %>">
                    <%= value.is_a?(Numeric) ? number_with_delimiter(value) : value %>
                  </td>
                <% end %>
                <td></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <% accessories = @snapshot.accessories %>
    <div class="pi-section">
      <div class="pi-section-head">
        <h5>按摩棒、藥盒庫存</h5>
        <span class="pi-sheet-tag">首列日期為當月期初量，之後為每日異動</span>
      </div>
      <div class="pi-table-wrap">
        <table class="pi-table pi-grid">
          <thead>
            <tr>
              <th class="pi-th-name pi-sticky">日期</th>
              <% accessories["products"].each do |product| %>
                <th class="pi-th-product"><%= product["name"] %></th>
              <% end %>
            </tr>
            <tr class="pi-realtime-row">
              <th class="pi-th-name pi-sticky">即時庫存</th>
              <% accessories["products"].each do |product| %>
                <th><%= product["realtime"].is_a?(Numeric) ? number_with_delimiter(product["realtime"]) : product["realtime"] %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% accessories["daily"].each do |row| %>
              <tr>
                <td class="pi-td-name pi-sticky"><%= Date.parse(row["date"]).strftime("%m/%d") %></td>
                <% row["values"].each do |value| %>
                  <td class="<%= 'pi-negative' if value.is_a?(Numeric) && value.negative? %>">
                    <%= value.is_a?(Numeric) ? number_with_delimiter(value) : value %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

  <% end %>
</div>

<style>
  .pi-page { padding: 0.5rem 0.25rem; }
  .pi-header { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
  .pi-title { margin-bottom: 0.25rem; font-weight: 700; }
  .pi-subtitle { color: #6b7280; margin-bottom: 0; font-size: 0.85rem; }
  .pi-meta { text-align: right; color: #6b7280; font-size: 0.85rem; }

  .pi-section { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 1rem; margin-bottom: 1.25rem; }
  .pi-section-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem; }
  .pi-section-head h5 { margin: 0; font-weight: 700; }
  .pi-sheet-tag { color: #9ca3af; font-size: 0.8rem; }

  .pi-table-wrap { overflow-x: auto; }
  .pi-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; white-space: nowrap; }
  .pi-table th, .pi-table td { border: 1px solid #e5e7eb; padding: 0.35rem 0.6rem; text-align: center; }
  .pi-table thead th { background: #f3f4f6; font-weight: 700; }
  .pi-th-name, .pi-td-name { text-align: center; font-weight: 700; background: #fafafa; }
  .pi-outbound { color: #dc2626; }
  .pi-negative { color: #dc2626; }
  .pi-arrival { color: #b45309; font-size: 0.8rem; }
  .pi-total-row td { font-weight: 700; background: #f9fafb; }

  .pi-grid .pi-th-product { min-width: 5.5rem; white-space: normal; font-size: 0.78rem; }
  .pi-realtime-row th { background: #fff7ed; color: #b45309; }
  .pi-sticky { position: sticky; left: 0; z-index: 1; }

  .pi-plan-list { display: flex; flex-direction: column; gap: 0.6rem; }
  .pi-plan-item { display: flex; gap: 1rem; align-items: flex-start; border-left: 4px solid #d1d5db; background: #fafafa; border-radius: 6px; padding: 0.6rem 0.9rem; }
  .pi-plan-when { flex: 0 0 9.5rem; font-weight: 700; font-size: 0.85rem; color: #374151; }
  .pi-plan-body { flex: 1; min-width: 0; }
  .pi-plan-head { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: baseline; font-weight: 700; margin-bottom: 0.15rem; }
  .pi-plan-product { color: #111827; }
  .pi-plan-action { font-weight: 400; color: #1f2937; }
  .pi-plan-reason { color: #6b7280; font-size: 0.82rem; }

  .pi-plan-urgent     { border-left-color: #dc2626; background: #fef2f2; }
  .pi-plan-scheduled  { border-left-color: #ea580c; background: #fff7ed; }
  .pi-plan-plan_ahead { border-left-color: #ca8a04; background: #fefce8; }
  .pi-plan-reference  { border-left-color: #16a34a; background: #f0fdf4; }

  .pi-chart-wrap { margin-bottom: 1.1rem; }
  .pi-chart { display: block; width: 100%; height: auto; }
  .pi-chart-caption { margin-top: 0.5rem; font-size: 0.76rem; color: #9ca3af; border-top: 1px solid #e5e7eb; padding-top: 0.5rem; }
  .pi-row-name { font-weight: 700; font-size: 13.5px; fill: #111827; }
  .pi-row-action { font-size: 12px; fill: #6b7280; }
  .pi-axis-label { font-size: 11px; fill: #6b7280; }
  .pi-month-label { font-size: 12px; font-weight: 600; fill: #6b7280; letter-spacing: 0.04em; }
  .pi-today-label { font-size: 11.5px; font-weight: 700; fill: #0f766e; }
  .pi-flag-label { font-size: 12px; font-weight: 600; }
  .pi-milestone-label { font-size: 11.5px; font-weight: 600; }
</style>
