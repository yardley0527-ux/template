<%# app/views/spending_rankings/index.html.erb %>
<% content_for :page_title, "消費排行榜" %>

<% def ig_link_url(account)
  return nil if account.blank?
  handle = account.strip.gsub(/^@/, '').gsub(%r{https?://(?:www\.)?instagram\.com/?}, '').gsub(%r{/$}, '').strip
  handle.present? ? "https://www.instagram.com/#{handle}/" : nil
end %>

<%# Header %>
<div class="row g-3 mb-3">
  <div class="col-12">
    <h4 class="fw-bold mb-0">消費排行榜</h4>
    <p class="text-muted small mb-0">只計「已付款」訂單，依會員彙總 2025 / 2026 消費金額</p>
  </div>
</div>

<%# 摘要卡：老闆先看重點，點卡片看名單 %>
<div class="row g-3 mb-4">
  <div class="col-md-4">
    <%= link_to spending_rankings_path(focus: "cooling"), class: "text-decoration-none" do %>
      <div class="card border-0 shadow-sm h-100 <%= 'border' if @focus == 'cooling' %>" style="border-left:4px solid #c0392b !important;">
        <div class="card-body py-3">
          <div class="text-muted small mb-1"><i class="fal fa-exclamation-triangle" style="color:#c0392b;"></i> 流失警訊</div>
          <div class="fw-bold" style="font-size:1.6rem; color:#c0392b;"><%= @summary[:cooling_count] %> 人</div>
          <div class="text-muted" style="font-size:0.78rem;">2025 前 100 名中，今年消費不到去年同期一半（其中 <%= @summary[:cooling_no_repurchase] %> 人今年完全沒回購）</div>
          <div class="fw-semibold mt-1" style="font-size:0.75rem; color:#c0392b;">點擊看名單 <i class="fal fa-chevron-right"></i></div>
        </div>
      </div>
    <% end %>
  </div>
  <div class="col-md-4">
    <%= link_to spending_rankings_path(focus: "rising"), class: "text-decoration-none" do %>
      <div class="card border-0 shadow-sm h-100 <%= 'border' if @focus == 'rising' %>" style="border-left:4px solid #1e7e34 !important;">
        <div class="card-body py-3">
          <div class="text-muted small mb-1"><i class="fal fa-arrow-up" style="color:#1e7e34;"></i> 上升新星</div>
          <div class="fw-bold" style="font-size:1.6rem; color:#1e7e34;"><%= @summary[:rising_count] %> 人</div>
          <div class="text-muted" style="font-size:0.78rem;">2026 前 100 名中，已超越自己 2025 全年消費（含 <%= @summary[:rising_new] %> 位 2025 未消費的新面孔）</div>
          <div class="fw-semibold mt-1" style="font-size:0.75rem; color:#1e7e34;">點擊看名單 <i class="fal fa-chevron-right"></i></div>
        </div>
      </div>
    <% end %>
  </div>
  <div class="col-md-4">
    <%= link_to spending_rankings_path(tab: "total"), class: "text-decoration-none" do %>
      <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #6e4a2e !important;">
        <div class="card-body py-3">
          <div class="text-muted small mb-1"><i class="fal fa-coins" style="color:#6e4a2e;"></i> 總榜前 <%= @summary[:total_count] %> 名貢獻</div>
          <div class="fw-bold" style="font-size:1.6rem; color:#6e4a2e;">NT$<%= number_with_delimiter(@summary[:total_amount]) %></div>
          <div class="text-muted" style="font-size:0.78rem;">2025 + 2026 累積消費金額合計</div>
          <div class="fw-semibold mt-1" style="font-size:0.75rem; color:#6e4a2e;">點擊看總榜 <i class="fal fa-chevron-right"></i></div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<% if @focus %>
  <div class="mb-3">
    <%= link_to "← 回排行榜", spending_rankings_path(tab: @tab), class: "btn btn-sm btn-dark" %>
  </div>
<% else %>
  <ul class="nav nav-tabs mb-3" style="font-size:0.9rem;">
    <% SpendingRankingsController::TABS.each do |key, config| %>
      <li class="nav-item">
        <%= link_to config[:title], spending_rankings_path(tab: key),
              class: "nav-link #{@tab == key ? 'active fw-bold' : 'text-muted'}" %>
      </li>
    <% end %>
  </ul>
<% end %>

<% list_title    = @focus_config ? @focus_config[:title]    : @tab_config[:title] %>
<% list_subtitle = @focus_config ? @focus_config[:subtitle] : @tab_config[:subtitle] %>
<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-white d-flex align-items-center flex-wrap" style="gap:8px;">
    <span class="fw-bold"><%= list_title %></span>
    <span class="badge bg-secondary"><%= @total_count %> 人</span>
    <span class="text-muted small"><%= list_subtitle %></span>
    <span class="ms-auto text-muted small">頁數：<%= @page %> / <%= @total_pages %></span>
  </div>
  <div class="card-body p-0 table-responsive">
    <% sort_key = @tab_config[:sort_key] %>
    <table class="table align-middle mb-0" style="font-size:0.86rem;">
      <thead style="background-color:#4a4a4a; color:white;">
        <tr>
          <th class="ps-3" style="width:<%= @focus_config ? 100 : 70 %>px;"><%= @focus_config ? @focus_config[:rank_label] : "排名" %></th>
          <th style="width:140px;">姓名</th>
          <th style="width:160px;">IG</th>
          <th style="width:85px;">卡別</th>
          <th style="width:120px;">
            動能
            <div class="fw-normal" style="font-size:0.68rem; opacity:0.75;">2026 對比 2025 同期</div>
          </th>
          <th class="text-end" style="width:140px;">2025 消費金額</th>
          <th class="text-end" style="width:150px;">2026 累積消費金額</th>
          <th class="text-end" style="width:150px;">總累積消費金額</th>
          <th class="text-end pe-3" style="width:130px;">最近消費</th>
        </tr>
      </thead>
      <tbody>
        <% @rows.each do |r| %>
          <% url = ig_link_url(r[:instagram_account]) %>
          <tr>
            <td class="ps-3">
              <% if r[:rank] <= 3 %>
                <span class="fw-bold" style="color:#c0392b; font-size:1rem;"><%= r[:rank] %></span>
              <% else %>
                <span class="text-muted"><%= r[:rank] %></span>
              <% end %>
            </td>
            <td class="fw-semibold">
              <% if r[:shopline_customer_id] %>
                <%= link_to r[:full_name].presence || r[:email], customer_path(r[:shopline_customer_id]), target: "_blank", class: "text-decoration-none" %>
              <% else %>
                <%= r[:full_name].presence || r[:email] %>
              <% end %>
            </td>
            <td>
              <% if url %>
                <%= link_to url, target: "_blank", class: "text-decoration-none d-flex align-items-center gap-1" do %>
                  <i class="fal fa-at text-danger"></i>
                  <span style="font-size:0.8rem; max-width:140px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:inline-block;">
                    <%= r[:instagram_account]&.sub(/^@/, '') %>
                  </span>
                <% end %>
              <% else %>
                <span class="text-muted small">—</span>
              <% end %>
            </td>
            <td>
              <% badge_bg, badge_fg = case r[:membership_level]
                                    when '黑卡' then ['#333', '#fff']
                                    when '金卡' then ['#b8860b', '#fff']
                                    when '銀卡' then ['#6c757d', '#fff']
                                    when '白卡' then ['#dee2e6', '#333']
                                    else             ['#adb5bd', '#333']
                                    end %>
              <span class="badge" style="background:<%= badge_bg %>; color:<%= badge_fg %>; font-size:0.75rem;"><%= r[:membership_level].presence || "—" %></span>
            </td>
            <td>
              <% case r[:trend] %>
              <% when :cooling %>
                <span class="badge" style="background:#fdecea; color:#c0392b; font-size:0.72rem;"><i class="fal fa-arrow-down"></i> 流失警訊</span>
              <% when :surpassed %>
                <span class="badge" style="background:#e6f4ea; color:#1e7e34; font-size:0.72rem;"><i class="fal fa-arrow-up"></i> 超越去年</span>
              <% when :new %>
                <span class="badge" style="background:#e7f1fb; color:#1a5da6; font-size:0.72rem;"><i class="fal fa-sparkles"></i> NEW</span>
              <% else %>
                <span class="text-muted small">穩定</span>
              <% end %>
            </td>
            <td class="text-end <%= 'fw-bold' if sort_key == :amount_2025 %>" style="<%= 'color:#c0392b; font-size:0.95rem;' if sort_key == :amount_2025 %>">
              <%= r[:amount_2025].positive? ? "NT$#{number_with_delimiter(r[:amount_2025])}" : "—" %>
            </td>
            <td class="text-end <%= 'fw-bold' if sort_key == :amount_2026 %>" style="<%= 'color:#c0392b; font-size:0.95rem;' if sort_key == :amount_2026 %>">
              <%= r[:amount_2026].positive? ? "NT$#{number_with_delimiter(r[:amount_2026])}" : "—" %>
            </td>
            <td class="text-end <%= sort_key == :amount_total ? 'fw-bold' : 'fw-semibold' %>" style="<%= sort_key == :amount_total ? 'color:#c0392b; font-size:0.95rem;' : 'color:#6e4a2e;' %>">
              NT$<%= number_with_delimiter(r[:amount_total]) %>
            </td>
            <td class="text-end pe-3">
              <% if r[:last_order_date] %>
                <div style="font-size:0.8rem;"><%= r[:last_order_date].strftime('%Y/%m/%d') %></div>
                <% if r[:silent_days] > SpendingRankingsController::SILENT_DAYS %>
                  <div class="fw-bold" style="font-size:0.72rem; color:#c0392b;"><%= r[:silent_days] %> 天沒消費</div>
                <% else %>
                  <div class="text-muted" style="font-size:0.72rem;"><%= r[:silent_days] %> 天前</div>
                <% end %>
              <% else %>
                <span class="text-muted small">—</span>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @rows.empty? %>
          <tr>
            <td colspan="9" class="text-center py-5 text-muted">
              <i class="fal fa-inbox fa-2x mb-2 d-block opacity-25"></i>
              目前沒有符合的消費紀錄
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @total_pages > 1 %>
    <div class="card-footer bg-white d-flex align-items-center justify-content-between">
      <span class="text-muted small">
        第 <%= (@page - 1) * SpendingRankingsController::PER_PAGE + 1 %>–<%= [(@page * SpendingRankingsController::PER_PAGE), @total_count].min %> 筆，共 <%= @total_count %> 筆
      </span>
      <div>
        <% page_params = { tab: @focus ? nil : @tab, focus: @focus }.compact %>
        <%= link_to "上一頁", spending_rankings_path(page_params.merge(page: [@page - 1, 1].max)),
              class: "btn btn-outline-secondary btn-sm me-2 #{'disabled' if @page <= 1}" %>
        <%= link_to "下一頁", spending_rankings_path(page_params.merge(page: [@page + 1, @total_pages].min)),
              class: "btn btn-outline-secondary btn-sm #{'disabled' if @page >= @total_pages}" %>
      </div>
    </div>
  <% end %>
</div>
