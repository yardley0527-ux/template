<!-- app/views/credit_tiers/index.html.erb -->
<div class="subheader">
  <h1 class="subheader-title">
    <i class="subheader-icon fal fa-user"></i>
    購物金級距 × 產品分組
    <small>依「現有購物金」分級，查看每級距客人購買最多的產品與名單</small>
  </h1>

  <div class="subheader-block">
    <%= link_to "匯出：產品彙總 CSV",
      credit_tiers_export_path(type: "products", threshold: @threshold, year: @year),
      class: "btn btn-outline-primary btn-sm me-2" %>

    <%= link_to "匯出：客人名單 CSV",
      credit_tiers_export_path(type: "customers", threshold: @threshold, year: @year),
      class: "btn btn-outline-primary btn-sm" %>
  </div>
</div>

<div class="row">
  <div class="col-12">
    <div class="panel">
      <div class="panel-hdr"><h2>篩選條件</h2></div>
      <div class="panel-container show">
        <div class="panel-content">
          <%= form_with url: credit_tiers_path, method: :get, local: true, class: "row g-2 align-items-end" do %>
            <div class="col-sm-6 col-md-3">
              <label class="form-label">購物金門檻</label>
              <%= number_field_tag :threshold, @threshold, class: "form-control" %>
            </div>

            <div class="col-sm-6 col-md-3">
              <label class="form-label">年份（可空）</label>
              <%= number_field_tag :year, @year, class: "form-control", placeholder: "例如 2024" %>
            </div>

            <div class="col-sm-6 col-md-3">
              <label class="form-label">商品關鍵字（可空）</label>
              <%= text_field_tag :q, @q, class: "form-control", placeholder: "例如 代謝錠" %>
            </div>

            <div class="col-sm-6 col-md-3">
              <div class="d-flex">
                <%= button_tag "更新", type: "submit", class: "btn btn-primary" %>
                <%= link_to "清除", credit_tiers_path, class: "btn btn-outline-secondary" %>
              </div>
            </div>

            <div class="col-12 mt-2">
              <div class="small text-muted">
                顯示每級距 Top <%= @limit_products %> 產品；每個產品最多展開 <%= @limit_customers %> 位客人（可用 URL 參數 limit_products / limit_customers 調整）。
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <% @result[:tiers].each_with_index do |tier, idx| %>
      <div class="panel">
        <div class="panel-hdr">
          <h2>
            級距：<%= tier[:key] %>
            <span class="badge bg-info-500 ms-2">客人 <%= tier[:customers_count] %></span>
            <span class="badge bg-success-500 ms-2">產品 <%= tier[:products].size %></span>
          </h2>
        </div>

        <div class="panel-container show">
          <div class="panel-content">
            <div class="table-responsive">
              <table class="table table-bordered table-hover table-striped w-100">
                <thead class="bg-primary-600">
                  <tr>
                    <th style="width: 40px;"></th>
                    <th>商品</th>
                    <th class="text-end">客數</th>
                    <th class="text-end">瓶數</th>
                    <th class="text-end">營收</th>
                  </tr>
                </thead>
                <tbody>
                  <% if tier[:products].blank? %>
                    <tr><td colspan="5" class="text-center text-muted py-4">沒有資料</td></tr>
                  <% else %>
                    <% tier[:products].each_with_index do |p, pidx| %>
                      <% collapse_id = "tier#{idx}_p#{pidx}" %>
                      <tr>
                        <td class="text-center">
                          <a data-bs-toggle="collapse" href="#<%= collapse_id %>" role="button" aria-expanded="false" aria-controls="<%= collapse_id %>">
                            <i class="fal fa-plus-square"></i>
                          </a>
                        </td>
                        <td class="fw-500"><%= p[:product_name] %></td>
                        <td class="text-end"><%= p[:customers_count].to_i %></td>
                        <td class="text-end"><%= p[:units_sold].to_i %></td>
                        <td class="text-end"><%= number_with_delimiter(p[:revenue].to_i) %></td>
                      </tr>

                      <tr class="collapse" id="<%= collapse_id %>">
                        <td colspan="5" class="bg-fusion-50">
                          <div class="p-2">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                              <div class="fw-500">名單（最多 <%= @limit_customers %> 人）</div>
                              <div class="small text-muted">
                                需要完整名單請用上方「匯出：客人名單 CSV」
                              </div>
                            </div>

                            <div class="table-responsive">
                              <table class="table table-sm table-bordered mb-0">
                                <thead>
                                  <tr>
                                    <th>客人</th>
                                    <th class="text-end">購物金</th>
                                    <th>LINE</th>
                                    <th>電話</th>
                                    <th>城市</th>
                                    <th class="text-end">件數</th>
                                    <th class="text-end">營收</th>
                                  </tr>
                                </thead>
                                <tbody>
                                  <% if p[:customers].blank? %>
                                    <tr><td colspan="7" class="text-center text-muted py-3">沒有名單</td></tr>
                                  <% else %>
                                    <% p[:customers].each do |c| %>
                                      <tr>
                                        <td>
                                          <div class="fw-500"><%= c[:full_name].presence || "(無名)" %></div>
                                          <div class="small text-muted"><%= c[:email] %></div>
                                          <div class="small text-muted"><%= c[:membership_level] %></div>
                                        </td>
                                        <td class="text-end"><%= c[:credits].to_i %></td>
                                        <td><%= c[:line_id] %></td>
                                        <td><%= c[:mobile_phone].presence || c[:phone] %></td>
                                        <td><%= c[:city] %></td>
                                        <td class="text-end"><%= c[:units_sold].to_i %></td>
                                        <td class="text-end"><%= number_with_delimiter(c[:revenue].to_i) %></td>
                                      </tr>
                                    <% end %>
                                  <% end %>
                                </tbody>
                              </table>
                            </div>
                          </div>
                        </td>
                      </tr>
                    <% end %>
                  <% end %>
                </tbody>
              </table>
            </div>

            <div class="small text-muted mt-2">
              這個 tier 的產品表是依「客數 → 瓶數 → 營收」排序。
            </div>
          </div>
        </div>
      </div>
    <% end %>

  </div>
</div>
