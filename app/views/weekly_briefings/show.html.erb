<% content_for :page_title, "每週檢討報告" %>
<% m = @briefing&.metrics || {} %>

<div class="subheader">
  <h1 class="subheader-title">
    <i class="fal fa-calendar-week mr-2 text-info"></i> 每週檢討報告
    <span class="text-muted small ml-2"><%= @period.week_start.strftime("%Y/%m/%d") %> ~ <%= @period.week_end.strftime("%m/%d") %></span>
  </h1>
  <div class="ml-auto">
    <%= link_to weekly_briefing_path(week_start: @period.prev_week_start.to_s), class: "btn btn-outline-secondary btn-sm mr-1" do %>
      <i class="fal fa-chevron-left"></i> 上一週
    <% end %>
    <%= link_to weekly_briefing_path(week_start: (@period.week_start + 7).to_s), class: "btn btn-outline-secondary btn-sm mr-1" do %>
      下一週 <i class="fal fa-chevron-right"></i>
    <% end %>
    <%= link_to weekly_briefings_path, class: "btn btn-outline-secondary btn-sm mr-1" do %>
      <i class="fal fa-list mr-1"></i>歷史週報
    <% end %>
    <% if current_user.admin? %>
      <%= button_to "重新產生本週報告", regenerate_weekly_briefing_path(week_start: @period.week_start.to_s),
                    method: :post, class: "btn btn-info btn-sm", data: { confirm: "重新產生會覆蓋這一週目前的 AI 分析，確定嗎？" } %>
    <% end %>
  </div>
</div>

<% if @briefing.nil? %>
  <div class="panel">
    <div class="panel-content text-center py-5 text-muted">
      <i class="fal fa-file-alt fa-3x mb-3 d-block opacity-25"></i>
      這一週還沒有產生報告。
      <% if current_user.admin? %>
        <div class="mt-3">
          <%= button_to "產生這一週的報告", regenerate_weekly_briefing_path(week_start: @period.week_start.to_s),
                        method: :post, class: "btn btn-info" %>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <% briefing = @briefing %>

  <% if briefing.status == "failed" %>
    <div class="alert alert-danger">
      <i class="fal fa-exclamation-triangle mr-1"></i>
      AI 分析生成失敗：<%= briefing.error_message %>
      <% if m.present? %>（下方數據仍為本次計算結果，可放心參考；只有 AI 解讀／待辦沒有產生）<% end %>
    </div>
  <% end %>

  <% if briefing.status == "success" %>
    <div class="panel">
      <div class="panel-hdr bg-info-600"><h2 class="text-white">本週一句話結論</h2></div>
      <div class="panel-content">
        <h4 class="mb-0"><%= briefing.one_liner %></h4>
      </div>
    </div>

    <% if briefing.key_numbers.any? %>
      <div class="row">
        <% briefing.key_numbers.each do |kn| %>
          <div class="col-md-3 col-6 mb-3">
            <div class="card h-100">
              <div class="card-body py-2">
                <div class="text-muted small"><%= kn["label"] %></div>
                <div class="h5 mb-0"><%= kn["value"] %></div>
                <div class="small text-muted">
                  vs <%= kn["compare_label"] %>：<%= kn["compare_value"] %>
                  <%= wb_delta_badge(kn["delta_pct"]) if kn["delta_pct"] %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%# ── 營收進度 ── %>
  <% rp = m["revenue_progress"] %>
  <% if rp %>
    <div class="panel">
      <div class="panel-hdr"><h2>營收進度</h2></div>
      <div class="panel-content">
        <div class="row text-center mb-3">
          <div class="col"><div class="text-muted small">本週</div><div class="h6"><%= wb_money(rp["this_week_revenue"]) %></div></div>
          <div class="col"><div class="text-muted small">上週</div><div class="h6"><%= wb_money(rp["prev_week_revenue"]) %></div><%= wb_delta_badge(rp["week_over_week_growth_pct"]) %></div>
          <div class="col"><div class="text-muted small">本月累計</div><div class="h6"><%= wb_money(rp["mtd_revenue"]) %></div></div>
          <div class="col"><div class="text-muted small">今年累計</div><div class="h6"><%= wb_money(rp["ytd_revenue"]) %></div></div>
          <div class="col"><div class="text-muted small">去年同期</div><div class="h6"><%= wb_money(rp["last_year_same_period_ytd_revenue"]) %></div><%= wb_delta_badge(rp["yoy_growth_pct"]) %></div>
          <div class="col"><div class="text-muted small">去年全年</div><div class="h6"><%= wb_money(rp["last_year_full_year_revenue"]) %></div></div>
        </div>
        <hr>
        <div class="row">
          <div class="col-md-6">
            <p class="mb-1">
              距離超越去年全年營收：
              <% if rp["already_beat_last_year"] %>
                <span class="badge badge-success">已超越（超出 <%= wb_money(-rp["gap_to_beat_last_year"]) %>）</span>
              <% else %>
                <span class="badge badge-warning">還差 <%= wb_money(rp["gap_to_beat_last_year"]) %></span>
              <% end %>
            </p>
            <p class="mb-1 small text-muted">今年剩餘 <%= rp["days_remaining_in_year"] %> 天（約 <%= rp["weeks_remaining_in_year"] %> 週）</p>
            <% if rp["required_weekly_revenue_to_beat_last_year"] %>
              <p class="mb-1 small">若要超越去年，之後每週至少需要營收：<strong><%= wb_money(rp["required_weekly_revenue_to_beat_last_year"]) %></strong>
                （近4週平均週營收：<%= wb_money(rp["trailing4_weekly_avg_revenue"]) %>）</p>
            <% end %>
          </div>
          <div class="col-md-6">
            <div class="text-muted small mb-1">年底營收預測（依近4週均速外推）</div>
            <table class="table table-sm mb-0">
              <tr><td>保守（近4週均速×0.85）</td><td class="text-right"><%= wb_money(rp.dig("projected_year_end", "conservative")) %></td></tr>
              <tr><td>基準（近4週均速）</td><td class="text-right"><%= wb_money(rp.dig("projected_year_end", "base")) %></td></tr>
              <tr><td>樂觀（近4週均速×1.15）</td><td class="text-right"><%= wb_money(rp.dig("projected_year_end", "optimistic")) %></td></tr>
            </table>
            <div class="small mt-1">
              基準情境<%= rp["will_beat_last_year_base_case"] ? content_tag(:span, "預估可超越去年", class: "text-success") : content_tag(:span, "預估無法超越去年", class: "text-danger") %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%# ── 新舊客分析 ── %>
  <% nvr = m["new_vs_returning"] %>
  <% if nvr %>
    <div class="panel">
      <div class="panel-hdr"><h2>新客與舊客分析</h2></div>
      <div class="panel-content p-0">
        <div class="table-responsive">
          <table class="table table-sm mb-0">
            <thead class="thead-light">
              <tr><th></th><th>本週</th><th>上週</th><th>近4週平均</th><th>去年同週</th></tr>
            </thead>
            <tbody>
              <% %w[new_customers returning_customers new_revenue returning_revenue new_aov returning_aov new_pct].each do |k| %>
                <tr>
                  <td class="text-muted small">
                    <%= { "new_customers"=>"新客人數","returning_customers"=>"舊客回購人數","new_revenue"=>"新客營收",
                          "returning_revenue"=>"舊客營收","new_aov"=>"新客客單價","returning_aov"=>"舊客客單價","new_pct"=>"新客佔比" }[k] %>
                  </td>
                  <% %w[this_week prev_week trailing4_weekly_avg last_year_same_week].each do |period_key| %>
                    <td>
                      <% v = nvr.dig(period_key, k) %>
                      <%= k.end_with?("revenue", "aov") ? wb_money(v) : (k == "new_pct" ? wb_pct(v) : v) %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <% nbr = nvr["new_buyer_repurchase"] %>
        <% if nbr %>
          <div class="p-3 small text-muted border-top">
            近4週新客回購率（<%= nbr["cohort_window_start"] %> ~ <%= nbr["cohort_window_end"] %> 首購 cohort，早期信號，非完整生命週期回購率）：
            <%= nbr["repurchased_count"] %> / <%= nbr["cohort_size"] %> = <strong><%= wb_pct(nbr["repurchase_rate_pct"]) %></strong>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# ── 直播表現 ── %>
  <% ls = m["livestreams"] %>
  <div class="panel">
    <div class="panel-hdr"><h2>直播表現（近 14 天）</h2></div>
    <div class="panel-content p-0">
      <% if ls.blank? || ls["events"].blank? %>
        <div class="p-4 text-center text-muted">本期間無直播</div>
      <% else %>
        <div class="table-responsive">
          <table class="table table-sm table-hover mb-0">
            <thead class="thead-light">
              <tr>
                <th>日期</th><th>主題</th><th>訂單數</th><th>買家數</th><th>新客%</th>
                <th>營收</th><th>客單價</th><th>vs上一場</th><th>vs同類型近3場</th>
              </tr>
            </thead>
            <tbody>
              <% ls["events"].each do |e| %>
                <tr>
                  <td class="text-nowrap"><%= e["date"] %><% if e["stale_stats"] %> <i class="fal fa-exclamation-circle text-warning" title="統計快取可能過期，建議重跑 livestreams:stats:refresh"></i><% end %></td>
                  <td><%= e["title"] %></td>
                  <td><%= e["total_orders"] %></td>
                  <td><%= e["total_buyers"] %>（新<%= e["new_buyers"] %>／舊<%= e["returning_buyers"] %>）</td>
                  <td><%= wb_pct(e["new_buyer_pct"]) %></td>
                  <td><%= wb_money(e["total_revenue"]) %></td>
                  <td><%= wb_money(e["aov"]) %></td>
                  <td><%= wb_delta_badge(e.dig("vs_previous_event", "revenue_delta_pct")) %></td>
                  <td><%= wb_delta_badge(e.dig("vs_same_type_avg3", "revenue_delta_pct")) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── 會員卡別維護 ── %>
  <% mem = m["membership"] %>
  <% if mem %>
    <div class="panel">
      <div class="panel-hdr"><h2>會員卡別維護</h2></div>
      <div class="panel-content p-0">
        <div class="table-responsive">
          <table class="table table-sm mb-0">
            <thead class="thead-light">
              <tr>
                <th>卡別</th><th>會員數</th><th>活躍<%= "(#{mem['active_window_days']}天內)" %></th><th>沉睡</th>
                <th>本週營收</th><th>本週客單價</th><th>今年累計營收</th>
              </tr>
            </thead>
            <tbody>
              <% mem["levels"].each do |lv| %>
                <tr>
                  <td><%= lv["level"] %></td>
                  <td><%= lv["member_count"] %></td>
                  <td><%= lv["active_count"] %></td>
                  <td><%= lv["dormant_count"] %></td>
                  <td><%= wb_money(lv.dig("this_week", "revenue")) %></td>
                  <td><%= wb_money(lv.dig("this_week", "aov")) %></td>
                  <td><%= wb_money(lv.dig("ytd", "revenue")) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="p-3 border-top small">
          <div>黑金卡營收依賴度（本週）：<strong><%= wb_pct(mem["black_gold_revenue_share_pct"]) %></strong></div>
          <div>升級 <%= mem.dig("changes","upgrade_count") %> 人（近4週平均 <%= mem.dig("changes","trailing4_weekly_avg_upgrade_count") %> 人）／
               降級 <%= mem.dig("changes","downgrade_count") %> 人（近4週平均 <%= mem.dig("changes","trailing4_weekly_avg_downgrade_count") %> 人）</div>
          <div class="text-muted mt-1"><%= mem["near_threshold_note"] %></div>
        </div>
      </div>
    </div>
  <% end %>

  <%# ── 商品回購與沉睡狀況 ── %>
  <% pr = m["product_repurchase"] %>
  <% if pr %>
    <div class="panel">
      <div class="panel-hdr"><h2>商品回購與沉睡狀況</h2></div>
      <div class="panel-content p-0">
        <div class="table-responsive">
          <table class="table table-sm table-hover mb-0">
            <thead class="thead-light">
              <tr>
                <th>產品</th><th>庫存</th><th>本週買家</th><th>本週營收</th><th>本週回購人數</th>
                <th>逾期未回購</th><th>今日待聯絡</th><th>即將用完</th><th>歷史回購率</th><th>平均回購週期</th>
              </tr>
            </thead>
            <tbody>
              <% pr["products"].each do |p| %>
                <tr>
                  <td><%= p["label"] %></td>
                  <td><%= CrmProduct::AVAILABILITY_STATUS_LABELS[p["availability_status"]] %></td>
                  <td><%= p.dig("this_week","total_customers") %></td>
                  <td><%= wb_money(p.dig("this_week","total_revenue")) %></td>
                  <td><%= p["repurchased_this_week"] %></td>
                  <td><span class="badge <%= p['overdue_count'].to_i.positive? ? 'badge-danger' : 'badge-light' %>"><%= p["overdue_count"] %></span></td>
                  <td><%= p["due_today_count"] %></td>
                  <td><%= p["due_soon_count"] %></td>
                  <td><%= wb_pct(p["lifetime_repurchase_rate_pct"]) %></td>
                  <td><%= p["median_repurchase_days"] ? "#{p['median_repurchase_days']} 天" : "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>

  <% if briefing.status == "success" %>
    <div class="row">
      <div class="col-md-6">
        <div class="panel">
          <div class="panel-hdr bg-success-600"><h2 class="text-white">做得好的地方</h2></div>
          <div class="panel-content">
            <% if briefing.wins.empty? %>
              <div class="text-muted small">本週無特別亮點</div>
            <% end %>
            <% briefing.wins.each do |w| %>
              <div class="mb-3 pb-2 border-bottom">
                <div class="font-weight-bold">✅ <%= w["point"] %></div>
                <div class="small text-muted">數據：<%= w["data"] %>｜比較對象：<%= w["compare"] %></div>
                <div class="small">為什麼：<%= w["why"] %></div>
                <div class="small text-success">建議：<%= w["recommendation"] %></div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="panel">
          <div class="panel-hdr bg-danger-600"><h2 class="text-white">做得不好的地方</h2></div>
          <div class="panel-content">
            <% if briefing.issues.empty? %>
              <div class="text-muted small">本週無明顯問題</div>
            <% end %>
            <% briefing.issues.each do |i| %>
              <div class="mb-3 pb-2 border-bottom">
                <div class="font-weight-bold">⚠️ <%= i["point"] %></div>
                <div class="small text-muted">數據：<%= i["data"] %>｜差距：<%= i["gap"] %></div>
                <div class="small">可能原因：<%= i["possible_cause"] %></div>
                <div class="small">影響程度：<%= i["impact"] %></div>
                <div class="small text-danger">不處理的後果：<%= i["consequence"] %></div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-hdr bg-warning-600"><h2 class="text-white">下週需要注意的風險</h2></div>
      <div class="panel-content">
        <% if briefing.risks.empty? %>
          <div class="text-muted small">本週未觸發任何風險旗標</div>
        <% end %>
        <% briefing.risks.each do |r| %>
          <div class="mb-2">
            <i class="fal fa-exclamation-triangle text-warning mr-1"></i>
            <strong><%= r["risk"] %></strong>
            <div class="small text-muted ml-3">觸發條件：<%= r["trigger_condition"] %>｜證據：<%= r["evidence"] %></div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="panel">
      <div class="panel-hdr"><h2>下週優先改善事項</h2></div>
      <div class="panel-content p-0">
        <div class="table-responsive">
          <table class="table table-sm mb-0">
            <thead class="thead-light">
              <tr><th>問題</th><th>數據證據</th><th>建議行動</th><th>目標客群</th><th>預期指標</th><th>驗收方式</th></tr>
            </thead>
            <tbody>
              <% briefing.priorities.each do |p| %>
                <tr>
                  <td><%= p["problem"] %></td>
                  <td class="small"><%= p["evidence"] %></td>
                  <td class="small"><%= p["action"] %></td>
                  <td class="small"><%= p["target_segment"] %></td>
                  <td class="small"><%= p["expected_kpi"] %></td>
                  <td class="small"><%= p["review_method"] %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-hdr"><h2>下週待辦事項</h2></div>
      <div class="panel-content p-0">
        <% if briefing.todos.empty? %>
          <div class="p-4 text-center text-muted">本週沒有產生待辦事項</div>
        <% else %>
          <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
              <thead class="thead-light">
                <tr>
                  <th style="width:24px;"></th><th>任務</th><th>優先級</th><th>負責角色</th><th>期限</th>
                  <th>目標客群</th><th>名單人數</th><th>預期KPI</th><th style="width:160px;"></th>
                </tr>
              </thead>
              <tbody>
                <% briefing.todos.sort_by { |t| [WeeklyBriefingTodo::PRIORITIES.index(t.priority) || 99, t.id] }.each do |todo| %>
                  <tr class="<%= 'text-muted' if todo.done? %>">
                    <td>
                      <%= button_to (todo.done? ? "↺" : "✓"), toggle_weekly_briefing_todo_path(todo), method: :patch,
                                    class: "btn btn-sm btn-outline-#{todo.done? ? 'secondary' : 'success'}", form: { style: "display:inline" } %>
                    </td>
                    <td>
                      <div class="<%= 'text-decoration-line-through' if todo.done? %>"><%= todo.title %></div>
                      <div class="small text-muted"><%= todo.description %></div>
                      <% if todo.data_issue.present? %><div class="small text-muted">對應問題：<%= todo.data_issue %></div><% end %>
                    </td>
                    <td><%= wb_priority_badge(todo.priority) %></td>
                    <td class="small"><%= todo.suggested_role %></td>
                    <td class="small text-nowrap"><%= todo.due_date&.strftime("%m/%d") %></td>
                    <td class="small"><%= todo.target_segment %></td>
                    <td>
                      <% if todo.target_count.present? %>
                        <span class="badge badge-info"><%= todo.target_count %> 人</span>
                      <% elsif todo.resolvable? %>
                        <%= button_to "預覽人數", preview_weekly_briefing_todo_path(todo), method: :post, class: "btn btn-sm btn-link p-0" %>
                      <% else %>
                        <span class="text-muted small">需人工建立名單</span>
                      <% end %>
                    </td>
                    <td class="small"><%= todo.expected_kpi %></td>
                    <td class="text-nowrap">
                      <% if %w[product_overdue product_due_soon].include?(todo.target_query["type"]) %>
                        <%= button_to "建立客服任務", create_task_weekly_briefing_todo_path(todo), method: :post, class: "btn btn-sm btn-outline-primary" %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
