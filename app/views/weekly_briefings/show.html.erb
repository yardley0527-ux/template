<% content_for :page_title, "每週經營決策報告" %>
<% content_for :head_block do %>
  <style>
    @media print {
      .no-print { display: none !important; }
      .panel { break-inside: avoid; page-break-inside: avoid; }
      table { break-inside: auto; }
      tr { break-inside: avoid; }
      body { font-size: 11px; }
    }
    .wb-option-card { border: 1px solid #e5e5e5; border-radius: 6px; padding: 12px; height: 100%; }
    .wb-option-card.recommended { border-color: #28a745; background: #f4fbf6; }
    .wb-finding-card { border-left: 4px solid #6f42c1; padding: 8px 12px; margin-bottom: 10px; }
  </style>
<% end %>
<% m = @briefing&.metrics || {} %>

<div class="subheader no-print">
  <h1 class="subheader-title">
    <i class="fal fa-calendar-week mr-2 text-info"></i> 每週經營決策報告
    <span class="text-muted small ml-2"><%= @period.week_start.strftime("%Y/%m/%d") %> ~ <%= @period.week_end.strftime("%m/%d") %></span>
  </h1>
  <div class="ml-auto">
    <%= link_to weekly_briefing_path(week_start: @period.prev_week_start.to_s), class: "btn btn-outline-secondary btn-sm mr-1" do %>
      <i class="fal fa-chevron-left"></i> 上一週
    <% end %>
    <%= link_to weekly_briefing_path(week_start: (@period.week_start + 7).to_s), class: "btn btn-outline-secondary btn-sm mr-1" do %>
      下一週 <i class="fal fa-chevron-right"></i>
    <% end %>
    <%= link_to weekly_briefings_path, class: "btn btn-outline-secondary btn-sm mr-1" do %>
      <i class="fal fa-list mr-1"></i>歷史週報
    <% end %>
    <%= link_to in_progress_weekly_briefing_path, class: "btn btn-outline-secondary btn-sm mr-1" do %>
      <i class="fal fa-hourglass-half mr-1"></i>查看本週即時進度
    <% end %>
    <button type="button" class="btn btn-outline-secondary btn-sm mr-1" onclick="window.print()">
      <i class="fal fa-print mr-1"></i>列印／另存為PDF
    </button>
    <% if current_user.admin? %>
      <% if @briefing&.regenerating? %>
        <button type="button" class="btn btn-info btn-sm" disabled id="wb-regenerate-btn">
          <i class="fal fa-spinner fa-spin mr-1"></i>產生中…
        </button>
      <% else %>
        <%= button_to "重新產生最新完整週報", regenerate_weekly_briefing_path(week_start: @period.week_start.to_s),
                      method: :post, class: "btn btn-info btn-sm", id: "wb-regenerate-btn",
                      data: { confirm: "重新產生會覆蓋這一週目前的分析，確定嗎？（若上游快取過期會自動一併刷新，可能需要幾分鐘，離開這頁不影響背景處理）" } %>
      <% end %>
    <% end %>
  </div>
</div>

<% if @briefing&.regenerating? %>
  <div class="alert alert-info no-print" id="wb-regenerating-banner">
    <i class="fal fa-spinner fa-spin mr-1"></i>
    報告正在背景重新產生中（重算商品回購週期＋呼叫AI，通常需要幾分鐘），這裡會自動偵測完成並重新整理，離開這頁不影響處理進度。
  </div>
<% end %>

<% if @briefing.nil? %>
  <div class="panel">
    <div class="panel-content text-center py-5 text-muted">
      <i class="fal fa-file-alt fa-3x mb-3 d-block opacity-25"></i>
      這一週還沒有產生報告。
      <% if current_user.admin? %>
        <div class="mt-3">
          <%= button_to "產生這一週的報告", regenerate_weekly_briefing_path(week_start: @period.week_start.to_s),
                        method: :post, class: "btn btn-info" %>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <% briefing = @briefing %>
  <% wt = m["week_type"] || {} %>

  <%#================ 頂部醒目警示：品質未過或內容格式異常時 ================%>
  <% if briefing.needs_review_banner? %>
    <div class="alert alert-danger">
      <i class="fal fa-exclamation-triangle mr-1"></i>
      <strong>此報告尚未通過品質驗收，不建議作為正式決策依據。</strong>
    </div>
  <% end %>

  <%#================ 報告狀態與品質驗收（管理頁一眼看到，不用查資料庫） ================%>
  <div class="panel">
    <div class="panel-content">
      <div class="row text-center">
        <div class="col-6 col-md-2 mb-2">
          <div class="text-muted small">產生狀態</div>
          <div>
            <% case briefing.status
               when "success" %>
              <span class="badge badge-success">成功</span>
            <% when "invalid_response" %>
              <span class="badge badge-warning">格式異常</span>
            <% else %>
              <span class="badge badge-danger">失敗</span>
            <% end %>
          </div>
        </div>
        <div class="col-6 col-md-2 mb-2">
          <div class="text-muted small">AI API</div>
          <div><%= briefing.ai_api_success? ? content_tag(:span, "成功", class: "badge badge-success") : content_tag(:span, "失敗", class: "badge badge-danger") %></div>
        </div>
        <div class="col-6 col-md-2 mb-2">
          <div class="text-muted small">品質驗收</div>
          <div>
            <% if briefing.status == "invalid_response" %>
              <span class="badge badge-warning">內容不完整</span>
            <% elsif briefing.status != "success" %>
              <span class="badge badge-secondary">尚未產生內容</span>
            <% elsif briefing.quality_passed? %>
              <span class="badge badge-success">已完成驗收</span>
            <% else %>
              <span class="badge badge-warning">需要檢查</span>
            <% end %>
          </div>
        </div>
        <div class="col-6 col-md-2 mb-2">
          <div class="text-muted small">資料完整度</div>
          <div><%= wb_pct(briefing.data_completeness_score) %></div>
        </div>
        <div class="col-6 col-md-2 mb-2">
          <div class="text-muted small">決策可信度</div>
          <div><span class="badge <%= {'高'=>'badge-success','中'=>'badge-warning','低'=>'badge-danger'}.fetch(briefing.decision_confidence_label, 'badge-secondary') %>"><%= briefing.decision_confidence_label || "—" %></span></div>
        </div>
        <div class="col-6 col-md-2 mb-2">
          <div class="text-muted small">使用模型／Prompt版本</div>
          <div class="small"><%= briefing.model || "—" %> / <%= briefing.prompt_version || "—" %></div>
        </div>
        <div class="col-6 col-md-2 mb-2">
          <div class="text-muted small">產生時間</div>
          <div class="small"><%= briefing.generated_at&.strftime("%m/%d %H:%M") || briefing.updated_at.strftime("%m/%d %H:%M") %></div>
        </div>
      </div>
      <% if briefing.signals_can_be_used_for.any? || briefing.signals_cannot_be_used_for.any? %>
        <div class="row mt-2">
          <div class="col-md-6 small">
            <strong class="text-success">本報告可以用來判斷：</strong>
            <ul class="mb-0"><% briefing.signals_can_be_used_for.each do |t| %><li><%= t %></li><% end %></ul>
          </div>
          <div class="col-md-6 small">
            <strong class="text-danger">本報告暫時不能用來判斷：</strong>
            <% if briefing.signals_cannot_be_used_for.any? %>
              <ul class="mb-0"><% briefing.signals_cannot_be_used_for.each do |t| %><li><%= t %></li><% end %></ul>
            <% else %>
              <div class="text-muted">（本週四大面向皆有可比較資料）</div>
            <% end %>
          </div>
        </div>
      <% end %>
      <% if briefing.status == "failed" %>
        <div class="alert alert-danger small mb-0 mt-2"><strong>錯誤摘要：</strong><%= briefing.error_message %></div>
      <% end %>
      <% if briefing.status == "invalid_response" %>
        <div class="alert alert-warning small mb-0 mt-2">
          <strong>AI 回應解析成功，但以下必要欄位缺失或空白（<%= briefing.retried? ? "已自動重試一次仍缺" : "" %>）：</strong>
          <ul class="mb-0"><% briefing.missing_fields.each do |f| %><li><%= f %></li><% end %></ul>
        </div>
      <% end %>
      <% if briefing.quality_needs_review? %>
        <div class="alert alert-warning small mb-0 mt-2">
          <strong>品質驗收未通過，以下項目需要檢查：</strong>
          <ul class="mb-0">
            <% Array(briefing.quality_check["failed_items"]).each do |item| %><li><%= item %></li><% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mb-2 no-print">
    <span class="badge badge-primary p-2">週型：<%= briefing.headline_display || wt["type_label"] %></span>
    <% if wt["campaign_size_note"] %><span class="badge badge-light border">⚠️ <%= wt["campaign_size_note"] %></span><% end %>
  </div>

  <%#================ 四大經營燈號（程式規則算出，不是AI判斷） ================%>
  <div class="panel">
    <div class="panel-hdr"><h2>四大經營燈號</h2></div>
    <div class="panel-content p-0">
      <div class="table-responsive">
        <table class="table table-sm mb-0">
          <thead class="thead-light"><tr><th>面向</th><th>燈號</th><th>核心結果</th><th>判斷原因</th><th>建議方向</th></tr></thead>
          <tbody>
            <% briefing.business_signals.each do |s| %>
              <% cls = { "green" => "badge-success", "yellow" => "badge-warning", "red" => "badge-danger", "gray" => "badge-secondary" }.fetch(s["status"], "badge-secondary") %>
              <tr>
                <td><%= s["area_label"] %></td>
                <td><span class="badge <%= cls %> p-2"><%= s["status_label"] %></span></td>
                <td class="small"><%= s["result"] %></td>
                <td class="small text-muted"><%= s["reason"] %></td>
                <td class="small"><%= s["recommended_direction"] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <% if briefing.status != "success" && m.present? %>
    <div class="alert alert-danger">
      <i class="fal fa-exclamation-triangle mr-1"></i>
      下方數據仍為本次計算結果，可放心參考；只有 AI 解讀／決策建議沒有正常產生（詳情見上方狀態卡片）。
    </div>
  <% end %>

  <% if briefing.status == "success" %>
    <%#================ 第一部分：老闆決策摘要 ================%>
    <div class="panel">
      <div class="panel-content d-flex align-items-start flex-wrap">
        <div class="mr-3 mb-2"><%= wb_status_badge(briefing.business_status) %></div>
        <div>
          <h4 class="mb-1"><%= briefing.one_liner %></h4>
          <div class="text-muted small">判斷依據：<%= briefing.executive_summary["status_basis"] %></div>
          <div class="text-muted small">信心水準：<%= { "high" => "高", "medium" => "中", "low" => "低" }[briefing.executive_summary["confidence"]] %>
            <% (briefing.executive_summary["reasons"] || []).each { |r| %> ・<%= r %><% } %>
          </div>
        </div>
      </div>
    </div>

    <% if briefing.top_findings.any? %>
      <div class="panel">
        <div class="panel-hdr"><h2>本週最重要的三個發現</h2></div>
        <div class="panel-content">
          <% briefing.top_findings.each_with_index do |f, i| %>
            <div class="wb-finding-card">
              <div class="font-weight-bold"><%= i + 1 %>. <%= f["finding"] %>
                <span class="badge badge-light border ml-1"><%= f["nature"] == "structural" ? "結構性" : "短期波動" %></span>
                <span class="badge <%= f['confidence'] == 'high' ? 'badge-success' : 'badge-info' %> ml-1">證據強度：<%= f["confidence"] == "high" ? "高" : "中" %></span>
              </div>
              <div class="small text-muted">數據證據：<%= f["data_evidence"] %></div>
              <div class="small">為什麼重要：<%= f["why_it_matters"] %></div>
              <div class="small text-primary">對未來營收的影響：<%= f["revenue_impact"] %></div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if briefing.decisions.any? %>
      <div class="panel">
        <div class="panel-hdr bg-primary-600"><h2 class="text-white">本週需要老闆決策的事項</h2></div>
        <div class="panel-content">
          <% briefing.decisions.each_with_index do |d, i| %>
            <div class="mb-4 <%= 'border-bottom pb-4' if i < briefing.decisions.size - 1 %>">
              <h5>決策 <%= i + 1 %>：<%= d["question"] %>
                <%= content_tag(:span, { "immediate" => "可立即決定", "small_test" => "小規模測試後決定", "needs_more_data" => "補資料後決定" }.fetch(d["decision_type"], d["decision_type"]),
                      class: "badge #{ {'immediate'=>'badge-success','small_test'=>'badge-info','needs_more_data'=>'badge-warning'}.fetch(d['decision_type'], 'badge-secondary') }") %>
              </h5>
              <div class="small text-muted mb-1">目前狀況：<%= d["current_situation"] %></div>
              <div class="small text-muted mb-2">數據證據：<%= d["data_evidence"] %></div>
              <div class="row">
                <% %w[option_a option_b option_c].each_with_index do |opt_key, idx| %>
                  <% opt = d[opt_key] %>
                  <% next if opt.blank? %>
                  <% letter = %w[A B C][idx] %>
                  <div class="col-md-4 mb-2">
                    <div class="wb-option-card <%= 'recommended' if d['recommended_option'] == letter %>">
                      <div class="font-weight-bold mb-1">
                        方案<%= letter %>
                        <% if d["recommended_option"] == letter %><span class="badge badge-success ml-1">系統建議</span><% end %>
                      </div>
                      <div class="small">做法：<%= opt["action"] %></div>
                      <div class="small text-success">預期效益：<%= opt["benefit"] %></div>
                      <div class="small text-danger">風險：<%= opt["risk"] %></div>
                      <div class="small text-muted">適用條件：<%= opt["condition"] %></div>
                    </div>
                  </div>
                <% end %>
              </div>
              <% if d["decision_type"] == "small_test" && d["test_design"].present? %>
                <% td = d["test_design"] %>
                <div class="alert alert-info small mt-2 mb-2">
                  <strong>測試設計：</strong>
                  對象：<%= td["target"] %>／規模：<%= td["scale"] %>／方式：<%= td["method"] %>／
                  成功KPI：<%= td["success_kpi"] %>／停止條件：<%= td["stop_condition"] %>／
                  <%= td["decision_point"] %>
                </div>
              <% end %>
              <% if d["decision_type"] == "needs_more_data" && d["data_needed"].present? %>
                <% dn = d["data_needed"] %>
                <div class="alert alert-warning small mt-2 mb-2">
                  <strong>需要先補的資料：</strong><%= dn["missing_data"] %>／
                  由誰補：<%= dn["who_should_provide"] %>／何時補：<%= dn["when_needed"] %>／
                  補完後要決定：<%= dn["decision_once_available"] %>
                </div>
              <% end %>
              <div class="small mt-2"><strong>建議原因：</strong><%= d["recommendation_reason"] %></div>
              <div class="small text-danger"><strong>不決策的影響：</strong><%= d["impact_if_no_decision"] %></div>
              <div class="small"><strong>下週驗證KPI：</strong><%= d["next_week_kpi"] %></div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="row">
      <div class="col-md-6">
        <div class="panel h-100">
          <div class="panel-hdr bg-danger-600"><h2 class="text-white">本週最大風險</h2></div>
          <div class="panel-content">
            <% if briefing.biggest_risk %>
              <div><%= briefing.biggest_risk["description"] %></div>
              <div class="small text-muted mt-1">數據證據：<%= briefing.biggest_risk["data_evidence"] %></div>
            <% end %>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="panel h-100">
          <div class="panel-hdr bg-success-600"><h2 class="text-white">本週最大機會</h2></div>
          <div class="panel-content">
            <% if briefing.biggest_opportunity %>
              <div><%= briefing.biggest_opportunity["description"] %></div>
              <div class="small text-muted mt-1">數據證據：<%= briefing.biggest_opportunity["data_evidence"] %></div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%#================ 第二部分：經營分析 ================%>
  <h4 class="mt-4 mb-2">經營分析</h4>

  <%# ── 2.1 營收與年度預測 ── %>
  <% rp = m["revenue_progress"] %>
  <% if rp %>
    <div class="panel">
      <div class="panel-hdr"><h2>營收與年度預測</h2></div>
      <div class="panel-content">
        <% if briefing.status == "success" %>
          <ul class="mb-3"><% Array(briefing.business_analysis["revenue_and_forecast"]).each { |b| %><li><%= b %></li><% } %></ul>
        <% end %>
        <div class="row text-center mb-3">
          <div class="col"><div class="text-muted small">本週</div><div class="h6"><%= wb_money(rp["this_week_revenue"]) %></div></div>
          <div class="col"><div class="text-muted small">上週</div><div class="h6"><%= wb_money(rp["prev_week_revenue"]) %></div><%= wb_delta_badge(rp["week_over_week_growth_pct"]) %></div>
          <div class="col"><div class="text-muted small">可比較基準<br><span class="text-muted" style="font-size:10px;"><%= rp.dig("comparable_basis", "basis_label") %></span></div>
            <div class="h6"><%= wb_money(rp.dig("comparable_basis", "compare_avg")) %></div><%= wb_delta_badge(rp.dig("comparable_basis", "growth_pct")) %></div>
          <div class="col"><div class="text-muted small">今年累計</div><div class="h6"><%= wb_money(rp["ytd_revenue"]) %></div></div>
          <div class="col"><div class="text-muted small">去年同期</div><div class="h6"><%= wb_money(rp["last_year_same_period_ytd_revenue"]) %></div><%= wb_delta_badge(rp["yoy_growth_pct"]) %></div>
          <div class="col"><div class="text-muted small">去年全年</div><div class="h6"><%= wb_money(rp["last_year_full_year_revenue"]) %></div></div>
        </div>
        <% if rp.dig("comparable_basis", "basis_note") %>
          <div class="alert alert-warning small py-2"><%= rp.dig("comparable_basis", "basis_note") %></div>
        <% end %>

        <hr>
        <div class="row">
          <div class="col-md-6">
            <p class="mb-1">
              距離超越去年全年營收：
              <% if rp["already_beat_last_year"] %>
                <span class="badge badge-success">已超越（超出 <%= wb_money(-rp["gap_to_beat_last_year"]) %>）</span>
              <% else %>
                <span class="badge badge-warning">還差 <%= wb_money(rp["gap_to_beat_last_year"]) %></span>
              <% end %>
            </p>
            <p class="mb-1 small text-muted">今年剩餘 <%= rp["days_remaining_in_year"] %> 天（約 <%= rp["weeks_remaining_in_year"] %> 週）</p>
            <table class="table table-sm mb-0">
              <tr><td>最低警戒線（週）</td><td class="text-right"><%= wb_money(rp.dig("revenue_lines", "minimum_required_weekly")) %></td></tr>
              <tr><td>經營安全線（週，+<%= rp.dig("revenue_lines","safety_buffer_pct")&.to_i %>%緩衝）</td><td class="text-right"><%= wb_money(rp.dig("revenue_lines", "safety_line_weekly")) %></td></tr>
              <tr><td>成長目標線（週，較去年+<%= rp.dig("revenue_lines","growth_target_pct")&.to_i %>%）</td><td class="text-right"><%= wb_money(rp.dig("revenue_lines", "growth_target_weekly")) %></td></tr>
            </table>
          </div>
          <div class="col-md-6">
            <div class="text-muted small mb-1">年底營收三種情境預測</div>
            <table class="table table-sm mb-0">
              <thead class="thead-light"><tr><th>情境</th><th>採用週均</th><th>預估年底營收</th><th>vs去年</th></tr></thead>
              <tbody>
                <% %w[conservative base optimistic].each do |key| %>
                  <% s = rp.dig("scenarios", key) || {} %>
                  <tr>
                    <td><%= { "conservative" => "保守", "base" => "基準", "optimistic" => "樂觀" }[key] %></td>
                    <td><%= wb_money(s["weekly_rate_used"]) %></td>
                    <td><%= wb_money(s["projected_year_end"]) %></td>
                    <td><%= s["beats_last_year"] ? content_tag(:span, "超越", class: "badge badge-success") : content_tag(:span, "落後 #{wb_money(s['vs_last_year'] ? -s['vs_last_year'] : nil)}", class: "badge badge-warning") %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
            <div class="small text-muted mt-1">
              <% %w[conservative base optimistic].each do |key| %>
                <div><strong><%= { "conservative" => "保守", "base" => "基準", "optimistic" => "樂觀" }[key] %>：</strong><%= rp.dig("scenarios", key, "method") %>；成立條件：<%= rp.dig("scenarios", key, "success_condition") %></div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%# ── 2.2 營收變動原因拆解 ── %>
  <% if briefing.status == "success" && Array(briefing.business_analysis["revenue_change_breakdown"]).any? %>
    <div class="panel">
      <div class="panel-hdr"><h2>營收變動原因拆解</h2></div>
      <div class="panel-content">
        <ul class="mb-2"><% briefing.business_analysis["revenue_change_breakdown"].each { |b| %><li><%= b %></li><% } %></ul>
        <% rc = rp["revenue_concentration"] %>
        <% if rc %>
          <div class="small text-muted">
            集中度：單一會員佔<%= wb_pct(rc["top_customer_share_pct"]) %>／單一卡別（<%= rc["top_level_name"] %>）佔<%= wb_pct(rc["top_level_share_pct"]) %>／
            單一商品（<%= rc["top_product_name"] %>）佔<%= wb_pct(rc["top_product_share_pct"]) %>／單場直播佔<%= wb_pct(rc["top_livestream_share_pct"]) %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# ── 2.3 新客與舊客 ── %>
  <% nvr = m["new_vs_returning"] %>
  <% if nvr %>
    <div class="panel">
      <div class="panel-hdr"><h2>新客與舊客分析</h2></div>
      <div class="panel-content p-0">
        <% if briefing.status == "success" %>
          <div class="p-3 pb-0"><ul class="mb-0"><% Array(briefing.business_analysis["new_and_returning_customers"]).each { |b| %><li><%= b %></li><% } %></ul></div>
        <% end %>
        <div class="table-responsive p-3">
          <table class="table table-sm mb-0">
            <thead class="thead-light">
              <tr><th>指標</th><th>本週</th><th>上週</th><th>近4週平均</th><th>去年同週</th></tr>
            </thead>
            <tbody>
              <% [["new_customers","新客人數"],["returning_customers","舊客回購人數"],["new_revenue","新客營收"],
                  ["returning_revenue","舊客營收"],["new_aov","新客客單價"],["returning_aov","舊客客單價"],["new_pct","新客佔比"]].each do |k, label| %>
                <tr>
                  <td class="text-muted small"><%= label %></td>
                  <% %w[this_week prev_week trailing4_weekly_avg last_year_same_week].each do |period_key| %>
                    <td>
                      <% v = nvr.dig(period_key, k) %>
                      <%= k.end_with?("revenue", "aov") ? wb_money(v) : (k == "new_pct" ? wb_pct(v) : v) %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="p-3 border-top">
          <div class="text-muted small mb-1">新客回購率（成熟cohort，只計入已完整走完觀察窗的首購週）</div>
          <div class="table-responsive">
            <table class="table table-sm mb-0">
              <thead class="thead-light"><tr><th>觀察窗</th><th>Cohort期間</th><th>樣本數</th><th>回購人數</th><th>回購率</th><th>上一成熟cohort</th><th>歷史平均</th></tr></thead>
              <tbody>
                <% Array(nvr["cohort_repurchase"]).each do |c| %>
                  <tr>
                    <td><%= c["window_days"] %>天</td>
                    <td class="small"><%= c["cohort_start"] %>~<%= c["cohort_end"] %></td>
                    <td><%= c["sample_size"] %><% unless c["sample_sufficient"] %><span class="badge badge-light border ml-1">樣本不足</span><% end %></td>
                    <td><%= c["repurchased_count"] %></td>
                    <td><%= wb_pct(c["repurchase_rate_pct"]) %></td>
                    <td><%= wb_pct(c["prev_cohort_rate_pct"]) %></td>
                    <td><%= wb_pct(c["historical_avg_rate_pct"]) %>（<%= c["historical_sample_weeks"] %>週）</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%# ── 2.4 直播表現 ── %>
  <% ls = m["livestreams"] %>
  <div class="panel">
    <div class="panel-hdr"><h2>直播表現（近 14 天）</h2></div>
    <div class="panel-content p-0">
      <% if briefing.status == "success" && Array(briefing.business_analysis["livestream_performance"]).any? %>
        <div class="p-3 pb-0"><ul class="mb-0"><% briefing.business_analysis["livestream_performance"].each { |b| %><li><%= b %></li><% } %></ul></div>
      <% end %>
      <% if ls.blank? || ls["events"].blank? %>
        <div class="p-4 text-center text-muted">本期間無直播</div>
      <% else %>
        <div class="table-responsive">
          <table class="table table-sm table-hover mb-0">
            <thead class="thead-light">
              <tr>
                <th>日期</th><th>主題</th><th>訂單數</th><th>買家數</th><th>新客%</th>
                <th>營收</th><th>客單價</th><th>vs上一場</th><th>vs同類型近3場</th>
              </tr>
            </thead>
            <tbody>
              <% ls["events"].each do |e| %>
                <tr>
                  <td class="text-nowrap"><%= e["date"] %><% if e["stale_stats"] %> <i class="fal fa-exclamation-circle text-warning" title="統計快取可能過期"></i><% end %></td>
                  <td><%= e["title"] %></td>
                  <td><%= e["total_orders"] %></td>
                  <td><%= e["total_buyers"] %>（新<%= e["new_buyers"] %>／舊<%= e["returning_buyers"] %>）</td>
                  <td><%= wb_pct(e["new_buyer_pct"]) %></td>
                  <td><%= wb_money(e["total_revenue"]) %></td>
                  <td><%= wb_money(e["aov"]) %></td>
                  <td><%= wb_delta_badge(e.dig("vs_previous_event", "revenue_delta_pct")) %></td>
                  <td><%= wb_delta_badge(e.dig("vs_same_type_avg3", "revenue_delta_pct")) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── 2.5 會員卡別健康度 ── %>
  <% mem = m["membership"] %>
  <% if mem %>
    <div class="panel">
      <div class="panel-hdr"><h2>會員卡別健康度</h2></div>
      <div class="panel-content p-0">
        <% if briefing.status == "success" && Array(briefing.business_analysis["membership_health"]).any? %>
          <div class="p-3 pb-0"><ul class="mb-0"><% briefing.business_analysis["membership_health"].each { |b| %><li><%= b %></li><% } %></ul></div>
        <% end %>
        <div class="table-responsive">
          <table class="table table-sm mb-0">
            <thead class="thead-light">
              <tr>
                <th>卡別</th><th>會員數</th><th>活躍率</th><th>本週營收</th><th>本週客單價</th><th>今年累計營收</th><th>YTD前10名佔比</th>
              </tr>
            </thead>
            <tbody>
              <% mem["levels"].each do |lv| %>
                <tr>
                  <td><%= lv["level"] %></td>
                  <td><%= lv["member_count"] %></td>
                  <td><%= wb_pct(lv["active_rate_pct"]) %></td>
                  <td><%= wb_money(lv.dig("this_week", "revenue")) %></td>
                  <td><%= wb_money(lv.dig("this_week", "aov")) %></td>
                  <td><%= wb_money(lv.dig("ytd", "revenue")) %></td>
                  <td><%= wb_pct(lv.dig("ytd_concentration", "top10_revenue_share_pct")) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="p-3 border-top small">
          <div>黑金卡營收依賴度（本週）：<strong><%= wb_pct(mem["black_gold_revenue_share_pct"]) %></strong></div>
          <div>升級 <%= mem.dig("changes","upgrade_count") %> 人（近4週平均 <%= mem.dig("changes","trailing4_weekly_avg_upgrade_count") %> 人）／
               降級 <%= mem.dig("changes","downgrade_count") %> 人（近4週平均 <%= mem.dig("changes","trailing4_weekly_avg_downgrade_count") %> 人）</div>
          <div>卡別營收加總校驗：未分類營收 <%= wb_money(mem.dig("reconciliation","unclassified_revenue")) %>（<%= wb_pct(mem.dig("reconciliation","unclassified_pct")) %>）
            <%= mem.dig("reconciliation","note") %></div>
        </div>
      </div>
    </div>
  <% end %>

  <%# ── 2.6 商品與回購 ── %>
  <% pr = m["product_repurchase"] %>
  <% if pr %>
    <div class="panel">
      <div class="panel-hdr">
        <h2>商品與回購</h2>
        <% if pr["contradiction_detected"] %>
          <span class="badge badge-dark ml-2">⚠️ 商品回購資料可能異常，下方回購數字已標示為資料不足</span>
        <% end %>
      </div>
      <div class="panel-content p-0">
        <% if briefing.status == "success" && Array(briefing.business_analysis["product_and_repurchase"]).any? %>
          <div class="p-3 pb-0"><ul class="mb-0"><% briefing.business_analysis["product_and_repurchase"].each { |b| %><li><%= b %></li><% } %></ul></div>
        <% end %>
        <div class="table-responsive">
          <table class="table table-sm table-hover mb-0">
            <thead class="thead-light">
              <tr>
                <th>產品</th><th>庫存</th><th>預計到貨日</th><th>本週買家</th><th>本週回購人數</th>
                <th>A/B/C/沉睡</th><th>今日待聯絡</th><th>即將用完</th><th>歷史回購率</th><th>建議行動</th>
              </tr>
            </thead>
            <tbody>
              <% pr["products"].each do |p| %>
                <% tiers = p.dig("actionability", "tiers") || {} %>
                <% stockout = briefing.risk_flags.find { |f| f["key"] == "product_stockout_risk" && f.dig("evidence", "product_key") == p["product_key"] } %>
                <tr class="<%= 'table-warning' if p['cycles_stale'] %> <%= 'table-danger' if stockout %>">
                  <td><%= p["label"] %><% if p["cycles_stale"] %><br><span class="badge badge-light border" title="快取上次刷新：<%= p['cycles_refreshed_at'] %>">快取過期</span><% end %></td>
                  <td>
                    <%= CrmProduct::AVAILABILITY_STATUS_LABELS[p["availability_status"]] %>
                    <% if stockout %><br><span class="badge badge-danger" title="<%= Array(stockout.dig('evidence','reasons')).join('；') %>">缺貨風險</span><% end %>
                  </td>
                  <td class="small"><%= p["expected_restock_date"] || "未定" %></td>
                  <td><%= p.dig("this_week","total_customers") %></td>
                  <td><%= wb_num(p["repurchased_this_week"]) %></td>
                  <td class="small text-nowrap">
                    A<%= tiers["a_tier_count"] %>／B<%= tiers["b_tier_count"] %>／C<%= tiers["c_tier_count"] %>／沉睡<%= tiers["dormant_tier_count"] %>
                    <% if tiers["unclassified_count"].to_i.positive? %>
                      <span class="badge badge-warning" title="<%= tiers['unclassified_note'] %>">未分類<%= tiers["unclassified_count"] %>（資料異常）</span>
                    <% end %>
                    <span class="badge badge-info">可行動 <%= p.dig("actionability","actionable_count") %></span>
                  </td>
                  <td><%= p["due_today_count"] %></td>
                  <td><%= p["due_soon_count"] %></td>
                  <td><%= wb_pct(p["lifetime_repurchase_rate_pct"]) %></td>
                  <td class="small">
                    <% if stockout %>
                      確認到貨日／評估預購或替代商品導購
                    <% elsif p.dig("actionability","actionable_count").to_i.positive? %>
                      優先聯繫A/B級可行動名單
                    <% else %>
                      維持既有節奏
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>

  <%# ── 2.7 未來四週展望 ── %>
  <% if briefing.status == "success" && Array(briefing.business_analysis["next_4_week_outlook"]).any? %>
    <div class="panel">
      <div class="panel-hdr"><h2>未來四週風險與機會</h2></div>
      <div class="panel-content">
        <ul class="mb-0"><% briefing.business_analysis["next_4_week_outlook"].each { |b| %><li><%= b %></li><% } %></ul>
      </div>
    </div>
  <% end %>

  <%# ── 風險清單（帶severity）── %>
  <div class="panel">
    <div class="panel-hdr bg-warning-600"><h2 class="text-white">下週需要注意的風險</h2></div>
    <div class="panel-content">
      <% if briefing.risk_flags.empty? %>
        <div class="text-muted small">本週未觸發任何風險旗標（明確門檻式偵測，不代表沒有其他隱憂——請一併參考上方「本週最大風險」）</div>
      <% else %>
        <% briefing.risk_flags.sort_by { |f| -WeeklyRiskFlagDetector::SEVERITY_RANK.fetch(f["severity"], 0) }.each do |f| %>
          <div class="mb-2 pb-2 border-bottom">
            <%= wb_severity_badge(f["severity"]) %>
            <span class="badge badge-light border"><%= WeeklyRiskFlagDetector::CATEGORY_LABELS[f["category"]] %></span>
            <strong><%= wb_risk_label(f) %></strong>
            <div class="small text-muted ml-1"><%= wb_evidence_text(f["evidence"]) %></div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <%#================ 下週行動清單（程式規則算出，保證涵蓋所有紅燈，不依賴AI） ================%>
  <div class="panel">
    <div class="panel-hdr bg-dark"><h2 class="text-white">下週行動清單</h2></div>
    <div class="panel-content p-0">
      <% if briefing.program_action_items.empty? %>
        <div class="p-4 text-center text-muted">本週沒有觸發任何風險旗標，暫無強制行動項目</div>
      <% else %>
        <div class="table-responsive">
          <table class="table table-sm mb-0">
            <thead class="thead-light">
              <tr><th>優先級</th><th>問題</th><th>建議檢查方向</th><th>具體行動</th><th>建議負責角色</th><th>完成期限</th><th>驗收KPI</th></tr>
            </thead>
            <tbody>
              <% briefing.program_action_items.each do |a| %>
                <tr>
                  <td><%= content_tag(:span, a["priority"], class: "badge #{ {'P0'=>'badge-danger','P1'=>'badge-warning','P2'=>'badge-secondary'}.fetch(a['priority'], 'badge-secondary') } p-2") %></td>
                  <td class="small"><%= a["problem"] %></td>
                  <td class="small text-muted"><%= Array(a["investigation_directions"]).join("、") %></td>
                  <td class="small"><%= a["action"] %></td>
                  <td class="small"><%= a["suggested_owner_role"] %></td>
                  <td class="text-nowrap small"><%= a["due_date"] %></td>
                  <td class="small"><%= a["success_metric"] %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>

  <%#================ 第三部分：決策後的執行方向（對應AI提出的老闆決策，跟上面的強制行動清單是不同表） ================%>
  <% if briefing.action_items.any? %>
    <div class="panel">
      <div class="panel-hdr"><h2>決策後的執行方向</h2></div>
      <div class="panel-content p-0">
        <div class="table-responsive">
          <table class="table table-sm mb-0">
            <thead class="thead-light"><tr><th>行動</th><th>對應決策</th><th>負責角色</th><th>建議期限</th><th>KPI</th></tr></thead>
            <tbody>
              <% briefing.action_items.each do |a| %>
                <tr>
                  <td><%= a["action"] %></td>
                  <td class="small text-muted"><%= a["linked_decision"] %></td>
                  <td><%= a["role"] %></td>
                  <td class="text-nowrap"><%= a["deadline"] %></td>
                  <td class="small"><%= a["kpi"] %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>

  <details class="mb-3 no-print">
    <summary class="btn btn-outline-secondary btn-sm">展開詳細待辦清單（<%= briefing.todos.count %>項）</summary>
    <div class="panel mt-2">
      <div class="panel-content p-0">
        <% if briefing.todos.empty? %>
          <div class="p-4 text-center text-muted">本週沒有產生待辦事項</div>
        <% else %>
          <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
              <thead class="thead-light">
                <tr>
                  <th style="width:24px;"></th><th>任務</th><th>優先級</th><th>負責角色</th><th>期限</th>
                  <th>目標客群</th><th>名單人數</th><th>預期KPI</th><th style="width:160px;"></th>
                </tr>
              </thead>
              <tbody>
                <% briefing.todos.sort_by { |t| [WeeklyBriefingTodo::PRIORITIES.index(t.priority) || 99, t.id] }.each do |todo| %>
                  <tr class="<%= 'text-muted' if todo.done? %>">
                    <td>
                      <%= button_to (todo.done? ? "↺" : "✓"), toggle_weekly_briefing_todo_path(todo), method: :patch,
                                    class: "btn btn-sm btn-outline-#{todo.done? ? 'secondary' : 'success'}", form: { style: "display:inline" } %>
                    </td>
                    <td>
                      <div class="<%= 'text-decoration-line-through' if todo.done? %>"><%= todo.title %></div>
                      <div class="small text-muted"><%= todo.description %></div>
                      <% if todo.data_issue.present? %><div class="small text-muted">對應問題：<%= todo.data_issue %></div><% end %>
                    </td>
                    <td><%= wb_priority_badge(todo.priority) %></td>
                    <td class="small"><%= todo.suggested_role %></td>
                    <td class="small text-nowrap"><%= todo.due_date&.strftime("%m/%d") %></td>
                    <td class="small"><%= todo.target_segment %></td>
                    <td>
                      <% if todo.target_count.present? %>
                        <span class="badge badge-info"><%= todo.target_count %> 人</span>
                      <% elsif todo.resolvable? %>
                        <%= button_to "預覽人數", preview_weekly_briefing_todo_path(todo), method: :post, class: "btn btn-sm btn-link p-0" %>
                      <% else %>
                        <span class="text-muted small">需人工建立名單</span>
                      <% end %>
                    </td>
                    <td class="small"><%= todo.expected_kpi %></td>
                    <td class="text-nowrap">
                      <% if %w[product_overdue product_due_soon].include?(todo.target_query["type"]) %>
                        <%= button_to "建立客服任務", create_task_weekly_briefing_todo_path(todo), method: :post, class: "btn btn-sm btn-outline-primary" %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>
    </div>
  </details>

  <%#================ 第四部分：數據附錄 ================%>
  <details class="mb-3">
    <summary class="btn btn-outline-secondary btn-sm">展開數據附錄（資料來源／完整明細／資料缺口）</summary>
    <div class="panel mt-2">
      <div class="panel-content">
        <h6>資料來源與計算定義</h6>
        <ul class="small">
          <li>有效訂單＝<code>shopline_orders.payment_status = '已付款'</code>（<code>ShoplineOrder.valid_paid</code>），排除未付款/付款失敗。</li>
          <li>新客／舊客＝以 <code>customer_purchase_summaries.first_date</code> 是否落在本期間判斷（<code>NewCustomerDefinition</code>），不是卡別。</li>
          <li>商品回購／逾期＝重用回購追蹤 Dashboard 同一份資料（<code>crm_customer_product_cycles</code>），本週回購比對用 <code>next_same_product_order_date</code> 是否落在本期間。</li>
          <li>營收金額一律取「訂單層級」金額（<code>MAX(total_amount)</code> 缺值才退回加總 <code>checkout_amount</code>），避免同一張訂單被拆成多個商品行重複計算。</li>
          <li>週型判斷（直播週/活動週/自然週）＝<code>livestreams.date</code> 與 <code>calendar_events(event_type: campaign)</code> 是否落在本週。</li>
        </ul>

        <% dg = m["data_gaps"] || {} %>
        <h6 class="mt-3">資料完整度：<%= wb_pct(dg["completeness_score"]) %></h6>
        <p class="small text-muted"><%= dg["score_note"] %></p>
        <div class="table-responsive">
          <table class="table table-sm mb-3">
            <thead class="thead-light">
              <tr><th>主題</th><th>影響程度</th><th>可用資料</th><th>缺少資料</th><th>目前作法</th><th>未來整合建議</th></tr>
            </thead>
            <tbody>
              <% Array(dg["gaps"]).sort_by { |g| { "critical" => 0, "important" => 1, "supplementary" => 2 }.fetch(g["impact"], 3) }.each do |g| %>
                <tr>
                  <td><%= g["topic"] %><% if g["scope"] == "this_week" %><span class="badge badge-light border ml-1">本週</span><% end %></td>
                  <td><%= { "critical" => content_tag(:span, "關鍵", class: "badge badge-danger"),
                            "important" => content_tag(:span, "重要", class: "badge badge-warning"),
                            "supplementary" => content_tag(:span, "補充", class: "badge badge-light border") }[g["impact"]] %></td>
                  <td class="small"><%= g["available"] %></td>
                  <td class="small"><%= g["missing"] %></td>
                  <td class="small"><%= g["proxy_used"] %></td>
                  <td class="small"><%= g["suggested_integration"] %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% if pr.present? %>
          <h6 class="mt-3">產品逾期分級距與可行動人數（完整明細）</h6>
          <div class="table-responsive">
            <table class="table table-sm mb-3">
              <thead class="thead-light">
                <tr><th>產品</th><th>1-30天</th><th>31-60天</th><th>61-90天</th><th>91-120天</th><th>121-180天</th><th>181-365天</th><th>366天+</th>
                  <th>可聯繫</th><th>已有任務</th><th>近30天已聯繫</th><th>完全沉睡</th><th>可行動人數</th></tr>
              </thead>
              <tbody>
                <% pr["products"].each do |p| %>
                  <% a = p["actionability"] || {} %>
                  <tr>
                    <td><%= p["label"] %></td>
                    <% %w[1-30 31-60 61-90 91-120 121-180 181-365 366+].each do |bucket| %>
                      <td><%= a.dig("age_buckets", bucket) %></td>
                    <% end %>
                    <td><%= a["reachable_count"] %></td>
                    <td><%= a["already_has_task_count"] %></td>
                    <td><%= a["contacted_last_30d_count"] %></td>
                    <td><%= a["fully_dormant_count"] %></td>
                    <td><strong><%= a["actionable_count"] %></strong></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>

        <h6>報告版本資訊</h6>
        <ul class="small mb-0">
          <li>產生時間：<%= briefing.generated_at %></li>
          <li>模型：<%= briefing.model %></li>
          <li>Prompt 版本：<%= briefing.prompt_version %></li>
          <li>更新時間：<%= briefing.updated_at %></li>
        </ul>
      </div>
    </div>
  </details>
<% end %>

<% content_for :scripts_block do %>
<script>
(function() {
  // 只有頁面載入時就是「產生中」才需要輪詢；沒有背景任務在跑就不用打API。
  var banner = document.getElementById("wb-regenerating-banner");
  if (!banner) return;

  var statusUrl = "<%= status_weekly_briefing_path(week_start: @period.week_start.to_s) %>";
  var pollCount = 0;
  var maxPolls = 90; // 7.5 分鐘（90 次 * 5 秒），避免分頁開著無限輪詢

  var timer = setInterval(function() {
    pollCount++;
    fetch(statusUrl, { headers: { "Accept": "application/json" } })
      .then(function(r) { return r.ok ? r.json() : null; })
      .then(function(data) {
        if (!data) return;
        if (!data.regenerating) {
          clearInterval(timer);
          window.location.reload();
        }
      })
      .catch(function() {});

    if (pollCount >= maxPolls) clearInterval(timer);
  }, 5000);
})();
</script>
<% end %>
