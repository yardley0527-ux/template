<%# 人工撰寫的週報補充分析（見 WeeklyManualReport）。內容都是彙總數字，不含個資。 %>
<div class="panel" id="wb-manual-report">
  <div class="panel-hdr bg-primary-600">
    <h2 class="text-white"><i class="fal fa-user-edit mr-1"></i><%= report[:title] %></h2>
  </div>
  <div class="panel-container show">
    <div class="panel-content">
      <span class="badge badge-primary mr-1">人工分析</span>
      <% if report[:prepared_on].present? %>
        <span class="text-muted small">整理日期：<%= report[:prepared_on] %></span>
      <% end %>
      <% if report[:scope].present? %>
        <p class="text-muted small mb-0 mt-2"><%= report[:scope] %></p>
      <% end %>
    </div>
  </div>
</div>

<% Array(report[:sections]).each do |section| %>
  <div class="panel">
    <div class="panel-hdr"><h2><%= section[:heading] %></h2></div>
    <div class="panel-container show">
      <div class="panel-content">
        <% Array(section[:blocks]).each do |block| %>
          <% if block[:caption].present? %>
            <h6 class="mt-3 mb-2"><%= block[:caption] %></h6>
          <% end %>
          <% if block[:table].present? %>
            <div class="table-responsive">
              <table class="table table-sm table-bordered mb-2">
                <thead class="thead-light">
                  <tr><% Array(block[:table][:headers]).each do |h| %><th class="text-nowrap"><%= h %></th><% end %></tr>
                </thead>
                <tbody>
                  <% Array(block[:table][:rows]).each do |row| %>
                    <tr><% Array(row).each_with_index do |cell, i| %><td class="<%= i.zero? ? 'font-weight-bold' : 'text-right' %>"><%= cell %></td><% end %></tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>
          <% if block[:bullets].present? %>
            <ul class="mb-2">
              <% Array(block[:bullets]).each do |b| %><li class="mb-1"><%= b %></li><% end %>
            </ul>
          <% end %>
          <% if block[:note].present? %>
            <p class="text-muted small mb-2"><%= block[:note] %></p>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
