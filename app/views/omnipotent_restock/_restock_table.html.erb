<%# locals: rows, show_product (optional, default false) %>
<% show_product = local_assigns.fetch(:show_product, false) %>
<div class="table-responsive" data-paginate="true" data-page-size="25">
  <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
    <thead class="table-light">
      <tr>
        <th style="width:3%">#</th>
        <th style="width:5%">分數</th>
        <% if show_product %><th style="width:8%">產品</th><% end %>
        <th style="width:12%">姓名 / 卡別</th>
        <th style="width:10%">客戶類型</th>
        <th style="width:15%">上次購買</th>
        <th style="width:14%">吃完日 / 提醒日</th>
        <th style="width:12%">通知狀態</th>
        <th style="width:10%">IG</th>
      </tr>
    </thead>
    <tbody>
      <% rows.each_with_index do |r, i| %>
        <% c = r[:customer]; dl = r[:days_left]; dur = r[:days_until_reminder] %>
        <% ct = r[:customer_type]; notif = r[:notification] %>
        <% current_status = notif&.status || "未通知" %>
        <% row_product_key = r[:product_key] || @product_key %>
        <tr>
          <td>
            <span class="badge <%= i < 3 ? 'bg-danger' : i < 8 ? 'bg-warning text-dark' : 'bg-light text-dark' %>">
              #<%= i + 1 %>
            </span>
          </td>
          <td class="text-center">
            <% score = r[:crm_score] || 0 %>
            <% score_color = score >= 70 ? '#991b1b' : score >= 50 ? '#b45309' : score >= 30 ? '#0369a1' : '#6b7280' %>
            <span class="fw-bold" style="font-size:1.1rem; color:<%= score_color %>;"><%= score %></span>
            <div class="text-muted" style="font-size:0.65rem;">分</div>
          </td>
          <% if show_product %>
            <td>
              <span class="fw-semibold small" style="color:<%= r[:product_color] %>;">
                <%= r[:product_icon] %> <%= r[:product_label] %>
              </span>
            </td>
          <% end %>
          <td>
            <%= link_to c.full_name, customer_path(c.id), target: "_blank",
                  class: "fw-semibold text-decoration-none d-block" %>
            <span class="text-muted small"><%= c.membership_level %></span>
            <%= link_to "旅程 →", crm_customer_journey_path(c.id, product: row_product_key),
                  class: "text-muted d-block", style: "font-size:0.68rem;" %>
          </td>
          <td>
            <span class="fw-semibold small" style="color:<%= ct[:color] %>;"><%= ct[:emoji] %> <%= ct[:label] %></span>
            <div class="text-muted small">累計 <%= r[:total_omni_bottles] %> 瓶・<%= r[:omni_count] %> 次</div>
          </td>
          <td>
            <div class="fw-semibold">
              <%= r[:bought_date]&.strftime("%m/%d") %> 買 <%= r[:bottles] %> 瓶
            </div>
            <div class="small">
              <% se = r[:source_event] %>
              <% if se == "一般購買" %>
                <span class="text-muted"><%= se %></span>
              <% else %>
                <span class="badge bg-warning text-dark" style="font-size:0.7rem;"><%= se %></span>
              <% end %>
            </div>
            <div class="text-muted small mt-1">
              <% if dl < 0 %>
                <span class="text-danger fw-semibold">逾期 <%= dl.abs %> 天</span>
              <% elsif dur <= 0 %>
                <span class="text-warning fw-semibold">提醒中，<%= dl %> 天後回購</span>
              <% else %>
                還有 <%= dur %> 天到提醒日
              <% end %>
            </div>
          </td>
          <td>
            <div class="small">吃完 <strong><%= r[:estimated_finish_date]&.strftime("%m/%d") %></strong></div>
            <div class="text-muted small">提醒 <%= r[:suggested_reminder_date]&.strftime("%m/%d") %></div>
            <div class="text-muted small">回購 <%= r[:expected_return_date]&.strftime("%m/%d") %></div>
          </td>
          <td>
            <% status_colors = { "未通知" => "secondary", "已通知" => "primary", "已回覆" => "success", "暫不需要" => "light" } %>
            <% status_text_colors = { "暫不需要" => "text-muted" } %>
            <div class="d-flex align-items-center gap-1 mb-1">
              <span class="badge bg-<%= status_colors[current_status] %> <%= status_text_colors[current_status] %> notif-status-badge">
                <%= current_status %>
              </span>
              <% if notif&.contacted_at %>
                <span class="text-muted notif-date-display" style="font-size:0.68rem;"><%= notif.contacted_at.strftime("%m/%d") %></span>
              <% else %>
                <span class="text-muted notif-date-display" style="font-size:0.68rem; display:none;"></span>
              <% end %>
            </div>
            <% if notif&.channel.present? || notif&.result.present? %>
              <div class="notif-detail-display mb-1" style="font-size:0.68rem;">
                <% if notif&.channel.present? %>
                  <span class="badge bg-light text-dark notif-channel-badge"><%= notif.channel %></span>
                <% else %>
                  <span class="badge bg-light text-dark notif-channel-badge" style="display:none;"></span>
                <% end %>
                <% if notif&.result.present? %>
                  <span class="badge bg-light text-dark notif-result-badge"><%= notif.result %></span>
                <% else %>
                  <span class="badge bg-light text-dark notif-result-badge" style="display:none;"></span>
                <% end %>
              </div>
            <% else %>
              <div class="notif-detail-display mb-1" style="font-size:0.68rem; display:none;">
                <span class="badge bg-light text-dark notif-channel-badge" style="display:none;"></span>
                <span class="badge bg-light text-dark notif-result-badge" style="display:none;"></span>
              </div>
            <% end %>
            <div class="d-flex flex-wrap gap-1 align-items-center"
                 data-email="<%= c.email %>"
                 data-ref-date="<%= r[:bought_date] %>"
                 data-product-key="<%= row_product_key %>"
                 data-current="<%= current_status %>"
                 data-channel="<%= notif&.channel %>"
                 data-result="<%= notif&.result %>"
                 data-contacted-at="<%= notif&.contacted_at %>">
              <% (OmnipotentNotificationStatus::STATUSES - [current_status]).each do |s| %>
                <button class="btn btn-outline-secondary py-0 notif-btn"
                        style="font-size:0.7rem;"
                        data-status="<%= s %>"><%= s %></button>
              <% end %>
              <button class="btn btn-link py-0 notif-detail-toggle text-muted"
                      style="font-size:0.65rem;" title="填寫聯絡紀錄">📝</button>
            </div>
            <div class="notif-detail-form mt-1 border rounded p-1 bg-light" style="display:none; font-size:0.75rem;">
              <div class="d-flex gap-1 flex-wrap align-items-center">
                <select class="form-select form-select-sm notif-channel-select" style="width:auto; font-size:0.72rem; padding:1px 4px;">
                  <option value="">管道</option>
                  <% OmnipotentNotificationStatus::CHANNELS.each do |ch| %>
                    <option value="<%= ch %>" <%= notif&.channel == ch ? 'selected' : '' %>><%= ch %></option>
                  <% end %>
                </select>
                <select class="form-select form-select-sm notif-result-select" style="width:auto; font-size:0.72rem; padding:1px 4px;">
                  <option value="">結果</option>
                  <% OmnipotentNotificationStatus::RESULTS.each do |res| %>
                    <option value="<%= res %>" <%= notif&.result == res ? 'selected' : '' %>><%= res %></option>
                  <% end %>
                </select>
                <input type="date" class="form-control form-control-sm notif-date-input"
                       value="<%= notif&.contacted_at || Date.today %>"
                       style="width:auto; font-size:0.72rem; padding:1px 4px;">
                <button class="btn btn-primary btn-sm py-0 notif-save-detail" style="font-size:0.7rem;">儲存</button>
              </div>
            </div>
          </td>
          <td>
            <% if c.instagram_account.present? && c.instagram_account != "無ig帳號" %>
              <% ig = c.instagram_account.gsub('@', '').strip %>
              <a href="https://instagram.com/<%= ig %>" target="_blank"
                 class="text-decoration-none small d-block">@<%= ig %></a>
            <% else %>
              <span class="text-muted small">—</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<script>
(function () {
  var CSRF       = document.querySelector('meta[name="csrf-token"]')?.content || '';
  var UPDATE_URL = '<%= crm_update_status_path %>';
  var STATUS_COLORS = { "未通知": "secondary", "已通知": "primary", "已回覆": "success", "暫不需要": "light" };
  var ALL_STATUSES  = ["未通知", "已通知", "已回覆", "暫不需要"];

  function patchStatus(email, refDate, payload, onSuccess) {
    fetch(UPDATE_URL, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
      body: JSON.stringify(Object.assign({ email: email, reference_date: refDate,
                                          product_key: container.dataset.productKey || '<%= JourneyProducts::DEFAULT_PRODUCT_KEY %>' }, payload))
    })
    .then(function (res) { return res.json(); })
    .then(function (data) { if (data.success) onSuccess(data); });
  }

  function refreshCell(container, data) {
    var td = container.closest('td');
    var newStatus = data.status;
    container.dataset.current = newStatus;
    if (data.channel)     container.dataset.channel    = data.channel;
    if (data.result)      container.dataset.result     = data.result;
    if (data.contacted_at) container.dataset.contactedAt = data.contacted_at;

    // badge
    var badge = td.querySelector('.notif-status-badge');
    badge.className = 'badge bg-' + (STATUS_COLORS[newStatus] || 'secondary') + (newStatus === '暫不需要' ? ' text-muted notif-status-badge' : ' notif-status-badge');
    badge.textContent = newStatus;

    // date display
    if (data.contacted_at) {
      var dateEl = td.querySelector('.notif-date-display');
      dateEl.textContent = data.contacted_at; dateEl.style.display = '';
    }

    // channel / result badges
    var detailDiv = td.querySelector('.notif-detail-display');
    if (data.channel || data.result) {
      detailDiv.style.display = '';
      var chBadge = detailDiv.querySelector('.notif-channel-badge');
      var resBadge = detailDiv.querySelector('.notif-result-badge');
      if (data.channel) { chBadge.textContent = data.channel; chBadge.style.display = ''; }
      if (data.result)  { resBadge.textContent = data.result;  resBadge.style.display = ''; }
    }

    // 重繪狀態按鈕
    var oldBtns = Array.from(container.querySelectorAll('.notif-btn'));
    oldBtns.forEach(function (b) { b.remove(); });
    var toggle = container.querySelector('.notif-detail-toggle');
    ALL_STATUSES.filter(function (s) { return s !== newStatus; }).forEach(function (s) {
      var b = document.createElement('button');
      b.className = 'btn btn-outline-secondary py-0 notif-btn';
      b.style.fontSize = '0.7rem'; b.dataset.status = s; b.textContent = s;
      container.insertBefore(b, toggle);
    });
  }

  // 狀態切換按鈕
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.notif-btn');
    if (!btn) return;
    var container = btn.closest('[data-email]');
    if (!container) return;
    patchStatus(container.dataset.email, container.dataset.refDate, { status: btn.dataset.status },
      function (data) { refreshCell(container, data); });
  });

  // 📝 展開 / 收合詳細紀錄表單
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.notif-detail-toggle');
    if (!btn) return;
    var container = btn.closest('[data-email]');
    var form = container.closest('td').querySelector('.notif-detail-form');
    form.style.display = form.style.display === 'none' ? '' : 'none';
  });

  // 儲存聯絡紀錄
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.notif-save-detail');
    if (!btn) return;
    var td        = btn.closest('td');
    var container = td.querySelector('[data-email]');
    var channel   = td.querySelector('.notif-channel-select').value;
    var result    = td.querySelector('.notif-result-select').value;
    var date      = td.querySelector('.notif-date-input').value;
    var payload   = {};
    if (channel) payload.channel     = channel;
    if (result)  payload.result      = result;
    if (date)    payload.contacted_at = date;
    patchStatus(container.dataset.email, container.dataset.refDate, payload, function (data) {
      refreshCell(container, data);
      td.querySelector('.notif-detail-form').style.display = 'none';
    });
  });
})();
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('[data-paginate="true"]:not([data-paginated])').forEach(initPaginate);
});
function initPaginate(wrapper) {
  wrapper.dataset.paginated = 'true';
  const pageSize = parseInt(wrapper.dataset.pageSize) || 25;
  const tbody    = wrapper.querySelector('tbody');
  if (!tbody) return;
  const allRows  = Array.from(tbody.querySelectorAll('tr'));
  if (allRows.length <= pageSize) return;
  const totalPages = Math.ceil(allRows.length / pageSize);
  const pane       = wrapper.parentNode;
  function renderPage(page) {
    allRows.forEach(function (row, i) {
      row.style.display = (i >= (page-1)*pageSize && i < page*pageSize) ? '' : 'none';
    });
    const old = pane.querySelector('.paginate-controls');
    if (old) old.remove();
    const ctrl = document.createElement('div');
    ctrl.className = 'paginate-controls d-flex justify-content-between align-items-center px-3 py-2 border-top bg-light';
    ctrl.style.fontSize = '0.85rem';
    const info = document.createElement('span');
    info.className = 'text-muted';
    info.textContent = `第 ${(page-1)*pageSize+1}–${Math.min(page*pageSize,allRows.length)} 筆，共 ${allRows.length} 筆`;
    const btns = document.createElement('div');
    btns.className = 'd-flex gap-1 flex-wrap';
    const prev = document.createElement('button');
    prev.className = 'btn btn-sm btn-outline-secondary py-0';
    prev.textContent = '‹'; prev.disabled = page===1;
    prev.addEventListener('click', function(){renderPage(page-1);});
    btns.appendChild(prev);
    const sp = Math.max(1,page-2), ep = Math.min(totalPages,sp+4);
    for (let p=sp;p<=ep;p++){
      const pb=document.createElement('button');
      pb.className='btn btn-sm py-0 '+(p===page?'btn-secondary':'btn-outline-secondary');
      pb.textContent=p; const cp=p;
      pb.addEventListener('click',function(){renderPage(cp);});
      btns.appendChild(pb);
    }
    const next=document.createElement('button');
    next.className='btn btn-sm btn-outline-secondary py-0';
    next.textContent='›'; next.disabled=page===totalPages;
    next.addEventListener('click',function(){renderPage(page+1);});
    btns.appendChild(next);
    ctrl.appendChild(info); ctrl.appendChild(btns); pane.appendChild(ctrl);
  }
  renderPage(1);
}
</script>
