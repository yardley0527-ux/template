<!-- path: app/views/products/index.html.erb -->
<div class="subheader">
  <h1 class="subheader-title">
    <i class="subheader-icon fal fa-box"></i>
    <% if @combo %>
      組合商品排行
      <small>顯示所有套組 / 組合品項</small>
    <% else %>
      產品排行（2024–2026）
      <small>分年份顯示 Top 產品</small>
    <% end %>
  </h1>
</div>

<div class="row">
  <div class="col-12">
    <div class="panel">
      <div class="panel-hdr"><h2>篩選</h2></div>

      <div class="panel-container show">
        <div class="panel-content">
          <%= form_with url: products_path, method: :get, local: true, class: "row g-2 align-items-end" do %>
            <div class="col-sm-6 col-md-5">
              <label class="form-label">搜尋商品</label>
              <%= text_field_tag :q, @q, class: "form-control", placeholder: "輸入商品名稱關鍵字..." %>
            </div>

            <div class="col-sm-6 col-md-3">
              <label class="form-label">排行依據</label>
              <%= select_tag :sort,
                options_for_select([["訂單數", "orders"], ["營收", "revenue"], ["瓶數", "units"]], @sort),
                class: "form-control" %>
            </div>

            <% if @combo %>
              <%= hidden_field_tag :combo, "1" %>   ← 放這裡
            <% end %>

            <div class="col-sm-12 col-md-4">
              <%= button_tag "查詢", type: "submit", class: "btn btn-primary" %>
              <%= link_to "清除", products_path, class: "btn btn-outline-secondary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <% @years.each do |year| %>
    <% rows = @top_by_year[year] || [] %>
    <div class="col-12 col-xl-4">
      <div class="panel">
        <div class="panel-hdr">
          <h2><%= year %> Top 產品</h2>
        </div>
        <div class="panel-container show">
          <div class="panel-content">
            <div class="table-responsive">
              <table class="table table-bordered table-hover table-striped w-100">
                <thead class="bg-primary-600">
                  <tr>
                    <th>商品名稱</th>
                    <th class="text-end">訂單數</th>
                    <th class="text-end">瓶數</th>
                    <th class="text-end">總金額</th>
                    <th class="text-end">購買人數</th>
                    <th class="text-end">回購率</th>
                  </tr>
                </thead>
                <tbody>
                  <% stats = @buyer_stats_by_year[year] || {} %>
                  <% rows.each do |row| %>
                    <% s = stats[row.product_name] || {} %>
                    <% buyers         = s[:buyers].to_i %>
                    <% repurchase_pct = buyers > 0 ? (s[:repeat_buyers].to_i * 100.0 / buyers).round : 0 %>
                    <tr>
                      <td>
                        <%= link_to row.product_name, product_path(CGI.escape(row.product_name)), class: "fw-500" %>
                      </td>
                      <td class="text-end"><%= row.orders_count.to_i %></td>
                      <td class="text-end"><%= row.total_quantity.to_i %></td>
                      <td class="text-end"><%= number_with_delimiter(row.revenue.to_f.round(0).to_i) %></td>
                      <td class="text-end"><%= buyers %></td>
                      <td class="text-end"><%= repurchase_pct %>%</td>
                    </tr>
                  <% end %>

                  <% if rows.blank? %>
                    <tr><td colspan="6" class="text-center text-muted py-4">沒有資料</td></tr>
                  <% end %>
                </tbody>
              </table>
            </div>

            <p class="text-muted mt-2 mb-0">顯示前 10 筆（依 <%= {"orders"=>"訂單數","revenue"=>"營收","units"=>"瓶數"}[@sort] %> 排序）。</p>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
