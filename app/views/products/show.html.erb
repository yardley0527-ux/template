<!-- path: app/views/products/show.html.erb -->
<div class="subheader">
  <h1 class="subheader-title">
    <i class="subheader-icon fal fa-chart-bar"></i>
    產品分析
    <small><%= @analysis&.product_name.presence || @product_name %></small>
  </h1>
  <div class="subheader-block">
    <%= link_to "← 回產品列表", products_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>
</div>

<% yearly_orders  = (@analysis&.yearly_orders  || {}) %>
<% yearly_revenue = (@analysis&.yearly_revenue || {}) %>
<% copurchase_top = (@analysis&.copurchase_top || []) %>
<% top_customers  = (@analysis&.top_customers  || []) %>

<div class="row">
  <div class="col-12 col-md-3">
    <div class="panel">
      <div class="panel-hdr"><h2>核心指標</h2></div>
      <div class="panel-container show">
        <div class="panel-content">
          <div class="d-flex justify-content-between"><span>訂單筆數</span><strong><%= (@analysis&.orders_count || 0).to_i %></strong></div>
          <div class="d-flex justify-content-between mt-2"><span>售出數量</span><strong><%= (@analysis&.units_sold || 0).to_i %></strong></div>
          <div class="d-flex justify-content-between mt-2"><span>總營收</span><strong><%= number_with_delimiter((@analysis&.revenue || 0).to_f.round(0).to_i) %></strong></div>
          <div class="d-flex justify-content-between mt-2"><span>不重複客戶</span><strong><%= (@analysis&.unique_customers || 0).to_i %></strong></div>

          <hr>

          <div class="d-flex justify-content-between"><span>平均客單</span><strong><%= number_with_delimiter((@analysis&.avg_order_amount || 0).to_f.round(0).to_i) %></strong></div>
          <div class="d-flex justify-content-between mt-2">
            <span>平均每單件數</span>
            <strong><%= (@analysis&.avg_units_per_order || 0).to_f.round(2) %></strong>
          </div>

          <hr>

          <div class="small text-muted">首購：<%= @analysis&.first_order_at || "-" %></div>
          <div class="small text-muted">末購：<%= @analysis&.last_order_at || "-" %></div>
        </div>
      </div>
    </div>
    <% if @analysis.top_cities.any? %>
      <div class="panel">
        <div class="panel-hdr"><h2>📍 熱銷縣市 Top 3</h2></div>
        <div class="panel-container show">
          <div class="panel-content">
            <% max = @analysis.top_cities.values.first.to_f %>
            <% @analysis.top_cities.each do |city, count| %>
              <div class="mb-2">
                <div class="d-flex justify-content-between mb-1">
                  <span><%= city %></span>
                  <span class="text-muted"><%= count %> 筆</span>
                </div>
                <div class="progress" style="height: 8px;">
                  <div class="progress-bar" style="width: <%= (count / max * 100).round %>%"></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  
  <div class="col-12 col-md-5">
    <div class="panel">
      <div class="panel-hdr"><h2>年度趨勢</h2></div>
      <div class="panel-container show">
        <div class="panel-content">
          <table class="table table-sm table-bordered mb-0">
            <thead class="bg-fusion-50">
              <tr>
                <th>年份</th>
                <th class="text-end">訂單數</th>
                <th class="text-end">營收</th>
              </tr>
            </thead>
            <tbody>
              <% years = (yearly_orders.keys | yearly_revenue.keys).sort %>
              <% years.each do |y| %>
                <tr>
                  <td><%= y %></td>
                  <td class="text-end"><%= yearly_orders[y].to_i %></td>
                  <td class="text-end"><%= number_with_delimiter(yearly_revenue[y].to_f.round(0).to_i) %></td>
                </tr>
              <% end %>

              <% if years.blank? %>
                <tr><td colspan="3" class="text-center text-muted py-3">沒有資料</td></tr>
              <% end %>
            </tbody>
          </table>

          <div class="text-muted small mt-2">下一步可接 SmartAdmin 的 chart（line/bar）把年度趨勢畫出來。</div>
        </div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-hdr"><h2>常被一起買的商品（Top 5）</h2></div>
      <div class="panel-container show">
        <div class="panel-content">
          <table class="table table-sm table-bordered mb-0">
            <thead class="bg-fusion-50">
              <tr><th>商品</th><th class="text-end">次數</th></tr>
            </thead>
            <tbody>
              <% copurchase_top.each do |name, cnt| %>
                <tr>
                  <td><%= link_to name, product_path(name) %></td>
                  <td class="text-end"><%= cnt.to_i %></td>
                </tr>
              <% end %>

              <% if copurchase_top.blank? %>
                <tr><td colspan="2" class="text-center text-muted py-3">沒有資料</td></tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-md-4">
    <div class="panel">
      <div class="panel-hdr"><h2>Top 客戶（營收）</h2></div>
      <div class="panel-container show">
        <div class="panel-content">
          <table class="table table-sm table-bordered mb-0">
            <thead class="bg-fusion-50">
              <tr>
                <th>客戶</th>
                <th class="text-end">訂單</th>
                <th class="text-end">件數</th>
                <th class="text-end">營收</th>
              </tr>
            </thead>
            <tbody>
              <% top_customers.each do |c| %>
                <tr>
                  <td>
                    <div class="fw-500"><%= c[:full_name].presence || "(無名)" %></div>
                    <div class="small text-muted"><%= c[:email] %></div>
                    <div class="small text-muted"><%= c[:membership_level] %></div>
                  </td>
                  <td class="text-end"><%= c[:orders_count].to_i %></td>
                  <td class="text-end"><%= c[:units_sold].to_i %></td>
                  <td class="text-end"><%= number_with_delimiter(c[:revenue].to_f.round(0).to_i) %></td>
                </tr>
              <% end %>

              <% if top_customers.blank? %>
                <tr><td colspan="4" class="text-center text-muted py-3">沒有資料</td></tr>
              <% end %>
            </tbody>
          </table>

          <div class="text-muted small mt-2">下一步可加：點客戶 → 顯示客戶行為頁。</div>
        </div>
      </div>
    </div>
  </div>
</div>
