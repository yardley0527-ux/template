<% content_for :page_title, "Chloe 回覆助手" %>
<% if @refreshing %><% content_for(:head_block) { tag.meta("http-equiv": "refresh", content: "5") } %><% end %>
<div class="subheader">
  <h1 class="subheader-title"><i class="fal fa-comment-dots mr-2 text-primary"></i> Chloe 回覆助手
    <small>測試版：不會發訊息給客人。貼上問題後，先找已核准答案，沒有才寫草稿</small></h1>
</div>

<% [:notice, :alert].each do |k| %>
  <% if flash[k] %><div class="alert alert-<%= k == :notice ? 'success' : 'danger' %>"><%= flash[k] %></div><% end %>
<% end %>

<div class="card mb-3"><div class="card-body">
  <%= form_with url: reply_assistant_index_path, local: true do %>
    <label for="question" class="font-weight-bold">客人的問題</label>
    <textarea id="question" name="question" class="form-control mb-2" rows="3" required></textarea>
    <button class="btn btn-primary" type="submit">產生回覆</button>
    <span class="text-muted small ml-2">知識庫：FAQ <%= @faq_count %> 筆、核准問答 <%= @approved_count %> 筆</span>
  <% end %>
</div></div>

<% if @drafts.empty? %>
  <p class="text-muted">還沒有測試紀錄。</p>
<% end %>

<% @drafts.each do |d| %>
  <div class="card mb-3"><div class="card-body">
    <p class="mb-1 text-muted small"><%= l(d.created_at, format: "%m/%d %H:%M") %></p>
    <p class="font-weight-bold" style="white-space:pre-line;"><%= d.question %></p>
    <% if d.needs_human %>
      <div class="alert alert-warning py-2">需要人工確認<%= "：#{d.human_reason}" if d.human_reason.present? %></div>
    <% end %>

    <% case d.status %>
    <% when "generating" %>
      <p class="text-muted mb-0">準備中…</p>
    <% when "failed" %>
      <div class="alert alert-danger mb-0">產生失敗：<%= d.error_message %></div>
    <% when "pending" %>
      <p class="small text-muted mb-1"><%= d.direct_match? ? "已核准答案（原文帶入，來源 #{d.match_ref}）" : (d.match_ref.present? ? "找到舊答案，因敏感問題待確認（來源 #{d.match_ref}）" : "AI 草稿") %></p>
      <%= form_with url: reply_assistant_path(d), method: :patch, local: true do %>
        <textarea name="final_answer" class="form-control mb-2" rows="5" aria-label="回覆內容"><%= d.answer %></textarea>
        <button class="btn btn-success btn-sm" name="decision" value="approve" type="submit">核准並存入</button>
        <button class="btn btn-outline-secondary btn-sm" name="decision" value="reject" type="submit">不採用</button>
      <% end %>
    <% when "approved" %>
      <p class="small text-success mb-1">已核准</p>
      <p class="mb-0" style="white-space:pre-line;"><%= d.final_answer %></p>
    <% else %>
      <p class="text-muted mb-0">不採用</p>
    <% end %>
  </div></div>
<% end %>
