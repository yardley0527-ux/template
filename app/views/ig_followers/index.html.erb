<%# app/views/ig_followers/index.html.erb %>
<% content_for :page_title, "IG 粉絲成長追蹤" %>

<div class="row g-3 mb-3">
  <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <h4 class="fw-bold mb-0">IG 粉絲成長追蹤</h4>
      <p class="text-muted small mb-0">苼莛官方 + 各品牌子帳號 + Chloe IG 每日追蹤數</p>
    </div>
    <span class="text-muted small">上次更新：<%= @last_updated || '尚無資料' %></span>
  </div>
</div>

<p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">今日概況</p>
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <div id="table-wrap"><div class="text-center text-muted py-4">資料載入中…</div></div>
  </div>
</div>

<p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">成長率排行榜</p>
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <div class="btn-group btn-group-sm mb-3" id="growth-toggle">
      <button type="button" class="btn btn-outline-primary active" data-days="7">近 7 天</button>
      <button type="button" class="btn btn-outline-primary" data-days="30">近 30 天</button>
    </div>
    <div id="growth-table-wrap"><div class="text-center text-muted py-4">資料載入中…</div></div>
  </div>
</div>

<p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">趨勢總覽</p>
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <div class="btn-group btn-group-sm mb-3" id="chart-toggle">
      <button type="button" class="btn btn-outline-primary active" data-mode="growth">累計成長數</button>
      <button type="button" class="btn btn-outline-primary" data-mode="indexed">指數化成長</button>
    </div>
    <div style="height:340px">
      <canvas id="overview-chart"></canvas>
    </div>
  </div>
</div>

<style>
  #table-wrap table, #growth-table-wrap table { width: 100%; font-size: 0.9rem; }
  #table-wrap th, #growth-table-wrap th { color: #718096; font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; padding: 8px 12px; text-align: left; border-bottom: 2px solid #e9ecef; }
  #table-wrap td, #growth-table-wrap td { padding: 10px 12px; border-bottom: 1px solid #f0f2f5; vertical-align: middle; }
  .acct-name { font-weight: 600; }
  .acct-handle { font-size: 0.75rem; color: #a0aec0; }
  .followers-num { font-weight: 700; font-size: 1rem; }
  .change-badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 20px; font-size: 0.82rem; font-weight: 600; }
  .change-badge.up   { background: #f0fff4; color: #276749; }
  .change-badge.down { background: #fff5f5; color: #c53030; }
  .change-badge.flat { background: #f7fafc; color: #718096; }
  .mini-chart { width: 100px; height: 36px; }
  @media (max-width: 600px) { .hide-mobile { display: none; } }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const allData = <%= raw @data.to_json %>;
  const NAMES = <%= raw @names.to_json %>;
  const COLORS = ['#667eea','#f6ad55','#68d391','#fc8181','#4fd1c5','#b794f4','#f687b3','#76e4f7','#faf089','#90cdf4','#fbd38d','#9ae6b4','#cbd5e0','#f6e05e'];

  let overviewChart = null;
  let overviewMode = 'growth';
  let growthDays = 7;

  function fmt(n) { return n.toLocaleString(); }

  function badge(change) {
    if (change === null) return '<span class="change-badge flat">—</span>';
    const sign = change > 0 ? '+' : '';
    const cls = change > 0 ? 'up' : change < 0 ? 'down' : 'flat';
    const arrow = change > 0 ? '↑' : change < 0 ? '↓' : '—';
    return `<span class="change-badge ${cls}">${arrow} ${sign}${change.toLocaleString()}</span>`;
  }

  function pctBadge(pct) {
    if (pct === null || !isFinite(pct)) return '<span class="change-badge flat">—</span>';
    const sign = pct > 0 ? '+' : '';
    const cls = pct > 0 ? 'up' : pct < 0 ? 'down' : 'flat';
    const arrow = pct > 0 ? '↑' : pct < 0 ? '↓' : '—';
    return `<span class="change-badge ${cls}">${arrow} ${sign}${pct.toFixed(1)}%</span>`;
  }

  function buildTable(data) {
    const rows = Object.entries(data).map(([acct, entries]) => {
      const cur = entries.at(-1)?.followers ?? null;
      const prev = entries.at(-2)?.followers ?? null;
      const change = cur !== null && prev !== null ? cur - prev : null;
      return { acct, entries, cur, change };
    }).filter(r => r.cur !== null);

    rows.sort((a, b) => b.cur - a.cur);

    if (!rows.length) {
      document.getElementById('table-wrap').innerHTML = '<div class="text-center text-muted py-4">尚無資料</div>';
      return;
    }

    const trs = rows.map((r, i) => `
      <tr>
        <td class="hide-mobile text-muted">${i + 1}</td>
        <td>
          <div class="acct-name">${NAMES[r.acct] || r.acct}</div>
          <div class="acct-handle">@${r.acct}</div>
        </td>
        <td class="followers-num">${fmt(r.cur)}</td>
        <td>${badge(r.change)}</td>
        <td class="hide-mobile"><canvas class="mini-chart" id="mini-${r.acct.replace(/\./g,'-')}"></canvas></td>
      </tr>
    `).join('');

    document.getElementById('table-wrap').innerHTML = `
      <table>
        <thead><tr>
          <th class="hide-mobile">#</th>
          <th>帳號</th>
          <th>追蹤數</th>
          <th>較昨日</th>
          <th class="hide-mobile">近 30 天</th>
        </tr></thead>
        <tbody>${trs}</tbody>
      </table>
    `;

    rows.forEach((r, i) => {
      const el = document.getElementById(`mini-${r.acct.replace(/\./g,'-')}`);
      if (!el || r.entries.length < 2) return;
      const slice = r.entries.slice(-30);
      new Chart(el, {
        type: 'line',
        data: {
          labels: slice.map(e => e.date),
          datasets: [{ data: slice.map(e => e.followers), borderColor: COLORS[i % COLORS.length], borderWidth: 1.5, pointRadius: 0, fill: false, tension: 0.4 }]
        },
        options: { responsive: false, plugins: { legend: { display: false }, tooltip: { enabled: false } }, scales: { x: { display: false }, y: { display: false } }, animation: false }
      });
    });
  }

  function findPastEntry(entries, days) {
    const latest = entries.at(-1);
    const target = new Date(latest.date);
    target.setDate(target.getDate() - days);
    const targetStr = target.toISOString().slice(0, 10);
    let result = null;
    for (const e of entries) {
      if (e.date <= targetStr) result = e;
      else break;
    }
    return result;
  }

  function buildGrowthLeaderboard(data, days) {
    const rows = Object.entries(data).map(([acct, entries]) => {
      if (entries.length < 2) return null;
      const latest = entries.at(-1);
      const past = findPastEntry(entries, days);
      if (!past || past.date === latest.date) return null;
      const change = latest.followers - past.followers;
      const pct = past.followers > 0 ? (change / past.followers) * 100 : null;
      return { acct, cur: latest.followers, change, pct, fromDate: past.date };
    }).filter(Boolean);

    rows.sort((a, b) => (b.pct ?? -Infinity) - (a.pct ?? -Infinity));

    if (!rows.length) {
      document.getElementById('growth-table-wrap').innerHTML =
        '<div class="text-center text-muted py-4">資料天數不足，待累積較長時間後可計算成長率</div>';
      return;
    }

    const trs = rows.map((r, i) => `
      <tr>
        <td class="hide-mobile text-muted">${i + 1}</td>
        <td>
          <div class="acct-name">${NAMES[r.acct] || r.acct}</div>
          <div class="acct-handle">@${r.acct}</div>
        </td>
        <td class="followers-num">${fmt(r.cur)}</td>
        <td>${badge(r.change)}</td>
        <td>${pctBadge(r.pct)}</td>
        <td class="hide-mobile acct-handle">${r.fromDate} → 今</td>
      </tr>
    `).join('');

    document.getElementById('growth-table-wrap').innerHTML = `
      <table>
        <thead><tr>
          <th class="hide-mobile">#</th>
          <th>帳號</th>
          <th>目前追蹤數</th>
          <th>成長量</th>
          <th>成長率</th>
          <th class="hide-mobile">區間</th>
        </tr></thead>
        <tbody>${trs}</tbody>
      </table>
    `;
  }

  function buildOverview(data, mode) {
    const ctx = document.getElementById('overview-chart').getContext('2d');
    if (overviewChart) { overviewChart.destroy(); overviewChart = null; }

    const datasets = [];
    let ci = 0;

    const dateSet = new Set();
    for (const entries of Object.values(data)) entries.forEach(e => dateSet.add(e.date));
    const labels = [...dateSet].sort().slice(-60);

    for (const [acct, entries] of Object.entries(data)) {
      if (entries.length < 2) continue;
      const byDate = Object.fromEntries(entries.map(e => [e.date, e.followers]));
      const base = entries[0].followers;
      const values = labels.map(d => {
        const v = byDate[d] ?? null;
        if (v === null) return null;
        return mode === 'indexed' ? (base > 0 ? (v / base) * 100 : null) : v - base;
      });
      datasets.push({
        label: NAMES[acct] || acct,
        data: values,
        borderColor: COLORS[ci % COLORS.length],
        backgroundColor: 'transparent',
        tension: 0.4,
        pointRadius: 2,
        borderWidth: 2,
        spanGaps: true,
      });
      ci++;
    }

    if (!datasets.length) return;

    overviewChart = new Chart(ctx, {
      type: 'line',
      data: { labels, datasets },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { position: 'bottom', labels: { boxWidth: 12, padding: 16, font: { size: 11 } } },
          tooltip: {
            callbacks: {
              label: ctx => {
                const v = ctx.raw;
                if (v === null || v === undefined) return `${ctx.dataset.label}: —`;
                if (mode === 'indexed') return `${ctx.dataset.label}: ${v.toFixed(1)}`;
                return `${ctx.dataset.label}: ${v.toLocaleString()}${mode === 'growth' ? ' (+)' : ''}`;
              }
            }
          }
        },
        scales: {
          x: { ticks: { maxTicksLimit: 10, font: { size: 11 } } },
          y: {
            ticks: { callback: v => mode === 'indexed' ? v.toFixed(0) : fmt(v), font: { size: 11 } },
            title: mode === 'indexed'
              ? { display: true, text: '指數（首日 = 100）', font: { size: 11 } }
              : undefined
          }
        }
      }
    });
  }

  document.getElementById('chart-toggle').addEventListener('click', e => {
    const btn = e.target.closest('button');
    if (!btn) return;
    e.currentTarget.querySelectorAll('button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    overviewMode = btn.dataset.mode;
    buildOverview(allData, overviewMode);
  });

  document.getElementById('growth-toggle').addEventListener('click', e => {
    const btn = e.target.closest('button');
    if (!btn) return;
    e.currentTarget.querySelectorAll('button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    growthDays = parseInt(btn.dataset.days, 10);
    buildGrowthLeaderboard(allData, growthDays);
  });

  if (Object.keys(allData).length) {
    buildTable(allData);
    buildGrowthLeaderboard(allData, growthDays);
    buildOverview(allData, overviewMode);
  } else {
    document.getElementById('table-wrap').innerHTML = '<div class="text-center text-muted py-4">尚無資料，請於 local 端執行 script/update_ig_followers.sh</div>';
    document.getElementById('growth-table-wrap').innerHTML = '<div class="text-center text-muted py-4">尚無資料</div>';
  }
});
</script>
