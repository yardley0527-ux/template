<% content_for :page_title, "直播場次" %>

<div class="subheader">
  <h1 class="subheader-title">
    <i class="fal fa-video mr-2 text-danger"></i> 直播場次
  </h1>
  <div class="ml-auto">
    <%= link_to new_livestream_path, class: "btn btn-primary btn-sm" do %>
      <i class="fal fa-plus mr-1"></i> 新增直播
    <% end %>
  </div>
</div>

<div class="alert alert-light border small mb-3">
  <i class="fal fa-info-circle mr-1"></i>
  「推定」欄位＝場次日至 D+窗口天數的訂單推定歸因，<strong>不是訂單真實來源</strong>；「歷史登記」欄位為人工登記數字。
</div>

<div class="panel">
  <div class="panel-container show">
    <div class="panel-content">

      <%= form_with url: livestreams_path, method: :get, local: true, class: "form-inline mb-3" do %>
        <label class="mr-2 mb-2">年份
          <%= select_tag :year, options_for_select([["全部", ""]] + @years.map { |y| ["#{y} 年", y] }, @selected_year),
                class: "form-control form-control-sm ml-1" %>
        </label>
        <label class="mr-2 mb-2">月份
          <%= select_tag :month, options_for_select([["全部", ""]] + (1..12).map { |m| ["#{m} 月", m] }, @selected_month),
                class: "form-control form-control-sm ml-1" %>
        </label>
        <label class="mr-2 mb-2">本場銷售產品
          <%= select_tag :product, options_for_select([["全部", ""]] + @product_options.map { |k, l| [l, k] }, @selected_product),
                class: "form-control form-control-sm ml-1" %>
        </label>
        <button type="submit" class="btn btn-sm btn-outline-primary mb-2 mr-1">
          <i class="fal fa-search mr-1"></i>篩選
        </button>
        <%= link_to "清除", livestreams_path, class: "btn btn-sm btn-outline-secondary mb-2" %>
      <% end %>

      <% if @livestreams.empty? %>
        <div class="text-center py-5 text-muted">
          <i class="fal fa-video fa-3x mb-3 d-block opacity-25"></i>
          <% if @selected_year || @selected_month || @selected_product %>
            篩選條件下沒有場次，<%= link_to "清除篩選", livestreams_path %>
          <% else %>
            尚無直播紀錄，<%= link_to "新增第一場", new_livestream_path %>
          <% end %>
        </div>
      <% else %>

        <%# ── 桌機：表格 ── %>
        <div class="d-none d-lg-block" style="overflow-x:auto;">
          <table class="table table-bordered table-hover align-middle small">
            <thead class="thead-light">
              <tr>
                <th>日期</th>
                <th>標題</th>
                <th>本場銷售產品</th>
                <th class="text-right">推定檔期營收</th>
                <th class="text-right">歷史登記營收</th>
                <th class="text-right">推定訂單</th>
                <th class="text-right">推定買家</th>
                <th class="text-right">新客</th>
                <th>統計更新</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody>
              <% @livestreams.each do |ls| %>
                <tr>
                  <td class="text-nowrap">
                    <%= link_to ls.date.strftime("%Y/%m/%d"), livestream_path(ls), class: "font-weight-bold" %>
                  </td>
                  <td><%= ls.title.presence || "（未命名場次）" %></td>
                  <td>
                    <% ls.product_keys.each do |key| %>
                      <span class="badge badge-light border mr-1 mb-1"><%= @product_labels[key] || key %></span>
                    <% end %>
                  </td>
                  <td class="text-right text-nowrap">
                    <% if LivestreamStatsPresenter.never_refreshed?(ls) %>
                      <span class="text-muted">—</span>
                    <% else %>
                      <%= number_with_delimiter(ls.total_revenue.to_i) %>
                      <% if LivestreamStatsPresenter.provisional?(ls) %>
                        <span class="badge badge-warning ml-1" title="場次窗口尚未走完，數字會持續變動">未定版</span>
                      <% end %>
                    <% end %>
                  </td>
                  <td class="text-right text-nowrap">
                    <%= ls.reported_revenue.present? ? number_with_delimiter(ls.reported_revenue.to_i) : content_tag(:span, "—", class: "text-muted") %>
                  </td>
                  <td class="text-right"><%= LivestreamStatsPresenter.never_refreshed?(ls) ? "—" : ls.total_orders %></td>
                  <td class="text-right"><%= LivestreamStatsPresenter.never_refreshed?(ls) ? "—" : ls.total_buyers %></td>
                  <td class="text-right text-nowrap">
                    <% if LivestreamStatsPresenter.never_refreshed?(ls) %>
                      —
                    <% else %>
                      <%= ls.new_buyers %>（<%= LivestreamStatsPresenter.new_buyer_pct(ls) %>%）
                    <% end %>
                  </td>
                  <td class="text-nowrap small text-muted">
                    <%= ls.stats_refreshed_at&.strftime("%m/%d %H:%M") || "尚未刷新" %>
                  </td>
                  <td class="text-nowrap">
                    <%= link_to edit_livestream_path(ls), class: "btn btn-xs btn-outline-secondary mr-1" do %>
                      <i class="fal fa-edit"></i>
                    <% end %>
                    <%= link_to livestream_path(ls), method: :delete, data: { confirm: "確定刪除 #{ls.date.strftime('%m/%d')} 的直播？" }, class: "btn btn-xs btn-outline-danger" do %>
                      <i class="fal fa-trash"></i>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <%# ── 手機：卡片 ── %>
        <div class="d-lg-none">
          <% @livestreams.each do |ls| %>
            <div class="card mb-3">
              <div class="card-header d-flex align-items-center py-2" style="background:#f5ede8;">
                <%= link_to ls.date.strftime("%Y/%m/%d"), livestream_path(ls), class: "font-weight-bold" %>
                <div class="ml-auto" style="white-space:nowrap;">
                  <%= link_to edit_livestream_path(ls), class: "btn btn-xs btn-outline-secondary mr-1" do %>
                    <i class="fal fa-edit"></i>
                  <% end %>
                  <%= link_to livestream_path(ls), method: :delete, data: { confirm: "確定刪除？" }, class: "btn btn-xs btn-outline-danger" do %>
                    <i class="fal fa-trash"></i>
                  <% end %>
                </div>
              </div>
              <div class="card-body py-2 px-3 small">
                <div class="font-weight-bold mb-1"><%= ls.title.presence || "（未命名場次）" %></div>
                <div class="mb-2">
                  <% ls.product_keys.each do |key| %>
                    <span class="badge badge-light border mr-1"><%= @product_labels[key] || key %></span>
                  <% end %>
                </div>
                <% if LivestreamStatsPresenter.never_refreshed?(ls) %>
                  <div class="text-muted">尚未刷新統計</div>
                <% else %>
                  <div class="d-flex justify-content-between border-bottom py-1">
                    <span class="text-muted">推定檔期營收</span>
                    <span>
                      <%= number_with_delimiter(ls.total_revenue.to_i) %>
                      <% if LivestreamStatsPresenter.provisional?(ls) %><span class="badge badge-warning ml-1">未定版</span><% end %>
                    </span>
                  </div>
                  <div class="d-flex justify-content-between border-bottom py-1">
                    <span class="text-muted">歷史登記營收</span>
                    <span><%= ls.reported_revenue.present? ? number_with_delimiter(ls.reported_revenue.to_i) : "—" %></span>
                  </div>
                  <div class="d-flex justify-content-between border-bottom py-1">
                    <span class="text-muted">推定訂單／買家</span>
                    <span><%= ls.total_orders %> 單／<%= ls.total_buyers %> 人</span>
                  </div>
                  <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">新客</span>
                    <span><%= ls.new_buyers %>（<%= LivestreamStatsPresenter.new_buyer_pct(ls) %>%）</span>
                  </div>
                  <div class="text-muted mt-1" style="font-size:0.75rem;">
                    統計更新：<%= ls.stats_refreshed_at.strftime("%m/%d %H:%M") %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

      <% end %>
    </div>
  </div>
</div>
