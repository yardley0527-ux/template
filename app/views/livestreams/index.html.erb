<% content_for :page_title, "直播歷史" %>

<div class="subheader">
  <h1 class="subheader-title">
    <i class="fal fa-video mr-2 text-danger"></i> 直播歷史
  </h1>
  <div class="ml-auto">
    <%= link_to new_livestream_path, class: "btn btn-primary btn-sm" do %>
      <i class="fal fa-plus mr-1"></i> 新增直播
    <% end %>
  </div>
</div>

<% if @livestreams.empty? %>
  <div class="text-center py-5 text-muted">
    <i class="fal fa-video fa-3x mb-3 d-block opacity-25"></i>
    尚無直播紀錄，<%= link_to "新增第一場", new_livestream_path %>
  </div>
<% else %>
  <% @livestreams.group_by { |ls| ls.date.year }.sort_by { |year, _| -year }.each do |year, year_group| %>
    <h4 class="mt-4 mb-3 font-weight-bold" style="border-left:4px solid #c00; padding-left:10px;">
      <%= year %> 年
    </h4>

    <%# ── 桌機：上半年 / 下半年 ── %>
    <div class="d-none d-lg-block">
      <% { "上半年（1–6月）" => (1..6), "下半年（7–12月）" => (7..12) }.each do |label, months| %>
        <% half = year_group.select { |ls| months.include?(ls.date.month) } %>
        <% next if half.empty? %>
        <p class="text-muted small mb-1 font-weight-bold"><%= label %></p>
        <div style="overflow-x:auto; margin-bottom:1.5rem;">
          <table class="table table-bordered text-center align-top" style="min-width:<%= [half.size * 160, 300].max %>px; table-layout:fixed;">
            <colgroup>
              <% half.each { %><col style="width:160px;"><% } %>
            </colgroup>
            <thead class="thead-light">
              <tr>
                <% half.each do |ls| %>
                  <th class="p-2">
                    <div class="font-weight-bold"><%= ls.date.strftime("%-m/%-d") %></div>
                    <div class="mt-1" style="white-space:nowrap;">
                      <%= link_to edit_livestream_path(ls), class: "btn btn-xs btn-outline-secondary mr-1" do %>
                        <i class="fal fa-edit"></i>
                      <% end %>
                      <%= link_to livestream_path(ls), method: :delete, data: { confirm: "確定刪除 #{ls.date.strftime('%m/%d')} 的直播？" }, class: "btn btn-xs btn-outline-danger" do %>
                        <i class="fal fa-trash"></i>
                      <% end %>
                    </div>
                  </th>
                <% end %>
              </tr>
            </thead>
            <tbody>
              <tr>
                <% half.each do |ls| %>
                  <td class="p-1" style="background:#fafafa;">
                    <div class="d-flex flex-wrap">
                      <% ls.livestream_images.each do |img| %>
                        <img src="<%= img.url %>" style="width:<%= ls.livestream_images.size > 1 ? '50%' : '100%' %>; object-fit:cover; border-radius:4px;" loading="lazy">
                      <% end %>
                    </div>
                  </td>
                <% end %>
              </tr>
              <% max_p = half.map { |ls| ls.livestream_products.size }.max || 0 %>
              <% max_p.times do |i| %>
                <tr>
                  <% half.each do |ls| %>
                    <td class="p-2 small">
                      <% prod = ls.livestream_products[i] %>
                      <% if prod %>
                        <span class="font-weight-bold"><%= prod.name %></span>
                        <span class="text-danger ml-1"><%= number_with_delimiter(prod.price) %> 元</span>
                      <% end %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
              <% max_g = half.map { |ls| ls.livestream_gifts.size }.max || 0 %>
              <% max_g.times do |i| %>
                <tr style="background:#fffbe6;">
                  <% half.each do |ls| %>
                    <td class="p-2 small">
                      <% g = ls.livestream_gifts[i] %>
                      <% if g %>
                        <span class="<%= g.highlight? ? 'font-weight-bold text-danger' : '' %>"><%= g.description %></span>
                      <% end %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>

    <%# ── 手機：按月份分組垂直卡片 ── %>
    <div class="d-lg-none">
      <% year_group.group_by { |ls| ls.date.month }.sort_by { |m, _| -m }.each do |month, month_group| %>
        <p class="text-muted small mb-2 font-weight-bold"><%= month %> 月</p>
        <% month_group.each do |ls| %>
          <div class="card mb-3">
            <div class="card-header d-flex align-items-center py-2" style="background:#f5ede8;">
              <span class="font-weight-bold"><%= ls.date.strftime("%-m/%-d") %></span>
              <div class="ml-auto" style="white-space:nowrap;">
                <%= link_to edit_livestream_path(ls), class: "btn btn-xs btn-outline-secondary mr-1" do %>
                  <i class="fal fa-edit"></i>
                <% end %>
                <%= link_to livestream_path(ls), method: :delete, data: { confirm: "確定刪除？" }, class: "btn btn-xs btn-outline-danger" do %>
                  <i class="fal fa-trash"></i>
                <% end %>
              </div>
            </div>
            <% if ls.livestream_images.any? %>
              <div class="d-flex flex-wrap">
                <% ls.livestream_images.each do |img| %>
                  <img src="<%= img.url %>" style="width:<%= ls.livestream_images.size > 1 ? '50%' : '100%' %>; object-fit:cover;" loading="lazy">
                <% end %>
              </div>
            <% end %>
            <div class="card-body py-2 px-3">
              <% ls.livestream_products.each do |prod| %>
                <div class="small py-1" style="border-bottom:1px solid #f0f0f0;">
                  <span class="font-weight-bold"><%= prod.name %></span>
                  <span class="text-danger ml-1"><%= number_with_delimiter(prod.price) %> 元</span>
                </div>
              <% end %>
              <% if ls.livestream_gifts.any? %>
                <div class="mt-2" style="background:#fffbe6; border-radius:4px; padding:6px 8px;">
                  <% ls.livestream_gifts.each do |g| %>
                    <div class="small <%= g.highlight? ? 'font-weight-bold text-danger' : 'text-muted' %>"><%= g.description %></div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

  <% end %>
<% end %>
