<%# app/views/korean_brand_leads/index.html.erb %>
<% content_for :page_title, "韓國品牌開團洽談" %>

<%
  def lead_status_label(lead)
    return "待聯絡" unless lead.contacted
    lead.replied ? "已回覆" : "已聯絡・待回覆"
  end

  def lead_status_badge_class(lead)
    return "badge-secondary" unless lead.contacted
    lead.replied ? "badge-success" : "badge-warning"
  end
%>

<div class="row g-3 mb-3">
  <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <h4 class="fw-bold mb-0">韓國品牌開團洽談</h4>
      <p class="text-muted small mb-0">追蹤跟韓國品牌接洽開團合作的進度：產品來源、聯絡管道、信件內容與回覆狀況</p>
    </div>
    <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#new-lead-modal">
      <i class="fal fa-plus mr-1"></i>新增品牌
    </button>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4 col-6">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted small mb-1">追蹤中品牌數</div>
        <div class="fw-bold" style="font-size:1.8rem;line-height:1"><%= @korean_brand_leads.size %></div>
      </div>
    </div>
  </div>
  <div class="col-md-4 col-6">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted small mb-1">已聯絡</div>
        <div class="fw-bold text-warning" style="font-size:1.8rem;line-height:1"><%= @korean_brand_leads.count(&:contacted) %></div>
      </div>
    </div>
  </div>
  <div class="col-md-4 col-6">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted small mb-1">已回覆</div>
        <div class="fw-bold text-success" style="font-size:1.8rem;line-height:1"><%= @korean_brand_leads.count(&:replied) %></div>
      </div>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="bg-light">
          <tr>
            <th style="min-width:140px">產品</th>
            <th style="min-width:180px">產品來源網站</th>
            <th style="min-width:160px">韓國公司聯絡管道</th>
            <th style="min-width:130px">是否聯絡</th>
            <th style="min-width:220px">信件內容</th>
            <th style="min-width:110px">是否有回覆</th>
            <th style="min-width:240px">備註</th>
            <th style="min-width:240px">Follow Up</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @korean_brand_leads.each do |lead| %>
            <tr>
              <td class="fw-bold"><%= lead.product_name %></td>
              <td>
                <% if lead.source_url.present? %>
                  <%= link_to "來源連結", lead.source_url, target: "_blank", rel: "noopener", class: "small" %>
                <% else %>
                  <span class="text-muted small">—</span>
                <% end %>
              </td>
              <td><span class="small"><%= lead.contact_channel.presence || "—" %></span></td>
              <td>
                <%= form_with model: lead, url: korean_brand_lead_path(lead), method: :patch, local: true, class: "mb-0" do |f| %>
                  <%= hidden_field_tag "korean_brand_lead[contacted]", !lead.contacted %>
                  <button type="submit" class="btn btn-sm <%= lead.contacted ? 'btn-outline-warning' : 'btn-outline-secondary' %>">
                    <span class="badge <%= lead_status_badge_class(lead) %>"><%= lead_status_label(lead) %></span>
                  </button>
                <% end %>
                <% if lead.contacted_at.present? %>
                  <div class="text-muted small mt-1"><%= lead.contacted_at.strftime("%Y-%m-%d") %></div>
                <% end %>
              </td>
              <td>
                <% if lead.email_content.present? %>
                  <button type="button" class="btn btn-sm btn-outline-secondary" data-toggle="modal" data-target="#email-content-<%= lead.id %>">
                    查看信件內容
                  </button>
                  <div class="modal fade" id="email-content-<%= lead.id %>" tabindex="-1" role="dialog">
                    <div class="modal-dialog modal-lg" role="document">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title"><%= lead.product_name %> — 信件內容</h5>
                          <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                        </div>
                        <div class="modal-body">
                          <pre class="small" style="white-space:pre-wrap;font-family:inherit;"><%= lead.email_content %></pre>
                        </div>
                      </div>
                    </div>
                  </div>
                <% else %>
                  <span class="text-muted small">—</span>
                <% end %>
              </td>
              <td>
                <% if lead.contacted %>
                  <%= form_with model: lead, url: korean_brand_lead_path(lead), method: :patch, local: true, class: "mb-0" do |f| %>
                    <%= hidden_field_tag "korean_brand_lead[replied]", !lead.replied %>
                    <button type="submit" class="btn btn-sm <%= lead.replied ? 'btn-outline-success' : 'btn-outline-secondary' %>">
                      <%= lead.replied ? "已回覆" : "尚未回覆" %>
                    </button>
                  <% end %>
                <% else %>
                  <span class="text-muted small">—</span>
                <% end %>
              </td>
              <td>
                <%= form_with model: lead, url: korean_brand_lead_path(lead), method: :patch, local: true, class: "d-flex gap-1 mb-0" do |f| %>
                  <%= f.text_area :notes, value: lead.notes, class: "form-control form-control-sm", rows: 3, placeholder: "備註" %>
                  <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="fal fa-save"></i></button>
                <% end %>
              </td>
              <td>
                <%= form_with model: lead, url: korean_brand_lead_path(lead), method: :patch, local: true, class: "d-flex gap-1 mb-0" do |f| %>
                  <%= f.text_area :follow_up, value: lead.follow_up, class: "form-control form-control-sm", rows: 3, placeholder: "Follow up" %>
                  <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="fal fa-save"></i></button>
                <% end %>
              </td>
              <td>
                <%= link_to korean_brand_lead_path(lead), method: :delete, data: { confirm: "確定刪除 #{lead.product_name}？" }, class: "btn btn-sm btn-outline-danger" do %>
                  <i class="fal fa-trash-alt"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="modal fade" id="new-lead-modal" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <%= form_with model: KoreanBrandLead.new, url: korean_brand_leads_path, local: true do |f| %>
        <div class="modal-header">
          <h5 class="modal-title">新增韓國品牌</h5>
          <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
        </div>
        <div class="modal-body">
          <div class="form-group">
            <label>產品 / 品牌名稱</label>
            <%= f.text_field :product_name, class: "form-control", required: true %>
          </div>
          <div class="form-group">
            <label>產品來源網站</label>
            <%= f.text_field :source_url, class: "form-control", placeholder: "https://..." %>
          </div>
          <div class="form-group">
            <label>韓國公司聯絡管道</label>
            <%= f.text_field :contact_channel, class: "form-control", placeholder: "Email / IG / 官網等" %>
          </div>
          <div class="form-group form-check">
            <%= f.check_box :contacted, class: "form-check-input" %>
            <label class="form-check-label">已聯絡</label>
          </div>
          <div class="form-group">
            <label>聯絡日期</label>
            <%= f.date_field :contacted_at, class: "form-control" %>
          </div>
          <div class="form-group">
            <label>信件內容</label>
            <%= f.text_area :email_content, class: "form-control", rows: 6 %>
          </div>
          <div class="form-group form-check">
            <%= f.check_box :replied, class: "form-check-input" %>
            <label class="form-check-label">已回覆</label>
          </div>
          <div class="form-group">
            <label>備註</label>
            <%= f.text_area :notes, class: "form-control", rows: 2 %>
          </div>
          <div class="form-group">
            <label>Follow Up</label>
            <%= f.text_area :follow_up, class: "form-control", rows: 2 %>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">取消</button>
          <button type="submit" class="btn btn-primary">新增</button>
        </div>
      <% end %>
    </div>
  </div>
</div>
