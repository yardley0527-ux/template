<div class="subheader">
  <h1 class="subheader-title">
    <i class="subheader-icon fal fa-user"></i>
    高購物金客群
    <small>購物金 > <%= number_with_delimiter(@threshold) %><%= @year.present? ? "（#{@year} 年）" : "" %></small>
  </h1>
</div>

<div class="panel">
  <div class="panel-hdr"><h2>條件</h2></div>
  <div class="panel-container show">
    <div class="panel-content">
      <%= form_with url: high_credit_customers_path, method: :get, local: true, class: "row g-2 align-items-end" do %>
        <div class="col-sm-6 col-md-3">
          <label class="form-label">門檻（購物金）</label>
          <%= number_field_tag :threshold, @threshold, class: "form-control" %>
        </div>

        <div class="col-sm-6 col-md-3">
          <label class="form-label">年份（可空）</label>
          <%= number_field_tag :year, @year, class: "form-control", placeholder: "例如 2024" %>
        </div>

        <div class="col-sm-6 col-md-4">
          <label class="form-label">搜尋（姓名 / email / line）</label>
          <%= text_field_tag :q, @q, class: "form-control", placeholder: "關鍵字..." %>
        </div>

        <div class="col-sm-6 col-md-2">
          <%= hidden_field_tag :tab, @tab %>
          <%= button_tag "查詢", type: "submit", class: "btn btn-primary" %>
        </div>
      <% end %>

      <div class="mt-3 d-flex gap-2 flex-wrap">
        <%= link_to "依客戶", high_credit_customers_path(threshold: @threshold, year: @year, q: @q, tab: "customers"),
          class: "btn btn-sm #{@tab == "customers" ? "btn-primary" : "btn-outline-primary"}" %>

        <%= link_to "依產品", high_credit_customers_path(threshold: @threshold, year: @year, q: @q, tab: "products"),
          class: "btn btn-sm #{@tab == "products" ? "btn-primary" : "btn-outline-primary"}" %>

        <span class="ms-auto"></span>

        <%= link_to "下載：客戶明細 CSV", export_high_credit_customers_path(type: "customers", threshold: @threshold, year: @year),
          class: "btn btn-sm btn-outline-success" %>

        <%= link_to "下載：產品名單 CSV", export_high_credit_customers_path(type: "products", threshold: @threshold, year: @year),
          class: "btn btn-sm btn-outline-success" %>
      </div>

      <div class="mt-2 text-muted">
        符合客戶數：<strong><%= @result[:customers_count] %></strong>
        ／ 有購買紀錄：<strong><%= @result[:by_customer].count { |c| c[:products].present? } %></strong>
        ／ 產品數：<strong><%= @result[:by_product].size %></strong>
      </div>
    </div>
  </div>
</div>

<% if @tab == "customers" %>
  <div class="panel">
    <div class="panel-hdr"><h2>依客戶</h2></div>
    <div class="panel-container show">
      <div class="panel-content">
        <div class="table-responsive">
          <table class="table table-bordered table-hover table-striped w-100">
            <thead class="bg-primary-600">
              <tr>
                <th>客戶</th>
                <th class="text-end">購物金</th>
                <th>城市</th>
                <th>會員</th>
                <th>購買產品（排序：瓶數→營收）</th>
              </tr>
            </thead>
            <tbody>
              <% (@customers || @result[:by_customer]).each do |c| %>
                <tr>
                  <td>
                    <div class="fw-500"><%= c[:full_name].presence || "(無名)" %></div>
                    <div class="small text-muted"><%= c[:email] %></div>
                    <% if c[:line_id].present? %>
                      <div class="small text-muted">LINE: <%= c[:line_id] %></div>
                    <% end %>
                    <% if c[:mobile_phone].present? %>
                      <div class="small text-muted">手機: <%= c[:mobile_phone] %></div>
                    <% end %>
                  </td>
                  <td class="text-end"><%= number_with_delimiter(c[:credit_value].to_i) %></td>
                  <td><%= c[:city].presence || "-" %></td>
                  <td><%= c[:membership_level].presence || "-" %></td>
                  <td>
                    <% if c[:products].blank? %>
                      <span class="text-muted">（沒有購買紀錄）</span>
                    <% else %>
                      <div class="d-flex flex-wrap gap-2">
                        <% c[:products].first(12).each do |p| %>
                          <span class="badge bg-info-200 text-dark">
                            <%= p[:product_name] %>
                            ／ <%= p[:units_sold].to_i %> 件
                            ／ <%= number_with_delimiter(p[:revenue].to_i) %>
                          </span>
                        <% end %>
                      </div>
                      <% if c[:products].size > 12 %>
                        <div class="small text-muted mt-1">…還有 <%= c[:products].size - 12 %> 個產品</div>
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>

              <% if (@customers || @result[:by_customer]).blank? %>
                <tr><td colspan="5" class="text-center text-muted py-4">沒有資料</td></tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <div class="panel">
    <div class="panel-hdr"><h2>依產品</h2></div>
    <div class="panel-container show">
      <div class="panel-content">
        <div class="table-responsive">
          <table class="table table-bordered table-hover table-striped w-100">
            <thead class="bg-primary-600">
              <tr>
                <th>產品</th>
                <th class="text-end">人數</th>
                <th>Top 客戶（前 10，排序：瓶數→營收）</th>
              </tr>
            </thead>
            <tbody>
              <% (@products || @result[:by_product]).each do |g| %>
                <% top_customers = (g[:customers] || []).first(10) %>

                <tr>
                  <td class="fw-500"><%= g[:product_name] %></td>

                  <td class="text-end"><%= number_with_delimiter((g[:customers] || []).size) %></td>

                  <td>
                    <% if top_customers.blank? %>
                      <span class="text-muted">（沒有購買紀錄）</span>
                    <% else %>
                      <div class="d-flex flex-wrap gap-2">
                        <% top_customers.each do |u| %>
                          <span class="badge bg-info-200 text-dark">
                            <%= u[:full_name].presence || "(無名)" %>
                            ／ <%= u[:units_sold].to_i %> 件
                            ／ <%= number_with_delimiter(u[:revenue].to_i) %>
                            ／ 購物金 <%= number_with_delimiter(u[:current_shopping_credits].to_i) %>
                            ／ <%= u[:membership_level].presence || "-" %>
                          </span>
                        <% end %>
                      </div>

                      <% if (g[:customers] || []).size > 10 %>
                        <div class="small text-muted mt-1">…還有 <%= (g[:customers] || []).size - 10 %> 人</div>
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>

              <% if (@products || @result[:by_product]).blank? %>
                <tr><td colspan="3" class="text-center text-muted py-4">沒有資料</td></tr>
              <% end %>
            </tbody>

          </table>
        </div>
      </div>
    </div>
  </div>
<% end %>
