<% content_for :page_title, "受眾比對" %>

<div class="row g-3 mb-3">
  <div class="col-12">
    <h4 class="fw-bold mb-0">ManyChat 受眾比對</h4>
    <p class="text-muted small mb-0">比對苼莛官方與 Chloe 的 IG 受眾，找出潛在再行銷目標</p>
  </div>
</div>

<% if flash[:notice] %>
  <div class="alert alert-success alert-dismissible fade show">
    <%= flash[:notice] %>
    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
  </div>
<% end %>
<% if flash[:alert] %>
  <div class="alert alert-danger alert-dismissible fade show">
    <%= flash[:alert] %>
    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
  </div>
<% end %>

<%# ── 上傳區 ── %>
<div class="row g-3 mb-4">
  <div class="col-md-6">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body">
        <h6 class="fw-bold mb-3">
          <i class="fal fa-upload mr-1 text-primary"></i> 上傳 Chloe 受眾 CSV
        </h6>
        <p class="text-muted small mb-3">ManyChat → Contacts → Bulk Actions → Export IG Custom Audience</p>
        <%= form_with url: manychat_audience_upload_path, multipart: true, local: true do |f| %>
          <%= f.hidden_field :account_type, value: 'chloe' %>
          <div class="custom-file mb-2">
            <%= f.file_field :csv_file, class: "custom-file-input", accept: ".csv", id: "chloe_csv" %>
            <label class="custom-file-label" for="chloe_csv">選擇 CSV 檔案…</label>
          </div>
          <%= f.submit "上傳 Chloe", class: "btn btn-primary btn-sm mt-2 w-100" %>
        <% end %>
        <% if @chloe_snapshots.any? %>
          <hr class="my-3">
          <p class="text-muted small mb-1">歷史快照</p>
          <% @chloe_snapshots.each do |s| %>
            <div class="d-flex justify-content-between small py-1 border-bottom">
              <span><%= s.created_at.strftime('%Y/%m/%d %H:%M') %></span>
              <span class="text-muted"><%= number_with_delimiter(s.iguid_count) %> 筆</span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body">
        <h6 class="fw-bold mb-3">
          <i class="fal fa-upload mr-1 text-success"></i> 上傳苼莛官方受眾 CSV
        </h6>
        <p class="text-muted small mb-3">ManyChat → 切換至苼莛帳號 → Contacts → Bulk Actions → Export IG Custom Audience</p>
        <%= form_with url: manychat_audience_upload_path, multipart: true, local: true do |f| %>
          <%= f.hidden_field :account_type, value: 'official' %>
          <div class="custom-file mb-2">
            <%= f.file_field :csv_file, class: "custom-file-input", accept: ".csv", id: "official_csv" %>
            <label class="custom-file-label" for="official_csv">選擇 CSV 檔案…</label>
          </div>
          <%= f.submit "上傳苼莛官方", class: "btn btn-success btn-sm mt-2 w-100" %>
        <% end %>
        <% if @official_snapshots.any? %>
          <hr class="my-3">
          <p class="text-muted small mb-1">歷史快照</p>
          <% @official_snapshots.each do |s| %>
            <div class="d-flex justify-content-between small py-1 border-bottom">
              <span><%= s.created_at.strftime('%Y/%m/%d %H:%M') %></span>
              <span class="text-muted"><%= number_with_delimiter(s.iguid_count) %> 筆</span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%# ── 比對結果 ── %>
<% if @selected_chloe && @selected_official %>
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-bottom-0 pt-3">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h6 class="fw-bold mb-0">比對結果</h6>
        <div class="d-flex gap-2 align-items-center small text-muted">
          <span>Chloe：<strong><%= @selected_chloe.created_at.strftime('%Y/%m/%d') %></strong></span>
          <span class="mx-1">vs</span>
          <span>苼莛：<strong><%= @selected_official.created_at.strftime('%Y/%m/%d') %></strong></span>
        </div>
      </div>

      <%# 快照選擇器 %>
      <% if @chloe_snapshots.size > 1 || @official_snapshots.size > 1 %>
        <%= form_with url: manychat_audience_path, method: :get, local: true, class: "mt-3" do |f| %>
          <div class="row g-2">
            <div class="col-auto">
              <label class="col-form-label col-form-label-sm">Chloe 快照</label>
            </div>
            <div class="col-auto">
              <%= f.select :chloe_snapshot_id,
                    @chloe_snapshots.map { |s| ["#{s.created_at.strftime('%Y/%m/%d')} (#{number_with_delimiter(s.iguid_count)}筆)", s.id] },
                    { selected: @selected_chloe.id },
                    class: "form-control form-control-sm" %>
            </div>
            <div class="col-auto">
              <label class="col-form-label col-form-label-sm">苼莛快照</label>
            </div>
            <div class="col-auto">
              <%= f.select :official_snapshot_id,
                    @official_snapshots.map { |s| ["#{s.created_at.strftime('%Y/%m/%d')} (#{number_with_delimiter(s.iguid_count)}筆)", s.id] },
                    { selected: @selected_official.id },
                    class: "form-control form-control-sm" %>
            </div>
            <%= f.submit "更新比對", class: "btn btn-outline-secondary btn-sm" %>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="card-body">
      <div class="row text-center g-3 mb-4">
        <div class="col-md-3">
          <div class="p-3 bg-light rounded">
            <div class="h3 fw-bold text-primary mb-0"><%= number_with_delimiter(@selected_official.iguid_count) %></div>
            <div class="small text-muted mt-1">苼莛官方受眾</div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="p-3 bg-light rounded">
            <div class="h3 fw-bold text-secondary mb-0"><%= number_with_delimiter(@selected_chloe.iguid_count) %></div>
            <div class="small text-muted mt-1">Chloe 受眾</div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="p-3 bg-light rounded">
            <div class="h3 fw-bold text-muted mb-0"><%= number_with_delimiter(@overlap_count) %></div>
            <div class="small text-muted mt-1">兩邊都有</div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="p-3 rounded" style="background: #fff3cd;">
            <div class="h3 fw-bold mb-0" style="color: #856404;"><%= number_with_delimiter(@only_official_count) %></div>
            <div class="small mt-1" style="color: #856404;">只在苼莛（目標受眾）</div>
          </div>
        </div>
      </div>

      <div class="alert alert-info mb-4">
        <i class="fal fa-info-circle mr-1"></i>
        <strong><%= number_with_delimiter(@only_official_count) %> 人</strong>曾與苼莛官方互動，但尚未與 Chloe 互動——可作為廣告再行銷或 DM 推薦目標。
      </div>

      <div class="d-flex gap-2">
        <%= link_to manychat_audience_export_path(
              chloe_snapshot_id: @selected_chloe.id,
              official_snapshot_id: @selected_official.id),
              class: "btn btn-warning" do %>
          <i class="fal fa-download mr-1"></i> 下載目標受眾 CSV（Meta Ads 用）
        <% end %>
      </div>
      <p class="text-muted small mt-2 mb-0">下載的 CSV 可直接上傳至 Meta 廣告管理員 → 自訂廣告受眾 → 顧客名單。</p>
    </div>
  </div>
<% elsif @chloe_snapshots.empty? || @official_snapshots.empty? %>
  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
      <i class="fal fa-chart-bar fa-3x text-muted mb-3 d-block"></i>
      <p class="text-muted">請先上傳兩個帳號的 CSV 才能進行比對。</p>
    </div>
  </div>
<% end %>

<% content_for :scripts_block do %>
<script>
document.querySelectorAll('.custom-file-input').forEach(function(input) {
  input.addEventListener('change', function() {
    var label = this.nextElementSibling;
    label.textContent = this.files[0] ? this.files[0].name : '選擇 CSV 檔案…';
  });
});
</script>
<% end %>
