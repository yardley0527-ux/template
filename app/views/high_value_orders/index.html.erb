<%# app/views/high_value_orders/index.html.erb %>
<% content_for :page_title, "破8000訂單速覽" %>

<% def ig_link_url(account)
  return nil if account.blank?
  handle = account.strip.gsub(/^@/, '').gsub(%r{https?://(?:www\.)?instagram\.com/?}, '').gsub(%r{/$}, '').strip
  handle.present? ? "https://www.instagram.com/#{handle}/" : nil
end %>

<%# Header %>
<div class="row g-3 mb-3">
  <div class="col-12 d-flex align-items-center justify-content-between flex-wrap" style="gap:12px;">
    <div>
      <h4 class="fw-bold mb-0">破8000訂單速覽</h4>
      <p class="text-muted small mb-0">單筆訂單 ≥ NT$8,000，依卡別分群</p>
    </div>
    <div class="btn-group" role="group">
      <% [['yesterday','昨日'], ['week','本週'], ['month','本月']].each do |val, label| %>
        <%= link_to label,
              high_value_orders_path(period: val, tab: @tab, level: @level, series_filter: @series_filter),
              class: "btn btn-sm #{@specific_month.blank? && @period == val ? 'btn-dark' : 'btn-outline-secondary'}" %>
      <% end %>
    </div>
  </div>
  <div class="col-12">
    <%= form_tag high_value_orders_path, method: :get, class: "d-flex align-items-center flex-wrap", style: "gap:10px;" do %>
      <%= hidden_field_tag :tab, @tab %>
      <%= hidden_field_tag :level, @level %>
      <div class="d-flex align-items-center" style="gap:6px;">
        <label class="text-muted small mb-0" style="white-space:nowrap;">月份</label>
        <select name="specific_month" class="form-control form-control-sm" style="width:auto;">
          <option value="">— 快速篩選 —</option>
          <% 24.times.map { |i| i.months.ago.beginning_of_month }.each do |m| %>
            <option value="<%= m.strftime('%Y-%m') %>" <%= @specific_month == m.strftime('%Y-%m') ? 'selected' : '' %>>
              <%= m.strftime('%Y 年 %m 月') %>
            </option>
          <% end %>
        </select>
      </div>
      <button type="submit" class="btn btn-sm btn-primary">篩選</button>
      <% if @series_filter.present? || @specific_month.present? %>
        <%= link_to "清除", high_value_orders_path(period: @period, tab: @tab, level: @level), class: "btn btn-sm btn-outline-secondary" %>
      <% end %>
    <% end %>
  </div>
</div>

<%# 新客／舊客 tabs %>
<ul class="nav nav-tabs mb-3" style="font-size:0.9rem;">
  <li class="nav-item">
    <%= link_to "新客（#{@new_count}）",
          high_value_orders_path(period: @period, tab: 'new', series_filter: @series_filter, specific_month: @specific_month),
          class: "nav-link #{@tab == 'new' ? 'active fw-bold' : 'text-muted'}" %>
  </li>
  <li class="nav-item">
    <%= link_to "舊客（#{@old_count}）",
          high_value_orders_path(period: @period, tab: 'old', level: @level == '新客' ? nil : @level, series_filter: @series_filter, specific_month: @specific_month),
          class: "nav-link #{@tab == 'old' ? 'active fw-bold' : 'text-muted'}" %>
  </li>
</ul>

<% if @tab == 'old' %>
  <%# Level tabs %>
  <ul class="nav nav-tabs mb-3" style="font-size:0.9rem;">
    <% @levels.each do |lvl| %>
      <% cnt = @tab_counts[lvl] || 0 %>
      <li class="nav-item">
        <%= link_to "#{lvl}（#{cnt}）",
              high_value_orders_path(period: @period, tab: 'old', level: lvl, series_filter: @series_filter, specific_month: @specific_month),
              class: "nav-link #{@level == lvl ? 'active fw-bold' : 'text-muted'}" %>
      </li>
    <% end %>
  </ul>
<% end %>

<%# Table %>
<% display_orders = @paged_orders %>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0 table-responsive">
    <table class="table align-middle mb-0" style="font-size:0.86rem;">
      <thead style="background-color:#4a4a4a; color:white;">
        <tr>
          <th class="ps-3" style="width:70px;">日期</th>
          <th>姓名</th>
          <th style="width:70px;">卡別</th>
          <th>訂單號碼</th>
          <th class="text-end" style="width:110px;">消費金額</th>
          <th>購買商品</th>
          <th style="width:160px;">IG</th>
          <th>Email</th>
          <% if @level == '新客' %>
            <th style="width:90px;" class="text-center">贈品已送</th>
          <% else %>
            <th style="width:190px;">贈品紀錄</th>
            <th style="width:90px;" class="text-center">贈品已送</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% display_orders.each do |o| %>
          <% url = ig_link_url(o.ig_account) %>
          <tr>
            <td class="ps-3 text-nowrap text-muted"><%= o.ord_date&.strftime("%-m/%-d") %></td>
            <td class="fw-semibold"><%= o.cust_name %></td>
            <td>
              <% badge_bg, badge_fg = case o.membership_level_col
                                    when '黑卡' then ['#333', '#fff']
                                    when '金卡' then ['#b8860b', '#fff']
                                    when '銀卡' then ['#6c757d', '#fff']
                                    when '白卡' then ['#dee2e6', '#333']
                                    else             ['#adb5bd', '#333']
                                    end %>
              <span class="badge" style="background:<%= badge_bg %>; color:<%= badge_fg %>; font-size:0.75rem;"><%= o.membership_level_col %></span>
              <% if @level == '新客' %>
                <span class="badge bg-warning text-dark ms-1" style="font-size:0.72rem;">首購</span>
              <% end %>
            </td>
            <td class="text-muted small"><%= o.order_num %></td>
            <td class="text-end fw-bold text-danger">
              NT$<%= number_with_delimiter(o.order_total.to_i) %>
            </td>
            <td style="max-width:360px;">
              <div class="d-flex flex-wrap" style="gap:4px;">
                <% (o.products_list || '').split('、').each do |item| %>
                  <% color = hvo_series_color(item) %>
                  <span style="display:inline-block; background:<%= color %>20; color:<%= color %>; border:1px solid <%= color %>55; border-radius:4px; padding:1px 7px; font-size:0.78rem; white-space:nowrap; font-weight:600;"><%= item %></span>
                <% end %>
              </div>
            </td>
            <td>
              <% if url %>
                <%= link_to url, target: "_blank", class: "text-decoration-none d-flex align-items-center gap-1" do %>
                  <i class="fal fa-at text-danger"></i>
                  <span style="font-size:0.8rem; max-width:130px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:inline-block;">
                    <%= o.ig_account&.sub(/^@/, '') %>
                  </span>
                <% end %>
              <% else %>
                <span class="text-muted small">—</span>
              <% end %>
            </td>
            <td class="text-muted small" style="max-width:180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
              <%= o.email_val.presence || '—' %>
            </td>
            <% gift = @gift_records[o.order_num] %>
            <% if @level == '新客' %>
              <td class="text-center">
                <input type="checkbox"
                  class="gift-sent-checkbox"
                  data-order="<%= o.order_num %>"
                  data-url="<%= upsert_order_gift_record_path %>"
                  <%= gift&.gift_sent? ? 'checked' : '' %>
                  style="width:18px; height:18px; cursor:pointer; accent-color:#c00;">
              </td>
            <% else %>
              <td>
                <select class="form-control form-control-sm gift-note-input"
                  data-order="<%= o.order_num %>"
                  data-url="<%= upsert_order_gift_record_path %>"
                  style="font-size:0.8rem;">
                  <option value="">— 選擇贈品 —</option>
                  <% @series_options.each do |s| %>
                    <option value="<%= s %>" <%= gift&.gift_note == s ? 'selected' : '' %>><%= s %></option>
                  <% end %>
                </select>
              </td>
              <td class="text-center">
                <input type="checkbox"
                  class="gift-sent-checkbox"
                  data-order="<%= o.order_num %>"
                  data-url="<%= upsert_order_gift_record_path %>"
                  <%= gift&.gift_sent? ? 'checked' : '' %>
                  style="width:18px; height:18px; cursor:pointer; accent-color:#c00;">
              </td>
            <% end %>
          </tr>
        <% end %>
        <% if @orders.empty? %>
          <tr>
            <td colspan="<%= @level == '新客' ? 9 : 10 %>" class="text-center py-5 text-muted">
              <i class="fal fa-inbox fa-2x mb-2 d-block opacity-25"></i>
              此期間無單筆 ≥ NT$8,000 的訂單
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% if @total_count > 0 %>
  <div class="d-flex align-items-center justify-content-between flex-wrap mt-2 px-1" style="gap:8px;">
    <div class="text-muted small">
      共 <%= @total_count %> 筆 ｜ 合計 NT$<%= number_with_delimiter(@total_revenue.to_i) %>
      ｜ 第 <%= @page %> / <%= @total_pages %> 頁
    </div>
    <% if @total_pages > 1 %>
      <%
        window = ([@page - 2, 1].max)...([@page + 3, @total_pages + 1].min)
        page_nums = ([1] + window.to_a + [@total_pages]).uniq
      %>
      <nav>
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= @page == 1 ? 'disabled' : '' %>">
            <%= link_to "«".html_safe, high_value_orders_path(period: @period, tab: @tab, level: @level, series_filter: @series_filter, specific_month: @specific_month, page: @page - 1), class: "page-link" %>
          </li>
          <% prev_p = nil %>
          <% page_nums.each do |p| %>
            <% if prev_p && p > prev_p + 1 %>
              <li class="page-item disabled"><span class="page-link">…</span></li>
            <% end %>
            <li class="page-item <%= p == @page ? 'active' : '' %>">
              <%= link_to p, high_value_orders_path(period: @period, tab: @tab, level: @level, series_filter: @series_filter, specific_month: @specific_month, page: p), class: "page-link" %>
            </li>
            <% prev_p = p %>
          <% end %>
          <li class="page-item <%= @page == @total_pages ? 'disabled' : '' %>">
            <%= link_to "»".html_safe, high_value_orders_path(period: @period, tab: @tab, level: @level, series_filter: @series_filter, specific_month: @specific_month, page: @page + 1), class: "page-link" %>
          </li>
        </ul>
      </nav>
    <% end %>
  </div>
<% end %>

<% content_for :scripts_block do %>
<script>
(function() {
  var CSRF = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

  function upsert(orderNum, url, data) {
    fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
      body: JSON.stringify({ order_number: orderNum, order_gift_record: data })
    });
  }

  function flashTip(td, text, color) {
    var old = td.querySelector('.cb-saved-tip');
    if (old) old.remove();
    var tip = document.createElement('div');
    tip.className = 'cb-saved-tip';
    tip.textContent = text;
    tip.style.cssText = 'font-size:0.72rem; color:' + color + '; margin-top:2px; font-weight:600;';
    td.appendChild(tip);
    setTimeout(function() { tip.remove(); }, 2000);
  }

  // 贈品已送：checkbox 打勾（新客／舊客共用）
  document.querySelectorAll('.gift-sent-checkbox').forEach(function(cb) {
    cb.addEventListener('change', function() {
      var td = cb.closest('td');
      upsert(cb.dataset.order, cb.dataset.url, { gift_sent: cb.checked });
      cb.closest('tr').style.background = cb.checked ? '#f0fff4' : '';
      flashTip(td, cb.checked ? '✓ 已送出' : '已取消', cb.checked ? '#28a745' : '#999');
    });
    if (cb.checked) cb.closest('tr').style.background = '#f0fff4';
  });

  // 贈品紀錄：select 一改變就自動存檔
  document.querySelectorAll('.gift-note-input').forEach(function(sel) {
    sel.addEventListener('change', function() {
      var td = sel.closest('td');
      sel.style.borderColor = sel.value ? '#28a745' : '#ccc';
      upsert(sel.dataset.order, sel.dataset.url, { gift_note: sel.value });
      flashTip(td, sel.value ? '✓ 已更新' : '已清除', sel.value ? '#28a745' : '#999');
    });
    if (sel.value) sel.style.borderColor = '#28a745';
  });
})();
</script>
<% end %>
