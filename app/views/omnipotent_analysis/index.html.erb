<%# app/views/omnipotent_analysis/index.html.erb %>
<% content_for :page_title, "全能直播分析" %>
<% level_keys = OmnipotentAnalysisController::LEVEL_KEYS %>

<%# 標題 + 場次切換 %>
<div class="row g-3 mb-4">
  <div class="col-12 d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
      <h4 class="fw-bold mb-0">全能直播分析 — <%= @event_label %></h4>
      <p class="text-muted small mb-0">本場購買情況與交叉推薦名單</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <% @all_omni_events.each do |ev| %>
        <% label = "#{ev[:year]}/#{ev[:label]}" %>
        <% active = ev[:date] == @current_event[:date] %>
        <%= link_to label,
              omnipotent_analysis_path(event: ev[:date].to_s),
              class: "btn btn-sm #{active ? 'btn-secondary' : 'btn-outline-secondary'}" %>
      <% end %>
    </div>
  </div>
</div>

<%# 3 個數字卡 %>
<div class="row g-3 mb-5">
  <div class="col-md-4">
    <div class="card border-0 shadow-sm text-center py-4">
      <div class="text-muted mb-2">本場買全能人數</div>
      <div class="fw-bold text-primary" style="font-size: 2rem; line-height: 1;"><%= @event_emails.size %></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card border-0 shadow-sm text-center py-4">
      <div class="text-muted mb-2">曾購買過（本場前）</div>
      <div class="fw-bold" style="font-size: 2rem; line-height: 1; color: #495057;"><%= @prev_count %></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card border-0 shadow-sm text-center py-4">
      <div class="text-muted mb-2">舊客回流率</div>
      <div class="fw-bold text-success" style="font-size: 2rem; line-height: 1;"><%= @prev_return_rate %>%</div>
      <div class="text-muted small mt-1"><%= @prev_returned_count %> / <%= @prev_count %> 人</div>
    </div>
  </div>
</div>

<%# 本場購買名單 %>
<% if @event_customers.any? %>
  <div class="d-flex align-items-center mb-3">
    <div class="border-start border-3 border-success ps-3">
      <h5 class="fw-bold mb-0 text-success">本場購買名單</h5>
      <p class="text-muted small mb-0"><%= @event_label %> 全能買家</p>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-5">
    <div class="card-header text-white d-flex justify-content-between align-items-center"
         style="background-color: #2d5a3d;">
      <span class="fw-bold">本場購買名單</span>
      <span class="badge bg-white text-dark"><%= @event_customers.size %> 人</span>
    </div>

    <div class="px-3 pt-2 border-bottom">
      <ul class="nav nav-tabs" id="tabs-event">
        <% OmnipotentAnalysisController::TARGET_MEMBERSHIPS.each do |level| %>
          <% key = level_keys[level] %>
          <% next if @event_customers.none? { |r| r[:customer].membership_level == level } %>
          <li class="nav-item">
            <button class="nav-link"
                    data-tab-prefix="event"
                    data-tab-target="event-<%= key %>"
                    type="button">
              <%= level %>
              <span class="badge bg-secondary">
                <%= @event_customers.count { |r| r[:customer].membership_level == level } %>
              </span>
            </button>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="card-body p-0">
      <% OmnipotentAnalysisController::TARGET_MEMBERSHIPS.each do |level| %>
        <% key  = level_keys[level] %>
        <% rows = @event_customers.select { |r| r[:customer].membership_level == level } %>
        <% next if rows.empty? %>
        <div class="invite-pane" id="pane-event-<%= key %>" style="display: none;">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
              <thead class="table-light">
                <tr>
                  <th>姓名</th>
                  <th>卡別</th>
                  <th>購買品項</th>
                  <th>瓶數</th>
                  <th>本次金額</th>
                  <th>整體消費力</th>
                  <th>電話</th>
                  <th>IG</th>
                </tr>
              </thead>
              <tbody>
                <% rows.each do |r| %>
                  <% c = r[:customer] %>
                  <tr>
                    <td><%= link_to c.full_name, customer_path(c.id), target: "_blank", class: "fw-semibold text-decoration-none" %></td>
                    <td><span class="text-muted small"><%= c.membership_level %></span></td>
                    <td><%= r[:last_product] || "-" %></td>
                    <td class="text-center"><%= r[:bottles] %> 瓶</td>
                    <td>NT$<%= number_with_delimiter(r[:order_amount].to_i) %></td>
                    <td class="fw-semibold">NT$<%= number_with_delimiter(r[:total_spend].to_i) %></td>
                    <td>
                      <% if c.mobile_phone.present? %>
                        <a href="tel:<%= c.mobile_phone %>" class="text-decoration-none text-muted small">
                          📞 <%= c.mobile_phone %>
                        </a>
                      <% end %>
                    </td>
                    <td>
                      <% if c.instagram_account.present? %>
                        <a href="https://instagram.com/<%= c.instagram_account.gsub('@','') %>" target="_blank" class="text-decoration-none">
                          📷 <%= c.instagram_account %>
                        </a>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%# 美白交叉推薦名單 %>
<% if @whitening_cross_buyers&.any? %>
  <div class="d-flex align-items-center mb-3">
    <div class="border-start border-3 ps-3" style="border-color: #c084fc;">
      <h5 class="fw-bold mb-0" style="color: #7e22ce;">💄 美白交叉推薦名單</h5>
      <p class="text-muted small mb-0">曾在全能直播同場購買美白，但之後未再回購的黑金卡客人，適合推「買全能送美白」優惠</p>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-5">
    <div class="card-header text-white d-flex justify-content-between align-items-center"
         style="background-color: #6b21a8;">
      <span class="fw-bold">美白交叉推薦名單</span>
      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-white text-dark"><%= @whitening_cross_buyers.size %> 人</span>
        <%= link_to "⬇ 匯出 CSV", omnipotent_export_whitening_path, class: "btn btn-sm btn-light fw-semibold" %>
      </div>
    </div>

    <div class="px-3 pt-2 border-bottom">
      <ul class="nav nav-tabs" id="tabs-whitening">
        <% %w[黑卡 金卡].each do |level| %>
          <% next if @whitening_cross_buyers.none? { |r| r[:customer].membership_level == level } %>
          <li class="nav-item">
            <button class="nav-link"
                    data-tab-prefix="whitening"
                    data-tab-target="whitening-<%= OmnipotentAnalysisController::LEVEL_KEYS[level] %>"
                    type="button">
              <%= level %>
              <span class="badge bg-secondary">
                <%= @whitening_cross_buyers.count { |r| r[:customer].membership_level == level } %>
              </span>
            </button>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="card-body p-0">
      <% %w[黑卡 金卡].each do |level| %>
        <% key  = OmnipotentAnalysisController::LEVEL_KEYS[level] %>
        <% rows = @whitening_cross_buyers.select { |r| r[:customer].membership_level == level } %>
        <% next if rows.empty? %>
        <div class="invite-pane" id="pane-whitening-<%= key %>" style="display: none;">
          <div class="table-responsive" data-paginate="true" data-page-size="20">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
              <thead class="table-light">
                <tr>
                  <th>#</th>
                  <th>姓名</th>
                  <th>卡別</th>
                  <th>全能參與場次</th>
                  <th>整體消費力</th>
                  <th>電話</th>
                  <th>IG</th>
                </tr>
              </thead>
              <tbody>
                <% rows.each_with_index do |r, i| %>
                  <% c = r[:customer] %>
                  <tr>
                    <td>
                      <span class="badge <%= i < 3 ? 'bg-danger' : i < 8 ? 'bg-warning text-dark' : 'bg-light text-dark' %>">
                        #<%= i + 1 %>
                      </span>
                    </td>
                    <td><%= link_to c.full_name, customer_path(c.id), target: "_blank", class: "fw-semibold text-decoration-none" %></td>
                    <td><span class="text-muted small"><%= c.membership_level %></span></td>
                    <td class="text-center text-muted"><%= r[:omni_count] %> 場</td>
                    <td class="fw-semibold">NT$<%= number_with_delimiter(c.total_amount.to_i) %></td>
                    <td>
                      <% if c.mobile_phone.present? %>
                        <a href="tel:<%= c.mobile_phone %>" class="text-decoration-none text-muted small">
                          📞 <%= c.mobile_phone %>
                        </a>
                      <% end %>
                    </td>
                    <td>
                      <% if c.instagram_account.present? %>
                        <a href="https://instagram.com/<%= c.instagram_account.gsub('@','') %>" target="_blank" class="text-decoration-none">
                          📷 <%= c.instagram_account %>
                        </a>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('[id^="tabs-"]').forEach(function (tabGroup) {
    const firstBtn = tabGroup.querySelector('.nav-link');
    if (firstBtn) activateTab(firstBtn);
  });
});

function activateTab(btn) {
  const prefix   = btn.dataset.tabPrefix;
  const targetId = btn.dataset.tabTarget;

  document.querySelectorAll(`[id^="pane-${prefix}-"]`).forEach(function (p) {
    p.style.display = 'none';
  });
  document.querySelectorAll(`#tabs-${prefix} .nav-link`).forEach(function (b) {
    b.classList.remove('active');
  });

  const target = document.getElementById('pane-' + targetId);
  if (target) {
    target.style.display = 'block';
    target.querySelectorAll('[data-paginate="true"]').forEach(function (wrapper) {
      if (!wrapper.dataset.paginated) initPaginate(wrapper);
    });
  }
  btn.classList.add('active');
}

document.addEventListener('click', function (e) {
  const btn = e.target.closest('[data-tab-target]');
  if (btn) activateTab(btn);
});

function initPaginate(wrapper) {
  wrapper.dataset.paginated = 'true';
  const pageSize = parseInt(wrapper.dataset.pageSize) || 20;
  const tbody    = wrapper.querySelector('tbody');
  if (!tbody) return;
  const allRows  = Array.from(tbody.querySelectorAll('tr'));
  if (allRows.length <= pageSize) return;
  const totalPages = Math.ceil(allRows.length / pageSize);
  const pane       = wrapper.closest('.invite-pane') || wrapper.parentNode;

  function renderPage(page) {
    allRows.forEach(function (row, i) {
      row.style.display = (i >= (page-1)*pageSize && i < page*pageSize) ? '' : 'none';
    });
    const old = pane.querySelector('.paginate-controls');
    if (old) old.remove();
    const ctrl = document.createElement('div');
    ctrl.className = 'paginate-controls d-flex justify-content-between align-items-center px-3 py-2 border-top bg-light';
    ctrl.style.fontSize = '0.85rem';
    const info = document.createElement('span');
    info.className = 'text-muted';
    info.textContent = `第 ${(page-1)*pageSize+1}–${Math.min(page*pageSize,allRows.length)} 筆，共 ${allRows.length} 筆`;
    const btns = document.createElement('div');
    btns.className = 'd-flex gap-1 flex-wrap';
    const prev = document.createElement('button');
    prev.className = 'btn btn-sm btn-outline-secondary py-0';
    prev.textContent = '‹'; prev.disabled = page===1;
    prev.addEventListener('click', function(){renderPage(page-1);});
    btns.appendChild(prev);
    const sp=Math.max(1,page-2), ep=Math.min(totalPages,sp+4);
    for(let p=sp;p<=ep;p++){
      const pb=document.createElement('button');
      pb.className='btn btn-sm py-0 '+(p===page?'btn-secondary':'btn-outline-secondary');
      pb.textContent=p; const cp=p;
      pb.addEventListener('click',function(){renderPage(cp);});
      btns.appendChild(pb);
    }
    const next=document.createElement('button');
    next.className='btn btn-sm btn-outline-secondary py-0';
    next.textContent='›'; next.disabled=page===totalPages;
    next.addEventListener('click',function(){renderPage(page+1);});
    btns.appendChild(next);
    ctrl.appendChild(info); ctrl.appendChild(btns); pane.appendChild(ctrl);
  }
  renderPage(1);
}
</script>
