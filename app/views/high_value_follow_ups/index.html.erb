<%# app/views/high_value_follow_ups/index.html.erb %>
<% content_for :page_title, "待追蹤名單" %>

<% def ig_link_url(account)
  return nil if account.blank?
  handle = account.strip.gsub(/^@/, '').gsub(%r{https?://(?:www\.)?instagram\.com/?}, '').gsub(%r{/$}, '').strip
  handle.present? ? "https://www.instagram.com/#{handle}/" : nil
end %>

<%# Header %>
<div class="row g-3 mb-3">
  <div class="col-12 d-flex align-items-center justify-content-between flex-wrap" style="gap:12px;">
    <div>
      <h4 class="fw-bold mb-0">舊客首購產品追蹤</h4>
      <p class="text-muted small mb-0">破8000舊客訂單中含首次購買產品，依卡別分群</p>
    </div>
    <div class="d-flex align-items-center flex-wrap" style="gap:8px;">
      <%= form_tag high_value_follow_ups_path, method: :get, class: "d-flex align-items-center flex-wrap", style: "gap:8px;" do %>
        <%= hidden_field_tag :status, @status %>
        <input type="date" name="start_date" value="<%= @start_date&.strftime('%Y-%m-%d') %>" class="form-control form-control-sm">
        <span class="text-muted small">至</span>
        <input type="date" name="end_date" value="<%= @end_date&.strftime('%Y-%m-%d') %>" class="form-control form-control-sm">
        <button type="submit" class="btn btn-sm btn-primary">查詢</button>
        <%= link_to "清除", high_value_follow_ups_path(status: @status), class: "btn btn-sm btn-outline-secondary" %>
      <% end %>
    </div>
  </div>
</div>

<div class="d-flex flex-wrap mb-3" style="gap:10px;">
  <div class="d-flex align-items-center px-3 py-2" style="background:#fff; border:1px solid #e9e2d8; border-left:4px solid #8f6340; border-radius:10px; gap:10px; box-shadow:0 1px 2px rgba(78,51,32,.05); min-width:160px;">
    <div class="d-flex align-items-center justify-content-center" style="width:34px; height:34px; border-radius:8px; background:#f4ece2; flex-shrink:0;">
      <i class="fal fa-user-clock" style="color:#8f6340; font-size:1rem;"></i>
    </div>
    <div>
      <div class="text-muted" style="font-size:0.75rem;">待追蹤</div>
      <div class="fw-bold" style="font-size:1.05rem; color:#2f2a24;"><%= @total_count %> 人</div>
    </div>
  </div>
  <% pending_alert = @pending_count > 0 %>
  <div class="d-flex align-items-center px-3 py-2" style="background:<%= pending_alert ? '#fdf1ef' : '#fff' %>; border:1px solid <%= pending_alert ? '#f3cdc7' : '#e9e2d8' %>; border-left:4px solid <%= pending_alert ? '#d03b3b' : '#188038' %>; border-radius:10px; gap:10px; box-shadow:0 1px 2px rgba(78,51,32,.05); min-width:160px;">
    <div class="d-flex align-items-center justify-content-center" style="width:34px; height:34px; border-radius:8px; background:<%= pending_alert ? '#fbe0dc' : '#e8f4ea' %>; flex-shrink:0;">
      <i class="fal <%= pending_alert ? 'fa-exclamation-circle' : 'fa-check-circle' %>" style="color:<%= pending_alert ? '#d03b3b' : '#188038' %>; font-size:1rem;"></i>
    </div>
    <div>
      <div class="text-muted" style="font-size:0.75rem;">未處理（沒填備註）</div>
      <div class="fw-bold" style="font-size:1.05rem; color:<%= pending_alert ? '#d03b3b' : '#188038' %>;">
        <%= pending_alert ? "#{@pending_count} 人" : "✓ 全部處理完" %>
      </div>
    </div>
  </div>
</div>

<%# 全部／未處理／已處理 篩選 %>
<ul class="nav nav-tabs mb-3" style="font-size:0.9rem;">
  <li class="nav-item">
    <%= link_to "全部（#{@total_count}）",
          high_value_follow_ups_path(status: 'all', start_date: params[:start_date], end_date: params[:end_date]),
          class: "nav-link #{@status == 'all' ? 'active fw-bold' : 'text-muted'}" %>
  </li>
  <li class="nav-item">
    <%= link_to "未處理（#{@pending_count}）",
          high_value_follow_ups_path(status: 'pending', start_date: params[:start_date], end_date: params[:end_date]),
          class: "nav-link #{@status == 'pending' ? 'active fw-bold' : 'text-muted'}" %>
  </li>
  <li class="nav-item">
    <%= link_to "已處理（#{@done_count}）",
          high_value_follow_ups_path(status: 'done', start_date: params[:start_date], end_date: params[:end_date]),
          class: "nav-link #{@status == 'done' ? 'active fw-bold' : 'text-muted'}" %>
  </li>
</ul>

<%# 依卡別分成多組，全部往下疊在同一頁 %>
<% @groups.each do |label, rows| %>
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white d-flex align-items-center" style="gap:8px;">
      <span class="fw-bold"><%= label %></span>
      <span class="badge bg-secondary"><%= rows.size %></span>
    </div>
    <div class="card-body p-0 table-responsive">
      <table class="table align-middle mb-0" style="font-size:0.86rem;">
        <thead style="background-color:#4a4a4a; color:white;">
          <tr>
            <th class="ps-3" style="width:60px;">日期</th>
            <th style="width:110px;">姓名</th>
            <th style="width:150px;">IG</th>
            <th style="width:80px;">卡別</th>
            <th class="text-end" style="width:100px;">消費金額</th>
            <th>是否購買過同產品</th>
            <th style="width:34%;">追蹤備註</th>
          </tr>
        </thead>
        <tbody>
          <% rows.each do |o| %>
            <% url = ig_link_url(o.ig_account) %>
            <% gift = @gift_records[o.order_num] %>
            <tr style="<%= gift&.follow_up_note.blank? ? 'background:#fffbe6;' : '' %>">
              <td class="ps-3 text-nowrap text-muted"><%= o.ord_date&.strftime("%-m/%-d") %></td>
              <td class="fw-semibold">
                <% if o.shopline_customer_id %>
                  <%= link_to o.cust_name, customer_path(o.shopline_customer_id), target: "_blank", class: "text-decoration-none" %>
                <% else %>
                  <%= o.cust_name %>
                <% end %>
              </td>
              <td>
                <% if url %>
                  <%= link_to url, target: "_blank", class: "text-decoration-none d-flex align-items-center gap-1" do %>
                    <i class="fal fa-at text-danger"></i>
                    <span style="font-size:0.8rem; max-width:130px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:inline-block;">
                      <%= o.ig_account&.sub(/^@/, '') %>
                    </span>
                  <% end %>
                <% else %>
                  <span class="text-muted small">—</span>
                <% end %>
              </td>
              <td>
                <% badge_bg, badge_fg = case o.membership_level_col
                                      when '黑卡' then ['#333', '#fff']
                                      when '金卡' then ['#b8860b', '#fff']
                                      when '銀卡' then ['#6c757d', '#fff']
                                      when '白卡' then ['#dee2e6', '#333']
                                      else             ['#adb5bd', '#333']
                                      end %>
                <span class="badge" style="background:<%= badge_bg %>; color:<%= badge_fg %>; font-size:0.75rem;"><%= o.membership_level_col %></span>
              </td>
              <td class="text-end fw-bold text-danger">
                NT$<%= number_with_delimiter(o.order_total.to_i) %>
              </td>
              <td style="max-width:360px;">
                <% (@products_by_order[o.order_num] || []).each do |p| %>
                  <div style="font-size:0.78rem;">
                    <% if p[:prior_date] %>
                      <span class="text-success">✓</span> <%= p[:name] %>（<%= p[:prior_date].strftime('%Y/%m/%d') %>）
                    <% else %>
                      <span class="text-muted">　</span> <%= p[:name] %>（首次購買）
                    <% end %>
                  </div>
                <% end %>
              </td>
              <td class="py-2">
                <textarea
                  class="form-control form-control-sm follow-up-note-input"
                  data-order="<%= o.order_num %>"
                  data-url="<%= upsert_order_gift_record_path %>"
                  rows="3"
                  placeholder="可輸入多行備註，點到其他地方自動存檔"
                  style="font-size:0.82rem; min-height:72px; resize:vertical;"><%= gift&.follow_up_note %></textarea>
              </td>
            </tr>
          <% end %>
          <% if rows.empty? %>
            <tr>
              <td colspan="7" class="text-center py-5 text-muted">
                <i class="fal fa-inbox fa-2x mb-2 d-block opacity-25"></i>
                此期間無含首次購買產品的舊客訂單
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<% content_for :scripts_block do %>
<script>
(function() {
  var CSRF = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

  function upsert(orderNum, url, data) {
    return fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
      body: JSON.stringify({ order_number: orderNum, order_gift_record: data })
    });
  }

  function flashTip(td, text, color) {
    var old = td.querySelector('.cb-saved-tip');
    if (old) old.remove();
    var tip = document.createElement('div');
    tip.className = 'cb-saved-tip';
    tip.textContent = text;
    tip.style.cssText = 'font-size:0.72rem; color:' + color + '; margin-top:2px; font-weight:600;';
    td.appendChild(tip);
    setTimeout(function() { tip.remove(); }, 2000);
  }

  // 追蹤備註：離開欄位即自動存檔（Enter 為換行）
  document.querySelectorAll('.follow-up-note-input').forEach(function(input) {
    var saved = input.value;
    function save() {
      if (input.value === saved) return;
      upsert(input.dataset.order, input.dataset.url, { follow_up_note: input.value }).then(function(r) {
        var td = input.closest('td');
        if (r.ok) {
          saved = input.value;
          input.style.borderColor = input.value ? '#28a745' : '#ccc';
          input.closest('tr').style.background = input.value ? '' : '#fffbe6';
          flashTip(td, input.value ? '✓ 已存檔' : '已清除', input.value ? '#28a745' : '#999');
        } else {
          flashTip(td, '存檔失敗，請再試一次', '#dc3545');
        }
      });
    }
    input.addEventListener('blur', save);
    if (input.value) input.style.borderColor = '#28a745';
  });
})();
</script>
<% end %>
