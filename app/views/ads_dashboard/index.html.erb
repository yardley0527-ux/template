<%# app/views/ads_dashboard/index.html.erb %>
<% content_for :page_title, "廣告成效面板" %>

<%
  def fmt_num(n); n ? number_with_delimiter(n.to_i) : "—"; end
%>

<%# ── Header ── %>
<div class="row g-3 mb-3">
  <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <h4 class="fw-bold mb-0">廣告成效面板</h4>
      <p class="text-muted small mb-0"><%= @ads_data['product'] %> · <%= @ads_data['company'] %></p>
    </div>
    <span class="text-muted small">上次更新：<%= @ads_data['last_updated'] || '尚無資料' %></span>
  </div>
</div>

<%# ── 今日總覽 ── %>
<p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">今日總覽</p>
<div class="row g-3 mb-4">
  <div class="col-md-3 col-6">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted small mb-1">今日總花費</div>
        <div class="fw-bold" style="font-size:1.8rem;line-height:1">NT$<%= fmt_num(@total_spend) %></div>
        <div class="text-muted small mt-1">日預算 NT$<%= fmt_num(@total_budget) %>（已消耗 <%= @total_budget > 0 ? (@total_spend / @total_budget * 100).round(0).to_i : 0 %>%）</div>
      </div>
    </div>
  </div>
  <div class="col-md-3 col-6">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted small mb-1">總曝光次數</div>
        <div class="fw-bold" style="font-size:1.8rem;line-height:1"><%= fmt_num(@total_impressions) %></div>
        <div class="text-muted small mt-1">所有廣告組合計</div>
      </div>
    </div>
  </div>
  <div class="col-md-3 col-6">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted small mb-1">平均 CTR</div>
        <div class="fw-bold <%= @avg_ctr && @avg_ctr >= 3 ? 'text-success' : '' %>" style="font-size:1.8rem;line-height:1">
          <%= @avg_ctr ? "#{@avg_ctr.round(2)}%" : "—" %>
        </div>
        <div class="text-muted small mt-1">台灣均值約 1–2%</div>
      </div>
    </div>
  </div>
  <div class="col-md-3 col-6">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted small mb-1">平均 CPM</div>
        <div class="fw-bold" style="font-size:1.8rem;line-height:1"><%= @avg_cpm ? "NT$#{@avg_cpm.round(0).to_i}" : "—" %></div>
        <div class="text-muted small mt-1">正常範圍 NT$120–250</div>
      </div>
    </div>
  </div>
</div>

<%# ── 廣告組成效 ── %>
<p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">廣告組成效（投放中）</p>
<div class="row g-3 mb-4">
  <% @active_campaigns.each do |c| %>
    <%
      sorted_days = (c['daily_data'] || []).sort_by { |d| d['date'] }
      l = sorted_days.last
      p = sorted_days.length >= 2 ? sorted_days[-2] : nil
      status_class = c['status'] == 'ACTIVE' ? 'badge-success' : 'badge-secondary'
      status_label = c['status'] == 'ACTIVE' ? '投放中' : '已暫停'
      date_range = sorted_days.any? ? (sorted_days.size == 1 ? sorted_days.first['date'][5..] : "#{sorted_days.first['date'][5..]} ~ #{sorted_days.last['date'][5..]}") : nil
    %>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
              <div class="fw-bold" style="font-size:1rem"><%= c['name'] %></div>
              <div class="text-muted small"><%= c['objective'] %></div>
              <% if date_range %>
                <div class="text-muted" style="font-size:11px">資料區間：<%= date_range %></div>
              <% end %>
            </div>
            <div class="text-right">
              <span class="badge <%= status_class %>"><%= status_label %></span>
              <div class="text-muted small mt-1">日預算 <strong>NT$<%= fmt_num(c['daily_budget']) %></strong></div>
            </div>
          </div>

          <% if l %>
            <%
              spend_rate = (l['spend'].to_f / c['daily_budget'].to_f * 100).round(0).to_i
              completion = (l['video_3s'].to_f > 0 && l['video_100'].to_f > 0) ? (l['video_100'].to_f / l['video_3s'].to_f * 100).round(1) : nil

              def change_badge(cur, prev, lower_better: false)
                return '' unless prev && cur
                diff = cur.to_f - prev.to_f
                return '' if diff == 0
                good = lower_better ? diff < 0 : diff > 0
                color = good ? 'text-success' : 'text-danger'
                arrow = diff > 0 ? '▲' : '▼'
                "<small class='#{color}'>#{arrow} #{diff.abs.round(2)}</small>"
              end
            %>
            <div class="row g-2">
              <% [
                  { label: '曝光次數',   value: fmt_num(l['impressions']), extra: change_badge(l['impressions'], p&.dig('impressions')) },
                  { label: 'CTR',        value: l['ctr'] ? "#{l['ctr']}%" : '—', extra: change_badge(l['ctr'], p&.dig('ctr')) },
                  { label: 'CPM',        value: l['cpm'] ? "NT$#{l['cpm'].to_i}" : '—', extra: change_badge(l['cpm'], p&.dig('cpm'), lower_better: true) },
                  { label: '觸及人數',   value: fmt_num(l['reach']), extra: '' },
                  { label: '花費',       value: "NT$#{fmt_num(l['spend'])}", extra: "<small class='text-muted'>預算消耗 #{spend_rate}%</small>" },
                  { label: '影片看完率', value: completion ? "#{completion}%" : (l['video_100'] ? "#{fmt_num(l['video_100'])} 人" : '—'), extra: '' }
                ].each do |m| %>
                <div class="col-4">
                  <div class="bg-light rounded p-2">
                    <div class="text-muted" style="font-size:11px"><%= m[:label] %></div>
                    <div class="fw-bold" style="font-size:1.1rem"><%= m[:value] %></div>
                    <%= raw m[:extra] %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-4 text-muted">
              <div style="font-size:2rem">⏳</div>
              <div class="small mt-1">廣告剛開始，數據準備中</div>
            </div>
          <% end %>

          <% if c['creative'] %>
            <div class="mt-3 pt-3 border-top">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                  <div class="fw-bold small">📹 <%= c['creative']['label'] %></div>
                  <div class="text-muted" style="font-size:11px"><%= c['creative']['type'] %></div>
                </div>
                <a href="<%= c['creative']['ig_post_url'] %>" target="_blank" class="btn btn-outline-primary btn-xs" style="font-size:11px;padding:2px 8px">開啟 IG →</a>
              </div>
              <div class="rounded overflow-hidden border">
                <iframe src="<%= c['creative']['ig_embed_url'] %>" scrolling="no"
                        allowtransparency="true" loading="lazy"
                        style="display:block;width:100%;min-height:460px;border:none"></iframe>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<%# ── 已封存廣告 ── %>
<% if @archived_campaigns.any? %>
  <div class="mb-4">
    <a class="text-uppercase text-muted small fw-bold letter-spacing-1 d-flex align-items-center gap-2 text-decoration-none"
       data-toggle="collapse" href="#archivedCampaigns" role="button" aria-expanded="false">
      <span>已封存廣告（<%= @archived_campaigns.size %>）</span>
      <span class="small">▼</span>
    </a>
    <div class="collapse" id="archivedCampaigns">
      <div class="row g-3 mt-1">
        <% @archived_campaigns.each do |c| %>
          <%
            sorted_days = (c['daily_data'] || []).sort_by { |d| d['date'] }
            l = sorted_days.last
            p = sorted_days.length >= 2 ? sorted_days[-2] : nil
            date_range = sorted_days.any? ? (sorted_days.size == 1 ? sorted_days.first['date'][5..] : "#{sorted_days.first['date'][5..]} ~ #{sorted_days.last['date'][5..]}") : nil
          %>
          <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100" style="opacity:0.65">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                  <div>
                    <div class="fw-bold" style="font-size:1rem"><%= c['name'] %></div>
                    <div class="text-muted small"><%= c['objective'] %></div>
                    <% if date_range %>
                      <div class="text-muted" style="font-size:11px">資料區間：<%= date_range %></div>
                    <% end %>
                  </div>
                  <div class="text-right">
                    <span class="badge badge-secondary">已暫停</span>
                    <div class="text-muted small mt-1">日預算 <strong>NT$<%= fmt_num(c['daily_budget']) %></strong></div>
                  </div>
                </div>
                <% if l %>
                  <%
                    spend_rate = (l['spend'].to_f / c['daily_budget'].to_f * 100).round(0).to_i
                    completion = (l['video_3s'].to_f > 0 && l['video_100'].to_f > 0) ? (l['video_100'].to_f / l['video_3s'].to_f * 100).round(1) : nil
                  %>
                  <div class="row g-2">
                    <% [
                        { label: '曝光次數',   value: fmt_num(l['impressions']), extra: '' },
                        { label: 'CTR',        value: l['ctr'] ? "#{l['ctr']}%" : '—', extra: '' },
                        { label: 'CPM',        value: l['cpm'] ? "NT$#{l['cpm'].to_i}" : '—', extra: '' },
                        { label: '觸及人數',   value: fmt_num(l['reach']), extra: '' },
                        { label: '花費',       value: "NT$#{fmt_num(l['spend'])}", extra: "<small class='text-muted'>預算消耗 #{spend_rate}%</small>" },
                        { label: '影片看完率', value: completion ? "#{completion}%" : (l['video_100'] ? "#{fmt_num(l['video_100'])} 人" : '—'), extra: '' }
                      ].each do |m| %>
                      <div class="col-4">
                        <div class="bg-light rounded p-2">
                          <div class="text-muted" style="font-size:11px"><%= m[:label] %></div>
                          <div class="fw-bold" style="font-size:1.1rem"><%= m[:value] %></div>
                          <%= raw m[:extra] %>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% else %>
                  <div class="text-center py-4 text-muted">
                    <div class="small mt-1">無數據</div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<%# ── 趨勢分析 ── %>
<p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">趨勢分析</p>
<div class="row g-3 mb-4">
  <div class="col-md-8">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="fw-bold mb-3">CTR 與 CPM 趨勢 <small class="text-muted fw-normal">（互動組）</small></div>
        <canvas id="trendChart" height="100"></canvas>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="fw-bold mb-3">影片觀看漏斗 <small class="text-muted fw-normal">（互動組最新）</small></div>
        <div id="funnelContainer"></div>
      </div>
    </div>
  </div>
</div>

<%# ── 優化建議 ── %>
<p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">優化建議</p>
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <% if @suggestions.empty? %>
      <div class="text-center py-4 text-muted">暫無建議，請等待數據累積</div>
    <% else %>
      <% @suggestions.each_with_index do |s, i| %>
        <div class="d-flex gap-3 <%= i < @suggestions.size - 1 ? 'pb-3 mb-3 border-bottom' : '' %>">
          <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
               style="width:38px;height:38px;font-size:18px;background:<%= s[:type] == 'good' ? '#e8f5e9' : s[:type] == 'warn' ? '#fff8e1' : s[:type] == 'bad' ? '#ffebee' : '#e3f2fd' %>">
            <%= s[:icon] %>
          </div>
          <div>
            <div class="fw-bold small"><%= s[:title] %></div>
            <div class="text-muted small mt-1"><%= s[:desc] %></div>
            <% if s[:action] %>
              <div class="text-primary small mt-1 fw-bold"><%= s[:action] %></div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<%# ── JavaScript ── %>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // ── Trend Chart ──
  const engagementData = <%= raw @campaigns.find { |c| c['name'].include?('互動') }&.then { |c|
    sorted = (c['daily_data'] || []).sort_by { |d| d['date'] }
    { labels: sorted.map { |d| d['date'][5..] }, ctr: sorted.map { |d| d['ctr'] }, cpm: sorted.map { |d| d['cpm'] } }.to_json
  } || '{"labels":[],"ctr":[],"cpm":[]}' %>;

  const trendCtx = document.getElementById('trendChart');
  if (trendCtx && engagementData.labels.length >= 2) {
    new Chart(trendCtx, {
      type: 'line',
      data: {
        labels: engagementData.labels,
        datasets: [
          {
            label: 'CTR (%)',
            data: engagementData.ctr,
            borderColor: '#1877F2',
            backgroundColor: 'rgba(24,119,242,0.08)',
            yAxisID: 'y',
            tension: 0.3,
            fill: true,
            pointRadius: 5,
            pointBackgroundColor: '#1877F2'
          },
          {
            label: 'CPM (NT$)',
            data: engagementData.cpm,
            borderColor: '#f5a623',
            backgroundColor: 'transparent',
            yAxisID: 'y1',
            tension: 0.3,
            pointRadius: 5,
            pointBackgroundColor: '#f5a623'
          }
        ]
      },
      options: {
        responsive: true,
        interaction: { mode: 'index', intersect: false },
        scales: {
          y:  { type: 'linear', position: 'left',  title: { display: true, text: 'CTR (%)' } },
          y1: { type: 'linear', position: 'right', title: { display: true, text: 'CPM (NT$)' }, grid: { drawOnChartArea: false } }
        },
        plugins: { legend: { position: 'bottom' } }
      }
    });
  } else if (trendCtx) {
    trendCtx.parentElement.innerHTML += '<p class="text-muted small text-center py-3">數據點不足，累積更多天後顯示趨勢</p>';
    trendCtx.style.display = 'none';
  }

  // ── Funnel ──
  const funnelCampaign = <%= raw @campaigns.find { |c| c['name'].include?('互動') }&.then { |c|
    fd = (c['daily_data'] || []).sort_by { |d| d['date'] }.reverse.find { |d| d['video_3s'] && d['video_100'] }
    fd ? { date: fd['date'], impressions: fd['impressions'], video_3s: fd['video_3s'], video_25: fd['video_25'], video_50: fd['video_50'], video_75: fd['video_75'], video_100: fd['video_100'] }.to_json : 'null'
  } || 'null' %>;

  const funnelEl = document.getElementById('funnelContainer');
  if (funnelEl && funnelCampaign) {
    const base = funnelCampaign.impressions;
    const steps = [
      { label: '曝光',     value: funnelCampaign.impressions, color: '#1877F2' },
      { label: '3 秒播放', value: funnelCampaign.video_3s,    color: '#3b5fc2' },
      { label: '看到 25%', value: funnelCampaign.video_25,    color: '#5578d2' },
      { label: '看到 50%', value: funnelCampaign.video_50,    color: '#7091e2' },
      { label: '看到 75%', value: funnelCampaign.video_75,    color: '#8aabf2' },
      { label: '看完 100%',value: funnelCampaign.video_100,   color: '#a4c4ff' },
    ].filter(s => s.value != null);

    funnelEl.innerHTML = steps.map(s => {
      const pct = (s.value / base * 100).toFixed(1);
      return `
        <div class="mb-2">
          <div class="d-flex justify-content-between mb-1" style="font-size:12px">
            <span class="text-muted">${s.label}</span>
            <span>${s.value.toLocaleString()}（${pct}%）</span>
          </div>
          <div class="bg-light rounded" style="height:18px;overflow:hidden">
            <div style="width:${pct}%;height:100%;background:${s.color};border-radius:4px"></div>
          </div>
        </div>`;
    }).join('') + `<div class="text-muted mt-2" style="font-size:11px">數據日期：${funnelCampaign.date}</div>`;
  } else if (funnelEl) {
    funnelEl.innerHTML = '<p class="text-muted small text-center py-3">漏斗數據準備中</p>';
  }
});
</script>
