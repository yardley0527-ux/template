<%# app/views/black_gold_customers/index.html.erb %>
<% content_for :page_title, "黑金卡消費備註" %>

<% def bg_ig_link_url(account)
  return nil if account.blank?
  handle = account.strip.gsub(/^@/, '').gsub(%r{https?://(?:www\.)?instagram\.com/?}, '').gsub(%r{/$}, '').strip
  handle.present? ? "https://www.instagram.com/#{handle}/" : nil
end %>

<% content_for :head_block do %>
<style>
  /* 手機版把表格改成一人一張卡，避免要左右滑一堆欄位才看得到內容 */
  @media (max-width: 767.98px) {
    .bg-table thead { display: none; }
    .bg-table, .bg-table tbody, .bg-table tr, .bg-table td { display: block; width: 100%; }
    .bg-table tr {
      border: 1px solid #e9e2d8;
      border-radius: 10px;
      margin: 10px;
      padding: 10px 12px;
      width: auto;
    }
    .bg-table td {
      padding: 8px 0;
      border: none;
      border-bottom: 1px solid #f1ede6;
    }
    .bg-table td:last-child { border-bottom: none; }
    .bg-table td[data-label]::before {
      content: attr(data-label);
      display: block;
      font-size: 0.68rem;
      font-weight: 700;
      color: #9a9186;
      letter-spacing: .02em;
      margin-bottom: 4px;
    }
    .bg-table .bg-truncate {
      max-width: none !important;
      white-space: normal !important;
      overflow: visible !important;
      text-overflow: unset !important;
    }
  }
</style>
<% end %>

<%# Header %>
<div class="row g-3 mb-3">
  <div class="col-12 d-flex align-items-center justify-content-between flex-wrap" style="gap:12px;">
    <div>
      <h4 class="fw-bold mb-0">黑金卡消費備註</h4>
      <p class="text-muted small mb-0">昨日／本週／本月回來消費的黑卡、金卡客人，這次跟上次比金額多還少、間隔多久，異常的自動標「特別注意」</p>
    </div>
  </div>
</div>

<%# 統計卡 %>
<div class="d-flex flex-wrap mb-3" style="gap:10px;">
  <div class="d-flex align-items-center px-3 py-2" style="background:#fff; border:1px solid #e9e2d8; border-left:4px solid #8f6340; border-radius:10px; gap:10px; box-shadow:0 1px 2px rgba(78,51,32,.05); min-width:160px;">
    <div class="d-flex align-items-center justify-content-center" style="width:34px; height:34px; border-radius:8px; background:#f4ece2; flex-shrink:0;">
      <i class="fal fa-crown" style="color:#8f6340; font-size:1rem;"></i>
    </div>
    <div>
      <div class="text-muted" style="font-size:0.75rem;">回購人數</div>
      <div class="fw-bold" style="font-size:1.05rem; color:#2f2a24;"><%= @groups.sum { |_, rows| rows.size } %> 人</div>
    </div>
  </div>
  <% attention_alert = @attention_count > 0 %>
  <div class="d-flex align-items-center px-3 py-2" style="background:<%= attention_alert ? '#fdf1ef' : '#fff' %>; border:1px solid <%= attention_alert ? '#f3cdc7' : '#e9e2d8' %>; border-left:4px solid <%= attention_alert ? '#d03b3b' : '#188038' %>; border-radius:10px; gap:10px; box-shadow:0 1px 2px rgba(78,51,32,.05); min-width:160px;">
    <div class="d-flex align-items-center justify-content-center" style="width:34px; height:34px; border-radius:8px; background:<%= attention_alert ? '#fbe0dc' : '#e8f4ea' %>; flex-shrink:0;">
      <i class="fal <%= attention_alert ? 'fa-exclamation-circle' : 'fa-check-circle' %>" style="color:<%= attention_alert ? '#d03b3b' : '#188038' %>; font-size:1rem;"></i>
    </div>
    <div>
      <div class="text-muted" style="font-size:0.75rem;">需要特別注意</div>
      <div class="fw-bold" style="font-size:1.05rem; color:<%= attention_alert ? '#d03b3b' : '#188038' %>;">
        <%= attention_alert ? "#{@attention_count} 人" : "✓ 沒有異常" %>
      </div>
    </div>
  </div>
</div>

<%# 本日／本週／本月 篩選 %>
<ul class="nav nav-tabs mb-3" style="font-size:0.9rem;">
  <li class="nav-item">
    <%= link_to "昨日（#{@counts['today']}）",
          black_gold_customers_path(period: 'today'),
          class: "nav-link #{@period == 'today' ? 'active fw-bold' : 'text-muted'}" %>
  </li>
  <li class="nav-item">
    <%= link_to "本週（#{@counts['week']}）",
          black_gold_customers_path(period: 'week'),
          class: "nav-link #{@period == 'week' ? 'active fw-bold' : 'text-muted'}" %>
  </li>
  <li class="nav-item">
    <%= link_to "本月（#{@counts['month']}）",
          black_gold_customers_path(period: 'month'),
          class: "nav-link #{@period == 'month' ? 'active fw-bold' : 'text-muted'}" %>
  </li>
</ul>

<p class="text-muted small mb-3">特別注意判定：金額比上次少一半以上（消費下滑），或距上次購買 <%= BlackGoldCustomersController::LONG_GAP_DAYS %> 天以上（間隔拉長）</p>

<%# 依卡別分組，組內依本次購買日新到舊排序，全部往下疊在同一頁 %>
<% @groups.each do |level, rows| %>
  <% badge_bg, badge_fg = level == '黑卡' ? ['#333', '#fff'] : ['#b8860b', '#fff'] %>
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white d-flex align-items-center" style="gap:8px;">
      <span class="badge" style="background:<%= badge_bg %>; color:<%= badge_fg %>; font-size:0.8rem;"><%= level %></span>
      <span class="badge bg-secondary"><%= rows.size %> 人</span>
    </div>
    <div class="card-body p-0 table-responsive">
      <table class="table align-middle mb-0 bg-table" style="font-size:0.86rem;">
        <thead style="background-color:#4a4a4a; color:white;">
          <tr>
            <th class="ps-3" style="width:110px;">姓名</th>
            <th class="text-center" style="width:70px;">已追蹤</th>
            <th style="width:140px;">IG</th>
            <th style="width:20%;">本次購買</th>
            <th style="width:100px;">上次購買</th>
            <th style="width:90px;">回購間隔</th>
            <th style="width:130px;">金額變化</th>
            <th style="width:110px;">特別注意</th>
            <th style="width:26%;">AI 觀察與建議</th>
          </tr>
        </thead>
        <tbody>
          <% rows.each do |r| %>
            <% url = bg_ig_link_url(r.ig_account) %>
            <% profile = r.profile %>
            <tr style="<%= r.needs_attention? ? 'background:#fdf1ef;' : (profile&.black_gold_followed_up? ? '' : 'background:#fffbe6;') %>">
              <td class="ps-3 fw-semibold" data-label="姓名">
                <%= link_to r.full_name, customer_path(r.shopline_customer_id), target: "_blank", class: "text-decoration-none" %>
              </td>
              <td class="text-center" data-label="已追蹤">
                <% if current_user.admin? %>
                  <input type="checkbox"
                    class="bg-followed-checkbox"
                    data-customer-id="<%= r.shopline_customer_id %>"
                    data-url="<%= toggle_black_gold_followed_up_path %>"
                    <%= profile&.black_gold_followed_up? ? 'checked' : '' %>
                    style="width:18px; height:18px; cursor:pointer; accent-color:#8f6340;">
                <% elsif profile&.black_gold_followed_up? %>
                  <span class="text-success fw-bold">✓</span>
                <% else %>
                  <span class="text-muted small">—</span>
                <% end %>
              </td>
              <td data-label="IG">
                <% if url %>
                  <%= link_to url, target: "_blank", class: "text-decoration-none d-flex align-items-center gap-1" do %>
                    <i class="fal fa-at text-danger"></i>
                    <span class="bg-truncate" style="font-size:0.8rem; max-width:120px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:inline-block;">
                      <%= r.ig_account&.sub(/^@/, '') %>
                    </span>
                  <% end %>
                <% else %>
                  <span class="text-muted small">—</span>
                <% end %>
              </td>
              <td data-label="本次購買">
                <div style="font-size:0.8rem;">
                  <div class="fw-semibold"><%= r.current_date.strftime('%Y/%m/%d') %>・NT$<%= number_with_delimiter(r.current_amount.to_i) %></div>
                  <div class="text-muted bg-truncate" style="font-size:0.75rem; max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= r.current_products %></div>
                </div>
              </td>
              <td class="text-nowrap" data-label="上次購買">
                <% if r.previous_date %>
                  <div style="font-size:0.8rem;"><%= r.previous_date.strftime('%Y/%m/%d') %></div>
                  <div class="text-muted" style="font-size:0.75rem;">NT$<%= number_with_delimiter(r.previous_amount.to_i) %></div>
                <% else %>
                  <span class="badge bg-light text-dark border" style="font-size:0.72rem;">首次消費</span>
                <% end %>
              </td>
              <td class="text-nowrap" data-label="回購間隔">
                <% if r.interval_days %>
                  <span class="<%= r.long_gap? ? 'text-danger fw-bold' : '' %>"><%= r.interval_days %> 天</span>
                <% else %>
                  <span class="text-muted small">—</span>
                <% end %>
              </td>
              <td class="text-nowrap" data-label="金額變化">
                <% if r.amount_diff %>
                  <% up = r.amount_diff > 0 %>
                  <span class="<%= r.dropped? ? 'text-danger fw-bold' : (up ? 'text-success fw-bold' : '') %>">
                    <%= up ? '▲' : (r.amount_diff < 0 ? '▼' : '—') %>
                    NT$<%= number_with_delimiter(r.amount_diff.abs.to_i) %>
                    <% if r.amount_change_ratio %>
                      <span style="font-size:0.72rem;">(<%= up ? '+' : '' %><%= number_to_percentage(r.amount_change_ratio * 100, precision: 0) %>)</span>
                    <% end %>
                  </span>
                <% else %>
                  <span class="text-muted small">—</span>
                <% end %>
              </td>
              <td data-label="特別注意">
                <% if r.dropped? %>
                  <span class="badge" style="background:#d03b3b; color:#fff; font-size:0.72rem;">消費下滑</span>
                <% end %>
                <% if r.long_gap? %>
                  <span class="badge" style="background:#d98a1a; color:#fff; font-size:0.72rem;">間隔拉長</span>
                <% end %>
                <% unless r.needs_attention? || r.first_time? %>
                  <span class="text-muted small">—</span>
                <% end %>
              </td>
              <td class="ai-cell py-2" data-customer-id="<%= r.shopline_customer_id %>" data-label="AI 觀察與建議">
                <% if r.ai_fresh? %>
                  <%= render "black_gold_customers/ai_result", profile: profile %>
                <% elsif r.needs_attention? %>
                  <div class="ai-auto-pending text-muted" style="font-size:0.76rem;" data-customer-id="<%= r.shopline_customer_id %>">
                    <i class="fal fa-spinner fa-spin"></i> AI 分析中…
                  </div>
                <% else %>
                  <button type="button" class="btn btn-sm btn-outline-secondary ai-trigger-btn" style="font-size:0.72rem;" data-customer-id="<%= r.shopline_customer_id %>">
                    <i class="fal fa-wand-magic-sparkles"></i> AI 分析
                  </button>
                <% end %>
              </td>
            </tr>
          <% end %>
          <% if rows.empty? %>
            <tr>
              <td colspan="9" class="text-center py-5 text-muted">
                <i class="fal fa-inbox fa-2x mb-2 d-block opacity-25"></i>
                這段期間沒有<%= level %>客人回購
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<% content_for :scripts_block do %>
<script>
(function() {
  var CSRF = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

  function flashTip(td, text, color) {
    var old = td.querySelector('.cb-saved-tip');
    if (old) old.remove();
    var tip = document.createElement('div');
    tip.className = 'cb-saved-tip';
    tip.textContent = text;
    tip.style.cssText = 'font-size:0.72rem; color:' + color + '; margin-top:2px; font-weight:600;';
    td.appendChild(tip);
    setTimeout(function() { tip.remove(); }, 2000);
  }

  // 已追蹤：checkbox 打勾即存檔（只有 Admin 看得到 checkbox，後端也會再擋一次）
  document.querySelectorAll('.bg-followed-checkbox').forEach(function(cb) {
    cb.addEventListener('change', function() {
      var td = cb.closest('td');
      fetch(cb.dataset.url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
        body: JSON.stringify({ customer_id: cb.dataset.customerId, value: cb.checked })
      }).then(function(r) {
        if (r.ok) {
          flashTip(td, cb.checked ? '✓ 已追蹤' : '已取消', cb.checked ? '#28a745' : '#999');
        } else {
          cb.checked = !cb.checked;
          flashTip(td, '更新失敗', '#dc3545');
        }
      });
    });
  });

  // AI 分析：特別注意的客人自動排隊分析（同時最多 2 個，避免一次打爆 API），
  // 其他客人由「AI 分析」按鈕手動觸發；分析完可點「重新分析」重跑
  var ANALYZE_URL = "<%= analyze_black_gold_customer_path %>";
  var CONCURRENCY = 2;

  function esc(s) {
    var d = document.createElement('div');
    d.textContent = s == null ? '' : s;
    return d.innerHTML;
  }

  function renderResult(cell, data) {
    if (data.ok) {
      var html = '';
      if (data.watch && data.watch.length) {
        html += '<div style="font-size:0.76rem; margin-bottom:3px;"><span class="fw-semibold text-danger">注意：</span>' + esc(data.watch.join('；')) + '</div>';
      }
      if (data.next_actions && data.next_actions.length) {
        html += '<div style="font-size:0.76rem;"><span class="fw-semibold text-success">下一步：</span>' + esc(data.next_actions.join('；')) + '</div>';
      }
      html += '<div class="text-muted" style="font-size:0.68rem; margin-top:3px;">AI 分析於 ' + esc(data.generated_at) + '・<a href="#" class="ai-reanalyze-link" data-customer-id="' + cell.dataset.customerId + '">重新分析</a></div>';
      cell.innerHTML = html;
    } else {
      cell.innerHTML = '<span class="text-danger small">分析失敗：' + esc(data.error || '未知錯誤') + '</span>';
    }
  }

  function runAnalyze(customerId, cell) {
    cell.innerHTML = '<div class="text-muted" style="font-size:0.76rem;"><i class="fal fa-spinner fa-spin"></i> AI 分析中…</div>';
    return fetch(ANALYZE_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
      body: JSON.stringify({ customer_id: customerId })
    }).then(function(r) { return r.json().then(function(data) { renderResult(cell, data); }); })
      .catch(function() { cell.innerHTML = '<span class="text-danger small">分析失敗，請再試一次</span>'; });
  }

  // 手動按鈕／重新分析連結（事件代理，含之後動態插入的「重新分析」連結）
  document.addEventListener('click', function(e) {
    var trigger = e.target.closest('.ai-trigger-btn, .ai-reanalyze-link');
    if (!trigger) return;
    e.preventDefault();
    var cell = trigger.closest('.ai-cell');
    runAnalyze(trigger.dataset.customerId, cell);
  });

  // 特別注意名單自動排隊分析
  var pending = Array.prototype.slice.call(document.querySelectorAll('.ai-auto-pending')).map(function(el) {
    return { customerId: el.dataset.customerId, cell: el.closest('.ai-cell') };
  });
  var active = 0;
  function pump() {
    while (active < CONCURRENCY && pending.length) {
      var item = pending.shift();
      active++;
      runAnalyze(item.customerId, item.cell).finally(function() {
        active--;
        pump();
      });
    }
  }
  pump();
})();
</script>
<% end %>
