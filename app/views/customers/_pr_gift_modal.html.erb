<%# 新增／修改共用的彈窗。gift 沒存過就是新增；產品名稱不在清單裡就當「其他」 %>
<% other_key = PrGiftsController::OTHER_PRODUCT %>
<% custom    = gift.persisted? && !products.include?(gift.product_name) %>
<% selected  = custom ? other_key : gift.product_name %>
<% options   = products.map { |p| [p, p, { "data-unit" => PrGift.default_unit_for(p) }] } +
               [["其他（自行輸入）", other_key]] %>

<div class="modal fade" id="<%= modal_id %>" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <%= form_with scope: :pr_gift,
            url: (gift.persisted? ? customer_pr_gift_path(customer, gift) : customer_pr_gifts_path(customer)),
            method: (gift.persisted? ? :patch : :post), local: true,
            html: { class: "pr-gift-form" } do |f| %>
        <div class="modal-header">
          <h5 class="modal-title"><%= title %></h5>
          <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
        </div>
        <div class="modal-body">
          <div class="form-group">
            <label>產品</label>
            <%= f.select :product_name, options_for_select(options, selected),
                  { include_blank: "選擇產品" }, { class: "form-control pr-gift-product", required: true } %>
            <%= f.text_field :product_other, value: (custom ? gift.product_name : nil), maxlength: 50,
                  placeholder: "輸入產品名稱", class: "form-control mt-2 pr-gift-other",
                  style: (custom ? nil : "display:none") %>
          </div>
          <div class="form-row">
            <div class="form-group col-6">
              <label>數量</label>
              <%= f.number_field :quantity, value: gift.quantity || 1, min: 1, max: 999, step: 1,
                    class: "form-control", required: true %>
            </div>
            <div class="form-group col-6">
              <label>單位</label>
              <%= f.select :unit, PrGift::UNITS, { selected: gift.unit }, { class: "form-control pr-gift-unit" } %>
            </div>
          </div>
          <div class="form-group">
            <label>日期</label>
            <%= f.date_field :given_on, value: gift.given_on || Date.current, class: "form-control", required: true %>
          </div>
          <div class="form-group mb-0">
            <label>備註（選填）</label>
            <%= f.text_field :note, value: gift.note, maxlength: 100, placeholder: "例如：試用、道歉補償", class: "form-control" %>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">取消</button>
          <button type="submit" class="btn btn-primary"><%= gift.persisted? ? "儲存" : "新增" %></button>
        </div>
      <% end %>
    </div>
  </div>
</div>
