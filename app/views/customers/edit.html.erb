<div class="customer-show">
  <div class="customer-header">
    <div class="back-link">
      <%= link_to "← 返回客戶頁面", customer_path(@customer), class: "btn-back" %>
    </div>

    <div class="customer-info-card">
      <div class="customer-avatar">
        <%= @customer.full_name&.first(1)&.upcase || "?" %>
      </div>
      <div class="customer-details">
        <h1><%= @customer.full_name.presence || "（無姓名）" %></h1>
        <div class="customer-meta">
          <span>
            <%= @edit_section == "health" ? "🩺 編輯健康資料" : "✏️ 編輯備註與培訓" %>
          </span>
        </div>
      </div>
    </div>
  </div>

  <section class="section">
    <h2 class="section-title">
      <%= @edit_section == "health" ? "🩺 健康資料" : "📝 備註與培訓" %>
    </h2>

    <%= form_with model: @profile, url: customer_path(@customer, section: @edit_section), method: :patch do |f| %>
      <div class="edit-card <%= @edit_section == 'health' ? 'edit-card-health' : '' %>">

        <% if @edit_section == "health" %>
          <div class="edit-field">
            <label class="edit-label">健康資料</label>
            <%= f.text_area :health_profile, rows: 12, class: "edit-textarea edit-textarea-health", placeholder: "輸入健康資料…" %>
          </div>

          <div class="edit-field">
            <label class="edit-label product-pref-label">🩺 健康標籤 — 點擊切換</label>

            <div class="product-tag-selector" id="health-tag-selector">
              <%= hidden_field_tag "customer_profile[health_tags][]", "" %>

              <div class="product-tag-list">
                <% @health_tag_options.each do |tag| %>
                  <% checked = @profile.health_tags.include?(tag) %>

                  <button
                    type="button"
                    class="product-tag-chip <%= 'is-selected' if checked %>"
                    data-tag-value="<%= tag %>">
                    <%= tag %>
                  </button>

                  <%= check_box_tag "customer_profile[health_tags][]",
                                    tag,
                                    checked,
                                    id: "customer_profile_health_tags_#{tag.parameterize}",
                                    class: "health-tag-checkbox d-none",
                                    data: { tag_value: tag } %>
                <% end %>
              </div>

              <div class="product-tag-selected">
                <span class="product-tag-selected-label">已選：</span>
                <span id="health-tag-summary">
                  <%= @profile.health_tags.present? ? @profile.health_tags.join("、") : "（尚未選擇）" %>
                </span>
              </div>
            </div>
          </div>
        <% else %>
          <div class="edit-field">
            <label class="edit-label">品牌大使培訓</label>
            <label class="toggle-wrap">
              <%= f.check_box :brand_ambassador_training, class: "toggle-input" %>
              <span class="toggle-track"><span class="toggle-thumb"></span></span>
              <span class="toggle-text">加入觀察名單</span>
            </label>
          </div>

          <div class="edit-field">
            <label class="edit-label">品牌大使黑名單</label>
            <label class="toggle-wrap">
              <%= f.check_box :brand_ambassador_blacklisted, class: "toggle-input toggle-input blacklist-toggle" %>
              <span class="toggle-track"><span class="toggle-thumb"></span></span>
              <span class="toggle-text" style="color:#ef4444;">列入黑名單</span>
            </label>
          </div>

          <div class="edit-field">
            <label class="edit-label">備註</label>
            <%= f.text_area :notes, rows: 6, class: "edit-textarea", placeholder: "輸入備註內容…" %>
          </div>

          <div class="edit-field">
            <label class="edit-label">回饋</label>
            <%= f.text_area :feedback, rows: 6, class: "edit-textarea", placeholder: "輸入客戶回饋…" %>
          </div>

          <div class="edit-field">
            <label class="edit-label">特別注意</label>
            <%= f.text_area :special_attention, rows: 6, class: "edit-textarea", placeholder: "輸入需要特別注意的事項…" %>
          </div>

          <div class="edit-field">
            <label class="edit-label product-pref-label">🏷 產品偏好 — 點擊切換</label>

            <div class="product-tag-selector" id="product-tag-selector">
              <%= hidden_field_tag "customer_profile[product_tags][]", "" %>

              <div class="product-tag-list">
                <% @product_tag_options.each do |tag| %>
                  <% checked = @profile.product_tags.include?(tag) %>

                  <button
                    type="button"
                    class="product-tag-chip <%= 'is-selected' if checked %>"
                    data-tag-value="<%= tag %>">
                    <%= tag %>
                  </button>

                  <%= check_box_tag "customer_profile[product_tags][]",
                                    tag,
                                    checked,
                                    id: "customer_profile_product_tags_#{tag.parameterize}",
                                    class: "product-tag-checkbox d-none",
                                    data: { tag_value: tag } %>
                <% end %>
              </div>

              <div class="product-tag-selected">
                <span class="product-tag-selected-label">已選：</span>
                <span id="product-tag-summary">
                  <%= @profile.product_tags.present? ? @profile.product_tags.join("、") : "（尚未選擇）" %>
                </span>
              </div>
            </div>
          </div>
        <% end %>

        <div class="edit-actions">
          <%= button_tag "儲存", type: "submit", class: "btn-save" %>
          <%= link_to "取消", customer_path(@customer), class: "btn-cancel" %>
        </div>

      </div>
    <% end %>
  </section>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    function bindTagSelector(selectorId, checkboxClass, summaryId) {
      var selector = document.getElementById(selectorId);
      if (!selector) return;

      var chips = selector.querySelectorAll(".product-tag-chip");
      var checkboxes = selector.querySelectorAll("." + checkboxClass);
      var summary = document.getElementById(summaryId);

      function syncTags() {
        var selected = [];

        checkboxes.forEach(function (checkbox) {
          var tag = checkbox.dataset.tagValue;
          var chip = selector.querySelector('.product-tag-chip[data-tag-value="' + tag + '"]');
          if (!chip) return;

          if (checkbox.checked) {
            chip.classList.add("is-selected");
            selected.push(tag);
          } else {
            chip.classList.remove("is-selected");
          }
        });

        if (summary) {
          summary.textContent = selected.length > 0 ? selected.join("、") : "（尚未選擇）";
        }
      }

      chips.forEach(function (chip) {
        chip.addEventListener("click", function () {
          var tag = chip.dataset.tagValue;
          var checkbox = selector.querySelector('.' + checkboxClass + '[data-tag-value="' + tag + '"]');
          if (!checkbox) return;

          checkbox.checked = !checkbox.checked;
          syncTags();
        });
      });

      syncTags();
    }

    bindTagSelector("product-tag-selector", "product-tag-checkbox", "product-tag-summary");
    bindTagSelector("health-tag-selector", "health-tag-checkbox", "health-tag-summary");
  });
</script>

<style>
  *, *::before, *::after { box-sizing: border-box; }

  .customer-show {
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px 16px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #1a1a2e;
    width: 100%;
  }

  .btn-back {
    display: inline-block;
    margin-bottom: 16px;
    color: #6366f1;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
  }
  .btn-back:hover { text-decoration: underline; }

  .customer-info-card {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 32px;
    box-shadow: 0 1px 4px rgba(0,0,0,.06);
  }

  .customer-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: #fff;
    font-size: 28px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .customer-details h1 {
    margin: 0 0 8px;
    font-size: 22px;
    font-weight: 700;
  }

  .customer-meta {
    font-size: 13px;
    color: #6b7280;
  }

  .section { margin-bottom: 40px; }

  .section-title {
    font-size: 17px;
    font-weight: 700;
    margin-bottom: 16px;
    color: #111827;
    padding-bottom: 8px;
    border-bottom: 2px solid #f3f4f6;
  }

  .edit-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 1px 4px rgba(0,0,0,.06);
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
    max-width: 1100px;
  }

  .edit-card-health {
    max-width: 1100px;
  }

  .edit-textarea-health {
    min-height: 600px;
  }

  .edit-field {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .edit-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #9ca3af;
  }

  .product-pref-label {
    font-size: 13px;
    color: #7c6f5b;
    text-transform: none;
    letter-spacing: 0;
    font-weight: 700;
  }

  .toggle-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    user-select: none;
  }

  .toggle-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .toggle-track {
    width: 44px;
    height: 24px;
    background: #e5e7eb;
    border-radius: 99px;
    position: relative;
    transition: background 0.2s;
    flex-shrink: 0;
  }

  .toggle-thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 1px 3px rgba(0,0,0,.2);
    transition: transform 0.2s;
  }

  .toggle-input:checked + .toggle-track { background: #6366f1; }
  .toggle-input:checked + .toggle-track .toggle-thumb { transform: translateX(20px); }

  .toggle-text {
    font-size: 14px;
    color: #374151;
    font-weight: 500;
  }

  .edit-textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    font-size: 14px;
    color: #374151;
    resize: vertical;
    font-family: inherit;
    line-height: 1.6;
    background: #fafafa;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .edit-textarea:focus {
    outline: none;
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99,102,241,.1);
    background: #fff;
  }

  .edit-actions {
    display: flex;
    gap: 10px;
    padding-top: 4px;
  }

  .btn-save {
    padding: 9px 24px;
    background: #6366f1;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;
  }
  .btn-save:hover { background: #4f52d3; }

  .btn-cancel {
    padding: 9px 18px;
    background: transparent;
    color: #6b7280;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: background 0.15s;
  }
  .btn-cancel:hover { background: #f9fafb; color: #374151; }

  .toggle-input.blacklist-toggle:checked + .toggle-track { background: #ef4444; }

  .product-tag-selector {
    width: 100%;
  }

  .product-tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 12px;
  }

  .product-tag-chip {
    appearance: none;
    border: 2px solid #b9b9b9;
    background: #fff;
    color: #333;
    border-radius: 999px;
    padding: 8px 16px;
    min-width: 0;
    text-align: center;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    cursor: pointer;
    transition: all 0.16s ease;
  }

  .product-tag-chip:hover {
    border-color: #8f8f8f;
  }

  .product-tag-chip.is-selected {
    background: #f6efe5;
    border-color: #9f7c4f;
    color: #6f532f;
  }

  .product-tag-selected {
    margin-top: 16px;
    font-size: 14px;
    color: #333;
  }

  .product-tag-selected-label {
    font-weight: 700;
    margin-right: 6px;
  }

  .d-none {
    display: none !important;
  }

  @media (max-width: 640px) {
    .customer-info-card {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 16px;
    }

    .customer-details h1 {
      font-size: 18px;
    }

    .edit-card {
      padding: 16px;
      gap: 18px;
    }

    .product-tag-list {
      gap: 10px 10px;
    }

    .product-tag-chip {
      font-size: 13px;
      padding: 8px 14px;
    }

    .edit-actions {
      flex-wrap: wrap;
    }
  }
</style>