                    <div class="progress" style="height: 8px;">
                      <div class="progress-bar" style="width: <%= max_lp > 0 ? (count / max_lp * 100).round : 0 %>%"></div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

