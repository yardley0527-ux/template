<div class="subheader">
  <h1 class="subheader-title">
    <i class="subheader-icon fal fa-chart-bar"></i>
    會員卡別統計
    <% total_members = @total_by_level.values.sum %>
    <small>
      Membership Stats ｜總會員數：<%= total_members %> 人
    </small>
  </h1>
  <div class="subheader-block">
    <%= link_to "← 回客人列表", customers_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>
</div>

<%= render "shared/data_freshness", updated_at: @customers_report_updated_at %>

<% levels = @membership_order.select { |l| @total_by_level[l].to_i > 0 } %>

<%# ── 新增會員數（今年 vs 去年） ── %>
<div class="row mb-4">
  <div class="col-12">
    <div class="panel">
      <div class="panel-hdr"><h2>🆕 新增會員數（<%= Date.current.year - 1 %> vs <%= Date.current.year %>）</h2></div>
      <div class="panel-container show">
        <div class="panel-content">
          <div class="row text-center mb-4">
            <div class="col-6 col-md-3 mb-3">
              <div class="text-muted small">去年（<%= Date.current.year - 1 %>）全年</div>
              <div class="h3 mb-0"><%= number_with_delimiter(@new_members_last_full_year) %> <small class="text-muted">人</small></div>
            </div>
            <div class="col-6 col-md-3 mb-3">
              <div class="text-muted small">去年 1/1–<%= Date.current.strftime("%-m/%-d") %>（同期）</div>
              <div class="h3 mb-0"><%= number_with_delimiter(@new_members_ytd_last_year) %> <small class="text-muted">人</small></div>
            </div>
            <div class="col-6 col-md-3 mb-3">
              <div class="text-muted small">今年 1/1–<%= Date.current.strftime("%-m/%-d") %>（至今）</div>
              <div class="h3 mb-0"><%= number_with_delimiter(@new_members_ytd_this_year) %> <small class="text-muted">人</small></div>
            </div>
            <div class="col-6 col-md-3 mb-3">
              <% pct = @new_members_ytd_last_year.positive? ? ((@new_members_ytd_this_year - @new_members_ytd_last_year) / @new_members_ytd_last_year.to_f * 100).round(1) : nil %>
              <div class="text-muted small">同期年增率</div>
              <div class="h3 mb-0 <%= pct && pct.negative? ? 'text-danger' : 'text-success' %>">
                <%= pct ? "#{pct.positive? ? '+' : ''}#{pct}%" : "—" %>
              </div>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table table-sm table-borderless mb-0">
              <thead>
                <tr class="text-muted small">
                  <th>月份</th>
                  <% @new_members_by_month.each { |row| %><th class="text-center"><%= row[:month] %> 月</th><% } %>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="text-muted small"><%= Date.current.year - 1 %></td>
                  <% @new_members_by_month.each { |row| %><td class="text-center"><%= row[:last_year] %></td><% } %>
                </tr>
                <tr>
                  <td class="text-muted small"><%= Date.current.year %></td>
                  <% @new_members_by_month.each do |row| %>
                    <td class="text-center <%= 'text-muted' if row[:month] > Date.current.month %>">
                      <%= row[:month] <= Date.current.month ? row[:this_year] : "—" %>
                    </td>
                  <% end %>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="small text-muted mt-2">依 Shopline 會員註冊時間（member_registered_at）計算，非下單日期。</div>
        </div>
      </div>
    </div>
  </div>
</div>

<%# ── 卡別人數趨勢（每日快照） ── %>
<div class="row mb-4">
  <div class="col-12">
    <div class="panel">
      <div class="panel-hdr"><h2>🪪 卡別人數趨勢（每日快照）</h2></div>
      <div class="panel-container show">
        <div class="panel-content">
          <% if @latest_snapshot.nil? %>
            <div class="text-muted">
              快照功能剛啟用（今天 <%= Date.current.strftime("%Y/%m/%d") %> 起每天自動記錄一次卡別人數），
              需要累積一段時間才能看出成長率 —— 明天起這裡就會開始出現「較昨天」的變化，
              滿一年後就能回答「今年 vs 去年」。
            </div>
          <% else %>
            <div class="small text-muted mb-3">最新快照日期：<%= @latest_snapshot.snapshot_date.strftime("%Y/%m/%d") %></div>
            <div class="table-responsive">
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th>卡別</th>
                    <th class="text-right">目前人數</th>
                    <th class="text-right">較 7 天前</th>
                    <th class="text-right">較 30 天前</th>
                    <th class="text-right">較去年同期</th>
                  </tr>
                </thead>
                <tbody>
                  <% @snapshot_levels.each do |level| %>
                    <% current = @latest_snapshot.count_for(level) %>
                    <tr>
                      <td><%= link_to level, customers_path(membership_level: level) %></td>
                      <td class="text-right fw-500"><%= number_with_delimiter(current) %></td>
                      <% [:d7, :d30, :y1].each do |key| %>
                        <% baseline = @snapshot_baselines[key] %>
                        <td class="text-right">
                          <% if baseline.nil? %>
                            <span class="text-muted">資料累積中</span>
                          <% else %>
                            <% diff = current - baseline.count_for(level) %>
                            <span class="<%= diff.positive? ? 'text-success' : (diff.negative? ? 'text-danger' : 'text-muted') %>">
                              <%= diff.positive? ? "+#{diff}" : diff %>
                            </span>
                          <% end %>
                        </td>
                      <% end %>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            <div class="small text-muted">
              比較基準日：7天前 <%= @snapshot_baselines[:d7]&.snapshot_date&.strftime("%Y/%m/%d") || "尚無資料" %>、
              30天前 <%= @snapshot_baselines[:d30]&.snapshot_date&.strftime("%Y/%m/%d") || "尚無資料" %>、
              去年同期 <%= @snapshot_baselines[:y1]&.snapshot_date&.strftime("%Y/%m/%d") || "尚無資料" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<%# ── 卡別成長人工對照（今年 vs 去年，暫時性，累積滿一年快照後可拿掉） ── %>
<% ref = @membership_manual_reference %>
<div class="row mb-4">
  <div class="col-12">
    <div class="panel">
      <div class="panel-hdr">
        <h2>📋 卡別成長對照：2025 全年 vs 2026 至今</h2>
      </div>
      <div class="panel-container show">
        <div class="panel-content">
          <div class="alert alert-warning small mb-4">
            <i class="fal fa-exclamation-triangle mr-1"></i>
            這個區塊是<b>人工整理的參考數字</b>，來源是使用者提供的 Shopline 後台儀表板截圖（截圖資料截至 <%= ref[:snapshot_at] %>，整理於 <%= ref[:updated_at] %>），
            不是本站資料庫即時查詢——上面的「每日快照」表格已經上線，累積滿一年後就能自動算出這裡的數字，屆時這個區塊會拿掉。
          </div>

          <h3 class="h6 fw-bold">新增會員數（SL 口徑：顧客累計數區間淨增）</h3>
          <div class="table-responsive mb-3">
            <table class="table table-sm table-bordered text-right">
              <thead class="thead-light">
                <tr>
                  <th class="text-left">區間</th><th>顧客（累計）</th><th>消費顧客</th><th>消費會員</th><th>未消費會員</th>
                </tr>
              </thead>
              <tbody>
                <% ref[:new_customers][:rows].each do |row| %>
                  <tr class="<%= 'font-weight-bold' if row[:is_delta] %>">
                    <td class="text-left"><%= row[:label] %></td>
                    <% [:customers, :paying_customers, :paying_members, :non_paying_members].each do |key| %>
                      <td class="<%= row[:is_delta] ? 'text-success' : '' %>">
                        <%= row[:is_delta] ? "+#{number_with_delimiter(row[key])}" : number_with_delimiter(row[key]) %>
                      </td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <div class="small text-muted mb-4">依 Shopline 會員註冊時間計算；2025/12（9,197）與 2026/01（9,297）累計顧客數截圖相差 100 人，推測是兩次截圖擷取時間不同、期間有回補註冊資料所致。</div>

          <h3 class="h6 fw-bold">黑卡・金卡：2025 全年成長</h3>
          <div class="row text-center mb-2">
            <% ref[:tiers_2025_full_year].select { |r| %w[黑卡 金卡].include?(r[:level]) }.each do |r| %>
              <div class="col-6 col-md-3 mb-3">
                <div class="text-muted small"><%= r[:level] %></div>
                <div class="h4 mb-0 text-success">+<%= r[:delta] %> <small class="text-muted">人</small></div>
                <div class="small text-muted">▲ <%= r[:pct] %>%（<%= r[:from] %> → <%= r[:to] %> 人）</div>
              </div>
            <% end %>
          </div>
          <div class="small text-muted mb-4">黑卡基期只有 14 人，+58 人就等於 +414%——百分比會被小基期放大，對外溝通建議附上人數而非只講倍數。</div>

          <h3 class="h6 fw-bold">銀卡・白卡・一般卡：2026 年初至今 vs 2025 全年</h3>
          <div class="table-responsive mb-2">
            <table class="table table-sm table-bordered text-right">
              <thead class="thead-light">
                <tr>
                  <th class="text-left">卡別</th>
                  <th>2025/01</th><th>2025/12</th><th>2025 全年 Δ</th>
                  <th>2026/01</th><th>2026/08/16</th><th>2026 至今 Δ</th>
                </tr>
              </thead>
              <tbody>
                <% ref[:tiers_2026_ytd_vs_2025_full_year].each do |r| %>
                  <tr>
                    <td class="text-left"><%= r[:level] %></td>
                    <td><%= number_with_delimiter(r[:y2025_start]) %></td>
                    <td><%= number_with_delimiter(r[:y2025_end]) %></td>
                    <td class="text-success">+<%= number_with_delimiter(r[:y2025_delta]) %>（+<%= r[:y2025_pct] %>%）</td>
                    <td><%= number_with_delimiter(r[:y2026_start]) %></td>
                    <td><%= number_with_delimiter(r[:y2026_end]) %></td>
                    <td class="<%= r[:y2026_delta].negative? ? 'text-danger' : 'text-success' %>">
                      <%= r[:y2026_delta].positive? ? "+" : "" %><%= number_with_delimiter(r[:y2026_delta]) %>（<%= r[:y2026_pct].positive? ? "+" : "" %><%= r[:y2026_pct] %>%）
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <div class="alert alert-info small mb-4">
            <i class="fal fa-flag mr-1"></i>
            2025 年五個卡別全部成長，但 2026 年至今唯獨「一般會員」在漲，白卡／銀卡／金卡幾乎都少了四分之一，黑卡也持平轉降。
            最可能的原因是卡別門檻每年重新核算（例如以近 12 個月消費金額滾動計算），年初做了一次降級重整；也可能是資料擷取時間點差異。
            建議跟營運確認卡別升降級規則的觸發時間，確認是「正常年度重算」還是資料異常。
          </div>

          <h3 class="h6 fw-bold">卡別人數：今年 1–7 月 vs 去年 1–7 月（同一口徑對照）</h3>
          <div class="table-responsive mb-2">
            <table class="table table-sm table-bordered text-right">
              <thead class="thead-light">
                <tr>
                  <th class="text-left">卡別</th>
                  <th>2025/01</th><th>2025/07</th><th>2025 年1–7月 Δ</th>
                  <th>2026/01</th><th>2026/07</th><th>2026 年1–7月 Δ</th>
                </tr>
              </thead>
              <tbody>
                <% ref[:tiers_jan_to_jul_yoy].each do |r| %>
                  <tr>
                    <td class="text-left"><%= r[:level] %></td>
                    <td><%= number_with_delimiter(r[:y2025_start]) %></td>
                    <td><%= number_with_delimiter(r[:y2025_end]) %></td>
                    <td class="text-success">+<%= number_with_delimiter(r[:y2025_delta]) %>（+<%= r[:y2025_pct] %>%）</td>
                    <td><%= number_with_delimiter(r[:y2026_start]) %></td>
                    <td><%= number_with_delimiter(r[:y2026_end]) %></td>
                    <td class="<%= r[:y2026_delta].negative? ? 'text-danger' : 'text-success' %>">
                      <%= r[:y2026_delta].positive? ? "+" : "" %><%= number_with_delimiter(r[:y2026_delta]) %>（<%= r[:y2026_pct].positive? ? "+" : "" %><%= r[:y2026_pct] %>%）
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <div class="small text-muted">
            區間：每年 1/1 起始 → 7 月底累計總數，兩年口徑一致。黑卡在 1–7 月其實還是正成長（78→81 人），是 7 月底到 8/16 這段才轉降到 77 人——
            代表整個降級走勢是漸進的，從年初就開始、一路到 8 月都還在持續，不是單一月份的資料抖動；白卡／銀卡／金卡則整個上半年都在減少，
            趨勢比一般會員的成長更早出現、也更明顯。
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%# ── 升降級是否成正比（真實異動紀錄，非快照對照） ── %>
<div class="row mb-4">
  <div class="col-12">
    <div class="panel">
      <div class="panel-hdr">
        <h2>🔁 升降級是否成正比（實際異動紀錄）</h2>
      </div>
      <div class="panel-container show">
        <div class="panel-content">
          <% if @level_change_tracking_started_at.nil? %>
            <div class="alert alert-secondary small mb-0">
              <i class="fal fa-info-circle mr-1"></i>
              目前還沒有任何一筆異動紀錄（<code>MembershipLevelChange</code>），要等下一次匯入 Shopline 會員報表、
              系統比對出卡別變化後才會有數字。
            </div>
          <% else %>
            <div class="alert alert-info small mb-4">
              <i class="fal fa-flag mr-1"></i>
              這裡的升級／降級人數是<b>系統每次匯入 Shopline 會員報表時，實際比對每個會員卡別變化算出來的</b>，
              看的是卡別名稱的相對高低（黑卡 &gt; 金卡 &gt; 銀卡 &gt; 白卡 &gt; 一般會員），不是門檻金額，
              所以今年 5 月調整卡別門檻之後的資料一樣可以公平比較升級數 vs 降級數。
              但這張表是從 <b><%= @level_change_tracking_started_at.strftime("%Y/%m/%d") %></b> 才開始記錄，
              5 月調整門檻當下造成的一次性重分類沒有算進來——下面的城市對照表下方會有一份 2025 vs 2026 的人工整理數字，
              那份因為橫跨新舊兩套門檻，不能直接拿來當作「升降級成不成比例」的證據。
            </div>

            <div class="row text-center mb-4">
              <div class="col-6 col-md-4">
                <div class="text-muted small">累計升級人次</div>
                <div class="h3 mb-0 text-success">+<%= number_with_delimiter(@level_change_total["upgrade"]) %></div>
              </div>
              <div class="col-6 col-md-4">
                <div class="text-muted small">累計降級人次</div>
                <div class="h3 mb-0 text-danger">-<%= number_with_delimiter(@level_change_total["downgrade"]) %></div>
              </div>
              <div class="col-12 col-md-4">
                <div class="text-muted small">升級：降級比</div>
                <% total_dg = @level_change_total["downgrade"] %>
                <div class="h3 mb-0">
                  <%= total_dg.zero? ? "—" : (@level_change_total["upgrade"].to_f / total_dg).round(2) %>
                  <small class="text-muted">: 1</small>
                </div>
              </div>
            </div>

            <h3 class="h6 fw-bold">金額口徑：升級組 vs 降級組的累積消費總額</h3>
            <div class="alert alert-warning small mb-3">
              <i class="fal fa-exclamation-triangle mr-1"></i>
              這裡的金額用的是<b>顧客目前的累積消費總額</b>（跟顧客列表/詳情頁「累積消費」同一個欄位），
              不是異動當下、決定卡別的那 12 個月消費金額——只能拿來看「升級組跟降級組大概各自代表多大的客戶量」，
              不是精確重建每次升降級當下的實際金額。
              對得到金額的異動筆數：升級 <%= number_with_delimiter(@level_change_amount_matched["upgrade"]) %> / <%= number_with_delimiter(@level_change_total["upgrade"]) %>，
              降級 <%= number_with_delimiter(@level_change_amount_matched["downgrade"]) %> / <%= number_with_delimiter(@level_change_total["downgrade"]) %>
              （對不到的是客戶資料後來被合併或刪除）。
            </div>
            <div class="row text-center mb-4">
              <div class="col-6 col-md-4">
                <div class="text-muted small">升級組累積消費總額</div>
                <div class="h4 mb-0 text-success">NT$ <%= number_with_delimiter(@level_change_amount_total["upgrade"].round) %></div>
                <div class="small text-muted">
                  平均每人 NT$ <%= @level_change_amount_matched["upgrade"].zero? ? "—" : number_with_delimiter((@level_change_amount_total["upgrade"] / @level_change_amount_matched["upgrade"]).round) %>
                </div>
              </div>
              <div class="col-6 col-md-4">
                <div class="text-muted small">降級組累積消費總額</div>
                <div class="h4 mb-0 text-danger">NT$ <%= number_with_delimiter(@level_change_amount_total["downgrade"].round) %></div>
                <div class="small text-muted">
                  平均每人 NT$ <%= @level_change_amount_matched["downgrade"].zero? ? "—" : number_with_delimiter((@level_change_amount_total["downgrade"] / @level_change_amount_matched["downgrade"]).round) %>
                </div>
              </div>
              <div class="col-12 col-md-4">
                <div class="text-muted small">升級組：降級組 金額比</div>
                <% amt_dg = @level_change_amount_total["downgrade"] %>
                <div class="h4 mb-0">
                  <%= amt_dg.zero? ? "—" : (@level_change_amount_total["upgrade"] / amt_dg).round(2) %>
                  <small class="text-muted">: 1</small>
                </div>
                <div class="small text-muted">（人數比是 <%= @level_change_total["downgrade"].zero? ? "—" : (@level_change_total["upgrade"].to_f / @level_change_total["downgrade"]).round(2) %> : 1）</div>
              </div>
            </div>

            <h3 class="h6 fw-bold">每月升級 vs 降級人次</h3>
            <div class="table-responsive mb-4">
              <table class="table table-sm table-bordered text-right">
                <thead class="thead-light">
                  <tr>
                    <th class="text-left">月份</th><th>升級</th><th>降級</th><th>升級：降級比</th>
                  </tr>
                </thead>
                <tbody>
                  <% @level_change_monthly.each do |month, counts| %>
                    <tr>
                      <td class="text-left"><%= month %></td>
                      <td class="text-success">+<%= counts["upgrade"] %></td>
                      <td class="text-danger">-<%= counts["downgrade"] %></td>
                      <td><%= counts["downgrade"].zero? ? "—" : (counts["upgrade"].to_f / counts["downgrade"]).round(2) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>

            <h3 class="h6 fw-bold">異動明細（依卡別轉換分組）</h3>
            <div class="table-responsive">
              <table class="table table-sm table-bordered text-right">
                <thead class="thead-light">
                  <tr>
                    <th class="text-left">方向</th><th class="text-left">從</th><th class="text-left">到</th><th>人次</th><th>累積消費總額（對得到的部分）</th>
                  </tr>
                </thead>
                <tbody>
                  <% @level_change_pairs.each do |r| %>
                    <tr>
                      <td class="text-left">
                        <span class="badge badge-<%= r[:direction] == 'upgrade' ? 'success' : 'danger' %>">
                          <%= r[:direction] == 'upgrade' ? '升級' : '降級' %>
                        </span>
                      </td>
                      <td class="text-left"><%= r[:from] %></td>
                      <td class="text-left"><%= r[:to] %></td>
                      <td><%= r[:count] %></td>
                      <td>NT$ <%= number_with_delimiter(r[:amount_total].round) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<%# ── 城市 ── %>
<div class="row mb-4">
  <div class="col-12">
    <div class="panel">
      <div class="panel-hdr"><h2>📍 城市分佈</h2></div>
      <div class="panel-container show">
        <div class="panel-content">
          <div class="row">
            <% levels.each do |level| %>
              <div class="col-6 col-md-4 col-xl-2 mb-3">
                <div class="fw-500 mb-2">
                  <%= link_to customers_path(membership_level: level), class: "text-dark" do %>
                    <%= level %> <span class="text-muted small">（<%= @total_by_level[level] %> 人）</span>
                  <% end %>
                </div>
                <% top = @city_stats[level].sort_by { |_, v| -v }.first(8) %>
                <% max = top.first&.last.to_f %>
                <% top.each do |city, count| %>
                  <div class="mb-2">
                    <div class="d-flex justify-content-between mb-1">
                      <%= link_to city, customers_path(membership_level: level, city: city), class: "small text-dark" %>
                      <span class="text-muted small"><%= count %> 人</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                      <div class="progress-bar" style="width: <%= max > 0 ? (count / max * 100).round : 0 %>%"></div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

