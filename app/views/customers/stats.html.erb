                  <div class="mb-2">
                    <div class="d-flex justify-content-between mb-1">
                      <%= link_to "流年 #{num}", customers_path(membership_level: level, personal_year: num), class: "small text-dark" %>                      <span class="text-muted small"><%= count %> 人</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                      <div class="progress-bar" style="width: <%= max_py > 0 ? (count / max_py * 100).round : 0 %>%"></div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>