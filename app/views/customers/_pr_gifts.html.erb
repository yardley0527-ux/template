<%# 公關品紀錄：所有人可看，只有 owner（admin）可新增／修改／刪除。
    新增／修改的彈窗在 _pr_gift_modals（放在頁面最上層，跟其他頁面的 modal 一樣） %>
<% @pr_gifts ||= customer.pr_gifts.recent_first.to_a %>
<% is_owner = current_user&.admin? %>

<div class="profile-block" id="pr-gifts">
  <span class="profile-block-title">🎁 公關品紀錄</span>

  <% if @pr_gifts.empty? %>
    <p class="profile-block-text">（尚無公關品紀錄）</p>
  <% else %>
    <ul class="list-unstyled mb-2">
      <% @pr_gifts.each do |gift| %>
        <li class="mb-2">
          <span class="text-muted"><%= gift.given_on.strftime("%Y/%m/%d") %></span>
          <strong><%= gift.summary %></strong>
          <% if gift.note.present? %><span class="text-muted small">（<%= gift.note %>）</span><% end %>

          <% if is_owner %>
            <button type="button" class="btn btn-sm btn-outline-secondary ml-1" title="修改"
                    data-toggle="modal" data-target="#edit-pr-gift-modal-<%= gift.id %>">
              <i class="fal fa-edit"></i>
            </button>
            <%= link_to customer_pr_gift_path(customer, gift), method: :delete, title: "刪除",
                  data: { confirm: "確定刪除這筆公關品紀錄？（#{gift.given_on.strftime('%Y/%m/%d')} #{gift.summary}）" },
                  class: "btn btn-sm btn-outline-danger" do %>
              <i class="fal fa-trash-alt"></i>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if is_owner %>
    <button type="button" class="btn btn-primary btn-sm mb-2" data-toggle="modal" data-target="#new-pr-gift-modal">
      <i class="fal fa-plus mr-1"></i>新增公關品
    </button>
  <% end %>
</div>
