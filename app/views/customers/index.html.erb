<!-- path: app/views/customers/index.html.erb -->
<div class="subheader">
  <h1 class="subheader-title">
    <i class="subheader-icon fal fa-user"></i>
    客人列表
    <small>Shopline Customers</small>
  </h1>
</div>

<% if @city_by_membership.any? %>
<div class="row mb-3">
  <div class="col-12">
    <div class="panel">
      <div class="panel-hdr"><h2>卡別城市分佈</h2></div>
      <div class="panel-container show">
        <div class="panel-content">
          <div class="row">
            <% @membership_order.each do |level| %>
              <% city_data = @city_by_membership[level] %>
              <% next if city_data.blank? %>
              <% top_cities = city_data.sort_by { |_, v| -v }.first(6) %>
              <% other_count = city_data.sum { |_, v| v } - top_cities.sum { |_, v| v } %>
              <% labels = top_cities.map(&:first) + (other_count > 0 ? ["其他"] : []) %>
              <% values = top_cities.map(&:last) + (other_count > 0 ? [other_count] : []) %>

              <div class="col-6 col-md-4 col-xl-2 text-center mb-3">
                <div class="fw-500 mb-1"><%= level %></div>
                <canvas id="chart_<%= level %>" height="180"></canvas>
                <div class="small text-muted mt-1">共 <%= city_data.values.sum %> 人</div>
              </div>

              <script>
                window.addEventListener("load", function() {
                  var ctx = document.getElementById("chart_<%= level %>").getContext("2d");
                  new Chart(ctx, {
                    type: "pie",
                    data: {
                      labels: <%= labels.to_json.html_safe %>,
                      datasets: [{
                        data: <%= values.to_json.html_safe %>,
                        backgroundColor: [
                          "#c8a97e",
                          "#7a3b1e",
                          "#e8d5b7",
                          "#a0522d",
                          "#4a2c0a",
                          "#d4956a",
                          "#6b4c3b"
                        ]
                      }]
                    },
                    options: {
                      plugins: {
                        legend: { position: "bottom", labels: { font: { size: 10 }, boxWidth: 10 } }
                      }
                    }
                  });
                });
              </script>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<% end %>

<div class="row">
  <div class="col-12">
    <div class="panel">
      <div class="panel-hdr"><h2>篩選</h2></div>
      <div class="panel-container show">
        <div class="panel-content">
          <%= form_with url: customers_path, method: :get, local: true, class: "row g-2 align-items-end" do %>
            <div class="col-sm-6 col-md-4">
              <label class="form-label">搜尋</label>
              <%= text_field_tag :q, @q, class: "form-control", placeholder: "姓名 / Email / 手機 / IG" %>
            </div>

            <div class="col-sm-6 col-md-2">
              <label class="form-label">城市</label>
              <%= text_field_tag :city, @city, class: "form-control", placeholder: "台北 / 台中..." %>
            </div>

            <div class="col-sm-6 col-md-2">
              <label class="form-label">購物金 ≥</label>
              <%= number_field_tag :min_credits, (@min_credits&.to_i), class: "form-control", placeholder: "3000" %>
            </div>

            <div class="col-sm-6 col-md-2">
              <label class="form-label">會員等級</label>
              <%= select_tag :membership_level,
                options_for_select([["全部", ""]] + @membership_levels.map { |l| [l, l] }, @membership_level),
                class: "form-control" %>
            </div>

            <div class="col-sm-12 col-md-9">
              <%= button_tag "查詢", type: "submit", class: "btn btn-primary me-2 mt-2" %>
              <%= link_to "清除", customers_path, class: "btn btn-outline-secondary mt-2" %>
            </div>
          <% end %>
        </div>

        <div class="panel-content">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="text-muted">
              總筆數：<%= number_with_delimiter(@total.to_i) %>　
              每頁：<%= CustomersController::PER_PAGE %>　
              頁數：<%= @page %> / <%= @total_pages %>
            </div>

            <div class="btn-group">
              <% prev_page = [@page - 1, 1].max %>
              <% next_page = [@page + 1, @total_pages].min %>
              <%= link_to "← 上一頁",
                customers_path(request.query_parameters.merge(page: prev_page)),
                class: "btn btn-outline-secondary btn-sm #{'disabled' if @page <= 1}" %>
              <%= link_to "下一頁 →",
                customers_path(request.query_parameters.merge(page: next_page)),
                class: "btn btn-outline-secondary btn-sm #{'disabled' if @page >= @total_pages}" %>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table table-bordered table-hover table-striped w-100">
              <thead class="bg-primary-600">
                <tr>
                  <th>姓名</th>
                  <th>生日</th>
                  <th>城市</th>
                  <th class="text-end"><%= sort_link_tag("訂單數", "orders_asc", "orders_desc", @sort) %></th>
                  <th class="text-end"><%= sort_link_tag("累積消費", "amount_asc", "amount_desc", @sort) %></th>
                  <th class="text-end"><%= sort_link_tag("購物金", "credits_asc", "credits_desc", @sort) %></th>
                  <th>會員</th>
                  <th>常買</th>
                  <th><%= sort_link_tag("未購警示", "inactive_asc", "inactive_desc", @sort) %></th>
                </tr>
              </thead>

              <tbody>
                <% @customers.each do |c| %>
                  <tr>
                    <td>
                      <div class="fw-500">
                        <%= link_to c.full_name.presence || "(無名)", customer_path(c) %>
                        <% if @inactive_info[c.email] %>
                          <span style="color:#c0392b; font-size:0.75em;">⚠</span>
                        <% end %>
                      </div>
                      <div class="small text-muted">
                        <% if c.instagram_account.present? %>
                          <a href="https://instagram.com/<%= c.instagram_account %>" target="_blank" rel="noopener noreferrer">
                            <%= c.instagram_account %>
                          </a>
                        <% end %>
                      </div>
                    </td>
                    <td class="small"><%= c.birthdate&.strftime("%m/%d") || "—" %></td>
                    <td><%= c.city %></td>
                    <td class="text-end"><%= c.order_count.to_i %></td>
                    <td class="text-end">NT$ <%= number_with_delimiter(c.total_amount.to_f.round(0).to_i) %></td>
                    <td class="text-end"><%= number_with_delimiter(c.current_shopping_credits.to_f.round(0).to_i) %></td>
                    <td><%= c.membership_level %></td>
                    <td><%= @top_products[c.email].presence || "—" %></td>
                    <td class="small">
                      <% if (info = @inactive_info[c.email]) %>
                        <span style="color:#c0392b;">⚠ <%= info[:days] %> 天未購</span><br>
                        <span class="text-muted">上次買 <%= info[:last_product] %></span>
                      <% else %>
                        —
                      <% end %>
                    </td>
                  </tr>
                <% end %>

                <% if @customers.blank? %>
                  <tr><td colspan="9" class="text-center text-muted py-4">沒有資料</td></tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <div class="d-flex justify-content-end mt-2">
            <% prev_page = [@page - 1, 1].max %>
            <% next_page = [@page + 1, @total_pages].min %>
            <%= link_to "← 上一頁",
              customers_path(request.query_parameters.merge(page: prev_page)),
              class: "btn btn-outline-secondary btn-sm me-2 #{'disabled' if @page <= 1}" %>
            <%= link_to "下一頁 →",
              customers_path(request.query_parameters.merge(page: next_page)),
              class: "btn btn-outline-secondary btn-sm #{'disabled' if @page >= @total_pages}" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>