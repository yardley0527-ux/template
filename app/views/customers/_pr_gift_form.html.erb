<%# 新增／修改共用。gift 沒存過就是新增；產品名稱不在清單裡就當「其他」 %>
<% other_key = PrGiftsController::OTHER_PRODUCT %>
<% custom    = gift.persisted? && !products.include?(gift.product_name) %>
<% selected  = custom ? other_key : gift.product_name %>
<% options   = products.map { |p| [p, p, { "data-unit" => PrGift.default_unit_for(p) }] } +
               [["其他（自行輸入）", other_key]] %>

<%= form_with scope: :pr_gift,
      url: (gift.persisted? ? customer_pr_gift_path(customer, gift) : customer_pr_gifts_path(customer)),
      method: (gift.persisted? ? :patch : :post),
      html: { class: "pr-gift-form border rounded p-2 mt-2 text-left" } do |f| %>
  <div class="form-row">
    <div class="form-group col-12 col-md-5 mb-2">
      <label class="small mb-0">產品</label>
      <%= f.select :product_name, options_for_select(options, selected),
            { include_blank: "選擇產品" }, { class: "form-control form-control-sm pr-gift-product", required: true } %>
      <%= f.text_field :product_other, value: (custom ? gift.product_name : nil), maxlength: 50,
            placeholder: "輸入產品名稱", class: "form-control form-control-sm mt-1 pr-gift-other",
            style: (custom ? nil : "display:none") %>
    </div>
    <div class="form-group col-6 col-md-2 mb-2">
      <label class="small mb-0">數量</label>
      <%= f.number_field :quantity, value: gift.quantity || 1, min: 1, max: 999, step: 1,
            class: "form-control form-control-sm", required: true %>
    </div>
    <div class="form-group col-6 col-md-2 mb-2">
      <label class="small mb-0">單位</label>
      <%= f.select :unit, PrGift::UNITS, { selected: gift.unit }, { class: "form-control form-control-sm pr-gift-unit" } %>
    </div>
    <div class="form-group col-12 col-md-3 mb-2">
      <label class="small mb-0">日期</label>
      <%= f.date_field :given_on, value: gift.given_on || Date.current, class: "form-control form-control-sm", required: true %>
    </div>
  </div>
  <div class="form-group mb-2">
    <label class="small mb-0">備註（選填）</label>
    <%= f.text_field :note, value: gift.note, maxlength: 100, placeholder: "例如：試用、道歉補償", class: "form-control form-control-sm" %>
  </div>
  <%= f.submit (gift.persisted? ? "儲存修改" : "新增"), class: "btn btn-primary btn-sm" %>
<% end %>
