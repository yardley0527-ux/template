<% content_for :page_title, "戰情首頁" %>

<style>
  /* 手機：戰情條字級縮小、倒數換行後仍醒目 */
  @media (max-width: 575.98px) {
    .cc-live-title { font-size: 1.25rem !important; }
    .cc-live-countdown { font-size: 1.1rem !important; display: block; margin-top: 4px; }
    .cc-card-body-tight { padding: 0.75rem !important; }
  }
</style>

<%# ── 同步失敗警告（有問題時才出現） ── %>
<% @snapshot[:sync_alerts].each do |alert| %>
  <div class="alert alert-danger py-2 mb-2">
    <i class="fal fa-exclamation-triangle mr-1"></i><%= alert %>
    <%= link_to "查看行事曆", calendar_events_path, class: "alert-link ml-2" %>
  </div>
<% end %>

<%# ── 戰情條：下一場直播 ── %>
<% live = @snapshot[:next_livestream] %>
<div class="card mb-3" style="border-left:6px solid #d9364c;">
  <div class="card-body py-3 cc-card-body-tight">
    <% if live %>
      <% days = (live.event_date - Date.current).to_i %>
      <div class="d-flex align-items-baseline flex-wrap">
        <span class="h3 mb-0 mr-3 font-weight-bold cc-live-title">
          <i class="fal fa-video text-danger mr-1"></i><%= live.title %>
        </span>
        <span class="h4 mb-0 text-danger font-weight-bold cc-live-countdown">
          <%= live.event_date.strftime("%-m/%-d") %>（週<%= %w[日 一 二 三 四 五 六][live.event_date.wday] %>）
          <%= days.zero? ? "🔴 今天" : "倒數 #{days} 天" %>
        </span>
        <% if live.time_info.present? %>
          <span class="text-muted ml-2"><i class="fal fa-clock"></i> <%= live.time_info %></span>
        <% end %>
      </div>
    <% else %>
      <span class="h4 mb-0 text-muted">目前沒有排定的直播</span>
    <% end %>
    <% arrival = @snapshot[:next_arrival] %>
    <% if arrival %>
      <div class="mt-2 text-dark">
        <i class="fal fa-truck text-success mr-1"></i>
        <strong><%= arrival.title %></strong>
        <span class="text-success font-weight-bold ml-1">
          <%= arrival.event_date.strftime("%-m/%-d") %>
          <% adays = (arrival.event_date - Date.current).to_i %>
          <%= adays.zero? ? "（今天）" : "（#{adays} 天後）" %>
        </span>
      </div>
    <% end %>
  </div>
</div>

<%# ── 風險條 ── %>
<% if @snapshot[:risks].any? %>
  <div class="card mb-3" style="border-left:6px solid #f0870f;">
    <div class="card-header py-2"><strong>⚠️ 風險提醒（<%= @snapshot[:risks].size %>）</strong></div>
    <ul class="list-group list-group-flush">
      <% @snapshot[:risks].each do |risk| %>
        <li class="list-group-item py-2 <%= risk[:level] == 'danger' ? 'text-danger font-weight-bold' : '' %>">
          <%= risk[:level] == "danger" ? "🔴" : "🟡" %> <%= risk[:message] %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<%# ── AI 每日晨報 ── %>
<% briefing = @snapshot[:briefing] %>
<% if briefing %>
  <div class="card mb-3" style="border-left:6px solid #6f42c1;">
    <div class="card-header py-2 d-flex align-items-center">
      <strong>🤖 AI 晨報</strong>
      <span class="badge badge-light border ml-2" title="AI 整理，可能有誤，點出處回行事曆查證原文">Beta・請查證</span>
      <span class="ml-auto small text-muted">
        <% if briefing.status == "success" %>
          <%= briefing.meta["report_date"] %> 日誌｜<%= briefing.generated_at&.strftime("%-m/%-d %H:%M") %> 生成
        <% end %>
      </span>
    </div>
    <div class="card-body py-2">
      <% if briefing.status == "failed" %>
        <div class="text-danger">
          <i class="fal fa-exclamation-triangle mr-1"></i>今日晨報生成失敗：<%= briefing.error_message %>
        </div>
      <% else %>
        <% briefing.summary.each do |item| %>
          <div class="py-1" style="border-bottom:1px dashed #eee;">
            ・<%= item["text"] %>
            <span class="badge badge-light border ml-1"><%= item["source"] %></span>
          </div>
        <% end %>
        <% if briefing.dropped_balls.any? %>
          <div class="mt-2 mb-1 font-weight-bold text-warning">⚠️ 跨部門待接球</div>
          <% briefing.dropped_balls.each do |item| %>
            <div class="py-1 small">・<%= item["text"] %>
              <span class="badge badge-light border ml-1"><%= item["source"] %></span>
            </div>
          <% end %>
        <% end %>
        <% if briefing.pending_decisions.any? %>
          <div class="mt-2 mb-1 font-weight-bold text-primary">📋 等主管回覆</div>
          <% briefing.pending_decisions.each do |item| %>
            <div class="py-1 small">・<%= item["text"] %>
              <span class="badge badge-light border ml-1"><%= item["source"] %></span>
            </div>
          <% end %>
        <% end %>
        <div class="small text-muted mt-2">出處日誌原文請到 <%= link_to "行事曆", calendar_events_path %> 對應日期查看</div>
      <% end %>
    </div>
  </div>
<% end %>

<%# ── 直播準備雷達 ── %>
<% radar = @snapshot[:radar] %>
<% if radar && radar[:products].any? %>
  <div class="card mb-3">
    <div class="card-header py-2">
      <strong><i class="fal fa-radar mr-1"></i> 直播準備雷達</strong>
      <span class="small text-muted ml-2">
        <%= radar[:livestream].event_date.strftime("%-m/%-d") %>「<%= radar[:products].join('、') %>」× 各部門近 3 天日誌
      </span>
      <span class="badge badge-light border float-right" title="關鍵字比對，僅代表日誌有提及，不代表完成">疑似相關・請查證</span>
    </div>
    <div class="card-body py-2">
      <div class="row">
        <% radar[:departments].each do |entry| %>
          <div class="col-6 col-md-3 mb-2">
            <% if entry[:mentions].positive? %>
              <details>
                <summary style="cursor:pointer;" class="font-weight-bold">
                  ✅ <%= entry[:department] %> <span class="badge badge-success"><%= entry[:mentions] %></span>
                </summary>
                <div class="small mt-1 pl-2" style="border-left:2px solid #d8e3d8;">
                  <% entry[:evidence].each do |ev| %>
                    <div class="mb-1"><span class="text-muted"><%= ev[:date].strftime("%-m/%-d") %></span> <%= ev[:line] %></div>
                  <% end %>
                </div>
              </details>
            <% else %>
              <span class="text-muted">➖ <%= entry[:department] %> <span class="small">無動靜</span></span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<div class="row">
  <%# ── 左欄：部門回報燈 ── %>
  <div class="col-lg-7 mb-3">
    <div class="card h-100">
      <div class="card-header py-2 d-flex align-items-center">
        <strong><i class="fal fa-users mr-1"></i> 部門今日回報</strong>
        <span class="ml-auto small text-muted">
          <% if @snapshot[:sync_last_run] %>
            <%= time_ago_in_words(@snapshot[:sync_last_run]) %>前同步
          <% end %>
        </span>
      </div>
      <div class="card-body py-3">
        <div class="row">
          <% @snapshot[:department_lights].each do |light| %>
            <div class="col-6 col-md-3 mb-2">
              <div class="p-2 rounded text-center" style="background:<%= light[:reported_today] ? '#e8f6ee' : '#f4f4f4' %>;">
                <div class="font-weight-bold">
                  <%= light[:reported_today] ? "🟢" : "⚪" %> <%= light[:department] %>
                </div>
                <div class="small text-muted">
                  <% if light[:reported_today] %>
                    今日已回報
                  <% elsif light[:last_date] %>
                    最後：<%= light[:last_date].strftime("%-m/%-d") %>
                  <% else %>
                    尚無紀錄
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        <div class="small text-muted mt-1">
          部門日誌通常於當天陸續填寫；點 <%= link_to "行事曆", calendar_events_path %> 看各部門完整內容
        </div>
      </div>
    </div>
  </div>

  <%# ── 右欄：近期大事 + 壽星 ── %>
  <div class="col-lg-5 mb-3">
    <div class="card mb-3">
      <div class="card-header py-2">
        <strong><i class="fal fa-calendar-alt mr-1"></i> 近期大事</strong>
        <%= link_to "完整行事曆 →", calendar_events_path, class: "small float-right" %>
      </div>
      <div class="list-group list-group-flush">
        <% if @snapshot[:upcoming_events].empty? %>
          <div class="list-group-item text-muted small">近期沒有排定事件</div>
        <% end %>
        <% @snapshot[:upcoming_events].each do |event| %>
          <div class="list-group-item py-2 d-flex align-items-center">
            <span class="badge badge-pill text-white mr-2" style="background:<%= event.type_color %>;"><%= event.type_label %></span>
            <span class="mr-2 text-truncate" style="min-width:0;"><%= event.title %></span>
            <span class="ml-auto small font-weight-bold text-nowrap"><%= event.event_date.strftime("%-m/%-d") %></span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="card">
      <div class="card-header py-2"><strong>🎂 本週壽星</strong></div>
      <div class="card-body py-2">
        <div id="bd-list" style="max-height:220px; overflow-y:auto;">
          <span class="text-muted small">載入中…</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var listEl = document.getElementById('bd-list');
  var days = ['日','一','二','三','四','五','六'];
  var today = new Date();

  fetch('/api/birthday_customers')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      var order = { '黑卡': 1, '金卡': 2, '銀卡': 3, '白卡': 4, '一般會員': 5 };
      data.sort(function(a, b) { return (order[a.membership_level] || 99) - (order[b.membership_level] || 99); });

      if (!data.length) {
        listEl.innerHTML = '<span class="text-muted small">本週沒有壽星 🎉</span>';
        return;
      }

      var html = '';
      for (var i = 0; i < data.length; i++) {
        var c = data[i];
        var parts = (c.birthday || '').split('/');
        var wd = parts.length === 2 ? '週' + days[new Date(today.getFullYear(), parseInt(parts[0], 10) - 1, parseInt(parts[1], 10)).getDay()] : '';
        html += '<div class="d-flex align-items-center py-1" style="border-bottom:1px dashed #eee;">'
          + '<a href="/customers/' + c.id + '" class="mr-2 font-weight-bold">' + c.full_name + '</a>'
          + (c.is_today ? '<span class="badge badge-primary mr-2">今天</span>' : '')
          + '<span class="small text-muted mr-2">' + c.birthday + ' ' + wd + '</span>'
          + (c.membership_level ? '<span class="badge badge-light border ml-auto">' + c.membership_level + '</span>' : '')
          + '</div>';
      }
      listEl.innerHTML = html;
    })
    .catch(function() { listEl.textContent = '載入失敗'; });
})();
</script>
