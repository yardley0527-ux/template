<%# app/views/member_contacts/index.html.erb %>
<% content_for :page_title, "會員分群" %>

<div class="row g-3 mb-4">
  <div class="col-12">
    <h4 class="fw-bold mb-0">會員分群</h4>
    <p class="text-muted small mb-0">依卡別 × 活躍度分群，可匯出 Email / Line ID</p>
    <p class="text-muted small mb-0 mt-1">
      最後匯入：<strong><%= @last_import_at ? @last_import_at.strftime("%Y/%m/%d %H:%M") : "—" %></strong>
    </p>
  </div>
</div>

<%# 總覽卡片 %>
<div class="row g-3 mb-4">
  <% [
    ["總會員數",     @total,          "text-primary",  "fa-users"],
    ["活躍（一年半內）", @total_active,  "text-success",  "fa-user-check"],
    ["不活躍（逾一年半）", @total_inactive, "text-danger", "fa-user-times"],
    ["有 Email",    @total_email,    "text-secondary", "fa-envelope"],
    ["有 Line ID",  @total_line,     "text-success",   "fa-comment"],
  ].each do |label, count, color, icon| %>
    <div class="col">
      <div class="card border-0 shadow-sm text-center py-3">
        <div class="mb-1"><i class="fal <%= icon %> <%= color %>"></i></div>
        <div class="fw-bold <%= color %>" style="font-size: 1.8rem; line-height: 1;"><%= number_with_delimiter(count) %></div>
        <div class="text-muted small mt-1"><%= label %></div>
      </div>
    </div>
  <% end %>
</div>

<%# 卡別 × 活躍度分群表 %>
<div class="d-flex align-items-center mb-3">
  <div class="border-start border-3 border-secondary ps-3">
    <h5 class="fw-bold mb-0 text-secondary">📊 卡別分群統計</h5>
    <p class="text-muted small mb-0">活躍 = 一年半內有消費紀錄</p>
  </div>
</div>

<div class="card border-0 shadow-sm mb-5">
  <div class="card-body p-0 table-responsive">
    <table class="table align-middle mb-0 text-center" style="font-size: 0.9rem;">
      <thead style="background-color: #4a4a4a; color: white;">
        <tr>
          <th class="text-start ps-3">卡別</th>
          <th>總人數</th>
          <th>活躍<span class="ms-1 small opacity-75">（一年半內）</span></th>
          <th>不活躍<span class="ms-1 small opacity-75">（逾一年半）</span></th>
          <th>活躍率</th>
          <th>有 Email</th>
          <th>有 Line ID</th>
          <th>匯出（全部）</th>
          <th>匯出（活躍）</th>
          <th>匯出（不活躍）</th>
        </tr>
      </thead>
      <tbody>
        <% @stats.each do |s| %>
          <% active_rate = s[:total] > 0 ? (s[:active].to_f / s[:total] * 100).round(1) : 0 %>
          <tr>
            <td class="fw-bold text-start ps-3"><%= s[:level] %></td>
            <td class="fw-semibold"><%= number_with_delimiter(s[:total]) %></td>
            <td class="text-success fw-semibold"><%= s[:active] %></td>
            <td class="text-danger"><%= s[:inactive] %></td>
            <td>
              <div class="d-flex align-items-center gap-1 justify-content-center">
                <div style="width:50px; background:#e9ecef; border-radius:4px; height:8px; overflow:hidden;">
                  <div style="width:<%= active_rate %>%; background:#198754; height:100%;"></div>
                </div>
                <span class="small"><%= active_rate %>%</span>
              </div>
            </td>
            <td class="text-muted"><%= s[:has_email] %></td>
            <td class="text-muted"><%= s[:has_line] %></td>
            <td><%= link_to "⬇ 全部", member_contacts_export_path(level: s[:level]), class: "btn btn-xs btn-outline-secondary py-0 px-2", style: "font-size:0.78rem;" %></td>
            <td><%= link_to "⬇ 活躍", member_contacts_export_path(level: s[:level], activity: 'active'), class: "btn btn-xs btn-outline-success py-0 px-2", style: "font-size:0.78rem;" %></td>
            <td><%= link_to "⬇ 不活躍", member_contacts_export_path(level: s[:level], activity: 'inactive'), class: "btn btn-xs btn-outline-danger py-0 px-2", style: "font-size:0.78rem;" %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot style="background-color: #f8f9fa; font-weight: 700;">
        <tr>
          <td class="text-start ps-3">合計</td>
          <td><%= number_with_delimiter(@total) %></td>
          <td class="text-success"><%= number_with_delimiter(@total_active) %></td>
          <td class="text-danger"><%= number_with_delimiter(@total_inactive) %></td>
          <td>
            <% total_rate = @total > 0 ? (@total_active.to_f / @total * 100).round(1) : 0 %>
            <%= total_rate %>%
          </td>
          <td class="text-muted"><%= number_with_delimiter(@total_email) %></td>
          <td class="text-muted"><%= number_with_delimiter(@total_line) %></td>
          <td><%= link_to "⬇ 全部", member_contacts_export_path, class: "btn btn-xs btn-secondary py-0 px-2", style: "font-size:0.78rem;" %></td>
          <td><%= link_to "⬇ 活躍", member_contacts_export_path(activity: 'active'), class: "btn btn-xs btn-success py-0 px-2", style: "font-size:0.78rem;" %></td>
          <td><%= link_to "⬇ 不活躍", member_contacts_export_path(activity: 'inactive'), class: "btn btn-xs btn-danger py-0 px-2", style: "font-size:0.78rem;" %></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<%# 說明 %>
<div class="card border-0 bg-light mb-4">
  <div class="card-body py-2 px-3 text-muted small">
    <strong>活躍定義：</strong>最近一年半（548 天）內有消費紀錄。｜
    <strong>匯出欄位：</strong>姓名、卡別、Email、Line ID、手機、狀態、上次消費日。｜
    統計對象：有 Shopline ID 的正式會員（黑卡～一般會員）。
  </div>
</div>


<%# ── 每日數據追蹤 ────────────────────────────────── %>
<div class="d-flex align-items-center justify-content-between mb-3">
  <div class="border-start border-3 border-success ps-3">
    <h5 class="fw-bold mb-0 text-success">📈 每日數據追蹤</h5>
    <p class="text-muted small mb-0">今日：<%= Date.today.strftime("%Y/%m/%d") %></p>
  </div>
  <%= button_to "🔄 更新 LINE 好友數", member_contacts_refresh_line_path,
        method: :post, class: "btn btn-sm btn-outline-success" %>
</div>

<% def delta_badge(today, yesterday)
     return "" unless today && yesterday
     diff = today - yesterday
     return "" if diff == 0
     color = diff > 0 ? "success" : "danger"
     sign  = diff > 0 ? "+" : ""
     "<span class='fw-semibold text-#{color} ms-1' style='font-size:0.85rem;'>#{sign}#{diff}</span>"
   end %>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-0">
    <%# 每日報告格式輸入表 %>
    <%= form_with url: member_contacts_update_sl_path, method: :post do |f| %>
      <%= f.fields_for :daily_member_stat, @today_stat do |ff| %>
        <div class="table-responsive">
        <table class="table align-middle mb-0" style="font-size:0.9rem;">
          <thead class="table-light">
            <tr>
              <th class="ps-3" style="width:40%;">項目</th>
              <th class="text-center text-muted" style="width:20%;">昨日</th>
              <th class="text-center" style="width:20%;">今日</th>
              <th class="text-center" style="width:20%;">變化</th>
            </tr>
          </thead>
          <tbody>
            <%# LINE 自動 %>
            <tr class="table-success bg-opacity-25">
              <td class="ps-3 fw-semibold">LINE 官方好友數 <span class="badge bg-success ms-1" style="font-size:0.65rem;">自動</span></td>
              <td class="text-center text-muted"><%= @yesterday_stat&.line_friends ? number_with_delimiter(@yesterday_stat.line_friends) : "—" %></td>
              <td class="text-center fw-bold text-success"><%= @today_stat.line_friends ? number_with_delimiter(@today_stat.line_friends) : "—" %></td>
              <td class="text-center"><%= delta_badge(@today_stat.line_friends, @yesterday_stat&.line_friends).html_safe %></td>
            </tr>
            <%# Shopline 手動 %>
            <% [
              ["官方好友＋是網站會員",       :line_and_sl_members],
              ["行動會員卡綁定人數",          :line_bound_members],
              ["手機未綁定但已消費",          :unbound_purchased],
              ["SL 會員總人數",              :sl_total_members],
              ["有消費過的人數",             :sl_purchased_members],
            ].each do |label, field|
              yesterday_val = @yesterday_stat&.send(field)
              today_val     = @today_stat.send(field)
            %>
              <tr>
                <td class="ps-3"><%= label %></td>
                <td class="text-center text-muted"><%= yesterday_val ? number_with_delimiter(yesterday_val) : "—" %></td>
                <td class="text-center">
                  <%= ff.number_field field, value: today_val,
                        class: "form-control form-control-sm text-center",
                        style: "width:100px; margin:0 auto;",
                        placeholder: "輸入",
                        "data-yesterday": yesterday_val,
                        "data-delta-target": "delta_#{field}" %>
                </td>
                <td class="text-center" id="delta_<%= field %>">
                  <%= delta_badge(today_val, yesterday_val).html_safe %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        </div>
        <div class="px-3 py-2 text-end border-top">
          <%= button_tag "儲存今日數據", type: "submit", class: "btn btn-sm btn-primary" %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<%# ── LINE 好友屬性 ──────────────────────────────── %>
<% if @demographic&.dig("available") %>
  <div class="d-flex align-items-center mb-3">
    <div class="border-start border-3 border-primary ps-3">
      <h5 class="fw-bold mb-0 text-primary">👥 LINE 好友屬性</h5>
      <p class="text-muted small mb-0">每 12 小時更新一次</p>
    </div>
  </div>

  <div class="row g-3 mb-5">
    <%# 性別 %>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <p class="fw-semibold text-secondary small mb-3">性別</p>
          <% @demographic["genders"].each do |g| %>
            <% next if g["percentage"].to_f == 0 %>
            <% label = { "female" => "女性", "male" => "男性", "unknown" => "未知" }[g["gender"]] || g["gender"] %>
            <div class="d-flex justify-content-between small mb-1">
              <span><%= label %></span><span class="fw-bold"><%= g["percentage"] %>%</span>
            </div>
            <div class="mb-2" style="background:#e9ecef;border-radius:4px;height:8px;">
              <div style="width:<%= g['percentage'] %>%;background:#0d6efd;height:100%;border-radius:4px;"></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# 年齡 %>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <p class="fw-semibold text-secondary small mb-3">年齡分佈</p>
          <% age_labels = { "from20to24"=>"20-24","from25to29"=>"25-29","from30to34"=>"30-34","from35to39"=>"35-39","from40to44"=>"40-44","from45to49"=>"45-49","from50to54"=>"50-54","from55to59"=>"55-59","from60to64"=>"60-64","from65to69"=>"65-69","from70"=>"70+","unknown"=>"未知" } %>
          <% @demographic["ages"].select { |a| a["percentage"].to_f >= 1 }.each do |a| %>
            <div class="d-flex justify-content-between small mb-1">
              <span><%= age_labels[a["age"]] || a["age"] %></span><span class="fw-bold"><%= a["percentage"] %>%</span>
            </div>
            <div class="mb-2" style="background:#e9ecef;border-radius:4px;height:8px;">
              <div style="width:<%= [a['percentage'], 100].min %>%;background:#198754;height:100%;border-radius:4px;"></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# 地區 %>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <p class="fw-semibold text-secondary small mb-3">地區（前 8）</p>
          <% @demographic["areas"].reject { |a| a["area"] == "unknown" }.first(8).each do |a| %>
            <div class="d-flex justify-content-between small mb-1">
              <span><%= a["area"] %></span><span class="fw-bold"><%= a["percentage"] %>%</span>
            </div>
            <div class="mb-2" style="background:#e9ecef;border-radius:4px;height:8px;">
              <div style="width:<%= [a['percentage'] * 5, 100].min %>%;background:#fd7e14;height:100%;border-radius:4px;"></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# 訂閱時長 %>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <p class="fw-semibold text-secondary small mb-3">加入時長</p>
          <% period_labels = { "within7days"=>"7 天內","within30days"=>"30 天內","within90days"=>"90 天內","within180days"=>"180 天內","within365days"=>"一年內","over365days"=>"一年以上" } %>
          <% @demographic["subscriptionPeriods"].each do |p| %>
            <div class="d-flex justify-content-between small mb-1">
              <span><%= period_labels[p["subscriptionPeriod"]] || p["subscriptionPeriod"] %></span><span class="fw-bold"><%= p["percentage"] %>%</span>
            </div>
            <div class="mb-2" style="background:#e9ecef;border-radius:4px;height:8px;">
              <div style="width:<%= p['percentage'] %>%;background:#6f42c1;height:100%;border-radius:4px;"></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<%# 近 30 天趨勢表 %>
<% if @recent_stats.size > 1 %>
  <div class="card border-0 shadow-sm mb-5">
    <div class="card-header bg-white fw-semibold text-secondary py-2">近期每日紀錄</div>
    <div class="card-body p-0 table-responsive">
      <table class="table table-sm align-middle text-center mb-0" style="font-size:0.82rem;">
        <thead class="table-light">
          <tr>
            <th class="text-start ps-3">日期</th>
            <th>LINE 好友</th>
            <th>好友＋會員</th>
            <th>行動會員卡</th>
            <th>未綁定已消費</th>
            <th>SL 會員</th>
            <th>有消費</th>
            <th>推播則數</th>
            <th>回覆則數</th>
          </tr>
        </thead>
        <tbody>
          <% @recent_stats.each_with_index do |s, i| %>
            <% prev = @recent_stats[i + 1] %>
            <tr>
              <td class="text-start ps-3 fw-semibold"><%= s.stat_date.strftime("%m/%d") %></td>
              <td class="text-success">
                <%= s.line_friends ? number_with_delimiter(s.line_friends) : "—" %>
                <%= delta_badge(s.line_friends, prev&.line_friends).html_safe %>
              </td>
              <td><%= s.line_and_sl_members ? number_with_delimiter(s.line_and_sl_members) : "—" %><%= delta_badge(s.line_and_sl_members, prev&.line_and_sl_members).html_safe %></td>
              <td><%= s.line_bound_members ? number_with_delimiter(s.line_bound_members) : "—" %><%= delta_badge(s.line_bound_members, prev&.line_bound_members).html_safe %></td>
              <td><%= s.unbound_purchased ? number_with_delimiter(s.unbound_purchased) : "—" %><%= delta_badge(s.unbound_purchased, prev&.unbound_purchased).html_safe %></td>
              <td><%= s.sl_total_members ? number_with_delimiter(s.sl_total_members) : "—" %><%= delta_badge(s.sl_total_members, prev&.sl_total_members).html_safe %></td>
              <td><%= s.sl_purchased_members ? number_with_delimiter(s.sl_purchased_members) : "—" %><%= delta_badge(s.sl_purchased_members, prev&.sl_purchased_members).html_safe %></td>
              <td class="text-muted"><%= s.api_push ? number_with_delimiter(s.api_push) : "—" %></td>
              <td class="text-muted"><%= s.api_reply ? number_with_delimiter(s.api_reply) : "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<% content_for :scripts_block do %>
<script>
document.querySelectorAll('input[data-yesterday]').forEach(function(input) {
  var targetId = input.dataset.deltaTarget;
  input.addEventListener('input', function() {
    var today = parseInt(this.value);
    var yesterday = parseInt(this.dataset.yesterday);
    var cell = document.getElementById(targetId);
    if (!cell) return;
    if (isNaN(today) || isNaN(yesterday)) { cell.innerHTML = ''; return; }
    var diff = today - yesterday;
    if (diff === 0) { cell.innerHTML = ''; return; }
    var color = diff > 0 ? 'success' : 'danger';
    var sign  = diff > 0 ? '+' : '';
    cell.innerHTML = '<span class="fw-semibold text-' + color + '" style="font-size:0.85rem;">' + sign + diff + '</span>';
  });
});
</script>
<% end %>
