<%# app/views/member_contacts/index.html.erb %>
<% content_for :page_title, "會員分群" %>

<div class="row g-3 mb-4">
  <div class="col-12">
    <h4 class="fw-bold mb-0">會員分群</h4>
    <p class="text-muted small mb-0">依卡別 × 活躍度分群，可匯出 Email / Line ID</p>
    <p class="text-muted small mb-0 mt-1">
      <span class="me-3">最後更新：<strong>2026/6/10</strong></span>
      <span>下次更新：<strong>2026/7/10</strong></span>
    </p>
  </div>
</div>

<%# 總覽卡片 %>
<div class="row g-3 mb-4">
  <% [
    ["總會員數",     @total,          "text-primary",  "fa-users"],
    ["活躍（一年半內）", @total_active,  "text-success",  "fa-user-check"],
    ["不活躍（逾一年半）", @total_inactive, "text-danger", "fa-user-times"],
    ["有 Email",    @total_email,    "text-secondary", "fa-envelope"],
    ["有 Line ID",  @total_line,     "text-success",   "fa-comment"],
  ].each do |label, count, color, icon| %>
    <div class="col">
      <div class="card border-0 shadow-sm text-center py-3">
        <div class="mb-1"><i class="fal <%= icon %> <%= color %>"></i></div>
        <div class="fw-bold <%= color %>" style="font-size: 1.8rem; line-height: 1;"><%= number_with_delimiter(count) %></div>
        <div class="text-muted small mt-1"><%= label %></div>
      </div>
    </div>
  <% end %>
</div>

<%# 卡別 × 活躍度分群表 %>
<div class="d-flex align-items-center mb-3">
  <div class="border-start border-3 border-secondary ps-3">
    <h5 class="fw-bold mb-0 text-secondary">📊 卡別分群統計</h5>
    <p class="text-muted small mb-0">活躍 = 一年半內有消費紀錄</p>
  </div>
</div>

<div class="card border-0 shadow-sm mb-5">
  <div class="card-body p-0 table-responsive">
    <table class="table align-middle mb-0 text-center" style="font-size: 0.9rem;">
      <thead style="background-color: #4a4a4a; color: white;">
        <tr>
          <th class="text-start ps-3">卡別</th>
          <th>總人數</th>
          <th>活躍<span class="ms-1 small opacity-75">（一年半內）</span></th>
          <th>不活躍<span class="ms-1 small opacity-75">（逾一年半）</span></th>
          <th>活躍率</th>
          <th>有 Email</th>
          <th>有 Line ID</th>
          <th>匯出（全部）</th>
          <th>匯出（活躍）</th>
          <th>匯出（不活躍）</th>
        </tr>
      </thead>
      <tbody>
        <% @stats.each do |s| %>
          <% active_rate = s[:total] > 0 ? (s[:active].to_f / s[:total] * 100).round(1) : 0 %>
          <tr>
            <td class="fw-bold text-start ps-3"><%= s[:level] %></td>
            <td class="fw-semibold"><%= number_with_delimiter(s[:total]) %></td>
            <td class="text-success fw-semibold"><%= s[:active] %></td>
            <td class="text-danger"><%= s[:inactive] %></td>
            <td>
              <div class="d-flex align-items-center gap-1 justify-content-center">
                <div style="width:50px; background:#e9ecef; border-radius:4px; height:8px; overflow:hidden;">
                  <div style="width:<%= active_rate %>%; background:#198754; height:100%;"></div>
                </div>
                <span class="small"><%= active_rate %>%</span>
              </div>
            </td>
            <td class="text-muted"><%= s[:has_email] %></td>
            <td class="text-muted"><%= s[:has_line] %></td>
            <td><%= link_to "⬇ 全部", member_contacts_export_path(level: s[:level]), class: "btn btn-xs btn-outline-secondary py-0 px-2", style: "font-size:0.78rem;" %></td>
            <td><%= link_to "⬇ 活躍", member_contacts_export_path(level: s[:level], activity: 'active'), class: "btn btn-xs btn-outline-success py-0 px-2", style: "font-size:0.78rem;" %></td>
            <td><%= link_to "⬇ 不活躍", member_contacts_export_path(level: s[:level], activity: 'inactive'), class: "btn btn-xs btn-outline-danger py-0 px-2", style: "font-size:0.78rem;" %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot style="background-color: #f8f9fa; font-weight: 700;">
        <tr>
          <td class="text-start ps-3">合計</td>
          <td><%= number_with_delimiter(@total) %></td>
          <td class="text-success"><%= number_with_delimiter(@total_active) %></td>
          <td class="text-danger"><%= number_with_delimiter(@total_inactive) %></td>
          <td>
            <% total_rate = @total > 0 ? (@total_active.to_f / @total * 100).round(1) : 0 %>
            <%= total_rate %>%
          </td>
          <td class="text-muted"><%= number_with_delimiter(@total_email) %></td>
          <td class="text-muted"><%= number_with_delimiter(@total_line) %></td>
          <td><%= link_to "⬇ 全部", member_contacts_export_path, class: "btn btn-xs btn-secondary py-0 px-2", style: "font-size:0.78rem;" %></td>
          <td><%= link_to "⬇ 活躍", member_contacts_export_path(activity: 'active'), class: "btn btn-xs btn-success py-0 px-2", style: "font-size:0.78rem;" %></td>
          <td><%= link_to "⬇ 不活躍", member_contacts_export_path(activity: 'inactive'), class: "btn btn-xs btn-danger py-0 px-2", style: "font-size:0.78rem;" %></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<%# 說明 %>
<div class="card border-0 bg-light mb-4">
  <div class="card-body py-2 px-3 text-muted small">
    <strong>活躍定義：</strong>最近一年半（548 天）內有消費紀錄。｜
    <strong>匯出欄位：</strong>姓名、卡別、Email、Line ID、手機、狀態、上次消費日。｜
    統計對象：有 Shopline ID 的正式會員（黑卡～一般會員）。
  </div>
</div>

<%# ── 每日數據追蹤 ────────────────────────────────── %>
<div class="d-flex align-items-center mb-3">
  <div class="border-start border-3 border-success ps-3">
    <h5 class="fw-bold mb-0 text-success">📈 每日數據追蹤</h5>
    <p class="text-muted small mb-0">今日：<%= Date.today.strftime("%Y/%m/%d") %></p>
  </div>
</div>

<%# 今日數字卡片 + 輸入 %>
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <div class="row g-3 mb-3">
      <%# LINE 自動欄位 %>
      <% [
        ["LINE 好友數", @today_stat.line_friends, "text-success"],
        ["曾加入好友", @today_stat.line_followers, "text-secondary"],
        ["封鎖數",     @today_stat.line_blocks,    "text-danger"],
      ].each do |label, val, color| %>
        <div class="col-auto">
          <div class="card border-0 bg-light text-center px-4 py-2">
            <div class="fw-bold <%= color %>" style="font-size:1.5rem;"><%= val ? number_with_delimiter(val) : "—" %></div>
            <div class="text-muted small"><%= label %></div>
          </div>
        </div>
      <% end %>
      <div class="col-auto d-flex align-items-center">
        <%= button_to "🔄 更新 LINE", member_contacts_refresh_line_path,
              method: :post, class: "btn btn-sm btn-outline-success" %>
      </div>
    </div>

    <%# Shopline 手動輸入 %>
    <hr class="my-3">
    <p class="text-muted small mb-2 fw-semibold">Shopline 數據（手動輸入）</p>
    <%= form_with url: member_contacts_update_sl_path, method: :post, class: "row g-2 align-items-end" do |f| %>
      <%= f.fields_for :daily_member_stat, @today_stat do |ff| %>
        <% [
          ["SL 會員總數",         :sl_total_members],
          ["有消費人數",           :sl_purchased_members],
          ["LINE+是網站會員",      :line_and_sl_members],
          ["行動會員卡綁定",       :line_bound_members],
          ["未綁定但已消費",       :unbound_purchased],
        ].each do |label, field| %>
          <div class="col-auto">
            <label class="form-label text-muted small mb-0"><%= label %></label>
            <%= ff.number_field field, value: @today_stat.send(field),
                  class: "form-control form-control-sm", style: "width:110px;", placeholder: "—" %>
          </div>
        <% end %>
        <div class="col-auto">
          <%= button_tag "儲存", type: "submit", class: "btn btn-sm btn-primary" %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<%# 近 30 天趨勢表 %>
<% if @recent_stats.any? %>
  <div class="card border-0 shadow-sm mb-5">
    <div class="card-header bg-white fw-semibold text-secondary py-2">近期每日紀錄</div>
    <div class="card-body p-0 table-responsive">
      <table class="table table-sm align-middle text-center mb-0" style="font-size:0.82rem;">
        <thead class="table-light">
          <tr>
            <th class="text-start ps-3">日期</th>
            <th>LINE 好友</th>
            <th>曾加入</th>
            <th>封鎖</th>
            <th>SL 會員</th>
            <th>有消費</th>
            <th>LINE+會員</th>
            <th>行動會員卡</th>
            <th>未綁定已消費</th>
          </tr>
        </thead>
        <tbody>
          <% @recent_stats.each do |s| %>
            <tr>
              <td class="text-start ps-3 fw-semibold"><%= s.stat_date.strftime("%m/%d") %></td>
              <td class="text-success"><%= s.line_friends ? number_with_delimiter(s.line_friends) : "—" %></td>
              <td class="text-muted"><%= s.line_followers ? number_with_delimiter(s.line_followers) : "—" %></td>
              <td class="text-danger"><%= s.line_blocks ? number_with_delimiter(s.line_blocks) : "—" %></td>
              <td><%= s.sl_total_members ? number_with_delimiter(s.sl_total_members) : "—" %></td>
              <td><%= s.sl_purchased_members ? number_with_delimiter(s.sl_purchased_members) : "—" %></td>
              <td><%= s.line_and_sl_members ? number_with_delimiter(s.line_and_sl_members) : "—" %></td>
              <td><%= s.line_bound_members ? number_with_delimiter(s.line_bound_members) : "—" %></td>
              <td><%= s.unbound_purchased ? number_with_delimiter(s.unbound_purchased) : "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
