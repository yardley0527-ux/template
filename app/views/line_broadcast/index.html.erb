<%# app/views/line_broadcast/index.html.erb %>
<% content_for :page_title, "LINE 推播分析" %>

<%
  def fmt_n(n);     number_with_delimiter(n.to_i); end
  def fmt_money(n); "NT$#{number_with_delimiter(n.to_i)}"; end
  def fmt_pct(n);   n && n > 0 ? "#{n}%" : "—"; end

  near_day_label = ->(d) {
    return "—" unless d
    d == 0 ? "直播當天" : d > 0 ? "直播後 #{d} 天" : "直播前 #{d.abs} 天"
  }
%>

<%# ── Header ── %>
<div class="row g-3 mb-3">
  <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <h4 class="fw-bold mb-0">LINE 推播分析</h4>
      <p class="text-muted small mb-0">最後更新：<%= @data["last_updated"] %></p>
    </div>
    <%# 年份切換 %>
    <div class="d-flex gap-2 flex-wrap">
      <% @year_summary.each do |ys| %>
        <a href="<%= line_broadcast_path(year: ys[:year]) %>"
           class="btn btn-sm <%= @selected_year == ys[:year] ? 'btn-primary' : 'btn-outline-secondary' %>">
          <%= ys[:year] %>年
          <span class="ml-1" style="font-size:11px">
            <%= fmt_n(ys[:count]) %>次 / <%= fmt_money(ys[:revenue]) %>
          </span>
        </a>
      <% end %>
    </div>
  </div>
</div>

<%# ── 關鍵結論 ── %>
<%
  best_wday_ins  = @weekday_stats&.max_by { |w| w[:avg_revenue] }
  best_hour_ins  = @hour_stats&.max_by    { |h| h[:avg_revenue] }
  best_month_ins = @monthly&.max_by       { |m| m[:revenue] }
  best_rev_ins   = @broadcasts&.max_by    { |b| b["revenue"].to_f }

  # 直播最佳時間點
  near_by_day = (-3..3).map do |d|
    rows = @near_broadcasts.select { |b| b["near_days"] == d }
    next if rows.empty?
    avg_rev = rows.sum { |b| b["revenue"].to_f } / rows.size
    { day: d, avg_rev: avg_rev, count: rows.size }
  end.compact
  best_near_slot = near_by_day.max_by { |r| r[:avg_rev] }
  best_near_vs   = best_near_slot && @avg_revenue_per_push > 0 ?
    ((best_near_slot[:avg_rev] / @avg_revenue_per_push - 1) * 100).round : nil

  _sorted_m = @monthly.reverse
  half2 = (_sorted_m.size / 2.0).ceil
  fh = _sorted_m.first(half2).map { |m| m[:revenue] }.then { |r| r.empty? ? 0 : r.sum / r.size }
  sh = _sorted_m.last(_sorted_m.size - half2).map { |m| m[:revenue] }.then { |r| r.empty? ? 0 : r.sum / r.size }
  trend_pct = fh > 0 ? ((sh / fh - 1) * 100).round : nil
%>
<div class="card border-0 mb-4" style="background:linear-gradient(135deg,#1a2a4a 0%,#2d4a7a 100%);color:#fff">
  <div class="card-body px-4 py-3">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <span class="fw-bold" style="font-size:0.8rem;letter-spacing:.1em;text-transform:uppercase;opacity:.7"><%= @selected_year %> 年 LINE 推播 — 關鍵結論</span>
      <span style="font-size:0.75rem;opacity:.5">供行銷策略參考</span>
    </div>
    <div class="row g-3">

      <% if best_wday_ins && best_hour_ins %>
      <div class="col-md-4">
        <div class="p-3 rounded" style="background:rgba(255,255,255,.08)">
          <div style="font-size:.75rem;opacity:.6;margin-bottom:4px">最佳推播時機</div>
          <div class="fw-bold" style="font-size:1.1rem">
            <%= best_wday_ins[:label] %> × <%= best_hour_ins[:label] %>
          </div>
          <div style="font-size:.82rem;opacity:.8;margin-top:4px">
            <%= best_wday_ins[:label] %> 平均每次 <%= fmt_money(best_wday_ins[:avg_revenue]) %>，
            <%= best_hour_ins[:label] %> 時段平均 <%= fmt_money(best_hour_ins[:avg_revenue]) %>
          </div>
          <div class="mt-2" style="font-size:.78rem;background:rgba(255,193,7,.2);border-left:3px solid #ffc107;padding:4px 8px;border-radius:2px">
            建議：固定排在 <%= best_wday_ins[:label] %> <%= best_hour_ins[:label] %>
          </div>
        </div>
      </div>
      <% end %>

      <% if best_near_slot && best_near_vs %>
      <div class="col-md-4">
        <div class="p-3 rounded" style="background:rgba(255,255,255,.08)">
          <div style="font-size:.75rem;opacity:.6;margin-bottom:4px">直播連動最佳時間點</div>
          <div class="fw-bold" style="font-size:1.1rem">
            <%= near_day_label.call(best_near_slot[:day]) %>
          </div>
          <div style="font-size:.82rem;opacity:.8;margin-top:4px">
            平均每次 <%= fmt_money(best_near_slot[:avg_rev]) %>，
            比全年均值 <span style="color:<%= best_near_vs >= 0 ? '#6fcf97' : '#eb5757' %>"><%= best_near_vs >= 0 ? "+#{best_near_vs}" : best_near_vs %>%</span>
          </div>
          <div class="mt-2" style="font-size:.78rem;background:rgba(255,193,7,.2);border-left:3px solid #ffc107;padding:4px 8px;border-radius:2px">
            建議：直播前後都要推，<%= near_day_label.call(best_near_slot[:day]) %>效果最強
          </div>
        </div>
      </div>
      <% end %>

      <% if best_month_ins %>
      <div class="col-md-4">
        <div class="p-3 rounded" style="background:rgba(255,255,255,.08)">
          <div style="font-size:.75rem;opacity:.6;margin-bottom:4px">年度表現趨勢</div>
          <% if trend_pct %>
            <div class="fw-bold" style="font-size:1.1rem">
              下半年 <%= trend_pct >= 0 ? "↑ 成長 #{trend_pct}%" : "↓ 下滑 #{trend_pct.abs}%" %>
            </div>
          <% end %>
          <div style="font-size:.82rem;opacity:.8;margin-top:4px">
            最佳月份：<%= @selected_year %>/<%= best_month_ins[:month] %>（<%= fmt_money(best_month_ins[:revenue]) %>）
          </div>
          <% if best_rev_ins %>
          <div style="font-size:.78rem;opacity:.7;margin-top:4px">
            單次最高：「<%= best_rev_ins["topic"] %>」<%= fmt_money(best_rev_ins["revenue"]) %>
          </div>
          <% end %>
        </div>
      </div>
      <% end %>

    </div>
  </div>
</div>

<%# ── 總覽卡片 ── %>
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm text-center py-3">
      <div class="text-muted small">推播次數</div>
      <div class="fw-bold" style="font-size:1.6rem"><%= fmt_n(@total_broadcasts) %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm text-center py-3">
      <div class="text-muted small">總營收</div>
      <div class="fw-bold text-success" style="font-size:1.4rem"><%= fmt_money(@total_revenue) %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm text-center py-3">
      <div class="text-muted small">平均閱讀率</div>
      <div class="fw-bold" style="font-size:1.6rem"><%= fmt_pct(@avg_read_rate&.round(1)) %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm text-center py-3">
      <div class="text-muted small">直播附近推播</div>
      <div class="fw-bold text-warning" style="font-size:1.6rem"><%= @near_livestream_count %></div>
      <div class="text-muted" style="font-size:11px">（±3天內）</div>
    </div>
  </div>
</div>

<%# ── 文字分析 ── %>
<%
  best_month   = @monthly.max_by { |m| m[:revenue] }
  worst_month  = @monthly.min_by { |m| m[:revenue] }
  best_wday    = @weekday_stats.max_by { |w| w[:avg_revenue] }
  best_hour    = @hour_stats.max_by { |h| h[:avg_revenue] }

  # 月度趨勢：後半段 vs 前半段平均營收（@monthly 已反序，需先還原時序）
  _sorted_monthly = @monthly.reverse
  half = (_sorted_monthly.size / 2.0).ceil
  first_half_avg  = _sorted_monthly.first(half).map { |m| m[:revenue] }.then { |r| r.empty? ? 0 : r.sum / r.size }
  second_half_avg = _sorted_monthly.last(_sorted_monthly.size - half).map { |m| m[:revenue] }.then { |r| r.empty? ? 0 : r.sum / r.size }
  trend_up = second_half_avg > first_half_avg
%>
<p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2"><%= @selected_year %> 年分析摘要</p>
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <div class="row g-3">

      <%# 整體表現 %>
      <div class="col-12">
        <div class="fw-bold mb-2" style="font-size:0.85rem;color:#888;text-transform:uppercase;letter-spacing:.05em">整體表現</div>
        <p class="mb-1">
          <%= @selected_year %> 年共執行 <strong><%= @total_broadcasts %> 次</strong>推播，帶來總營收
          <strong class="text-success"><%= fmt_money(@total_revenue) %></strong>、
          訂單 <strong><%= fmt_n(@total_orders) %> 筆</strong>，
          平均每次推播貢獻 <strong><%= fmt_money(@avg_revenue_per_push) %></strong>。
        </p>
        <p class="mb-0 text-muted small">
          平均已讀率 <%= fmt_pct(@avg_read_rate&.round(1)) %>，平均 CTR <%= fmt_pct(@avg_ctr&.round(2)) %>。
          <% if @monthly.size >= 4 %>
            下半年整體表現較上半年<% if trend_up %>
              <span class="text-success fw-bold">提升</span>（平均月收 <%= fmt_money(second_half_avg) %> vs <%= fmt_money(first_half_avg) %>）。
            <% else %>
              <span class="text-danger fw-bold">下滑</span>（平均月收 <%= fmt_money(second_half_avg) %> vs <%= fmt_money(first_half_avg) %>）。
            <% end %>
          <% end %>
        </p>
      </div>

      <div class="col-12"><hr class="my-1"></div>

      <%# 月份亮點 %>
      <div class="col-md-6">
        <div class="fw-bold mb-2" style="font-size:0.85rem;color:#888;text-transform:uppercase;letter-spacing:.05em">月份亮點</div>
        <% if best_month %>
          <p class="mb-1">
            <span class="badge badge-success mr-1">最佳月份</span>
            <strong><%= @selected_year %>/<%= best_month[:month] %></strong>：
            營收 <strong class="text-success"><%= fmt_money(best_month[:revenue]) %></strong>，
            共 <%= best_month[:count] %> 次推播，訂單 <%= fmt_n(best_month[:orders]) %> 筆。
          </p>
        <% end %>
        <% if worst_month && worst_month != best_month %>
          <p class="mb-0 text-muted small">
            表現最弱月份：<%= @selected_year %>/<%= worst_month[:month] %>（<%= fmt_money(worst_month[:revenue]) %>，<%= worst_month[:count] %> 次推播）。
          </p>
        <% end %>
      </div>

      <%# 推播亮點 %>
      <div class="col-md-6">
        <div class="fw-bold mb-2" style="font-size:0.85rem;color:#888;text-transform:uppercase;letter-spacing:.05em">推播亮點</div>
        <% if @best_revenue_broadcast %>
          <p class="mb-1">
            <span class="badge badge-warning mr-1">最高營收</span>
            「<strong><%= @best_revenue_broadcast["topic"] %></strong>」
            （<%= @best_revenue_broadcast["push_time"].to_s[0..9] %>）：
            <strong class="text-success"><%= fmt_money(@best_revenue_broadcast["revenue"]) %></strong>，
            訂單 <%= @best_revenue_broadcast["orders"] %> 筆。
          </p>
        <% end %>
        <% if @best_ctr_broadcast %>
          <p class="mb-0 text-muted small">
            CTR 最高：「<%= @best_ctr_broadcast["topic"] %>」<%= fmt_pct(@best_ctr_broadcast["ctr"]) %>
            （<%= @best_ctr_broadcast["push_time"].to_s[0..9] %>）。
          </p>
        <% end %>
      </div>

      <div class="col-12"><hr class="my-1"></div>

      <%# 時機建議 %>
      <div class="col-md-6">
        <div class="fw-bold mb-2" style="font-size:0.85rem;color:#888;text-transform:uppercase;letter-spacing:.05em">最佳推播時機</div>
        <% if best_wday %>
          <p class="mb-1">
            <span class="badge badge-primary mr-1">最佳星期</span>
            <strong><%= best_wday[:label] %></strong>：
            平均每次 <strong><%= fmt_money(best_wday[:avg_revenue]) %></strong>，
            CTR <%= fmt_pct(best_wday[:avg_ctr]) %>。
          </p>
        <% end %>
        <% if best_hour %>
          <p class="mb-0 text-muted small">
            最佳時段：<strong><%= best_hour[:label] %></strong>，平均每次 <%= fmt_money(best_hour[:avg_revenue]) %>。
          </p>
        <% end %>
      </div>

      <%# 直播連動 %>
      <% if @near_livestream_count > 0 %>
        <div class="col-md-6">
          <div class="fw-bold mb-2" style="font-size:0.85rem;color:#888;text-transform:uppercase;letter-spacing:.05em">直播連動</div>
          <%
            near_rev = @near_broadcasts.sum { |b| b["revenue"].to_f }
            near_avg = @near_broadcasts.size > 0 ? near_rev / @near_broadcasts.size : 0
            all_avg  = @avg_revenue_per_push
          %>
          <p class="mb-1">
            直播日期前後 3 天共 <strong><%= @near_livestream_count %> 次</strong>推播，
            平均每次 <strong class="<%= near_avg > all_avg ? 'text-success' : 'text-danger' %>"><%= fmt_money(near_avg) %></strong>
            （全年均 <%= fmt_money(all_avg) %>）。
          </p>
          <p class="mb-0 text-muted small">
            直播前後推播效益<% if near_avg > all_avg %>
              <strong class="text-success">高於</strong>一般推播 +<%= ((near_avg / all_avg - 1) * 100).round %>%。
            <% else %>
              <strong class="text-muted">低於</strong>一般推播。
            <% end %>
          </p>
        </div>
      <% end %>

    </div>
  </div>
</div>

<%# ── 月份成效表 ── %>
<p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">每月成效</p>
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover table-sm mb-0 align-middle">
        <thead class="thead-light">
          <tr>
            <th class="px-3">月份</th>
            <th class="text-center">次數</th>
            <th class="text-right">總營收</th>
            <th class="text-right">訂單數</th>
            <th class="text-center">閱讀率</th>
            <th class="text-center">CTR</th>
            <th class="text-center">直播附近</th>
            <th>當月最佳推播</th>
          </tr>
        </thead>
        <tbody>
          <% @monthly.each do |m| %>
            <tr>
              <td class="px-3 fw-bold"><%= @selected_year %>/<%= m[:month] %></td>
              <td class="text-center"><%= m[:count] %></td>
              <td class="text-right text-success fw-bold"><%= fmt_money(m[:revenue]) %></td>
              <td class="text-right"><%= fmt_n(m[:orders]) %></td>
              <td class="text-center"><%= fmt_pct(m[:avg_read_rate]) %></td>
              <td class="text-center"><%= fmt_pct(m[:avg_ctr]) %></td>
              <td class="text-center">
                <% if m[:near_count] > 0 %>
                  <span class="badge badge-warning"><%= m[:near_count] %> 次</span>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
              <td class="small text-muted" style="max-width:200px; white-space:normal;">
                <% if m[:best] %>
                  <%= m[:best]["topic"] %>
                  <span class="text-success fw-bold d-block"><%= fmt_money(m[:best]["revenue"]) %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%# ── 星期幾 & 時段 並排 ── %>
<div class="row g-3 mb-4">

  <div class="col-md-6">
    <p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">星期幾成效</p>
    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        <% max_rev = @weekday_stats.map { |w| w[:avg_revenue] }.max.to_f %>
        <table class="table table-sm mb-0 align-middle">
          <thead class="thead-light">
            <tr>
              <th class="px-3">星期</th>
              <th class="text-center">次數</th>
              <th class="text-right">平均每次營收</th>
              <th class="text-center">閱讀率</th>
              <th class="text-center">CTR</th>
            </tr>
          </thead>
          <tbody>
            <% @weekday_stats.each do |w| %>
              <% is_best = max_rev > 0 && w[:avg_revenue] == max_rev.to_i %>
              <tr class="<%= is_best ? 'table-success' : '' %>">
                <td class="px-3 fw-bold"><%= w[:label] %><%= " 🏆" if is_best %></td>
                <td class="text-center text-muted"><%= w[:count] %></td>
                <td class="text-right fw-bold"><%= fmt_money(w[:avg_revenue]) %></td>
                <td class="text-center"><%= fmt_pct(w[:avg_read_rate]) %></td>
                <td class="text-center"><%= fmt_pct(w[:avg_ctr]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">時段成效</p>
    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        <% max_rev_h = @hour_stats.map { |h| h[:avg_revenue] }.max.to_f %>
        <table class="table table-sm mb-0 align-middle">
          <thead class="thead-light">
            <tr>
              <th class="px-3">時段</th>
              <th class="text-center">次數</th>
              <th class="text-right">平均每次營收</th>
              <th class="text-center">閱讀率</th>
              <th class="text-center">CTR</th>
            </tr>
          </thead>
          <tbody>
            <% @hour_stats.each do |h| %>
              <% is_best_h = max_rev_h > 0 && h[:avg_revenue] == max_rev_h.to_i %>
              <tr class="<%= is_best_h ? 'table-success' : '' %>">
                <td class="px-3 fw-bold"><%= h[:label] %><%= " 🏆" if is_best_h %></td>
                <td class="text-center text-muted"><%= h[:count] %></td>
                <td class="text-right fw-bold"><%= fmt_money(h[:avg_revenue]) %></td>
                <td class="text-center"><%= fmt_pct(h[:avg_read_rate]) %></td>
                <td class="text-center"><%= fmt_pct(h[:avg_ctr]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>

<%# ── 直播連動分析 ── %>
<% if @near_broadcasts.any? %>
<%
  # 按距離分組
  by_day = (-3..3).map do |d|
    rows = @near_broadcasts.select { |b| b["near_days"] == d }
    next if rows.empty?
    avg_rev = rows.sum { |b| b["revenue"].to_f } / rows.size
    avg_ctr = rows.map { |b| b["ctr"].to_f }.select { |v| v > 0 }.then { |a| a.empty? ? 0 : a.sum / a.size }
    avg_read = rows.map { |b| b["read_rate"].to_f }.select { |v| v > 0 }.then { |a| a.empty? ? 0 : a.sum / a.size }
    vs_avg = @avg_revenue_per_push > 0 ? ((avg_rev / @avg_revenue_per_push - 1) * 100).round : 0
    { day: d, count: rows.size, avg_rev: avg_rev, avg_ctr: avg_ctr, avg_read: avg_read, vs_avg: vs_avg }
  end.compact

  best_slot = by_day.max_by { |r| r[:avg_rev] }
  overall_near_avg = @near_broadcasts.sum { |b| b["revenue"].to_f } / @near_broadcasts.size
  near_vs_all = @avg_revenue_per_push > 0 ? ((overall_near_avg / @avg_revenue_per_push - 1) * 100).round : 0
%>
<p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">直播連動分析</p>
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">

    <%# 整體結論 %>
    <p class="mb-3">
      <%= @selected_year %> 年共有 <strong><%= @near_broadcasts.size %> 次</strong>推播落在直播日前後 3 天，
      平均每次帶來 <strong class="<%= near_vs_all >= 0 ? 'text-success' : 'text-danger' %>"><%= fmt_money(overall_near_avg) %></strong>，
      比全年均值（<%= fmt_money(@avg_revenue_per_push) %>）
      <% if near_vs_all >= 0 %>
        <strong class="text-success">高 <%= near_vs_all %>%</strong>。
      <% else %>
        <strong class="text-danger">低 <%= near_vs_all.abs %>%</strong>。
      <% end %>
      <% if best_slot %>
        效果最好的時間點為
        <strong><%= near_day_label.call(best_slot[:day]) %></strong>（平均 <%= fmt_money(best_slot[:avg_rev]) %>）。
      <% end %>
    </p>

    <%# 各距離對比表 %>
    <div class="table-responsive">
      <table class="table table-sm mb-0 align-middle">
        <thead class="thead-light">
          <tr>
            <th class="px-3">與直播距離</th>
            <th class="text-center">推播次數</th>
            <th class="text-right">平均每次營收</th>
            <th class="text-right">vs 全年均值</th>
            <th class="text-center">平均閱讀率</th>
            <th class="text-center">平均 CTR</th>
          </tr>
        </thead>
        <tbody>
          <%# 全年均值對照列 %>
          <tr class="table-light">
            <td class="px-3 text-muted small">全年平均（基準）</td>
            <td class="text-center text-muted small"><%= @total_broadcasts %></td>
            <td class="text-right text-muted"><%= fmt_money(@avg_revenue_per_push) %></td>
            <td class="text-right text-muted">—</td>
            <td class="text-center text-muted"><%= fmt_pct(@avg_read_rate&.round(1)) %></td>
            <td class="text-center text-muted"><%= fmt_pct(@avg_ctr&.round(2)) %></td>
          </tr>
          <% by_day.sort_by { |r| r[:day] }.each do |r| %>
            <% is_best = best_slot && r[:day] == best_slot[:day] %>
            <tr class="<%= is_best ? 'table-success' : '' %>">
              <td class="px-3 fw-bold">
                <% color = r[:day] == 0 ? "danger" : r[:day].abs == 1 ? "warning" : "secondary" %>
                <span class="badge badge-<%= color %> mr-1"><%= near_day_label.call(r[:day]) %></span>
                <%= "🏆" if is_best %>
              </td>
              <td class="text-center"><%= r[:count] %></td>
              <td class="text-right fw-bold"><%= fmt_money(r[:avg_rev]) %></td>
              <td class="text-right fw-bold <%= r[:vs_avg] >= 10 ? 'text-success' : r[:vs_avg] <= -10 ? 'text-danger' : 'text-muted' %>">
                <%= r[:vs_avg] >= 0 ? "+#{r[:vs_avg]}%" : "#{r[:vs_avg]}%" %>
              </td>
              <td class="text-center"><%= fmt_pct(r[:avg_read].round(1)) %></td>
              <td class="text-center"><%= fmt_pct(r[:avg_ctr].round(2)) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  </div>
</div>
<% end %>

<%# ── 亮點推播（老闆看的圖片） ── %>
<% if @highlights.any? %>
  <p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">亮點推播</p>
  <div class="row g-3 mb-4">
    <% @highlights.each do |h| %>
      <div class="col-md-4 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
          <% if h["image_url"].present? %>
            <img src="<%= h["image_url"] %>" class="card-img-top"
                 style="object-fit:cover; max-height:240px;">
          <% end %>
          <div class="card-body">
            <div class="fw-bold small mb-1"><%= h["topic"] %></div>
            <div class="text-muted small mb-2"><%= h["push_time"].to_s[0..15] %></div>
            <% if h["note"].present? %>
              <p class="small mb-2"><%= h["note"] %></p>
            <% end %>
            <div class="d-flex gap-3 flex-wrap">
              <% if h["revenue"].to_f > 0 %>
                <span class="text-success fw-bold small"><%= fmt_money(h["revenue"]) %></span>
              <% end %>
              <% if h["read_rate"].to_f > 0 %>
                <span class="text-muted small">閱讀率 <%= fmt_pct(h["read_rate"]) %></span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
