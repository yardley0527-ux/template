<%# app/views/line_broadcast/index.html.erb %>
<% content_for :page_title, "LINE 推播分析" %>

<%
  def fmt_n(n);     number_with_delimiter(n.to_i); end
  def fmt_money(n); "NT$#{number_with_delimiter(n.to_i)}"; end
  def fmt_pct(n);   n && n > 0 ? "#{n}%" : "—"; end

  near_day_label = ->(d) {
    return "—" unless d
    d == 0 ? "直播當天" : d > 0 ? "直播後 #{d} 天" : "直播前 #{d.abs} 天"
  }
%>

<%# ── Header ── %>
<div class="row g-3 mb-3">
  <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <h4 class="fw-bold mb-0">LINE 推播分析</h4>
      <p class="text-muted small mb-0">最後更新：<%= @data["last_updated"] %></p>
    </div>
    <%# 年份切換 %>
    <div class="d-flex gap-2 flex-wrap">
      <% @year_summary.each do |ys| %>
        <a href="<%= line_broadcast_path(year: ys[:year]) %>"
           class="btn btn-sm <%= @selected_year == ys[:year] ? 'btn-primary' : 'btn-outline-secondary' %>">
          <%= ys[:year] %>年
          <span class="ml-1" style="font-size:11px">
            <%= fmt_n(ys[:count]) %>次 / <%= fmt_money(ys[:revenue]) %>
          </span>
        </a>
      <% end %>
    </div>
  </div>
</div>

<%# ── 總覽卡片 ── %>
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm text-center py-3">
      <div class="text-muted small">推播次數</div>
      <div class="fw-bold" style="font-size:1.6rem"><%= fmt_n(@total_broadcasts) %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm text-center py-3">
      <div class="text-muted small">總營收</div>
      <div class="fw-bold text-success" style="font-size:1.4rem"><%= fmt_money(@total_revenue) %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm text-center py-3">
      <div class="text-muted small">平均閱讀率</div>
      <div class="fw-bold" style="font-size:1.6rem"><%= fmt_pct(@avg_read_rate&.round(1)) %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm text-center py-3">
      <div class="text-muted small">直播附近推播</div>
      <div class="fw-bold text-warning" style="font-size:1.6rem"><%= @near_livestream_count %></div>
      <div class="text-muted" style="font-size:11px">（±3天內）</div>
    </div>
  </div>
</div>

<%# ── 月份成效表 ── %>
<p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">每月成效</p>
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover table-sm mb-0 align-middle">
        <thead class="thead-light">
          <tr>
            <th class="px-3">月份</th>
            <th class="text-center">次數</th>
            <th class="text-right">總營收</th>
            <th class="text-right">訂單數</th>
            <th class="text-center">閱讀率</th>
            <th class="text-center">CTR</th>
            <th class="text-center">直播附近</th>
            <th>當月最佳推播</th>
          </tr>
        </thead>
        <tbody>
          <% @monthly.each do |m| %>
            <tr>
              <td class="px-3 fw-bold"><%= @selected_year %>/<%= m[:month] %></td>
              <td class="text-center"><%= m[:count] %></td>
              <td class="text-right text-success fw-bold"><%= fmt_money(m[:revenue]) %></td>
              <td class="text-right"><%= fmt_n(m[:orders]) %></td>
              <td class="text-center"><%= fmt_pct(m[:avg_read_rate]) %></td>
              <td class="text-center"><%= fmt_pct(m[:avg_ctr]) %></td>
              <td class="text-center">
                <% if m[:near_count] > 0 %>
                  <span class="badge badge-warning"><%= m[:near_count] %> 次</span>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
              <td class="small text-muted" style="max-width:200px; white-space:normal;">
                <% if m[:best] %>
                  <%= m[:best]["topic"] %>
                  <span class="text-success fw-bold d-block"><%= fmt_money(m[:best]["revenue"]) %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%# ── 星期幾 & 時段 並排 ── %>
<div class="row g-3 mb-4">

  <div class="col-md-6">
    <p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">星期幾成效</p>
    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        <% max_rev = @weekday_stats.map { |w| w[:avg_revenue] }.max.to_f %>
        <table class="table table-sm mb-0 align-middle">
          <thead class="thead-light">
            <tr>
              <th class="px-3">星期</th>
              <th class="text-center">次數</th>
              <th class="text-right">平均每次營收</th>
              <th class="text-center">閱讀率</th>
              <th class="text-center">CTR</th>
            </tr>
          </thead>
          <tbody>
            <% @weekday_stats.each do |w| %>
              <% is_best = max_rev > 0 && w[:avg_revenue] == max_rev.to_i %>
              <tr class="<%= is_best ? 'table-success' : '' %>">
                <td class="px-3 fw-bold"><%= w[:label] %><%= " 🏆" if is_best %></td>
                <td class="text-center text-muted"><%= w[:count] %></td>
                <td class="text-right fw-bold"><%= fmt_money(w[:avg_revenue]) %></td>
                <td class="text-center"><%= fmt_pct(w[:avg_read_rate]) %></td>
                <td class="text-center"><%= fmt_pct(w[:avg_ctr]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">時段成效</p>
    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        <% max_rev_h = @hour_stats.map { |h| h[:avg_revenue] }.max.to_f %>
        <table class="table table-sm mb-0 align-middle">
          <thead class="thead-light">
            <tr>
              <th class="px-3">時段</th>
              <th class="text-center">次數</th>
              <th class="text-right">平均每次營收</th>
              <th class="text-center">閱讀率</th>
              <th class="text-center">CTR</th>
            </tr>
          </thead>
          <tbody>
            <% @hour_stats.each do |h| %>
              <% is_best_h = max_rev_h > 0 && h[:avg_revenue] == max_rev_h.to_i %>
              <tr class="<%= is_best_h ? 'table-success' : '' %>">
                <td class="px-3 fw-bold"><%= h[:label] %><%= " 🏆" if is_best_h %></td>
                <td class="text-center text-muted"><%= h[:count] %></td>
                <td class="text-right fw-bold"><%= fmt_money(h[:avg_revenue]) %></td>
                <td class="text-center"><%= fmt_pct(h[:avg_read_rate]) %></td>
                <td class="text-center"><%= fmt_pct(h[:avg_ctr]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>

<%# ── 直播附近的推播 ── %>
<% if @near_broadcasts.any? %>
  <p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">
    直播日期前後 3 天的推播（<%= @near_broadcasts.size %> 筆）
  </p>
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover table-sm mb-0 align-middle">
          <thead class="thead-light">
            <tr>
              <th class="px-3">推播主題</th>
              <th class="text-center">時間</th>
              <th class="text-center">星期</th>
              <th class="text-center">與直播距離</th>
              <th class="text-center">閱讀率</th>
              <th class="text-center">CTR</th>
              <th class="text-right">訂單</th>
              <th class="text-right">營收</th>
            </tr>
          </thead>
          <tbody>
            <% @near_broadcasts.each do |b| %>
              <tr>
                <td class="px-3 small" style="max-width:200px; white-space:normal"><%= b["topic"] %></td>
                <td class="text-center text-muted small"><%= b["push_time"].to_s[0..15] %></td>
                <td class="text-center text-muted small"><%= ["週一","週二","週三","週四","週五","週六","週日"][b["wday"].to_i] %></td>
                <td class="text-center">
                  <% d = b["near_days"] %>
                  <% color = d == 0 ? "danger" : d.abs == 1 ? "warning" : "secondary" %>
                  <span class="badge badge-<%= color %>"><%= near_day_label.call(d) %></span>
                </td>
                <td class="text-center"><%= fmt_pct(b["read_rate"]) %></td>
                <td class="text-center"><%= fmt_pct(b["ctr"]) %></td>
                <td class="text-right"><%= b["orders"] %></td>
                <td class="text-right fw-bold text-success"><%= fmt_money(b["revenue"]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% end %>

<%# ── 亮點推播（老闆看的圖片） ── %>
<% if @highlights.any? %>
  <p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">亮點推播</p>
  <div class="row g-3 mb-4">
    <% @highlights.each do |h| %>
      <div class="col-md-4 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
          <% if h["image_url"].present? %>
            <img src="<%= h["image_url"] %>" class="card-img-top"
                 style="object-fit:cover; max-height:240px;">
          <% end %>
          <div class="card-body">
            <div class="fw-bold small mb-1"><%= h["topic"] %></div>
            <div class="text-muted small mb-2"><%= h["push_time"].to_s[0..15] %></div>
            <% if h["note"].present? %>
              <p class="small mb-2"><%= h["note"] %></p>
            <% end %>
            <div class="d-flex gap-3 flex-wrap">
              <% if h["revenue"].to_f > 0 %>
                <span class="text-success fw-bold small"><%= fmt_money(h["revenue"]) %></span>
              <% end %>
              <% if h["read_rate"].to_f > 0 %>
                <span class="text-muted small">閱讀率 <%= fmt_pct(h["read_rate"]) %></span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
