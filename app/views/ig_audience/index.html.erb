<%# app/views/ig_audience/index.html.erb %>
<% content_for :page_title, "IG 受眾重疊分析" %>

<% unless @data %>
  <div class="alert alert-warning">
    尚無分析資料。請在本機執行 <code>rake ig:audience_analysis</code> 並將結果 JSON 推上來。
  </div>
<% else %>

<%# ── Header ── %>
<div class="row g-3 mb-3">
  <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <h4 class="fw-bold mb-0">IG 受眾重疊分析</h4>
      <p class="text-muted small mb-0">
        <a href="https://www.instagram.com/shengting_official" target="_blank" class="text-muted">@shengting_official</a>
        ✕
        <a href="https://www.instagram.com/chloechao0527" target="_blank" class="text-muted">@chloechao0527</a>
      </p>
    </div>
    <span class="text-muted small">最後更新：<%= @last_updated %></span>
  </div>
</div>

<%# ── 結論摘要（給老闆 & 社群同事） ── %>
<%
  target_count     = @target["count"]
  both_count       = @both["count"]
  chloe_only_count = @chloe_only["count"]
  neither_count    = @neither["count"]
  buyers_total     = target_count + both_count + chloe_only_count + neither_count

  chloe_buyer_pct    = buyers_total > 0 ? (chloe_only_count.to_f / buyers_total * 100).round(1) : 0
  neither_buyer_pct  = buyers_total > 0 ? (neither_count.to_f    / buyers_total * 100).round(1) : 0
  overlap_buyer_pct  = buyers_total > 0 ? (both_count.to_f       / buyers_total * 100).round(1) : 0
%>
<p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">分析結論</p>
<div class="card border-0 shadow-sm mb-4" style="border-left: 4px solid #4a6fa5 !important;">
  <div class="card-body">

    <p class="fw-bold mb-3" style="font-size:1rem">
      在 <%= number_with_delimiter(buyers_total) %> 位有購買紀錄且留有 IG 帳號的客戶中，受眾結構如下：
    </p>

    <div class="row g-3 mb-3">
      <div class="col-md-6">
        <div class="p-3 rounded" style="background:#fff8e1;">
          <div class="fw-bold mb-1">📌 Chloe 個人帳號的帶購影響力遠大於品牌帳號</div>
          <p class="small mb-0">
            有 <strong><%= number_with_delimiter(chloe_only_count) %> 人（<%= chloe_buyer_pct %>%）</strong>只追蹤 @chloechao0527、沒有追蹤品牌帳號，卻已購買。
            反過來，只追蹤品牌帳號就購買的僅有 <strong><%= target_count %> 人</strong>。
            代表大部分購買決策是被 Chloe 個人影響，品牌帳號對轉換的直接貢獻較小。
          </p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="p-3 rounded" style="background:#e8f5e9;">
          <div class="fw-bold mb-1">✅ 核心受眾：兩邊都追蹤的 <%= number_with_delimiter(both_count) %> 人（<%= overlap_buyer_pct %>%）</div>
          <p class="small mb-0">
            同時追蹤 @shengting_official 與 @chloechao0527 且有購買的客戶，是品牌最忠實的一群。
            這群人對兩邊的廣告都會看到，是重複曝光的核心族群，也最容易響應新品或活動通知。
          </p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="p-3 rounded" style="background:#fce4ec;">
          <div class="fw-bold mb-1">⚠️ <%= neither_buyer_pct %>% 的買家兩個帳號都沒追蹤</div>
          <p class="small mb-0">
            共 <strong><%= number_with_delimiter(neither_count) %> 人</strong>有購買但不追蹤任何一個帳號，
            可能來自搜尋、直播連結、親友分享等非 IG 管道。
            這群人目前在 IG 上無法被再行銷觸及，值得另外建立 LINE 或 EDM 名單。
          </p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="p-3 rounded" style="background:#e3f2fd;">
          <div class="fw-bold mb-1">💡 廣告投放建議</div>
          <p class="small mb-0">
            若 Chloe 廣告與品牌廣告分開投，<strong>應以 Chloe 帳號為主力</strong>——
            她的受眾中有購買行為的人數是品牌帳號的 <%= (chloe_only_count.to_f / [target_count, 1].max).round(0).to_i %> 倍。
            品牌帳號的廣告適合用來做<strong>既有買家的品牌感經營</strong>，而非主要獲客工具。
          </p>
        </div>
      </div>
    </div>

    <p class="text-muted small mb-0">
      資料來源：Instagram 帳號原生匯出（<%= @last_updated %>）✕ Shopline 客戶購買紀錄。
      比對依據：客戶填寫的 Instagram 帳號欄位（精準比對）。
    </p>

  </div>
</div>

<%# ── 帳號概覽 ── %>
<p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">帳號粉絲概覽</p>
<div class="row g-3 mb-4">
  <div class="col-md-3 col-6">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body text-center">
        <div class="text-muted small mb-1">@shengting_official</div>
        <div class="fw-bold" style="font-size:1.5rem"><%= number_with_delimiter(@shengting_followers) %></div>
        <div class="text-muted small">粉絲人數</div>
      </div>
    </div>
  </div>
  <div class="col-md-3 col-6">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body text-center">
        <div class="text-muted small mb-1">@chloechao0527</div>
        <div class="fw-bold" style="font-size:1.5rem"><%= number_with_delimiter(@chloe_followers) %></div>
        <div class="text-muted small">粉絲人數</div>
      </div>
    </div>
  </div>
  <div class="col-md-3 col-6">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body text-center">
        <div class="text-muted small mb-1">兩帳號粉絲重疊</div>
        <div class="fw-bold text-primary" style="font-size:1.5rem"><%= number_with_delimiter(@overlap_count) %></div>
        <div class="text-muted small">佔品牌粉絲 <%= @overlap_pct %>%</div>
      </div>
    </div>
  </div>
  <div class="col-md-3 col-6">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body text-center">
        <div class="text-muted small mb-1">有購買 + 有IG帳號</div>
        <div class="fw-bold text-success" style="font-size:1.5rem"><%= number_with_delimiter(@total_buyers) %></div>
        <div class="text-muted small">Shopline 買家</div>
      </div>
    </div>
  </div>
</div>

<%# ── 買家分群 ── %>
<p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">買家分群分析
  <span class="text-muted fw-normal" style="font-size:11px">（點擊卡片查看購買商品與時間分析）</span>
</p>
<div class="row g-3 mb-4">

  <%# 🎯 目標 %>
  <div class="col-md-3 col-6">
    <a href="<%= ig_audience_detail_path(tab: 'target') %>" class="text-decoration-none">
      <div class="card border-0 shadow-sm h-100" style="cursor:pointer; transition:box-shadow .15s;"
           onmouseover="this.style.boxShadow='0 4px 16px rgba(240,173,78,.35)'"
           onmouseout="this.style.boxShadow=''">
        <div class="card-body text-center">
          <div style="font-size:1.5rem">🎯</div>
          <div class="fw-bold" style="font-size:1.6rem; color:#f0ad4e"><%= number_with_delimiter(@target["count"]) %></div>
          <div class="small fw-bold">追蹤品牌＋有買</div>
          <div class="text-muted small">未追蹤 Chloe</div>
          <div class="text-muted mt-2" style="font-size:11px">點擊看購買分析 →</div>
        </div>
      </div>
    </a>
  </div>

  <%# ✅ 兩邊都追蹤 %>
  <div class="col-md-3 col-6">
    <a href="<%= ig_audience_detail_path(tab: 'both') %>" class="text-decoration-none">
      <div class="card border-0 shadow-sm h-100" style="cursor:pointer; transition:box-shadow .15s;"
           onmouseover="this.style.boxShadow='0 4px 16px rgba(92,184,92,.35)'"
           onmouseout="this.style.boxShadow=''">
        <div class="card-body text-center">
          <div style="font-size:1.5rem">✅</div>
          <div class="fw-bold" style="font-size:1.6rem; color:#5cb85c"><%= number_with_delimiter(@both["count"]) %></div>
          <div class="small fw-bold">兩邊都追蹤＋有買</div>
          <div class="text-muted small">核心受眾</div>
          <div class="text-muted mt-2" style="font-size:11px">點擊看購買分析 →</div>
        </div>
      </div>
    </a>
  </div>

  <%# 📌 只追 Chloe %>
  <div class="col-md-3 col-6">
    <a href="<%= ig_audience_detail_path(tab: 'chloe_only') %>" class="text-decoration-none">
      <div class="card border-0 shadow-sm h-100" style="cursor:pointer; transition:box-shadow .15s;"
           onmouseover="this.style.boxShadow='0 4px 16px rgba(51,122,183,.35)'"
           onmouseout="this.style.boxShadow=''">
        <div class="card-body text-center">
          <div style="font-size:1.5rem">📌</div>
          <div class="fw-bold" style="font-size:1.6rem; color:#337ab7"><%= number_with_delimiter(@chloe_only["count"]) %></div>
          <div class="small fw-bold">追蹤 Chloe＋有買</div>
          <div class="text-muted small">未追蹤品牌帳號</div>
          <div class="text-muted mt-2" style="font-size:11px">點擊看購買分析 →</div>
        </div>
      </div>
    </a>
  </div>

  <%# ⚪ 兩邊都沒追蹤 %>
  <div class="col-md-3 col-6">
    <a href="<%= ig_audience_detail_path(tab: 'neither') %>" class="text-decoration-none">
      <div class="card border-0 shadow-sm h-100" style="cursor:pointer; transition:box-shadow .15s;"
           onmouseover="this.style.boxShadow='0 4px 16px rgba(136,136,136,.3)'"
           onmouseout="this.style.boxShadow=''">
        <div class="card-body text-center">
          <div style="font-size:1.5rem">⚪</div>
          <div class="fw-bold" style="font-size:1.6rem; color:#888"><%= number_with_delimiter(@neither["count"]) %></div>
          <div class="small fw-bold">有買</div>
          <div class="text-muted small">兩邊都未追蹤</div>
          <div class="text-muted mt-2" style="font-size:11px">點擊看購買分析 →</div>
        </div>
      </div>
    </a>
  </div>

</div>

<%# ── 分群分析面板 ── %>
<%
  tab_meta = {
    "target"     => { label: "🎯 追蹤品牌＋有買＋未追蹤 Chloe",  color: "#f0ad4e" },
    "both"       => { label: "✅ 兩邊都追蹤＋有買（核心受眾）",    color: "#5cb85c" },
    "chloe_only" => { label: "📌 追蹤 Chloe＋有買＋未追蹤品牌",   color: "#337ab7" },
    "neither"    => { label: "⚪ 有買但兩邊都未追蹤",              color: "#888"    }
  }
  current = tab_meta[@active_tab]
  wday_names = %w[週日 週一 週二 週三 週四 週五 週六]
  hour_slots = [
    { label: "凌晨 0–5",   hours: (0..5) },
    { label: "早上 6–9",   hours: (6..9) },
    { label: "上午 10–12", hours: (10..11) },
    { label: "中午 12–14", hours: (12..13) },
    { label: "下午 14–18", hours: (14..17) },
    { label: "晚上 18–22", hours: (18..21) },
    { label: "深夜 22–24", hours: (22..23) },
  ]
  by_hour_map = (@tab_by_hour || []).index_by { |r| r.hour.to_i }
  slotted = hour_slots.map do |s|
    rows = s[:hours].map { |h| by_hour_map[h] }.compact
    next nil if rows.empty?
    { label: s[:label], orders: rows.sum { |r| r.order_count.to_i }, revenue: rows.sum { |r| r.revenue.to_f } }
  end.compact
%>

<%# Tab 切換列 %>
<div class="d-flex gap-2 flex-wrap mb-3">
  <% tab_meta.each do |key, meta| %>
    <a href="<%= ig_audience_path(tab: key) %>"
       class="btn btn-sm <%= @active_tab == key ? 'btn-primary' : 'btn-outline-secondary' %>">
      <%= meta[:label] %>
    </a>
  <% end %>
</div>

<div class="card border-0 shadow-sm mb-4" style="border-top: 3px solid <%= current[:color] %> !important;">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span class="fw-bold"><%= current[:label] %>（<%= @active_count %> 人）</span>
    <div class="d-flex gap-2">
      <%= link_to ig_audience_detail_path(tab: @active_tab), class: "btn btn-sm btn-outline-primary" do %>
        <i class="fa fa-expand mr-1"></i> 完整分析
      <% end %>
      <%= link_to ig_audience_export_path(tab: @active_tab), class: "btn btn-sm btn-outline-secondary" do %>
        <i class="fa fa-download mr-1"></i> 下載 CSV
      <% end %>
    </div>
  </div>

  <div class="card-body">

    <%# ── 商品排行 Top 10 ── %>
    <p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">購買商品排行 Top 10</p>
    <% if @tab_top_products&.any? %>
      <% total_rev = @tab_top_products.sum { |p| p.total_revenue.to_f } %>
      <div class="table-responsive mb-4">
        <table class="table table-sm mb-0 align-middle">
          <thead class="thead-light">
            <tr>
              <th class="px-2" style="width:28px">#</th>
              <th>商品</th>
              <th class="text-right">人數</th>
              <th class="text-right">數量</th>
              <th class="text-right">營收</th>
              <th style="width:140px">佔比</th>
            </tr>
          </thead>
          <tbody>
            <% @tab_top_products.each_with_index do |p, i| %>
              <% pct = total_rev > 0 ? (p.total_revenue.to_f / total_rev * 100).round(1) : 0 %>
              <tr>
                <td class="px-2 text-muted small"><%= i + 1 %></td>
                <td class="fw-bold small"><%= p.product_name %></td>
                <td class="text-right text-muted small"><%= p.buyer_count %> 人</td>
                <td class="text-right text-muted small"><%= number_with_delimiter(p.total_qty) %></td>
                <td class="text-right text-success fw-bold small">NT$<%= number_with_delimiter(p.total_revenue.to_i) %></td>
                <td>
                  <div class="d-flex align-items-center gap-1">
                    <div style="flex:1;background:#f0f0f0;border-radius:3px;height:7px;overflow:hidden;">
                      <div style="width:<%= pct %>%;background:<%= i == 0 ? current[:color] : '#adb5bd' %>;height:7px;"></div>
                    </div>
                    <span class="text-muted" style="font-size:11px;min-width:32px"><%= pct %>%</span>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <%# ── 星期 & 時段 ── %>
    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">星期幾下單</p>
        <% max_wday = (@tab_by_weekday || []).map { |r| r.revenue.to_f }.max.to_f %>
        <table class="table table-sm mb-0">
          <tbody>
            <% (@tab_by_weekday || []).each do |r| %>
              <% pct = max_wday > 0 ? (r.revenue.to_f / max_wday * 100).round : 0 %>
              <% is_best = r.revenue.to_f == max_wday %>
              <tr class="<%= is_best ? 'table-warning' : '' %>">
                <td class="px-2 fw-bold small" style="width:60px"><%= wday_names[r.dow.to_i] %></td>
                <td>
                  <div style="background:#f0f0f0;border-radius:3px;height:7px;overflow:hidden;">
                    <div style="width:<%= pct %>%;background:#5bc0de;height:7px;"></div>
                  </div>
                </td>
                <td class="text-right text-muted small" style="width:100px">NT$<%= number_with_delimiter(r.revenue.to_i) %></td>
                <td class="small text-muted" style="width:20px"><%= "🏆" if is_best %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="col-md-6">
        <p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">幾點下單</p>
        <% max_slot = slotted.map { |s| s[:revenue] }.max.to_f %>
        <table class="table table-sm mb-0">
          <tbody>
            <% slotted.each do |s| %>
              <% pct = max_slot > 0 ? (s[:revenue] / max_slot * 100).round : 0 %>
              <% is_best = s[:revenue] == max_slot %>
              <tr class="<%= is_best ? 'table-warning' : '' %>">
                <td class="px-2 fw-bold small" style="width:90px"><%= s[:label] %></td>
                <td>
                  <div style="background:#f0f0f0;border-radius:3px;height:7px;overflow:hidden;">
                    <div style="width:<%= pct %>%;background:#9b59b6;height:7px;"></div>
                  </div>
                </td>
                <td class="text-right text-muted small" style="width:100px">NT$<%= number_with_delimiter(s[:revenue].to_i) %></td>
                <td class="small text-muted" style="width:20px"><%= "🏆" if is_best %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%# ── 買家名單（分頁） ── %>
    <p class="text-uppercase text-muted small fw-bold letter-spacing-1 mb-2">
      買家名單
      <span class="fw-normal text-muted">— 第 <%= @page %> / <%= @total_pages %> 頁，共 <%= number_with_delimiter(@active_count) %> 人</span>
    </p>
    <div class="table-responsive">
      <table class="table table-hover table-sm mb-0">
        <thead class="thead-light">
          <tr>
            <th class="px-2" style="width:36px">#</th>
            <th>IG 帳號</th>
            <th>客戶姓名</th>
            <th>Email</th>
            <th class="text-right">訂單數</th>
            <th class="text-right">總消費</th>
          </tr>
        </thead>
        <tbody>
          <% @paged_buyers.each_with_index do |b, i| %>
            <tr>
              <td class="px-2 text-muted small"><%= (@page - 1) * @per_page + i + 1 %></td>
              <td>
                <a href="https://www.instagram.com/<%= b['ig'] %>" target="_blank" class="text-muted small">
                  @<%= b["ig"] %>
                </a>
              </td>
              <td class="small"><%= b["name"] %></td>
              <td class="text-muted small"><%= b["email"] %></td>
              <td class="text-right small"><%= b["orders"] %></td>
              <td class="text-right fw-bold small">NT$<%= number_with_delimiter(b["amount"].to_i) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @total_pages > 1 %>
      <div class="d-flex justify-content-between align-items-center pt-2 mt-1 border-top">
        <span class="text-muted small">
          第 <%= (@page - 1) * @per_page + 1 %>–<%= [@page * @per_page, @active_count].min %> 筆
        </span>
        <nav>
          <ul class="pagination pagination-sm mb-0">
            <li class="page-item <%= @page <= 1 ? 'disabled' : '' %>">
              <%= link_to "«", ig_audience_path(tab: @active_tab, page: @page - 1), class: "page-link" %>
            </li>
            <% first_p = [@page - 3, 1].max; last_p = [@page + 3, @total_pages].min %>
            <% if first_p > 1 %>
              <%= link_to "1", ig_audience_path(tab: @active_tab, page: 1), class: "page-link" %>
              <li class="page-item disabled"><span class="page-link">…</span></li>
            <% end %>
            <% (first_p..last_p).each do |p| %>
              <li class="page-item <%= p == @page ? 'active' : '' %>">
                <%= link_to p, ig_audience_path(tab: @active_tab, page: p), class: "page-link" %>
              </li>
            <% end %>
            <% if last_p < @total_pages %>
              <li class="page-item disabled"><span class="page-link">…</span></li>
              <%= link_to @total_pages, ig_audience_path(tab: @active_tab, page: @total_pages), class: "page-link" %>
            <% end %>
            <li class="page-item <%= @page >= @total_pages ? 'disabled' : '' %>">
              <%= link_to "»", ig_audience_path(tab: @active_tab, page: @page + 1), class: "page-link" %>
            </li>
          </ul>
        </nav>
      </div>
    <% end %>

  </div>
</div>

<% end %>
