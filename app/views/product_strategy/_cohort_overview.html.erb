<% pct = ->(a, b) { b.to_i.positive? ? "#{(a * 100.0 / b).round(1)}%" : "—" } %>
<div class="pc-panel">
  <div class="pc-head">
    <div>
      <div class="pc-title">🧭 首購來源追蹤總表</div>
      <div class="pc-sub">依每位客人第一筆訂單的產品分群（PDRN 拆預購／現貨），看之後的回購次數、金額、跨買、卡別變化。點產品名稱看該產品的客人分析。</div>
    </div>
    <%= form_with url: product_strategy_path, method: :get, local: true, class: "d-flex align-items-center gap-2" do %>
      <%= select_tag :period, options_for_select(ProductCohortAnalysis::PERIODS.map { |k, v| [v, k] }, @period), class: "form-control form-control-sm", onchange: "this.form.submit()" %>
    <% end %>
  </div>
  <div class="table-responsive">
    <table class="table table-sm table-hover pc-table mb-1">
      <thead>
        <tr>
          <th>首購來源</th>
          <th class="text-end">首購人數</th>
          <th class="text-end">有回購</th>
          <th class="text-end">同產品回購</th>
          <th class="text-end">30 天回購率</th>
          <th class="text-end">90 天回購率</th>
          <th class="text-end">回購者平均消費</th>
          <th class="text-end">平均回購次數</th>
          <th>跨買前 3 名</th>
          <th class="text-end">卡別升級</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @cohort_rows.each do |source, s| %>
          <% w30 = s[:windows][30]; w90 = s[:windows][90] %>
          <tr>
            <td class="pc-nowrap"><%= link_to source, product_strategy_source_path(source: source, period: @period.presence), class: "fw-bold #{'pc-pre' if source == 'PDRN 預購'}" %></td>
            <td class="text-end"><%= number_with_delimiter(s[:total]) %></td>
            <td class="text-end pc-nowrap"><%= number_with_delimiter(s[:repurchased]) %> <span class="text-muted">(<%= pct.(s[:repurchased], s[:total]) %>)</span></td>
            <td class="text-end pc-nowrap"><%= number_with_delimiter(s[:same_again]) %> <span class="text-muted">(<%= pct.(s[:same_again], s[:total]) %>)</span></td>
            <td class="text-end"><%= pct.(w30[:hit], w30[:eligible]) %></td>
            <td class="text-end"><%= pct.(w90[:hit], w90[:eligible]) %></td>
            <td class="text-end pc-nowrap">NT$ <%= number_with_delimiter(s[:repurchased].positive? ? (s[:after_amount] / s[:repurchased]).round : 0) %></td>
            <td class="text-end"><%= s[:avg_after_days] %></td>
            <td><% s[:cross].first(3).each do |f, v| %><span class="pc-tag"><%= f %> <%= v[:people] %></span><% end %></td>
            <td class="text-end pc-nowrap"><%= s[:upgraded] %> <span class="text-muted">(<%= pct.(s[:upgraded], s[:total]) %>)</span></td>
            <td><%= link_to "看分析 →", product_strategy_source_path(source: source, period: @period.presence), class: "btn btn-xs btn-outline-primary pc-nowrap" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="small text-muted">
    共 <%= number_with_delimiter(@cohort_total) %> 人；同 IG 的不同 email 算同一人，已排除黑名單。
    回購＝首購那天之後另一天有下單（任何產品）；同產品回購＝之後又買了首購那個產品。30／90 天回購率只算首購已滿 30／90 天的人。
    卡別升級＝首購那張單的會員等級 → 現在。
  </div>
</div>

<style>
  .pc-panel { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 16px 18px; margin-bottom: 20px; }
  .pc-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; margin-bottom: 10px; }
  .pc-title { font-size: 1.1rem; font-weight: 700; }
  .pc-sub { color: #6b7280; font-size: 13px; }
  .pc-table th { white-space: nowrap; color: #6b7280; font-weight: 600; font-size: 12px; }
  .pc-table td { vertical-align: middle; }
  .pc-nowrap { white-space: nowrap; }
  .pc-tag { display: inline-block; background: #ede7f6; color: #4527a0; border-radius: 999px; padding: 1px 8px; font-size: 12px; margin: 0 4px 2px 0; white-space: nowrap; }
  .pc-pre { color: #bf360c; }
</style>
