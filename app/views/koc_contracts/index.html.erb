<%# app/views/koc_contracts/index.html.erb %>
<% content_for :page_title, "合約狀態" %>

<div class="row g-3 mb-3">
  <div class="col-12">
    <h4 class="fw-bold mb-0">合約狀態</h4>
    <p class="text-muted small mb-0">合作中的 KOC，財務部登記合約寄出／收到日期</p>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="bg-light">
          <tr>
            <th>IG 帳號</th>
            <th>別稱</th>
            <th style="min-width:150px">已寄合約</th>
            <th style="min-width:150px">已收合約</th>
          </tr>
        </thead>
        <tbody>
          <% @kocs.each do |koc| %>
            <tr>
              <td>
                <a href="<%= koc.profile_link %>" target="_blank" rel="noopener">
                  @<%= koc.ig_username %>
                </a>
              </td>
              <td><%= koc.alias %></td>
              <td>
                <%= form_with model: koc, url: koc_contract_path(koc), method: :patch, local: true, class: "mb-0" do |f| %>
                  <%= f.date_field :contract_sent_at, value: koc.contract_sent_at, class: "form-control form-control-sm", onchange: "this.form.requestSubmit()" %>
                <% end %>
              </td>
              <td>
                <%= form_with model: koc, url: koc_contract_path(koc), method: :patch, local: true, class: "mb-0" do |f| %>
                  <%= f.date_field :contract_received_at, value: koc.contract_received_at, class: "form-control form-control-sm", onchange: "this.form.requestSubmit()" %>
                <% end %>
              </td>
            </tr>
          <% end %>
          <% if @kocs.empty? %>
            <tr>
              <td colspan="4" class="text-center text-muted py-4">目前沒有「合作中」的 KOC</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
